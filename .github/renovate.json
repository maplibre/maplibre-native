{
  "enabledManagers": ["gradle-wrapper", "bazel", "bazel-module", "bazelisk"],
  "packageRules": [
    {
      "matchManagers": ["bazel", "bazel-module"],
      "groupName": "bazel"
    },
    {
      "description": "Bazel 8.8 makes ios-ci fail on macos-26 runners (lost runners, filesystem I/O errors)",
      "matchManagers": ["bazelisk"],
      "matchDepNames": ["bazel"],
      "allowedVersions": "<8.7.0"
    }
  ],
  "ignoreDeps": ["cxx.rs"],
  "schedule": "* * 1,15 * *",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days"
}
