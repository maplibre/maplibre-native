{
  "version": 8,
  "metadata": {
    "test": {
      "mapMode": "continuous",
      "outputsImage": true,
      "keepUprightMargin": 20,
      "width": 128,
      "height": 256,
      "operations": [
        [
          "setBearing",
          -6
        ],
        [
          "wait"
        ],
        [
          "setBearing",
          6
        ],
        [
          "wait"
        ],
        [
          "setZoom",
          4.4
        ],
        [
          "wait"
        ]
      ]
    }
  },
  "center": [
    10,
    12.5
  ],
  "zoom": 3.4,
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "Feature",
        "properties": {},
        "geometry": {
          "type": "LineString",
          "coordinates": [
            [
              10,
              5
            ],
            [
              10,
              20
            ]
          ]
        }
      }
    }
  },
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "geojson",
      "paint": {
        "line-color": "#ccc",
        "line-width": 8
      }
    },
    {
      "id": "label",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "symbol-placement": "line-center",
        "text-allow-overlap": true,
        "text-ignore-placement": true,
        "text-field": "Main Street",
        "text-font": [
          "Open Sans Semibold",
          "Arial Unicode MS Bold"
        ],
        "text-keep-upright": true
      }
    }
  ]
}
