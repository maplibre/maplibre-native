{"metadata":{"roleHeading":"Instance Method","modules":[{"name":"MapLibre"}],"title":"featuresInSourceLayersWithIdentifiers:predicate:","fragments":[{"text":"- ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"identifier"}],"symbolKind":"method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"identifier"}],"role":"symbol","externalID":"c:objc(cs)MLNVectorTileSource(im)featuresInSourceLayersWithIdentifiers:predicate:"},"abstract":[{"type":"text","text":"Returns an array of map features loaded by this source, restricted to the given"},{"type":"text","text":" "},{"type":"text","text":"source layers and filtered by the given predicate."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"NSArray<id<MLNFeature>>","preciseIdentifier":"c:Q$objc(cs)NSArray","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSSet<NSString *>","preciseIdentifier":"c:Q$objc(cs)NSSet","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"sourceLayerIdentifiers","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"predicate:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSPredicate","preciseIdentifier":"c:objc(cs)NSPredicate","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"predicate","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The source layers to include in the query. Only"},{"type":"text","text":" "},{"type":"text","text":"the features contained in these source layers are included in the returned"},{"type":"text","text":" "},{"type":"text","text":"array. This array may not be empty."}],"type":"paragraph"}],"name":"sourceLayerIdentifiers"},{"content":[{"inlineContent":[{"type":"text","text":"A predicate to filter the returned features. Use "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"include all loaded features."}],"type":"paragraph"}],"name":"predicate"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"text":"An array of objects conforming to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference"},{"text":" protocol that","type":"text"},{"text":" ","type":"text"},{"text":"represent features loaded by the source that match the predicate.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Each object in the returned array represents a feature loaded by the source and","type":"text"},{"text":" ","type":"text"},{"text":"provides access to attributes specified as part of the loaded feature. The","type":"text"},{"text":" ","type":"text"},{"text":"source loads a feature if the source is added to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference"},{"text":"’s style; that","type":"text"},{"text":" ","type":"text"},{"text":"style has a layer that uses the source; and the map view has recently scrolled","type":"text"},{"text":" ","type":"text"},{"text":"to the region containing the feature.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Features come from tiled vector data that is converted to tiles internally, so","type":"text"},{"text":" ","type":"text"},{"text":"feature geometries are clipped at tile boundaries and features may appear","type":"text"},{"text":" ","type":"text"},{"text":"duplicated across tiles. For example, suppose part of a lengthy polyline","type":"text"},{"text":" ","type":"text"},{"text":"representing a road has recently scrolled into view. The resulting array","type":"text"},{"text":" ","type":"text"},{"text":"includes those parts of the road that lie within the map tiles that the source","type":"text"},{"text":" ","type":"text"},{"text":"has loaded, even if the road extends into other tiles. The portion of the road","type":"text"},{"text":" ","type":"text"},{"text":"within each map tile is included individually.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Returned features may not necessarily be visible to the user at the time they","type":"text"},{"text":" ","type":"text"},{"text":"are loaded: the style may contain a layer that forces the source’s tiles to","type":"text"},{"text":" ","type":"text"},{"text":"load but filters out the features in question, preventing them from being","type":"text"},{"text":" ","type":"text"},{"text":"drawn. To obtain only ","type":"text"},{"inlineContent":[{"type":"text","text":"visible"}],"type":"emphasis"},{"text":" features, use the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:","type":"reference"},{"text":" ","type":"text"},{"text":"or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:","type":"reference"},{"text":" ","type":"text"},{"text":"method.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featuresInSourceLayersWithIdentifiers:predicate:"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/maplibre\/mlnvectortilesource\/featuresinsourcelayerswithidentifiers:predica