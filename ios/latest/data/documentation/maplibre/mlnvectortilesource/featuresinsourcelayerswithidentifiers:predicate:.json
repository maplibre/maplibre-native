{"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"- (","kind":"text"},{"text":"NSArray<id<MLNFeature>>","preciseIdentifier":"c:Q$objc(cs)NSArray","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSSet<NSString *>","preciseIdentifier":"c:Q$objc(cs)NSSet","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"sourceLayerIdentifiers","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"predicate:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSPredicate","preciseIdentifier":"c:objc(cs)NSPredicate","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"predicate","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The source layers to include in the query. Only","type":"text"},{"text":" ","type":"text"},{"text":"the features contained in these source layers are included in the returned","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"array. This array may not be empty."}]}],"name":"sourceLayerIdentifiers"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A predicate to filter the returned features. Use ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"include all loaded features."}]}],"name":"predicate"}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"An array of objects conforming to the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true,"type":"reference"},{"text":" protocol that","type":"text"},{"text":" ","type":"text"},{"text":"represent features loaded by the source that match the predicate.","type":"text"}]}],"kind":"content"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each object in the returned array represents a feature loaded by the source and"},{"type":"text","text":" "},{"type":"text","text":"provides access to attributes specified as part of the loaded feature. The"},{"type":"text","text":" "},{"type":"text","text":"source loads a feature if the source is added to an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true},{"type":"text","text":"’s style; that"},{"type":"text","text":" "},{"text":"style has a layer that uses the source; and the map view has recently scrolled","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the region containing the feature."}]},{"type":"paragraph","inlineContent":[{"text":"Features come from tiled vector data that is converted to tiles internally, so","type":"text"},{"type":"text","text":" "},{"type":"text","text":"feature geometries are clipped at tile boundaries and features may appear"},{"type":"text","text":" "},{"type":"text","text":"duplicated across tiles. For example, suppose part of a lengthy polyline"},{"type":"text","text":" "},{"type":"text","text":"representing a road has recently scrolled into view. The resulting array"},{"type":"text","text":" "},{"text":"includes those parts of the road that lie within the map tiles that the source","type":"text"},{"type":"text","text":" "},{"text":"has loaded, even if the road extends into other tiles. The portion of the road","type":"text"},{"text":" ","type":"text"},{"text":"within each map tile is included individually.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Returned features may not necessarily be visible to the user at the time they","type":"text"},{"type":"text","text":" "},{"text":"are loaded: the style may contain a layer that forces the source’s tiles to","type":"text"},{"type":"text","text":" "},{"text":"load but filters out the features in question, preventing them from being","type":"text"},{"type":"text","text":" "},{"text":"drawn. To obtain only ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"visible","type":"text"}]},{"text":" features, use the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"method.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnvectortilesource\/featuresinsourcelayerswithidentifiers:predicate:"]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featuresInSourceLayersWithIdentifiers:predicate:"},"abstract":[{"type":"text","text":"Returns an array of map features loaded by this source, restricted to the given"},{"type":"text","text":" "},{"type":"text","text":"source layers and filtered by the given predicate."}],"sections":[],"metadata":{"role":"symbol","title":"featuresInSourceLayersWithIdentifiers:predicate:","symbolKind":"method","fragments":[{"text":"- ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"identifier"}],"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:pred