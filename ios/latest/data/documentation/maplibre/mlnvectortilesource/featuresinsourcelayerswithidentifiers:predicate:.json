{"abstract":[{"text":"Returns an array of map features loaded by this source, restricted to the given","type":"text"},{"text":" ","type":"text"},{"text":"source layers and filtered by the given predicate.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnvectortilesource\/featuresinsourcelayerswithidentifiers:predicate:"]}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","preciseIdentifier":"c:Q$objc(cs)NSArray","text":"NSArray<id<MLNFeature>>"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:Q$objc(cs)NSSet","text":"NSSet<NSString *>"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"sourceLayerIdentifiers"},{"kind":"text","text":" "},{"kind":"identifier","text":"predicate:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSPredicate","text":"NSPredicate"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"predicate"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The source layers to include in the query. Only"},{"type":"text","text":" "},{"type":"text","text":"the features contained in these source layers are included in the returned"},{"type":"text","text":" "},{"type":"text","text":"array. This array may not be empty."}],"type":"paragraph"}],"name":"sourceLayerIdentifiers"},{"content":[{"inlineContent":[{"type":"text","text":"A predicate to filter the returned features. Use "},{"code":"nil","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"include all loaded features."}],"type":"paragraph"}],"name":"predicate"}]},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"An array of objects conforming to the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference"},{"type":"text","text":" protocol that"},{"type":"text","text":" "},{"type":"text","text":"represent features loaded by the source that match the predicate."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Each object in the returned array represents a feature loaded by the source and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provides access to attributes specified as part of the loaded feature. The"},{"type":"text","text":" "},{"type":"text","text":"source loads a feature if the source is added to an "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference"},{"text":"’s style; that","type":"text"},{"text":" ","type":"text"},{"text":"style has a layer that uses the source; and the map view has recently scrolled","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the region containing the feature."}],"type":"paragraph"},{"inlineContent":[{"text":"Features come from tiled vector data that is converted to tiles internally, so","type":"text"},{"text":" ","type":"text"},{"text":"feature geometries are clipped at tile boundaries and features may appear","type":"text"},{"text":" ","type":"text"},{"text":"duplicated across tiles. For example, suppose part of a lengthy polyline","type":"text"},{"type":"text","text":" "},{"type":"text","text":"representing a road has recently scrolled into view. The resulting array"},{"type":"text","text":" "},{"type":"text","text":"includes those parts of the road that lie within the map tiles that the source"},{"type":"text","text":" "},{"type":"text","text":"has loaded, even if the road extends into other tiles. The portion of the road"},{"type":"text","text":" "},{"type":"text","text":"within each map tile is included individually."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Returned features may not necessarily be visible to the user at the time they"},{"type":"text","text":" "},{"type":"text","text":"are loaded: the style may contain a layer that forces the source’s tiles to"},{"type":"text","text":" "},{"type":"text","text":"load but filters out the features in question, preventing them from being"},{"type":"text","text":" "},{"text":"drawn. To obtain only ","type":"text"},{"inlineContent":[{"type":"text","text":"visible"}],"type":"emphasis"},{"text":" features, use the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"or"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:","isActive":true},{"text":" ","type":"text"},{"text":"method.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featuresInSourceLayersWithIdentifiers:predicate:","interfaceLanguage":"occ"},"metadata":{"title":"featuresInSourceLayersWithIdentifiers:predicate:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:predicate:"}],"modules":[{"name":"MapLibre"}],"symbolKind":"method","externalID":"c:objc(cs)MLNVectorTileSource(im)featuresInSourceLayersWithIdentifiers:predicate:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"