{"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"- ("},{"preciseIdentifier":"c:Q$objc(cs)NSArray","kind":"typeIdentifier","text":"NSArray<id<MLNFeature>>"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:Q$objc(cs)NSSet","kind":"typeIdentifier","text":"NSSet<NSString *>"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"sourceLayerIdentifiers"},{"kind":"text","text":" "},{"kind":"identifier","text":"predicate:"},{"kind":"text","text":"("},{"text":"NSPredicate","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSPredicate"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"predicate"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"sourceLayerIdentifiers","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source layers to include in the query. Only"},{"text":" ","type":"text"},{"type":"text","text":"the features contained in these source layers are included in the returned"},{"text":" ","type":"text"},{"text":"array. This array may not be empty.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A predicate to filter the returned features. Use "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"include all loaded features."}],"type":"paragraph"}],"name":"predicate"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"An array of objects conforming to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":" protocol that"},{"type":"text","text":" "},{"type":"text","text":"represent features loaded by the source that match the predicate."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each object in the returned array represents a feature loaded by the source and"},{"type":"text","text":" "},{"text":"provides access to attributes specified as part of the loaded feature. The","type":"text"},{"text":" ","type":"text"},{"text":"source loads a feature if the source is added to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference"},{"type":"text","text":"’s style; that"},{"type":"text","text":" "},{"type":"text","text":"style has a layer that uses the source; and the map view has recently scrolled"},{"type":"text","text":" "},{"type":"text","text":"to the region containing the feature."}]},{"inlineContent":[{"text":"Features come from tiled vector data that is converted to tiles internally, so","type":"text"},{"type":"text","text":" "},{"type":"text","text":"feature geometries are clipped at tile boundaries and features may appear"},{"type":"text","text":" "},{"text":"duplicated across tiles. For example, suppose part of a lengthy polyline","type":"text"},{"text":" ","type":"text"},{"text":"representing a road has recently scrolled into view. The resulting array","type":"text"},{"text":" ","type":"text"},{"text":"includes those parts of the road that lie within the map tiles that the source","type":"text"},{"type":"text","text":" "},{"text":"has loaded, even if the road extends into other tiles. The portion of the road","type":"text"},{"type":"text","text":" "},{"type":"text","text":"within each map tile is included individually."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned features may not necessarily be visible to the user at the time they"},{"type":"text","text":" "},{"type":"text","text":"are loaded: the style may contain a layer that forces the source’s tiles to"},{"type":"text","text":" "},{"type":"text","text":"load but filters out the features in question, preventing them from being"},{"type":"text","text":" "},{"type":"text","text":"drawn. To obtain only "},{"type":"emphasis","inlineContent":[{"type":"text","text":"visible"}]},{"type":"text","text":" features, use the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:"},{"type":"text","text":" "},{"type":"text","text":"or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:"},{"type":"text","text":" "},{"type":"text","text":"method."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNVectorTileSource(im)featuresInSourceLayersWithIdentifiers:predicate:","fragments":[{"text":"- ","kind":"text"},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"identifier"}],"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"featuresInSourceLayersWithIdentifiers:predicate:","navigatorTitle":[{"kind":"text","text":"- "},{"text":"featuresInSourceLayersWithIdentifiers:predicate:","kind":"identifier"}]},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"]]},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featuresInSourceLayersWithIdentifiers:predicate:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Returns an array of map features loaded by this source, restricted to the given"},{"type":"text","text":" "},{"type":"text","text":"source layers and filtered by the given predicate."}],"variants":[{"paths":["\/documentation\/maplibre\/mlnvectortilesource\/featuresinsourcelayerswithidentifiers:predicate:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"type":"topic","title":"MLNStyle","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFeature":{"fragments":[{"kind":"identifier","text":"MLNFeature"}],"url":"\/documentation\/maplibre\/mlnfeature","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":"  protocol is used to provide details about geographic features"},{"type":"text","text":" "},{"type":"text","text":"contained in an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","type":"reference","isActive":true},{"type":"text","text":" object. Each concrete"},{"type":"text","text":" "},{"type":"text","text":"subclass of "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"type":"text","text":" in turn has a subclass that conforms to this protocol. A"},{"type":"text","text":" "},{"type":"text","text":"feature object associates a shape with an optional identifier and attributes."}],"title":"MLNFeature"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","type":"reference"},{"text":" is a map content source that supplies tiled vector data","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"text":"Mapbox Vector Tile","type":"text"},{"text":" format","type":"text"},{"text":" ","type":"text"},{"text":"to be shown on the map. The location of and metadata about the tiles are","type":"text"},{"text":" ","type":"text"},{"text":"defined either by an option dictionary or by an external file that conforms to","type":"text"},{"text":" ","type":"text"},{"text":"the","type":"text"},{"text":" ","type":"text"},{"text":"TileJSON specification","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A vector tile source is added to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object along with one or more","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","type":"reference"},{"text":" objects. A vector style layer defines the appearance of","type":"text"},{"text":" ","type":"text"},{"text":"any content supplied by the vector tile source.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","fragments":[{"kind":"identifier","text":"MLNVectorTileSource"}],"type":"topic","title":"MLNVectorTileSource","role":"symbol","url":"\/documentation\/maplibre\/mlnvectortilesource","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/featuresInSourceLayersWithIdentifiers:predicate:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:predicate:"}],"url":"\/documentation\/maplibre\/mlnvectortilesource\/featuresin