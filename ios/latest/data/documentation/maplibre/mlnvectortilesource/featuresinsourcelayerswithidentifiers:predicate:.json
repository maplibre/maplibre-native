]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source layers to include in the query. Only"},{"text":" ","type":"text"},{"type":"text","text":"the features contained in these source layers are included in the returned"},{"type":"text","text":" "},{"type":"text","text":"array. This array may not be empty."}]}],"name":"sourceLayerIdentifiers"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A predicate to filter the returned features. Use "},{"code":"nil","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"include all loaded features.","type":"text"}]}],"name":"predicate"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"An array of objects conforming to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"text":" protocol that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"represent features loaded by the source that match the predicate."}],"type":"paragraph"}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each object in the returned array represents a feature loaded by the source and"},{"text":" ","type":"text"},{"text":"provides access to attributes specified as part of the loaded feature. The","type":"text"},{"text":" ","type":"text"},{"text":"source loads a feature if the source is added to an ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true,"type":"reference"},{"text":"’s style; that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"style has a layer that uses the source; and the map view has recently scrolled"},{"type":"text","text":" "},{"type":"text","text":"to the region containing the feature."}]},{"type":"paragraph","inlineContent":[{"text":"Features come from tiled vector data that is converted to tiles internally, so","type":"text"},{"type":"text","text":" "},{"text":"feature geometries are clipped at tile boundaries and features may appear","type":"text"},{"text":" ","type":"text"},{"text":"duplicated across tiles. For example, suppose part of a lengthy polyline","type":"text"},{"type":"text","text":" "},{"type":"text","text":"representing a road has recently scrolled into view. The resulting array"},{"type":"text","text":" "},{"text":"includes those parts of the road that lie within the map tiles that the source","type":"text"},{"type":"text","text":" "},{"type":"text","text":"has loaded, even if the road extends into other tiles. The portion of the road"},{"type":"text","text":" "},{"type":"text","text":"within each map tile is included individually."}]},{"inlineContent":[{"type":"text","text":"Returned features may not necessarily be visible to the user at the time they"},{"type":"text","text":" "},{"text":"are loaded: the style may contain a layer that forces the source’s tiles to","type":"text"},{"text":" ","type":"text"},{"text":"load but filters out the features in question, preventing them from being","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"drawn. To obtain only "},{"type":"emphasis","inlineContent":[{"type":"text","text":"visible"}]},{"type":"text","text":" features, use the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:"},{"type":"text","text":" "},{"type":"text","text":"or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method."