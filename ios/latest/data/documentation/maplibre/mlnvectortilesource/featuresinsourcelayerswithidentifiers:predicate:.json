roject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object along with one or more"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" objects. A vector style layer defines the appearance of"},{"type":"text","text":" "},{"type":"text","text":"any content supplied by the vector tile source."}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnvectortilesource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:":{"role":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:"}],"url":"\/documentation\/maplibre\/mlnmapview\/visiblefeaturesatpoint:instylelayerswithidentifiers:predicate:","title":"visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:","abstract":[{"type":"text","text":"Returns an array of rendered map features that intersect with a given point,"},{"type":"text","text":" "},{"type":"text","text":"restricted to the given style layers and filtered by the given predicate."}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/featuresInSourceLayersWithIdentifiers:predicate:":{"role":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"featuresInSourceLayersWithIdentifiers:predicate:"}],"url":"\/documentation\/maplibre\/mlnvectortilesource\/featuresinsourcelayerswithidentifiers:predicate:","title":"featuresInSourceLayersWithIdentifiers:predicate:","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featuresInSourceLayersWithIdentifier