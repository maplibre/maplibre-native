","isActive":true},{"type":"text","text":" is dense enough to warrant a heatmap,"},{"type":"text","text":" "},{"type":"text","text":"you can alternatively cluster the source using the "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHeatmapStyleLayer","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"option and render the data using an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHeatmapStyleLayer","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHeatmapStyleLayer","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can access an existing heatmap style layer using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"MLNStyle\/layerWithIdentifier:"},{"type":"text","text":" method if you know its identifier;"},{"type":"text","text":" "},{"type":"text","text":"otherwise, find it using the "},{"type":"codeVoice","code":"MLNStyle\/layers"},{"type":"text","text":" property. You can also create a"},{"type":"text","text":" "},{"type":"text","text":"new heatmap style layer and add it to the style using a method such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"MLNStyle\/addLayer:"},{"type":"text","text":"."}]},{"type":"heading","level":4,"anchor":"Related-examples","text":"Related examples"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"text","text":"Create a"},{"type":"text","text":" "},{"type":"text","text":"heatmap layer"},{"type":"text","text":" example to learn how to add this style layer to your map."}]},{"type":"heading","level":3,"anchor":"Example","text":"Example"},{"syntax":"swift","type":"codeListing","code":[]}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHeatmapStyleLayer","i