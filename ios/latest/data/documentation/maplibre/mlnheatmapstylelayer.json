apWeight"},{"type":"text","text":" but controls the intensity of the heatmap globally."},{"type":"text","text":" "},{"type":"text","text":"Primarily used for adjusting the heatmap based on zoom level."}],"fragments":[{"kind":"identifier","text":"heatmapIntensity"}],"kind":"symbol","role":"symbol","title":"heatmapIntensity","url":"\/documentation\/maplibre\/mlnheatmapstylelayer\/heatmapintensity","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNHeatmapStyleLayer/heatmapColor":{"role":"symbol","fragments":[{"text":"heatmapColor","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnheatmapstylelayer\/heatmapcolor","title":"heatmapColor","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHeatmapStyleLayer\/heatmapColor","abstract":[{"type":"text","text":"The color of each screen point based on its density value in a heatmap. This"},{"type":"text","text":" "},{"type":"text","text":"property is normally set to an interpolation or step expression with the"},{"type":"text","text":" "},{"code":"$heatmapDensity","type":"codeVoice"},{"type":"text","text":" value as its input."}],"kind":"symbol"}}}