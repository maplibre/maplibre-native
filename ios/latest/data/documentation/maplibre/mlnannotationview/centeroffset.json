{"metadata":{"title":"centerOffset","fragments":[{"text":"centerOffset","kind":"identifier"}],"role":"symbol","symbolKind":"property","remoteSource":{"fileName":"MLNAnnotationView.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/platform\/ios\/src\/MLNAnnotationView.h#L159"},"navigatorTitle":[{"kind":"identifier","text":"centerOffset"}],"roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNAnnotationView(py)centerOffset"},"variants":[{"paths":["\/documentation\/maplibre\/mlnannotationview\/centeroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"CGVector","preciseIdentifier":"c:@S@CGVector"},{"kind":"text","text":" "},{"kind":"identifier","text":"centerOffset"},{"kind":"text","text":";"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"By default, the center point of an annotation view is placed at the geographic","type":"text"},{"text":" ","type":"text"},{"text":"coordinate point of the associated annotation. If you do not want the view to","type":"text"},{"text":" ","type":"text"},{"text":"be centered, you can use this property to reposition the view. The offset’s","type":"text"},{"text":" ","type":"text"},{"code":"dx","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dy","type":"codeVoice"},{"text":" values are measured in points. Positive offset values move the","type":"text"},{"text":" ","type":"text"},{"text":"annotation view down and to the right, while negative values move it up and to","type":"text"},{"text":" ","type":"text"},{"text":"the left.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set the offset if the annotation view’s visual center point is somewhere other","type":"text"},{"text":" ","type":"text"},{"text":"than the logical center of the view. For example, the view may contain an image","type":"text"},{"text":" ","type":"text"},{"text":"that depicts a downward-pointing pushpin or thumbtack, with the tip positioned","type":"text"},{"text":" ","type":"text"},{"text":"at the center-bottom of the view. In that case, you would set the offset’s ","type":"text"},{"code":"dx","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to zero and its ","type":"text"},{"code":"dy","type":"codeVoice"},{"text":" to half the height of the view.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView\/centerOffset","interfaceLanguage":"occ"},"sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView"]]},"abstract":[{"type":"text","text":"The offset, measured in points, at which to place the center of the view."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotation":{"title":"MLNAnnotation","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlnannotation","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation"},{"type":"text","text":" protocol is used to provide annotation-related information"},{"type":"text","text":" "},{"type":"text","text":"to a map view. To use this protocol, you adopt it in any custom objects that"},{"type":"text","text":" "},{"type":"text","text":"store or represent annotation data. Each object then serves as the source of"},{"type":"text","text":" "},{"text":"information about a single map annotation and provides critical information,","type":"text"},{"type":"text","text":" "},{"text":"such as the annotation’s location on the map. Annotation objects do not provide","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"text":" ","type":"text"},{"text":"conjunction with the map view’s delegate) the creation of an appropriate","type":"text"},{"text":" ","type":"text"},{"text":"objects to handle the display.","type":"text"}],"fragments":[{"text":"MLNAnnotation","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationView/centerOffset":{"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"centerOffset"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView\/centerOffset","url":"\/documentation\/maplibre\/mlnannotationview\/centeroffset","abstract":[{"text":"The offset, measured in points, at which to place the center of the view.","type":"text"}],"title":"centerOffset"},"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"type":"topic","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationView":{"title":"MLNAnnotationView","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView","type":"reference","isActive":true},{"text":" class is responsible for marking a point annotation","type":"text"},{"type":"text","text":" "},{"text":"with a view. Annotation views represent an annotation object, which is an","type":"text"},{"text":" ","type":"text"},{"text":"object that corresponds to the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation"},{"text":" protocol. When an annotation’s","type":"text"},{"text":" ","type":"text"},{"text":"geographic coordinate is visible in the map view, the map view asks its","type":"text"},{"text":" ","type":"text"},{"text":"delegate to a corresponding annotation view. If an annotation view is created","type":"text"},{"text":" ","type":"text"},{"text":"with a reuse identifier, the map view may recycle the view when it goes","type":"text"},{"text":" ","type":"text"},{"text":"offscreen.","type":"text"}],"type":"topic","url":"\/documentation\/maplibre\/mlnannotationview","fragments":[{"text":"MLNAnnotationView","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView","role":"symbol"}}}