text","text":"objects and may be recycled later and put into a reuse queue that is maintained"},{"type":"text","text":" "},{"type":"text","text":"by the map view."}],"url":"\/documentation\/maplibre\/mlnannotationimage"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCoordinateQuad":{"fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}],"type":"topic","kind":"symbol","title":"MLNCoordinateQuad","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","role":"symbol","abstract":[{"text":"A quadrilateral area as measured on a two-dimensional map projection.","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"type":"text","text":" differs from "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","isActive":true},{"type":"text","text":" in that it allows"},{"type":"text","text":" "},{"type":"text","text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals."},{"type":"text","text":" "},{"type":"text","text":"The coordinates are described in counter clockwise order from top left."}],"url":"\/documentation\/maplibre\/mlncoordinatequad"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/coordinates":{"title":"coordinates","abstract":[{"text":"The coordinates at which the corners of the source image will be placed.","type":"text"}],"role":"symbol","fragments":[{"text":"coordinates","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/coordinates","url":"\/documentation\/maplibre\/mlnimagesource\/coordinates","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/setImage:forName:":{"title":"setImage:forName:","abstract":[{"type":"text","text":"Adds or overrides an image used by the style’s layers."}],"role":"symbol","fragments":[{"t