Project\/documentation\/MapLibre\/MLNAnnotationImage","isActive":true},{"type":"text","text":" class is responsible for presenting point-based"},{"type":"text","text":" "},{"type":"text","text":"annotations visually on a map view. Annotation image objects wrap "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":" "},{"type":"text","text":"objects and may be recycled later and put into a reuse queue that is maintained"},{"type":"text","text":" "},{"type":"text","text":"by the map view."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCoordinateQuad":{"type":"topic","url":"\/documentation\/maplibre\/mlncoordinatequad","kind":"symbol","title":"MLNCoordinateQuad","role":"symbol","fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","abstract":[{"text":"A quadrilateral area as measured on a two-dimensional map projection.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","type":"reference","isActive":true},{"text":" differs from ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","type":"reference","isActive":true},{"text":" in that it allows","type":"text"},{"text":" ","type":"text"},{"text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals.","type":"text"},{"text":" ","type":"text"},{"text":"The coordinates are described in counter clockwise order from top left.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/setImage:forName:":{"abstract":[{"text":"Adds or overrides an image used by the style’s layers.","type":"text"}],"role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"setImage:forName:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","kind":"symbol","url":"\/documentation\/maplibre\