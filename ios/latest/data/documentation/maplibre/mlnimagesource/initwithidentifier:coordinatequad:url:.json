 and may be recycled later and put into a reuse queue that is maintained"},{"type":"text","text":" "},{"type":"text","text":"by the map view."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCoordinateQuad":{"title":"MLNCoordinateQuad","type":"topic","abstract":[{"type":"text","text":"A quadrilateral area as measured on a two-dimensional map projection."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"type":"text","text":" differs from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"type":"text","text":" in that it allows"},{"type":"text","text":" "},{"type":"text","text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals."},{"type":"text","text":" "},{"type":"text","text":"The coordinates are described in counter clockwise order from top left."}],"fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlncoordinatequad","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/setImage:forName:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","fragments":[{"text":"- ","kind":"text"},{"text":"setImage:forName:","kind":"identifier"}],"title":"setImage:forName:","kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/setimage:forname:","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Adds or overrides an image used by the style’s layers."}]},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symb