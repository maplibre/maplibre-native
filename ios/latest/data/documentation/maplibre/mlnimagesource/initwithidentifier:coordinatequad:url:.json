"text","text":" "},{"type":"text","text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals."},{"type":"text","text":" "},{"type":"text","text":"The coordinates are described in counter clockwise order from top left."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","type":"topic","role":"symbol","kind":"symbol","title":"MLNCoordinateQuad","fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/initWithIdentifier:coordinateQuad:URL:":{"url":"\/documentation\/maplibre\/mlnimagesource\/initwithidentifier:coordinatequad:url:","abstract":[{"text":"Returns a georeferenced image source with an identifier, coordinates and a URL.","type":"text"}],"type":"topic","fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:coordinateQuad:URL:","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/initWithIdentifier:coordinateQuad:URL:","kind":"symbol","title":"initWithIdentifier:coordinateQuad:URL:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","title":"MLNAnnotationImage","role":"symbol","url":"\/documentation\/maplibre\/mlnannotationimage","fragments":[{"text":"MLNAnnotationImage","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage"},{"type":"text","text":" class is responsible for presenting point-based"},{"type":"text","text":" "},{"type":"text","text":"annotations visually on a map view. Annotation image objects wrap "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":" "},{"type":"text","text":"objects and may be recycled later and put into a reuse queue that is maintained