d image scales and rotates as the"},{"type":"text","text":" "},{"type":"text","text":"user zooms and rotates the map. Images may also be used as icons or patterns"},{"type":"text","text":" "},{"type":"text","text":"in a style layer. To register an image for use as an icon or pattern,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:"},{"type":"text","text":" method. To configure a point"},{"type":"text","text":" "},{"type":"text","text":"annotation’s image, use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage"},{"type":"text","text":" class."}],"fragments":[{"kind":"identifier","text":"MLNImageSource"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource","kind":"symbol","title":"MLNImageSource","role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnimagesource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCoordinateQuad":{"url":"\/documentation\/maplibre\/mlncoordinatequad","type":"topic","title":"MLNCoordinateQuad","role":"symbol","fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}],"abstract":[{"type":"text","text":"A quadrilateral area as measured on a two-dimensional map projection."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"type":"text","text":" differs from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"type":"text","text":" in that it allows"},{"type":"text","text":" "},{"type":"text","text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals."},{"type":"text","text":" "},{"type":"text","text":"The coordinates are described in counter clockwise order from top