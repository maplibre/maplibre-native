ift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad"},{"text":" in that it allows","type":"text"},{"text":" ","type":"text"},{"text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals.","type":"text"},{"text":" ","type":"text"},{"text":"The coordinates are described in counter clockwise order from top left.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlncoordinatequad","title":"MLNCoordinateQuad"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/initWithIdentifier:coordinateQuad:URL:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/initWithIdentifier:coordinateQuad:URL:","fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:coordinateQuad:URL:","kind":"identifier"}],"type":"topic","abstract":[{"text":"Returns a georeferenced image source with an identifier, coordinates and a URL.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlnimagesource\/initwithidentifier:coordinatequad:url:","title":"initWithIdentifier:coordinateQuad:URL:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage":{"title":"MLNAnnotationImage","url":"\/documentation\/maplibre\/mlnannotationimage","fragments":[{"text":"MLNAnnotationImage","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","type":"topic","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","isActive":true},{"text":" class is responsible for presenting point-based","type":"text"},{"text":" ","type":"text"},{"text":"annotations visually on a map view. Annotation image objects wrap ","type":"text"},{"code":"UIImage","type":"codeVoice"},{"text":" ","type":"text"},{"text":"objects and may be recycled later and put into a reuse queue that is maintained","type":"text"},{"text":" ","