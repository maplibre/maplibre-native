xt"},{"text":"centered.","type":"text"}],"type":"paragraph"}],"name":"centerCoordinate"},{"content":[{"inlineContent":[{"text":"The altitude (measured in meters) above the map at which the","type":"text"},{"text":" ","type":"text"},{"text":"camera should be situated. The altitude may be less than the distance from","type":"text"},{"text":" ","type":"text"},{"text":"the camera’s viewpoint to the camera’s focus point.","type":"text"}],"type":"paragraph"}],"name":"altitude"},{"content":[{"inlineContent":[{"text":"The viewing angle of the camera, measured in degrees. A value of","type":"text"},{"text":" ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" results in a camera pointed straight down at the map. Angles greater","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" result in a camera angled toward the horizon.","type":"text"}],"type":"paragraph"}],"name":"pitch"},{"content":[{"inlineContent":[{"text":"The camera’s heading, measured in degrees clockwise from true","type":"text"},{"text":" ","type":"text"},{"text":"north. A value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" means that the top edge of the map view corresponds to","type":"text"},{"text":" ","type":"text"},{"text":"true north. The value ","type":"text"},{"code":"90","type":"codeVoice"},{"text":" means the top of the map is pointing due east.","type":"text"},{"text":" ","type":"text"},{"text":"The value ","type":"text"},{"code":"180","type":"codeVoice"},{"text":" means the top of the map points due south, and so on.","type":"text"}],"type":"paragraph"}],"name":"heading"}],"kind":"parameters"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapcamera\/cameralookingatcentercoordinate:altitude:pitch:heading:"]}