{"abstract":[{"type":"text","text":"Returns a new camera with the given distance, pitch, and heading."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"+ (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"cameraLookingAtCenterCoordinate:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:@S@CLLocationCoordinate2D","text":"CLLocationCoordinate2D","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"internalParam","text":"centerCoordinate"},{"kind":"text","text":" "},{"kind":"identifier","text":"acrossDistance:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"CLLocationDistance","preciseIdentifier":"c:@T@CLLocationDistance"},{"kind":"text","text":") "},{"kind":"internalParam","text":"distance"},{"kind":"text","text":" "},{"kind":"identifier","text":"pitch:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"c:@T@CGFloat"},{"kind":"text","text":") "},{"kind":"internalParam","text":"pitch"},{"kind":"text","text":" "},{"kind":"identifier","text":"heading:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"CLLocationDirection","preciseIdentifier":"c:@T@CLLocationDirection"},{"kind":"text","text":") "},{"kind":"internalParam","text":"heading"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"parameters":[{"name":"centerCoordinate","content":[{"type":"paragraph","inlineContent":[{"text":"The geographic coordinate on which the map should be","type":"text"},{"text":" ","type":"text"},{"text":"centered.","type":"text"}]}]},{"name":"distance","content":[{"type":"paragraph","inlineContent":[{"text":"The straight-line distance from the viewpoint to the","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/centerCoordinate"},{"text":".","type":"text"}]}]