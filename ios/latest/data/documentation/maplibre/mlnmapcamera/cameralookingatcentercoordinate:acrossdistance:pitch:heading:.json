{"abstract":[{"type":"text","text":"Returns a new camera with the given distance, pitch, and heading."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"+ (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"cameraLookingAtCenterCoordinate:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CLLocationCoordinate2D","preciseIdentifier":"c:@S@CLLocationCoordinate2D","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"centerCoordinate","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"acrossDistance:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CLLocationDistance","kind":"typeIdentifier","preciseIdentifier":"c:@T@CLLocationDistance"},{"text":") ","kind":"text"},{"text":"distance","kind":"internalParam"},{"kind":"text","text":" "},{"kind":"identifier","text":"pitch:"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@CGFloat","text":"CGFloat"},{"text":") ","kind":"text"},{"text":"pitch","kind":"internalParam"},{"kind":"text","text":" "},{"kind":"identifier","text":"heading:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@T@CLLocationDirection","kind":"typeIdentifier","text":"CLLocationDirection"},{"kind":"text","text":") "},{"kind":"internalParam","text":"heading"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The geographic coordinate on which the map should be"},{"type":"text","text":" "},{"type":"text","text":"centered."}],"type":"paragraph"}],"name":"centerCoordinate"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The straight-line distance from the viewpoint to the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/centerCoordinate"},{"type":"text","text":"."}]