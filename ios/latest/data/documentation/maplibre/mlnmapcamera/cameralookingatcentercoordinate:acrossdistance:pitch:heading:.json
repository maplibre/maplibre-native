raight-line distance from the viewpoint to the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/centerCoordinate","type":"reference","isActive":true},{"type":"text","text":"."}]}],"name":"distance"},{"content":[{"inlineContent":[{"text":"The viewing angle of the camera, measured in degrees. A value of","type":"text"},{"type":"text","text":" "},{"code":"0","type":"codeVoice"},{"text":" results in a camera pointed straight down at the map. Angles greater","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" result in a camera angled toward the horizon.","type":"text"}],"type":"paragraph"}],"name":"pitch"},{"content":[{"inlineContent":[{"type":"text","text":"The camera’s heading, measured in degrees clockwise from true"},{"type":"text","text":" "},{"type":"text","text":"north. A value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" means that the top edge of the map view corresponds to"},{"type":"text","text":" "},{"type":"text","text":"true north. The value "},{"type":"codeVoice","code":"90"},{"type":"text","text":" means the top of the map is pointing due east."},{"type":"text","text":" "},{"type":"text","text":"The value "},{"type":"codeVoice","code":"180"},{"type":"text","text":" means the top of the map points due south, and so on."}],"type":"paragraph"}],"name":"heading"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This method interprets the distance as a straight-line distance from the"},{"type":"text","text":" "},{"type":"text","text":"viewpoint to the center coordinate. To specify the altitude of the viewpoint,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/cameraLookingAtCen