{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Returns a new camera with the given distance, pitch, and heading.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"cameraLookingAtCenterCoordinate:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CLLocationCoordinate2D","kind":"typeIdentifier","preciseIdentifier":"c:@S@CLLocationCoordinate2D"},{"text":") ","kind":"text"},{"text":"centerCoordinate","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"acrossDistance:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CLLocationDistance","kind":"typeIdentifier","preciseIdentifier":"c:@T@CLLocationDistance"},{"text":") ","kind":"text"},{"text":"distance","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"pitch:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"c:@T@CGFloat"},{"text":") ","kind":"text"},{"text":"pitch","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"heading:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CLLocationDirection","preciseIdentifier":"c:@T@CLLocationDirection","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"internalParam","text":"heading"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"name":"centerCoordinate","content":[{"type":"paragraph","inlineContent":[{"text":"The geographic coordinate on which the map should be","type":"text"},{"text":" ","type":"text"},{"text":"centered.","type":"text"}]}]},{"name":"distance","content":[{"type":"paragraph","inlineContent":[{"text":"The straight-line distance from the viewpoint to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/centerCoordinate","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"name":"pitch","content":[{"type":"paragraph","inlineContent":[{"text":"The viewing angle of the camera, measured in degrees. A value of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" results in a camera pointed straight down at the map. Angles greater","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" result in a camera angled toward the horizon.","type":"text"}]}]},{"name":"heading","content":[{"type":"paragraph","inlineContent":[{"text":"The camera’s heading, measured in degrees clockwise from true","type":"text"},{"text":" ","type":"text"},{"text":"north. A value of ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" means that the top edge of the map view corresponds to","type":"text"},{"text":" ","type":"text"},{"text":"true north. The value ","type":"text"},{"type":"codeVoice","code":"90"},{"text":" means the top of the map is pointing due east.","type":"text"},{"text":" ","type":"text"},{"text":"The value ","type":"text"},{"type":"codeVoice","code":"180"},{"text":" means the top of the map points due south, and so on.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method interprets the distance as a straight-line distance from the"},{"type":"text","text":" "},{"type":"text","text":"viewpoint to the center coordinate. To specify the altitude of the viewpoint,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapCamera\/cameraLookingAtCenterCoordinate:altitude:pitch:heading:","isActive":true},{"type":"text","text":" method."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyP