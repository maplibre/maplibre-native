ect\/documentation\/MapLibre\/MLNHillshadeStyleLayer"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer"},{"type":"text","text":" objects. Use a hillshade"},{"type":"text","text":" "},{"type":"text","text":"style layer to control the appearance of content supplied by the raster DEM source,"},{"type":"text","text":" "},{"type":"text","text":"or a color relief style layer to render elevation data with a color ramp."}],"type":"topic","url":"\/documentation\/maplibre\/mlnrasterdemsource","title":"MLNRasterDEMSource","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"abstract":[{"type":"text","text":"Client-side elevation coloring based on DEM data. The implementation supports"},{"type":"text","text":" "},{"type":"text","text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings."}],"title":"MLNColorReliefStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"MLNColorReliefStyleLayer"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/initWithIdentifier:coordinateQuad:image:":{"type":"topic","fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:coordinateQuad:image:","kind":"identifier"}],"title":"initWithIdentifier:coordinateQuad:image:","role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/initWithIdentifier:coordinateQuad:image:","url":"\/documentation\/maplibre\/mlnimagesource\/initwithidentifier:coordinatequad:image:","abstract":[{"type":"text","text":"Returns a georeferenced image source with an identifier, coordinates and an image."}]}}}