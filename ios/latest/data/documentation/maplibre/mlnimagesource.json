nd rotates as the","type":"text"},{"text":" ","type":"text"},{"text":"user zooms and rotates the map. Images may also be used as icons or patterns","type":"text"},{"text":" ","type":"text"},{"text":"in a style layer. To register an image for use as an icon or pattern,","type":"text"},{"text":" ","type":"text"},{"text":"use the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","type":"reference","isActive":true},{"text":" method. To configure a point","type":"text"},{"text":" ","type":"text"},{"text":"annotation’s image, use the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","type":"reference","isActive":true},{"text":" class.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"abstract":[{"text":"Client-side elevation coloring based on DEM data. The implementation supports","type":"text"},{"text":" ","type":"text"},{"text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings.","type":"text"}],"fragments":[{"kind":"identifier","text":"MLNColorReliefStyleLayer"}],"kind":"symbol","title":"MLNColorReliefStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","type":"topic","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","kind":"symbol","type":"topic","title":"sourceWithIdentifier:","abstract":[{"text":"Returns a source with the given identifier in the current style.","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"sourceWithIdentifier:","kind":"identifier"}]}}}