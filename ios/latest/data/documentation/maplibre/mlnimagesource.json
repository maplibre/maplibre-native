e\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object along with one or more"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer"},{"type":"text","text":" or "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","isActive":true,"type":"reference"},{"text":" objects. Use a hillshade","type":"text"},{"text":" ","type":"text"},{"text":"style layer to control the appearance of content supplied by the raster DEM source,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or a color relief style layer to render elevation data with a color ramp."}],"url":"\/documentation\/maplibre\/mlnrasterdemsource","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterDEMSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/setImage:forName:":{"abstract":[{"text":"Adds or overrides an image used by the style’s layers.","type":"text"}],"url":"\/documentation\/maplibre\/mlnstyle\/setimage:forname:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setImage:forName:"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","type":"topic","title":"setImage:forName:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}],"title":"sourceWithIdentifier:","fragments":[{"text":"- ","kind":"text"},{"text":"sourceWithIdentifier:","kind":"identifier"}],"kind":"symbol"}}}