leSource"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnrastertilesource","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCoordinateQuad":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","abstract":[{"type":"text","text":"A quadrilateral area as measured on a two-dimensional map projection."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","isActive":true},{"type":"text","text":" differs from "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateQuad","isActive":true},{"type":"text","text":" in that it allows"},{"type":"text","text":" "},{"type":"text","text":"representation of non-axis aligned bounds and non-rectangular quadrilaterals."},{"type":"text","text":" "},{"type":"text","text":"The coordinates are described in counter clockwise order from top left."}],"type":"topic","title":"MLNCoordinateQuad","fragments":[{"kind":"identifier","text":"MLNCoordinateQuad"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlncoordinatequad","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/URL":{"fragments":[{"text":"URL","kind":"identifier"}],"abstract":[{"type":"text","text":"The URL to the source image."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/URL","kind":"symbol","url":"\/documentation\/maplibre\/mlnimagesource\/url","role":"symbol","title":"URL","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/For_Style_Authors":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors","abstract":[],"type":"topic","title":"Information for Style Authors","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/for_style_authors","role":"article"}}}