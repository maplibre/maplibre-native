roject\/documentation\/MapLibre\/MLNHillshadeStyleLayer"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer"},{"type":"text","text":" objects. Use a hillshade"},{"type":"text","text":" "},{"type":"text","text":"style layer to control the appearance of content supplied by the raster DEM source,"},{"type":"text","text":" "},{"type":"text","text":"or a color relief style layer to render elevation data with a color ramp."}],"role":"symbol","fragments":[{"kind":"identifier","text":"MLNRasterDEMSource"}],"title":"MLNRasterDEMSource","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource/initWithIdentifier:coordinateQuad:URL:":{"fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:coordinateQuad:URL:","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnimagesource\/initwithidentifier:coordinatequad:url:","abstract":[{"type":"text","text":"Returns a georeferenced image source with an identifier, coordinates and a URL."}],"title":"initWithIdentifier:coordinateQuad:URL:","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource\/initWithIdentifier:coordinateQuad:URL:","role":"symbol","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","kind":"symbol","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","abstract":[{"type":"text","text":"Client-side elevation coloring based on DEM data. The implementation supports"},{"type":"text","text":" "},{"type":"text","text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings."}],"role":"symbol","fragments":[{"kind":"identifier","text":"MLNColorReliefStyleLayer"}],"title":"MLNColorReliefStyleLayer","type":"topic"}}}