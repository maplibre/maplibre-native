 pattern,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"use the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","type":"reference"},{"type":"text","text":" method. To configure a point"},{"type":"text","text":" "},{"type":"text","text":"annotation’s image, use the "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","isActive":true},{"type":"text","text":" class."}],"url":"\/documentation\/maplibre\/mlnimagesource","title":"MLNImageSource","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}],"fragments":[{"text":"- ","kind":"text"},{"text":"sourceWithIdentifier:","kind":"identifier"}],"title":"sourceWithIdentifier:","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnrasterstylelayer","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is a style layer that renders georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"imagery on the map, especially raster tiles."}],"fragments":[{"text":"MLNRasterStyleLayer","kind":"identifier"}],"title":"MLNRasterStyleLayer","kind":"symbol"}}}