{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSExpression","preciseIdentifier":"c:objc(cs)NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"rasterResamplingMode"},{"kind":"text","text":";"}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The default value of this property is an expression that evaluates to ","type":"text"},{"code":"linear","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Set this property to ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to reset it to the default value."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This attribute corresponds to the "},{"text":"raster-resampling","type":"text"},{"text":" ","type":"text"},{"text":"layout property in the MapLibre Style Spec.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Constant ","type":"text"},{"code":"MLNRasterResamplingMode","type":"codeVoice"},{"text":" values","type":"text"},{"text":" ","type":"text"},{"text":"Any of the following constant string values:","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"linear"},{"type":"text","text":": (Bi)linear filtering interpolates pixel values using the weighted"},{"type":"text","text":" "},{"type":"text","text":"average of the four closest original source pixels creating a smooth but blurry"},{"type":"text","text":" "},{"type":"text","text":"look when overscaled"},{"type":"text","text":" "},{"code":"nearest","type":"codeVoice"},{"type":"text","text":": Nearest neighbor filtering interpolates pixel values using the"},{"type":"text","text":" "},{"type":"text","text":"nearest original source pixel creating a sharp but pixelated look when"},{"type":"text","text":" "},{"type":"text","text":"overscaled"},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"type":"text","text":" "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"type":"text","text":" "},{"type":"text","text":"attributes."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/maplibre\/mlnrasterstylelayer\/rasterresamplingmode"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer\/rasterResamplingMode","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"The resampling\/interpolation method to use for overscaling, also known as"},{"type":"text","text":" "},{"type":"text","text":"texture magnification filter"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","symbolKind":"property","externalID":"c:objc(cs)MLNRasterStyleLayer(py)rasterResamplingMode","roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"ras