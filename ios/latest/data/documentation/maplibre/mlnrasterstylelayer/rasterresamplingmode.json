{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"text":") ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression"},{"text":" * ","kind":"text"},{"kind":"identifier","text":"rasterResamplingMode"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The default value of this property is an expression that evaluates to "},{"type":"codeVoice","code":"linear"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Set this property to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to reset it to the default value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This attribute corresponds to the "},{"text":"raster-resampling","type":"text"},{"type":"text","text":" "},{"type":"text","text":"layout property in the MapLibre Style Spec."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Constant ","type":"text"},{"type":"codeVoice","code":"MLNRasterResamplingMode"},{"type":"text","text":" values"},{"text":" ","type":"text"},{"text":"Any of the following constant string values:","type":"text"},{"text":" ","type":"text"},{"code":"linear","type":"codeVoice"},{"type":"text","text":": (Bi)linear filtering interpolates pixel values using the weighted"},{"type":"text","text":" "},{"type":"text","text":"average of the four closest original source pixels creating a smooth but blurry"},{"type":"text","text":" "},{"type":"text","text":"look when overscaled"},{"type":"text","text":" "},{"code":"nearest","type":"codeVoice"},{"type":"text","text":": Nearest neighbor filtering interpolates pixel values using the"},{"type":"text","text":" "},{"type":"text","text":"nearest original source pixel creating a sharp but pixelated look when"},{"type":"text","text":" "},{"type":"text","text":"overscaled"},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"type":"text","text":" "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"type":"text","text":" "},{"type":"text","text":"attributes."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnrasterstylelayer\/rasterresamplingmode"]}],"metadata":{"symbolKind":"property","role":"symbol","externalID":"c:objc(cs)MLNRasterStyleLayer(py)rasterResamplingMode","title":"rasterResamplingMode","roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"rasterResamplingMode"}],"navigatorTitle":[{"text":"rasterResamplingMode","kind":"identifier"}],"modules":[{"name":"MapLibre"}]},"kind":"symbol","abstract":[{"text":"The resampling\/interpolation method to use for overscaling, also known as","type":"text"},{"text":" ","type":"text"},{"text":"texture magnification filter","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer\/rasterResamplingMode","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer"]]},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre","kind":"symbol","role":"collection","type":"topic","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer/rasterResamplingMode":{"title":"rasterResamplingMode","kind":"symbol","fragments":[{"kind":"identifier","text":"rasterResamplingMode"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer\/rasterResamplingMode","role":"symbol","abstract":[{"text":"The resampling\/interpolation method to use for overscaling, also known as","type":"text"},{"text":" ","type":"text"},{"text":"texture magnification filter","type":"text"}],"type":"topic","url":"\/documentation\/maplibre\/mlnrasterstylelayer\/rasterresamplingmode"},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is a style layer that renders georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"imagery on the map, especially raster tiles."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","type":"topic","fragments":[{"kind":"identifier","text":"MLNRasterStyleLayer"}],"title":"MLNRasterStyleLayer","url":"\/documentation\/maplibre\/mlnrasterstylelayer","role":"symbol","kind":"symbol"}}}