{"variants":[{"paths":["\/documentation\/maplibre\/mlnrasterstylelayer\/rasterresamplingmode"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"The resampling\/interpolation method to use for overscaling, also known as"},{"type":"text","text":" "},{"type":"text","text":"texture magnification filter"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"text":"NSExpression","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSExpression"},{"text":" * ","kind":"text"},{"text":"rasterResamplingMode","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The default value of this property is an expression that evaluates to ","type":"text"},{"code":"linear","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Set this property to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to reset it to the default value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This attribute corresponds to the "},{"type":"text","text":"raster-resampling"},{"type":"text","text":" "},{"text":"layout property in the MapLibre Style Spec.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can set this property to an expression containing any of the following:"}]},{"type":"paragraph","inlineContent":[{"text":"Constant ","type":"text"},{"code":"MLNRasterResamplingMode","type":"codeVoice"},{"type":"text","text":" values"},{"type":"text","text":" "},{"text":"Any of the following constant string values:","type":"text"},{"type":"text","text":" "},{"code":"linear","type":"codeVoice"},{"type":"text","text":": (Bi)linear filtering