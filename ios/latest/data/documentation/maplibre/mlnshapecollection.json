rance of an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":"’s shape collection collectively using an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"},{"type":"text","text":" object, or use multiple instances of"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"configure the appearance of each kind of shape inside the collection.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot add an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollection","isActive":true},{"type":"text","text":" object directly to a map view as an"},{"type":"text","text":" "},{"type":"text","text":"annotation. However, you can create individual "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolyline","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolyline","isActive":true},{"type":"text","text":" objects from the "},{"type":"codeVoice","code":"shapes"},{"type":"text","text":" array and add those"},{"type":"text","text":" "},{"type":"text","text":"annotation objects to the map view using the "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/addAnnotations:","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To represent a collection of point, polyline, or polygon shapes, it may be more"},{"type":"text","text":" "},{"type":"text","text":"convenient to use an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection","isActive":true},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMultiPolygon","isActive":true},{"type":"text","text":" object, respectively. To access a shape collection’s"},{"type":"text","text":" "},{"type":"text","text":"attributes, use the corresponding "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true},{"type":"text","text":" object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A shape collection is known as a"},{"type":"text","text":" "},{"type":"text","text":"GeometryCollection"},{"type":"text","text":" "},{"type":"text","text":"geometry in GeoJSON."}]}],"kind":"content"}],"metadata":{"externalID":"c:objc(cs)MLNShapeCollection","fragments":[{"text":"MLNShapeCollection","kind":"identifier"}],"roleHeading":"Class","title":"MLNShapeCollection","role":"symbol","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"MLNShapeCollection","kind