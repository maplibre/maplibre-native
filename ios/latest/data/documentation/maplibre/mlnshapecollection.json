e\/MLNPointAnnotation"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolyline"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolyline"},{"type":"text","text":" objects from the "},{"type":"codeVoice","code":"shapes"},{"type":"text","text":" array and add those"},{"type":"text","text":" "},{"type":"text","text":"annotation objects to the map view using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/addAnnotations:"},{"type":"text","text":" "},{"type":"text","text":"method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To represent a collection of point, polyline, or polygon shapes, it may be more"},{"type":"text","text":" "},{"type":"text","text":"convenient to use an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMultiPolygon"},{"type":"text","text":" object, respectively. To access a shape collection’s"},{"type":"text","text":" "},{"type":"text","text":"attributes, use the corresponding "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":" object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A shape collection is known as a"},{"type":"text","text":" "},{"type":"text","text":"GeometryCollection"},{"type":"text","text":" "},{"type":"text","text":"geometry in GeoJSON."}],"