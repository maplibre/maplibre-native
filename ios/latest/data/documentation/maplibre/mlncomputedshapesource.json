":"text","text":" "},{"type":"text","text":"use the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","type":"reference"},{"type":"text","text":" method. To configure a point"},{"type":"text","text":" "},{"type":"text","text":"annotation’s image, use the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","type":"reference"},{"type":"text","text":" class."}],"role":"symbol","title":"MLNImageSource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}],"fragments":[{"text":"- ","kind":"text"},{"text":"sourceWithIdentifier:","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","type":"topic","kind":"symbol","title":"sourceWithIdentifier:","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNComputedShapeSource/initWithIdentifier:dataSource:options:":{"kind":"symbol","url":"\/documentation\/maplibre\/mlncomputedshapesource\/initwithidentifier:datasource:options:","abstract":[{"type":"text","text":"Returns a custom shape data source initialized with an identifier, data source, and a"},{"type":"text","text":" "},{"type":"text","text":"dictionary of options for the source according to the"},{"type":"text","text":" "},{"type":"text","text":"style"},{"type":"text","text":" "},{"type":"text","text":"specification"},{"text":".","type":"text"}],"title":"initWithIdentifier:dataSource:options:","role":"symbol","type":"topic","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithIdentifier:dataSource:options:"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/Ma