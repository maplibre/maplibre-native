text":" ","type":"text"},{"text":"consisting of two ","type":"text"},{"type":"codeVoice","code":"NSExpression"},{"text":" objects.","type":"text"}],"metadata":{"title":"MLNShapeSourceOptionClusterProperties","symbolKind":"var","fragments":[{"kind":"identifier","text":"MLNShapeSourceOptionClusterProperties"}],"role":"symbol","externalID":"c:@MLNShapeSourceOptionClusterProperties","navigatorTitle":[{"kind":"identifier","text":"MLNShapeSourceOptionClusterProperties"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Global Variable"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShape":{"kind":"symbol","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference"},{"text":" is an abstract class that represents a shape or annotation. Shapes","type":"text"},{"text":" ","type":"text"},{"text":"constitute the content of a map — not only the overlays atop the map, but also","type":"text"},{"text":" ","type":"text"},{"text":"the content that forms the base map.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","url":"\/documentation\/maplibre\/mlnshape","fragments":[{"kind":"identifier","text":"MLNShape"}],"title":"MLNShape","type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSourceOptionClusterProperties":{"kind":"symbol","abstract":[{"type":"text","text":"An "},{"code":"NSDictionary","type":"codeVoice"},{"text":" object where the key is an ","type":"text"},{"type":"codeVoice","code":"NSString"},{"text":". The dictionary key will","type":"text"},{"type":"text","text":" "},{"type":"text","text":"be the feature attribute key. The resulting attribute value is"},{"type":"text","text":" "},{"type":"text","text":"aggregated from the clustered points. The dictionary value is an "},{"type":"codeVoice","code":"NSArray"},{"type":"text","text":" "},{"type":"text","text":"consisting of two "},{"code":"NSExpression","type":