{"kind":"symbol","sections":[],"abstract":[{"text":"An ","type":"text"},{"code":"NSDictionary","type":"codeVoice"},{"text":" object where the key is an ","type":"text"},{"code":"NSString","type":"codeVoice"},{"text":". The dictionary key will","type":"text"},{"text":" ","type":"text"},{"text":"be the feature attribute key. The resulting attribute value is","type":"text"},{"text":" ","type":"text"},{"text":"aggregated from the clustered points. The dictionary value is an ","type":"text"},{"code":"NSArray","type":"codeVoice"},{"text":" ","type":"text"},{"text":"consisting of two ","type":"text"},{"code":"NSExpression","type":"codeVoice"},{"text":" objects.","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSourceOptionClusterProperties","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/maplibre\/mlnshapesourceoptionclusterproperties"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"metadata":{"roleHeading":"Global Variable","externalID":"c:@MLNShapeSourceOptionClusterProperties","modules":[{"name":"MapLibre"}],"title":"MLNShapeSourceOptionClusterProperties","fragments":[{"kind":"identifier","text":"MLNShapeSourceOptionClusterProperties"}],"navigatorTitle":[{"kind":"identifier","text":"MLNShapeSourceOptionClusterProperties"}],"role":"symbol","symbolKind":"var"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"extern"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"c:MLNShapeSource.h@T@MLNShapeSourceOption","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSourceOption","text":"MLNShapeSourceOption"},{"kind":"text","text":" "},{"kind":"keyword","text":"const"},{"kind":"text","text":" "},{"kind":"identifier","text":"MLNShapeSourceOptionClusterProperties"},{"kind":"te