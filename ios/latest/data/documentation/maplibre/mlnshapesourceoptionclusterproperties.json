{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlnshapesourceoptionclusterproperties"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"kind":"symbol","abstract":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"NSDictionary"},{"text":" object where the key is an ","type":"text"},{"type":"codeVoice","code":"NSString"},{"text":". The dictionary key will","type":"text"},{"text":" ","type":"text"},{"text":"be the feature attribute key. The resulting attribute value is","type":"text"},{"text":" ","type":"text"},{"text":"aggregated from the clustered points. The dictionary value is an ","type":"text"},{"type":"codeVoice","code":"NSArray"},{"text":" ","type":"text"},{"text":"consisting of two ","type":"text"},{"type":"codeVoice","code":"NSExpression"},{"text":" objects.","type":"text"}],"metadata":{"modules":[{"name":"MapLibre"}],"fragments":[{"text":"MLNShapeSourceOptionClusterProperties","kind":"identifier"}],"navigatorTitle":[{"text":"MLNShapeSourceOptionClusterProperties","kind":"identifier"}],"externalID":"c:@MLNShapeSourceOptionClusterProperties","title":"MLNShapeSourceOptionClusterProperties","role":"symbol","roleHeading":"Global Variable","symbolKind":"var"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"extern","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"c:MLNShapeSource.h@T@MLNShapeSourceOption","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSourceOption","text":"MLNShapeSourceOption","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MLNShapeSourceOptionClusterProperties","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"dis