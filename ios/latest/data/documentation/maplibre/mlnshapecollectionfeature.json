":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer","fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"role":"symbol","title":"MLNSymbolStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeCollectionFeature/shapeCollectionWithShapes:":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature\/shapeCollectionWithShapes:","url":"\/documentation\/maplibre\/mlnshapecollectionfeature\/shapecollectionwithshapes:","title":"shapeCollectionWithShapes:","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"shapeCollectionWithShapes:"}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"type":"topic","url":"\/documentation\/maplibre\/mlnstyle","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyle"}],"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"title":"MLNStyle"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"type":"topic","url":"\/documentation\/maplibre\/mlnvectortilesource","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNVectorTileSource"}],"abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","type":"reference"},{"type":"text","text":" is a map content source tha