","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation"},{"text":" object is known as a point annotation or point shape. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you could use a point shape to represent a city at low zoom levels, an","type":"text"},{"text":" ","type":"text"},{"text":"address at high zoom levels, or the location of a long press gesture.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnpointannotation","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"MLNPointAnnotation"}],"title":"MLNPointAnnotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"type":"topic","kind":"symbol","title":"MLNSource","url":"\/documentation\/maplibre\/mlnsource","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true},{"text":" is an abstract base class for map content sources. A map content","type":"text"},{"text":" ","type":"text"},{"text":"source supplies content to be shown on the map. A source is added to an","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"text":" object along with an ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"text":" object. The","type":"text"},{"text":" ","type":"text"},{"text":"foreground style layer defines the appearance of any content supplied by the","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"role":"symbol","fragments":[{"text":"MLNSource","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with