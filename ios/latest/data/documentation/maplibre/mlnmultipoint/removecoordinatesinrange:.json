":"symbol","url":"\/documentation\/maplibre\/mlnshape"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/shape":{"abstract":[{"type":"text","text":"The contents of the source. A shape can represent a GeoJSON geometry, a"},{"type":"text","text":" "},{"type":"text","text":"feature, or a collection of features."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"shape","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnshapesource\/shape","title":"shape","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/shape"}}}