":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":" is an abstract class that represents a shape or annotation. Shapes"},{"type":"text","text":" "},{"type":"text","text":"constitute the content of a map — not only the overlays atop the map, but also"},{"type":"text","text":" "},{"type":"text","text":"the content that forms the base map."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","title":"MLNStyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShape/title":{"type":"topic","title":"title","abstract":[{"type":"text","text":"The title of the shape annotation."}],"url":"\/documentation\/maplibre\/mlnshape\/title","kind":"symbol","fragments":[{"text":"title","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape\/title","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFeature/attributes":{"title":"attributes","type":"topic","url":"\/documentation\/maplibre\/mlnfeature\/attributes","abstract":[{"type":"text","text":"A dictionary of attributes for this feature."}],"role":"symbol","fragments":[{"kind":"identifier","text":"attributes"}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/attributes"}}}