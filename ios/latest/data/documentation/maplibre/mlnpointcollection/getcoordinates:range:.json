ge","content":[{"inlineContent":[{"text":"The range of points you want. The ","type":"text"},{"type":"codeVoice","code":"location"},{"text":" field indicates the","type":"text"},{"text":" ","type":"text"},{"text":"first point you are requesting, with ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" being the first point, ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" being","type":"text"},{"text":" ","type":"text"},{"text":"the second point, and so on. The ","type":"text"},{"type":"codeVoice","code":"length"},{"text":" field indicates the number of","type":"text"},{"text":" ","type":"text"},{"text":"points you want. The array in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"codeVoice","code":"coords"}]},{"text":" must be large enough to accommodate","type":"text"},{"text":" ","type":"text"},{"text":"the number of requested coordinates.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection\/getCoordinates:range:","interfaceLanguage":"occ"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNPointCollection/getCoordinates:range:":{"title":"getCoordinates:range:","url":"\/documentation\/maplibre\/mlnpointcollection\/getcoordinates:range:","kind":"symbol","role":"symbol","abstract":[{"text":"Retrieves one or more coordinates associated with the shape.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection\/getCoordinates:range:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"getCoordinates:range:"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNPointCollection":{"title":"MLNPointCollection","role":"symbol","fragments":[{"text":"MLNPointCollection","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnpointcollection","identifier":"doc:\/\/org