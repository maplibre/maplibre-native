{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"weak"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:Qoobjc(pl)MLNMapSnapshotterDelegate","text":"id<MLNMapSnapshotterDelegate>"},{"kind":"text","text":" "},{"kind":"identifier","text":"delegate"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The delegate is responsible for responding to significant changes during the"},{"type":"text","text":" "},{"type":"text","text":"snapshotting process, such as the style loading. Implement a delegate to"},{"type":"text","text":" "},{"type":"text","text":"customize the style that is depicted by the snapshot."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You set the delegate after initializing the snapshotter but before receiving"},{"type":"text","text":" "},{"type":"text","text":"the snapshot, typically before starting the snapshot. The snapshotter keeps a"},{"type":"text","text":" "},{"type":"text","text":"weak reference to its delegate, so you must keep a strong reference to it to"},{"type":"text","text":" "},{"type":"text","text":"ensure that your style customizations apply."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"title":"delegate","navigatorTitle":[{"text":"delegate","kind":"identifier"}],"symbolKind":"property","roleHeading":"Instance Property","role":"symbol","externalID":"c:objc(cs)MLNMapSnapshotter(py)delegate","fragments":[{"kind":"identifier","text":"delegate"}],"modules":[{"name":"MapLibre"}]},"abstract":[{"text":"The snapshotter’s delegate.","type":"text"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documen