{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapSnapshotter"]]},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapSnapshotter\/delegate","interfaceLanguage":"occ"},"metadata":{"role":"symbol","roleHeading":"Instance Property","navigatorTitle":[{"kind":"identifier","text":"delegate"}],"symbolKind":"property","title":"delegate","fragments":[{"text":"delegate","kind":"identifier"}],"externalID":"c:objc(cs)MLNMapSnapshotter(py)delegate","modules":[{"name":"MapLibre"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"The snapshotter’s delegate.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"weak","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:Qoobjc(pl)MLNMapSnapshotterDelegate","text":"id<MLNMapSnapshotterDelegate>","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"delegate","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The delegate is responsible for responding to significant changes during the","type":"text"},{"text":" ","type":"text"},{"text":"snapshotting process, such as the style loading. Implement a delegate to","type":"text"},{"text":" ","type":"text"},{"text":"customize the style that is depicted by the snapshot.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You set the delegate after initializing the snapshotter but before receiving","type":"text"},{"text":" ","type":"text"},{"text":"the snapshot, typically before starting the snapshot. The snapshotter keeps a","type":"text"},{"text":" ","type"