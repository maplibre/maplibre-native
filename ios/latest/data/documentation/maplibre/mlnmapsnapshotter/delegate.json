{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapSnapshotter"]]},"sections":[],"abstract":[{"type":"text","text":"The snapshotter’s delegate."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/maplibre\/mlnmapsnapshotter\/delegate"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"fragments":[{"kind":"identifier","text":"delegate"}],"symbolKind":"property","roleHeading":"Instance Property","externalID":"c:objc(cs)MLNMapSnapshotter(py)delegate","navigatorTitle":[{"text":"delegate","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"role":"symbol","title":"delegate"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"weak"},{"kind":"text","text":") "},{"text":"id<MLNMapSnapshotterDelegate>","kind":"typeIdentifier","preciseIdentifier":"c:Qoobjc(pl)MLNMapSnapshotterDelegate"},{"kind":"text","text":" "},{"kind":"identifier","text":"delegate"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The delegate is responsible for responding to significant changes during the"},{"type":"text","text":" "},{"type":"text","text":"snapshotting process, such as the style loading. Implement a delegate to"},{"type":"text","text":" "},{"type":"text","text":"customize the style that is depicted by the snapshot."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You set the delegate after initializing the snapshotter but before receiving"},{"type":"text","text":" "},{"type":"text","text":"the snapshot, typically before starting the snapshot. The snapshotter keeps