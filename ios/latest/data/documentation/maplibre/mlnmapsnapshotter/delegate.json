{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapSnapshotter"]]},"kind":"symbol","metadata":{"role":"symbol","fragments":[{"kind":"identifier","text":"delegate"}],"externalID":"c:objc(cs)MLNMapSnapshotter(py)delegate","roleHeading":"Instance Property","navigatorTitle":[{"text":"delegate","kind":"identifier"}],"symbolKind":"property","title":"delegate","modules":[{"name":"MapLibre"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapSnapshotter\/delegate","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"The snapshotter’s delegate."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"weak"},{"kind":"text","text":") "},{"preciseIdentifier":"c:Qoobjc(pl)MLNMapSnapshotterDelegate","kind":"typeIdentifier","text":"id<MLNMapSnapshotterDelegate>"},{"kind":"text","text":" "},{"kind":"identifier","text":"delegate"},{"kind":"text","text":";"}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate is responsible for responding to significant changes during the"},{"type":"text","text":" "},{"type":"text","text":"snapshotting process, such as the style loading. Implement a delegate to"},{"type":"text","text":" "},{"type":"text","text":"customize the style that is depicted by the snapshot."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You set the delegate after initializing the snapshotter but before receiving"},{"type":"text","text":" "},{"type":"text","text":"the snapshot, typically before starting the snapshot. The snapshotter keeps a