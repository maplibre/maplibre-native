":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"text":" instance passed into this initializer is treated as an ordinary","type":"text"},{"text":" ","type":"text"},{"text":"shape, causing any attributes to be inaccessible to an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"evaluating a predicate or configuring certain layout or paint attributes. To","type":"text"},{"text":" ","type":"text"},{"text":"preserve the attributes associated with each feature, use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-initWithIdentifier:features:options:"},{"text":" method instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To create a shape from GeoJSON source code, use the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape\/shapeWithData:encoding:error:"},{"text":" method.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shapes:options:"},"variants":[{"paths":["\/documentation\/maplibre\/mlnshapesource\/initwithidentifier:shapes:options:"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Returns a shape source with an identifier, an array of shapes, and a dictionary of"},{"text":" ","type":"text"},{"type":"text","text":"options for the source."