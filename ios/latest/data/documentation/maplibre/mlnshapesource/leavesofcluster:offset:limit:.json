ocumentation/MapLibre/MLNShapeSource/leavesOfCluster:offset:limit:":{"title":"leavesOfCluster:offset:limit:","url":"\/documentation\/maplibre\/mlnshapesource\/leavesofcluster:offset:limit:","fragments":[{"text":"- ","kind":"text"},{"text":"leavesOfCluster:offset:limit:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/leavesOfCluster:offset:limit:","type":"topic","kind":"symbol","abstract":[{"text":"Returns an array of map features that are the leaves of the specified cluster.","type":"text"},{"text":" ","type":"text"},{"text":"(“Leaves” are the original points that belong to the cluster.)","type":"text"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNPointFeatureCluster":{"role":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointFeatureCluster"},{"type":"text","text":" object associates a point shape (with an optional"},{"type":"text","text":" "},{"type":"text","text":"identifier and attributes) and represents a point cluster."}],"url":"\/documentation\/maplibre\/mlnpointfeaturecluster","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointFeatureCluster","kind":"symbol","fragments":[{"text":"MLNPointFeatureCluster","kind":"identifier"}],"type":"topic","title":"MLNPointFeatureCluster"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFeature":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","fragments":[{"text":"MLNFeature","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":"  protocol is used to provide details about geographic features"},{"type":"text","text":" "},{"type":"text","text":"contained in an "},{"type":"reference","identifier":"doc:\/\/org.swi