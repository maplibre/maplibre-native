":"text"},{"text":"improves performance. The default value is 0.375.","type":"text"}],"title":"MLNShapeSourceOptionSimplificationTolerance","role":"symbol","url":"\/documentation\/maplibre\/mlnshapesourceoptionsimplificationtolerance"}}}