{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"- ("},{"preciseIdentifier":"c:Q$objc(cs)NSArray","kind":"typeIdentifier","text":"NSArray<id<MLNFeature>>"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"featuresMatchingPredicate:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)NSPredicate","kind":"typeIdentifier","text":"NSPredicate"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"predicate"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"name":"predicate","content":[{"inlineContent":[{"text":"A predicate to filter the returned features. Use ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"include all features in the source."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An array of objects conforming to the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true,"type":"reference"},{"text":" protocol that","type":"text"},{"text":" ","type":"text"},{"text":"represent features in the source that match the predicate.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Each object in the returned array represents a feature for the current style","type":"text"},{"text":" ","type":"text"},{"text":"and provides access to attributes specified via the ","type":"text"},{"code":"shape","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Features come from tiled GeoJSON data that is converted to tiles internally,","type":"text"},{"text":" ","type":"text"},{"text":"so feature geometries are clipped at tile boundaries and features","type":"text"},{"text":" ","type":"text"},{"text":"may appear duplicated across tiles. For example, suppose this source contains a","type":"text"},{"text":" ","type":"text"},{"text":"long polyline representing a road. The resulting array includes those parts of","type":"text"},{"text":" ","type":"text"},{"text":"the road that lie within the map tiles that the source has loaded, even if the","type":"text"},{"text":" ","type":"text"},{"text":"road extends into other tiles. The portion of the road within each map tile is","type":"text"},{"text":" ","type":"text"},{"text":"included individually.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Returned features may not necessarily be visible to the user at the time they","type":"text"},{"text":" ","type":"text"},{"text":"are loaded: the style may lack a layer that draws the features in question. To","type":"text"},{"text":" ","type":"text"},{"text":"obtain only ","type":"text"},{"inlineContent":[{"type":"text","text":"visible"}],"type":"emphasis"},{"text":" features, use the","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:inStyleLayersWithIdentifiers:predicate:"},{"text":" ","type":"text"},{"text":"or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesInRect:inStyleLayersWithIdentifiers:predicate:","type":"reference"},{"text":" ","type":"text"},{"text":"method.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Returns an array of map features for this source, filtered by the given"},{"type":"text","text":" "},{"type":"text","text":"predicate."}],"metadata":{"fragments":[{"text":"- ","kind":"text"},{"text":"featuresMatchingPredicate:","k