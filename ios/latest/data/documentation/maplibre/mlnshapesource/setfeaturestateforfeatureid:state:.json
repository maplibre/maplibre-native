ith any existing"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs in the feature’s state. Feature state can be read in style"},{"type":"text","text":" "},{"type":"text","text":"expressions through the "},{"code":"feature-state","type":"codeVoice"},{"type":"text","text":" expression operator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The target feature must have an identifier in the underlying source data:"},{"type":"text","text":" "},{"type":"text","text":"either an "},{"code":"id","type":"codeVoice"},{"type":"text","text":" attribute in the original GeoJSON data, or an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"identifier","type":"codeVoice"},{"type":"text","text":" is set."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can only be used while the source is attached to a map."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","title":"setFeatureStateForFeatureID:state:","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"c:objc(cs)MLNShapeSource(im)setFeatureStateForFeatureID:state:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setFeatureStateForFeatureID:state:"}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setFeatureStateForFeatureID:state:"}]},"abstract":[{"type":"text","text":"Sets the state of a feature in this source."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnshapesource\/setfeaturestateforfeatureid:state:"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:","interfaceLanguage":"occ"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.sw