ate object is merged with any existing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"key-value pairs in the feature’s state. Feature state can be read in style"},{"text":" ","type":"text"},{"type":"text","text":"expressions through the "},{"code":"feature-state","type":"codeVoice"},{"type":"text","text":" expression operator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The target feature must have an identifier in the underlying source data:"},{"text":" ","type":"text"},{"type":"text","text":"either an "},{"code":"id","type":"codeVoice"},{"type":"text","text":" attribute in the original GeoJSON data, or an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"identifier","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This method can only be used while the source is attached to a map.","type":"text"}]}]}],"metadata":{"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"setFeatureStateForFeatureID:state:","externalID":"c:objc(cs)MLNShapeSource(im)setFeatureStateForFeatureID:state:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setFeatureStateForFeatureID:state:"}],"modules":[{"name":"MapLibre"}],"fragments":[{"text":"- ","kind":"text"},{"text":"setFeatureStateForFeatureID:state:","kind":"identifier"}]},"kind":"symbol","abstract":[{"type":"text","text":"Sets the state of a feature in this source."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"]]},"variants":[{"paths":["\/documentation\/mapl