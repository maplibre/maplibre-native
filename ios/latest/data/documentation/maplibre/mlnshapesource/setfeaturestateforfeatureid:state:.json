ged with any existing","type":"text"},{"text":" ","type":"text"},{"text":"key-value pairs in the feature’s state. Feature state can be read in style","type":"text"},{"text":" ","type":"text"},{"text":"expressions through the ","type":"text"},{"code":"feature-state","type":"codeVoice"},{"text":" expression operator.","type":"text"}]},{"inlineContent":[{"text":"The target feature must have an identifier in the underlying source data:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"either an "},{"code":"id","type":"codeVoice"},{"type":"text","text":" attribute in the original GeoJSON data, or an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"whose "},{"code":"identifier","type":"codeVoice"},{"type":"text","text":" is set."}],"type":"paragraph"},{"inlineContent":[{"text":"This method can only be used while the source is attached to a map.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:","interfaceLanguage":"occ"},"abstract":[{"text":"Sets the state of a feature in this source.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","title":"setFeatureStateForFeatureID:state:","symbolKind":"method","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"setFeatureStateForFeatureID:state:","kind":"identifier"}],"role":"symbol","externalID":"c:objc(cs)MLNShapeSource(im)setFeatureStateForFeatureID:state:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setFeatureStateForFeatureID:state:"}]},"variants":[{"paths":["\/documentation\/maplibre\/mlnshapesource\/setfeaturestateforfeatureid:state:"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/d