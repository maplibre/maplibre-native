dentifier of the feature whose state to set."}],"type":"paragraph"}]},{"name":"state","content":[{"inlineContent":[{"type":"text","text":"A set of key-value pairs to merge into the feature’s state. The"},{"type":"text","text":" "},{"type":"text","text":"values should be valid JSON types."}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"YES"},{"type":"text","text":" if the source is attached to a map and the update was"},{"type":"text","text":" "},{"type":"text","text":"dispatched."}],"type":"paragraph"}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A feature’s state is a set of user-defined key-value pairs that are assigned"},{"type":"text","text":" "},{"type":"text","text":"to a feature at runtime. The state object is merged with any existing"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs in the feature’s state. Feature state can be read in style"},{"type":"text","text":" "},{"type":"text","text":"expressions through the "},{"type":"codeVoice","code":"feature-state"},{"type":"text","text":" expression operator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The target feature must have an identifier in the underlying source data:"},{"type":"text","text":" "},{"type":"text","text":"either an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" attribute in the original GeoJSON data, or an "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" is set."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can only be used while the source is attached to a map."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"role":"symbol","title":"MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","type":"topic","kind":"symbol","abstract":[{"text":"The proxy object for the current map style.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"fragments":[{"kind":"identifier","text":"MLNShapeSource"}],"url":"\/documentation\/maplibre\/mlnshapesource","title":"MLNShapeSource","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"type":"text","text":" object along with an "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"code":"shape","type":"codeVoice"},{"type":"text","text":" or "},{"code":"URL","type":"codeVoice"},{"type":"text","text":" property."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/setFeatureStateForFeatureID:state:":{"role":"symbol","title":"setFeatureStateForFeatureID:state:","fragments":[{"text":"- ","kind":"text"},{"text":"setFeatureStateForFeatureID:state:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:","url":"\/documentation\/maplibre\/mlnshapesource\/setfeaturestateforfeatureid:state:","type":"topic","kind":"symbol","abstract":[{"text":"Sets the state of a feature in this source.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShape":{"fragments":[{"text":"MLNShape","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnshape","title":"MLNShape","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true,"type":"reference"},{"text":" is an abstract class that represents a shape or annotation. Shapes","type":"text"},{"text":" ","type":"text"},{"text":"constitute the content of a map — not only the overlays atop the map, but also","type":"text"},{"text":" ","type":"text"},{"text":"the content that forms the base map.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"role":"symbol","title":"MLNVectorTileSource","fragments":[{"kind":"identifier","text":"MLNVectorTileSource"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","ur