:"text"},{"text":"values should be valid JSON types.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"code":"YES","type":"codeVoice"},{"type":"text","text":" if the source is attached to a map and the update was"},{"type":"text","text":" "},{"type":"text","text":"dispatched."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"],"kind":"mentions"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A feature’s state is a set of user-defined key-value pairs that are assigned"},{"type":"text","text":" "},{"type":"text","text":"to a feature at runtime. The state object is merged with any existing"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs in the feature’s state. Feature state can be read in style"},{"type":"text","text":" "},{"type":"text","text":"expressions through the "},{"type":"codeVoice","code":"feature-state"},{"type":"text","text":" expression operator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The target feature must have an identifier in the underlying source data:"},{"type":"text","text":" "},{"type":"text","text":"either an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" attribute in the original GeoJSON data, or an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" is set."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can only be used while the source is attached to a map."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/org.swift.M