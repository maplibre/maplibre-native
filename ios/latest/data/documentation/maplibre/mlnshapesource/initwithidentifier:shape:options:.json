ance. The default value is 0.375."}],"title":"MLNShapeSourceOptionSimplificationTolerance","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSourceOptionSimplificationTolerance","role":"symbol"}}}