text":"feature object associates a shape with an optional identifier and attributes."}],"title":"MLNFeature","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"}}}