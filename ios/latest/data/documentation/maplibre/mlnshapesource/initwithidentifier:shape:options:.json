t"},{"type":"text","text":" "},{"type":"text","text":"shapes can be a mixture of different kinds of shapes."}],"role":"symbol","kind":"symbol","fragments":[{"text":"MLNShapeCollection","kind":"identifier"}],"title":"MLNShapeCollection"}}}