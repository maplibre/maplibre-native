.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with one or more"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true},{"type":"text","text":" objects. A vector style layer defines the appearance of"},{"type":"text","text":" "},{"type":"text","text":"any content supplied by the vector tile source."}],"title":"MLNVectorTileSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFeature/attributes":{"title":"attributes","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/attributes","abstract":[{"type":"text","text":"A dictionary of attributes for this feature."}],"type":"topic","url":"\/documentation\/maplibre\/mlnfeature\/attributes","role":"symbol","kind":"symbol","fragments":[{"text":"attributes","kind":"identifier"}]}}}