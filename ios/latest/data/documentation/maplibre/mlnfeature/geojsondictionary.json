tyle","isActive":true},{"type":"text","text":" object along with one or more"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true},{"type":"text","text":" objects. A vector style layer defines the appearance of"},{"type":"text","text":" "},{"type":"text","text":"any content supplied by the vector tile source."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFeature/geoJSONDictionary":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/geoJSONDictionary","url":"\/documentation\/maplibre\/mlnfeature\/geojsondictionary","type":"topic","abstract":[{"type":"text","text":"Returns a dictionary that can be serialized as a GeoJSON Feature representation"},{"type":"text","text":" "},{"type":"text","text":"of an instance of an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":" subclass."}],"title":"geoJSONDictionary","kind":"symbol","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"geoJSONDictionary","kind":"identifier"}]}}}