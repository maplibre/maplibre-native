":[{"type":"text","text":"In vector tiles loaded by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":" objects, the keys and values of"},{"type":"text","text":" "},{"type":"text","text":"each feature’s attribute dictionary are determined by the source. Each"},{"type":"text","text":" "},{"type":"text","text":"attribute name is a string, while each attribute value may be a null value,"},{"type":"text","text":" "},{"type":"text","text":"Boolean value, integer, floating-point number, or string. These data types are"},{"type":"text","text":" "},{"type":"text","text":"mapped to instances of the following Foundation classes:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"In the tile source","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"In this dictionary","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Null","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"NSNull","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"boolValue","type":"codeVoice"},{"text":" property)","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSNumber","type":"codeVoice"},{"text":" (use the ","type":"text"},{"code":"unsignedLongLongValue","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"longLongValue","type":"codeVoice"},{"text":" property)","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"number","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"NSNumber","type":"codeVoice"},{"text":" (use the ","type":"text"},{"code":"doubleValue","type":"codeVoice"},{"text":" property)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"NSString","type":"codeVoice"}]}]]],"header":