g, while each attribute value may be a null value,","type":"text"},{"text":" ","type":"text"},{"text":"Boolean value, integer, floating-point number, or string. These data types are","type":"text"},{"text":" ","type":"text"},{"text":"mapped to instances of the following Foundation classes:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"In the tile source","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"In this dictionary","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Null","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSNull"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"boolValue"},{"text":" property)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSNumber"},{"text":" (use the ","type":"text"},{"type":"codeVoice","code":"unsignedLongLongValue"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"longLongValue"},{"text":" property)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"number","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSNumber"},{"text":" (use the ","type":"text"},{"type":"codeVoice","code":"doubleValue"},{"text":" property)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSString"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"When adding a feature to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"text":", use the same Foundation types","type":"text"},{"text":" ","type":"text"},{"text":"listed above for each attribute value. In addition to the Foundation types, you","type":"text"},{"text":" ","type":"text"},{"text":"may also set an attribute to an ","type":"text"},{"code":"NSColor","type":"codeVoice"},{"text":" (macOS) or ","type":"text"},{"code":"UIColor","type":"codeVoice"},{"text":" (iOS), which","type":"text"},{"text":" ","type":"text"},{"text":"will be converted into its","type":"text"},{"text":" ","type":"text"},{"text":"CSS string representation","type":"text"},{"text":" ","type":"text"},{"text":"when the feature is added to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"text":". This can be convenient when","type":"text"},{"text":" ","type":"text"},{"text":"using the attribute to supply a value for a color-typed layout or paint","type":"text"},{"text":" ","type":"text"},{"text":"attribute via a key path expression.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that while it is possible to change this value on feature","type":"text"},{"text":" ","type":"text"},{"text":"instances obtained from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:","type":"reference"},{"type":"text","text":" and related"},{"type":"text","text":" "},{"type":"text","text":"methods, there will be no effect on the map. Setting this value can be useful"},{"type":"text","text":" "},{"type":"text","text":"when the feature instance is used to initialize an "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"type":"text","text":" and that"},{"type":"text","text":" "},{"type":"text","text":"source is added to the map and styled."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/attributes","interfaceLanguage":"occ"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","variants":[{"paths":["\/documentation\/maplibre\/mlnfeatur