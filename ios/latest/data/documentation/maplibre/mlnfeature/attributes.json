cumentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"text":" object to display only important features, you might assign","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a value above 50 to the important features’ "},{"code":"importance","type":"codeVoice"},{"type":"text","text":" attribute, then set"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","type":"reference"},{"text":" to an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nspredicate","type":"reference"},{"text":" with the format","type":"text"},{"text":" ","type":"text"},{"code":"importance > 50","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can also configure many layout and paint attributes of an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference"},{"text":" ","type":"text"},{"text":"object to match the value of an attribute in this dictionary whenever it","type":"text"},{"text":" ","type":"text"},{"text":"renders this feature. For example, if you display features in an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"text":" using an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","type":"reference"},{"text":", you can assign a ","type":"text"},{"code":"halfway","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attribute to each of the source’s features, then set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius","type":"refe