sted above for each attribute value. In addition to the Foundation types, you"},{"type":"text","text":" "},{"type":"text","text":"may also set an attribute to an "},{"type":"codeVoice","code":"NSColor"},{"type":"text","text":" (macOS) or "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":" (iOS), which"},{"type":"text","text":" "},{"type":"text","text":"will be converted into its"},{"type":"text","text":" "},{"type":"text","text":"CSS string representation"},{"type":"text","text":" "},{"type":"text","text":"when the feature is added to an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":". This can be convenient when"},{"type":"text","text":" "},{"type":"text","text":"using the attribute to supply a value for a color-typed layout or paint"},{"type":"text","text":" "},{"type":"text","text":"attribute via a key path expression."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that while it is possible to change this value on feature"},{"type":"text","text":" "},{"type":"text","text":"instances obtained from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:"},{"type":"text","text":" and related"},{"type":"text","text":" "},{"type":"text","text":"methods, there will be no effect on the map. Setting this value can be useful"},{"type":"text","text":" "},{"type":"text","text":"when the feature instance is used to initialize an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" and that"},{"type":"text","text":" "},{"type":"text","text":"source is added to the map and styled."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/attributes","interfaceLanguage":"occ"},"metadata":{"roleHe