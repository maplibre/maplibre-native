{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature\/attributes"},"metadata":{"symbolKind":"property","navigatorTitle":[{"text":"attributes","kind":"identifier"}],"fragments":[{"kind":"identifier","text":"attributes"}],"roleHeading":"Instance Property","title":"attributes","role":"symbol","externalID":"c:objc(pl)MLNFeature(py)attributes","modules":[{"name":"MapLibre"}]},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"copy"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSDictionary<NSString *,id>","preciseIdentifier":"c:Q$objc(cs)NSDictionary"},{"kind":"text","text":" * "},{"kind":"identifier","text":"attributes"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can configure an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"},{"type":"text","text":" object to include or exclude a"},{"type":"text","text":" "},{"type":"text","text":"specific feature in an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":". In the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate"},{"type":"text","text":" property, compare a key of the attribute"},{"type":"text","text":" "},{"type":"text","text":"dictionary to the value you want to include. For example, if you want an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"type":"text","text":" object to display only important features, you might assign"},{"type":"text","text":" "},{"type":"text","text":"a value above 50 to the important features’ "},{"type":"codeVoice","code":"importance"},{"type":"text","text":" attribute, then set"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate"},{"type":"text","text":" to an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nspredicate"},{"type":"text","text":" with the format"},{"type":"text","text":" "},{"type":"codeVoice","code":"importance > 50"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also configure many layout and paint attributes of an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" "},{"type":"text","text":"object to match the value of an attribute in this dictionary whenever it"},{"type":"text","text":" "},{"type":"text","text":"renders this feature. For example, if you display features in an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" using an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},{"type":"text","text":", you can assign a "},{"type":"codeVoice","code":"halfway"},{"type":"text","text":" "},{"type":"text","text":"attribute to each of the source’s features, then set"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius"},{"type":"text","text":" to an expression for the key path "},{"type":"codeVoice","code":"halfway"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconImageName"},{"type":"text","text":" "},{"type":"text","text":"properties allow you to use attributes yet another way. For example, to label"},{"type":"text","text":" "},{"type":"text","text":"features in an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" object by their names, you can assign a "},{"type":"codeVoice","code":"name"},{"type":"text","text":" "},{"type":"text","text":"attribute to each of the source’s features, then set"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text"},{"type":"text","text":" to an expression for the constant string value"},{"type":"text","text":" "},{"type":"codeVoice","code":"{name}"},{"type":"text","text":". See the"},{"type":"text","text":" "},{"type":"text","text":"Predicates and Expressions"},{"type":"text","text":" "},{"type":"text","text":"guide for more information about expressions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In vector tiles loaded by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":" objects, the keys and values of"},{"type":"text","text":" "},{"type":"text","text":"each feature’s attribute dictionary are determined by the source. Each"},{"type":"text","text":" "},{"type":"text","text":"attribute name is a string, while each attribute value may be a null value,"},{"type":"text","text":" "},{"type":"text","text":"Boolean value, integer, floating-point number, or string. These data types are"},{"type":"text","text":" "},{"type":"text","text":"mapped to instances of the following Foundation classes:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"In the tile source","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"In this dictionary","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Null","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNull"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"boolValue"},{"text":" property)","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"},{"text":" (use the ","type":"text"},{"type":"codeVoice","code":"unsignedLongLongValue"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"longLongValue"},{"text":" property)","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"number","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"},{"text":" (use the ","type":"text"},{"type":"codeVoice","code":"doubleValue"},{"text":" property)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSString"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When adding a feature to an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":", use the same Foundation types"},{"type":"text","text":" "},{"type":"text","text":"listed above for each attribute value. In addition to the Foundation types, you"},{"type":"text","text":" "},{"type":"text","text":"may also set an attribute to an "},{"type":"codeVoice","code":"NSColor"},{"type":"text","text":" (macOS) or "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":" (iOS), which"},{"type":"text","text":" "},{"type":"text","text":"will be converted into its"},{"type":"text","text":" "},{"type":"text","text":"CSS string representation"},{"type":"text","text":" "},{"type":"text","text":"when the feature is added to an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":". This can be convenient when"},{"type":"text","text":" "},{"type":"text","text":"using the attribute to supply a value for a color-typed layout or paint"},{"type":"text","text":" "},{"type":"text","text":"attribute via a key path expression."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that while it is possible to change this value on feature"},{"type":"text","text":" "},{"type":"text","text":"instances obtained from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:"},{"type":"text","text":" and related"},{"type":"text","text":" "},{"type":"text","text":"methods, there will be no effect on the map. Setting this value can be useful"},{"type":"text","text":" "},{"type":"text","text":"when the feature instance is used to initialize an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" and that"},{"type":"text","text":" "},{"type":"text","text":"source is added to the map and styled."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnfeature\/attributes"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A dictionary of attributes for this feature."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","kind":"symbol","fragments":[{"text":"MLNShapeSource","kind":"identifier"}],"title":"MLNShapeSource","role":"symbol","url":"\/documentation\/maplibre\/mlnshapesource","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can u