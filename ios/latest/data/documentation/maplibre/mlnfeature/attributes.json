ibre\/MLNShapeSource","type":"reference"},{"text":" using an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","type":"reference"},{"text":", you can assign a ","type":"text"},{"code":"halfway","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attribute to each of the source’s features, then set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius","type":"reference"},{"text":" to an expression for the key path ","type":"text"},{"code":"halfway","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconImageName","type":"reference"},{"text":" ","type":"text"},{"text":"properties allow you to use attributes yet another way. For example, to label","type":"text"},{"text":" ","type":"text"},{"text":"features in an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"reference"},{"text":" object by their names, you can assign a ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attribute to each of the source’s features, then set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text","type":"reference"},{"text":" to an expression for the constant string value","type":"text"},{"text":" ","type":"text"},{"code":"{name}","type":"codeVoice"},{"type":"text","text":". See the"},{"type":"text","text":" "},{"type":"text","text":"Predicates and Expressions"},{"type":"text","text":" "},{"type":"text","text":"guide for more information about expressions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In vector tiles loaded by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":" objects, the keys and values of"},{"type":"text","text":" "},{"type":"text","text":"each feature’s attribute dictionary are determined by the source. Each"},{"type":"text","text":" "},{"type":"text","text":"attribute name is a string, while each attribute value may be a null value,"},{"type":"text","text":" "},{"type":"text","text":"Boolean value, integer, floating-point number, or string. These data types are"},{"type":"text","text":" "},{"type":"text","text":"mapped to instances of the following Foundation classes:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"In the tile source","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"In this dictionary","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Null","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NSNull","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"boolValue","type":"codeVoice"},{"text":" property)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSNumber","type":"codeVoice"},{"text":" (use the ","type":"text"},{"code":"unsignedLongLongValue","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"longLongValue","type":"codeVoice"},{"text":" property)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"number","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NSNumber","type":"codeVoice"},{"text":" (use the ","type":"text"},{"code":"doubleValue","type":"codeVoice"},{"text":" property)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"String","typ