{"metadata":{"externalID":"c:objc(pl)MLNFeature(py)attributes","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"kind":"identifier","text":"attributes"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"attributes"}],"title":"attributes"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"copy"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSDictionary<NSString *,id>","preciseIdentifier":"c:Q$objc(cs)NSDictionary"},{"kind":"text","text":" * "},{"kind":"identifier","text":"attributes"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can configure an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true},{"type":"text","text":" object to include or exclude a"},{"type":"text","text":" "},{"type":"text","text":"specific feature in an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":". In the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","isActive":true},{"type":"text","text":" property, compare a key of the attribute"},{"type":"text","text":" "},{"type":"text","text":"dictionary to the value you want to include. For example, if you want an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","isActive":true},{"type":"text","text":" object to display only important features, you might assign"},{"type":"text","text":" "},{"type":"text","text":"a value above 50 to the important features’ "},{"type":"codeVoice","code":"importance"},{"type":"text","text":" attribute, then set"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","isActive":true},{"type":"text","text":" to an"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nspredicate","isActive":true},{"type":"text","text":" with the format"},{"type":"text","text":" "},{"type":"codeVoice","code":"importance > 50"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also configure many layout and paint attributes of an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" "},{"type":"text","text":"object to match the value of an attribute in this dictionary whenever it"},{"type":"text","text":" "},{"type":"text","text":"renders this feature. For example, if you display features in an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" using an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":", you can assign a "},{"type":"codeVoice","code":"halfway"},{"type":"text","text":" "},{"type":"text","text":"attribute to each of the source’s features, then set"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius","isActive":true},{"type":"text","text":" to an expression for the key path "},{"type":"codeVoice","code":"halfway"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconImageName","isActive":true},{"type":"text","text":" "},{"type":"text","text":"properties allow you to use attributes yet another way. For example, to label"},{"type":"text","text":" "},{"type":"text","text":"features in an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" object by their names, you can assign a "},{"type":"codeVoice","code":"name"},{"type":"text","text":" "},{"type":"text","text":"attribute to each of the source’s features, then set"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text"},{"type":"text","text":" to an expression for the constant string value"},{"type":"text","text":" "},{"type":"codeVoice","code":"{name}"},{"type":"text","text":". See the"},{"type":"text","text":" "},{"type":"text","text":"Predicates and Expressions"},{"type":"text","text":" "},{"type":"text","text":"guide for more information about expressions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In vector tiles loaded by "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":" objects, the keys and values of"},{"type":"text","text":" "},{"type":"text","text":"each feature’s attribute dictionary are determined by the source. Each"},{"type":"text","text":" "},{"type":"text","text":"attribute name is a string, while each attribute value may be a null value,"},{"type":"text","text":" "},{"type":"text","text":"Boolean value, integer, floating-point number, or string. These data types are"},{"type":"text","text":" "},{"type":"text","text":"mapped to instances of the following Foundation classes:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"In the tile source"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"In this dictionary"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Null"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNull"}]}]],[[{"inlineContent":[{"code":"boolValue","type":"codeVoice"},{"text":" property)","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSNumber","type":"codeVoice"},{"text":" (use the ","type":"text"},{"code":"unsignedLongLongValue","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"longLongValue","type":"codeVoice"},{"text":" property)","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"number","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":" (use the "},{"type":"codeVoice","code":"doubleValue"},{"type":"text","text":" property)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSString"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When adding a feature to an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":", use the same Foundation types"},{"text":" ","type":"text"},{"text":"listed above for each attribute value. In addition to the Foundation types, you","type":"text"},{"typ