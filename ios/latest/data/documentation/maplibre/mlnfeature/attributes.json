ibre\/MLNShapeSource","type":"reference"},{"text":" using an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","type":"reference"},{"text":", you can assign a ","type":"text"},{"code":"halfway","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attribute to each of the source’s features, then set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius","type":"reference"},{"text":" to an expression for the key path ","type":"text"},{"code":"halfway","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconImageName"},{"type":"text","text":" "},{"type":"text","text":"properties allow you to use attributes yet another way. For example, to label"},{"type":"text","text":" "},{"type":"text","text":"features in an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" object by their names, you can assign a "},{"code":"name","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"attribute to each of the source’s features, then set"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/text"},{"type":"text","text":" to an expression for the constant string value"},{"type":"text","text":" "},{"code":"{name}","type":"codeVoice"},{"type":"text","text":". See the"},{"type":"text","text":" "},{"type":"text","text":"Predicates and Expressions"},{"type":"text","text":" "