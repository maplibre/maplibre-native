xt","text":". In the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate"},{"type":"text","text":" property, compare a key of the attribute"},{"type":"text","text":" "},{"text":"dictionary to the value you want to include. For example, if you want an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"text":" object to display only important features, you might assign","type":"text"},{"text":" ","type":"text"},{"text":"a value above 50 to the important features’ ","type":"text"},{"code":"importance","type":"codeVoice"},{"text":" attribute, then set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate"},{"text":" to an","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nspredicate"},{"type":"text","text":" with the format"},{"type":"text","text":" "},{"type":"codeVoice","code":"importance > 50"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also configure many layout and paint attributes of an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" "},{"type":"text","text":"object to match the value of an attribute in this dictionary whenever it"},{"type":"text","text":" "},{"text":"renders this feature. For example, if you display features in an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" using an "},{"isActive":true,"type":"reference","ide