","text":" "},{"type":"text","text":"with a reuse identifier, the map view may recycle the view when it goes"},{"type":"text","text":" "},{"text":"offscreen.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationView","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/objc(cs)NSObject":{"title":"NSObject","identifier":"doc:\/\/org.swift.MyProject\/objc(cs)NSObject","type":"unresolvable"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/image":{"role":"symbol","title":"image","abstract":[{"type":"text","text":"The image to be displayed for the annotation."}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnannotationimage\/image","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/image","fragments":[{"text":"image","kind":"identifier"}]},"doc://org.swift.MyProject/objc(pl)NSSecureCoding":{"title":"NSSecureCoding","identifier":"doc:\/\/org.swift.MyProject\/objc(pl)NSSecureCoding","type":"unresolvable"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/enabled":{"type":"topic","fragments":[{"kind":"identifier","text":"enabled"}],"url":"\/documentation\/maplibre\/mlnannotationimage\/enabled","title":"enabled","abstract":[{"text":"A Boolean value indicating whether the annotation is enabled.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/enabled","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotation":{"type":"topic","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","type":"reference"},{"text":" protocol is used to provide annotation-related information","type":"text"},{"text":" ","type":"text"},{"text":"to a map view. To use this protocol, you adopt it in any custom objects that","type":"text"},{"text":" ","type":"text"},{"text":"store or represent annotation data. Each object then serves as the source of","type":"text"},{"text":" ","type":"text"},{"text":"information about a single map annotation and provides critical information,","type":"text"},{"text":" ","type":"text"},{"text":"such as the annotation’s location on the map. Annotation objects do not provide","type":"text"},{"text":" ","type":"text"},{"text":"the visual representation of the annotation but typically coordinate (in","type":"text"},{"type":"text","text":" "},{"text":"conjunction with the map view’s delegate) the creation of an appropriate","type":"text"},{"text":" ","type":"text"},{"text":"objects to handle the display.","type":"text"}],"title":"MLNAnnotation","url":"\/documentation\/maplibre\/mlnannotation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/reuseIdentifier":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/reuseIdentifier","kind":"symbol","title":"reuseIdentifier","type":"topic","abstract":[{"type":"text","text":"The string that identifies that this annotation image is reusable. (read-only)"}],"fragments":[{"kind":"identifier","text":"reuseIdentifier"}],"url":"\/documentation\/maplibre\/mlnannotationimage\/reuseidentifier"}}}