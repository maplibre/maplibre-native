ation but typically coordinate (in","type":"text"},{"text":" ","type":"text"},{"text":"conjunction with the map view’s delegate) the creation of an appropriate","type":"text"},{"text":" ","type":"text"},{"text":"objects to handle the display.","type":"text"}],"url":"\/documentation\/maplibre\/mlnannotation","role":"symbol","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/annotationImageWithImage:reuseIdentifier:":{"title":"annotationImageWithImage:reuseIdentifier:","type":"topic","abstract":[{"type":"text","text":"Initializes and returns a new annotation image object."}],"url":"\/documentation\/maplibre\/mlnannotationimage\/annotationimagewithimage:reuseidentifier:","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"annotationImageWithImage:reuseIdentifier:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/annotationImageWithImage:reuseIdentifier:","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/enabled":{"kind":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the annotation is enabled."}],"fragments":[{"text":"enabled","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/enabled","role":"symbol","url":"\/documentation\/maplibre\/mlnannotationimage\/enabled","title":"enabled","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotationImage/image":{"kind":"symbol","abstract":[{"type":"text","text":"The image to be displayed for the annotation."}],"fragments":[{"text":"image","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage\/image","role":"symbol","url":"\/documentation\/maplibre\/mlnannotationimage\/image","title":"