{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/prefetchesTiles"},"abstract":[{"text":"A Boolean value indicating whether the map should prefetch tiles.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"assign"},{"kind":"text","text":") "},{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"prefetchesTiles"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When this property is set to "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", the map view prefetches tiles designed for"},{"type":"text","text":" "},{"type":"text","text":"a low zoom level and displays them until receiving more detailed tiles for the"},{"type":"text","text":" "},{"type":"text","text":"current zoom level. The prefetched tiles typically contain simplified versions"},{"type":"text","text":" "},{"type":"text","text":"of each shape, improving the map view’s perceived performance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default value of this property is "},{"code":"YES","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","title":"prefetchesTiles","navigatorTitle":[{"text":"prefetchesTiles","kind":"identifier"}],"externalID":"c:objc(cs)MLNMapView(py)prefetchesTiles","role":"symbol","remoteSource