{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A Boolean value indicating whether the map may display scale information.","type":"text"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/showsScale"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"assign"},{"kind":"text","text":") "},{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"showsScale"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The scale bar may not be shown at all zoom levels. The scale bar becomes visible"},{"type":"text","text":" "},{"type":"text","text":"when the maximum distance visible on the map view is less than 400 miles (800"},{"type":"text","text":" "},{"type":"text","text":"kilometers). The zoom level where this occurs depends on the latitude at the map"},{"type":"text","text":" "},{"type":"text","text":"view’s center coordinate, as well as the device screen width. At latitudes"},{"type":"text","text":" "},{"type":"text","text":"farther from the equator, the scale bar becomes visible at lower zoom levels."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The unit of measurement is determined by the user’s device locale."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view controlled by this property is available at "},{"code":"scaleBar","type":"codeVoice"},{"type":"text