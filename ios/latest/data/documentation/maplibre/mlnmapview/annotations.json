","text":" "},{"type":"text","text":"such as the annotation’s location on the map. Annotation objects do not provide"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/annotations":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/annotations","kind":"symbol","abstract":[{"text":"The complete list of annotations associated with the receiver. (read-only)","type":"text"}],"url":"\/documentation\/maplibre\/mlnmapview\/annotations","title":"annotations","type":"topic","fragments":[{"kind":"identifier","text":"annotations"}],"role":"symbol"}}}