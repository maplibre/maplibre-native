rmation,"},{"type":"text","text":" "},{"type":"text","text":"such as the annotation’s location on the map. Annotation objects do not provide"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"url":"\/documentation\/maplibre\/mlnannotation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/visibleAnnotations":{"kind":"symbol","title":"visibleAnnotations","abstract":[{"text":"The complete list of annotations associated with the receiver that are","type":"text"},{"text":" ","type":"text"},{"text":"currently visible.","type":"text"}],"url":"\/documentation\/maplibre\/mlnmapview\/visibleannotations","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleAnnotations","fragments":[{"text":"visibleAnnotations","kind":"identifier"}],"type":"topic","role":"symbol"}}}