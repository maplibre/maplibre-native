xt","text":" "},{"type":"text","text":"property may be overridden at any time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The usage of "},{"type":"codeVoice","code":"automaticallyAdjustsScrollViewInsets"},{"type":"text","text":" has been deprecated"},{"type":"text","text":" "},{"type":"text","text":"use the map view’s property "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/automaticallyAdjustsContentInset"},{"type":"text","text":"instead."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Sets the distance from the edges of the map view’s frame to the edges of the"},{"type":"text","text":" "},{"type":"text","text":"map view’s logical viewport with an optional transition animation and"},{"type":"text","text":" "},{"type":"text","text":"completion handler."}],"variants":[{"paths":["\/documentation\/maplibre\/mlnmapview\/setcontentinset:animated:completionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/automaticallyAdjustsContentInset":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/automaticallyAdjustsContentInset","abstract":[{"text":"A boolean value that indicates if whether the map view should automatically","type":"text"},{"text":" ","type":"text"},{"text":"adjust its content insets.","type":"text"}],"title":"automaticallyAdjustsContentInset","fragments":[{"kind":"identifier","text":"automaticallyAdjustsContentInset"}],"url":"\/documentation\/maplibre\/mlnmapview\/automaticallyadjustscontentinset","type":"topic","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"role":"symbol","kind":"symbol","title":"MLNMapView","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","url":"\/documentation\/maplibre\/mlnmapview","fragments":[{"text":"ML