{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The coordinate bounds visible in the receiver’s viewport."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCoordinateBounds","kind":"typeIdentifier","text":"MLNCoordinateBounds","preciseIdentifier":"c:@S@MLNCoordinateBounds"},{"kind":"text","text":" "},{"kind":"identifier","text":"visibleCoordinateBounds"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Changing the value of this property updates the receiver immediately. If you"},{"type":"text","text":" "},{"type":"text","text":"want to animate the change, call "},{"type":"codeVoice","code":"-setVisibleCoordinateBounds:animated:"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a longitude is less than −180 degrees or greater than 180 degrees, the"},{"type":"text","text":" "},{"type":"text","text":"visible bounds straddles the antimeridian or international date line. For"},{"type":"text","text":" "},{"type":"text","text":"example, if both Tokyo and San Francisco are visible, the visible bounds might"},{"type":"text","text":" "},{"type":"text","text":"extend from (35.68476, −220.24257) to (37.78428, −122.41310)."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlnmapview\/visiblecoordinatebounds"],"traits":[{"interfaceLanguage":"occ"}]}],"met