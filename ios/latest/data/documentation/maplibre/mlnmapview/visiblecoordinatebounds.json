":"paragraph","inlineContent":[{"type":"text","text":"If a longitude is less than −180 degrees or greater than 180 degrees, the"},{"type":"text","text":" "},{"type":"text","text":"visible bounds straddles the antimeridian or international date line. For"},{"type":"text","text":" "},{"type":"text","text":"example, if both Tokyo and San Francisco are visible, the visible bounds might"},{"type":"text","text":" "},{"type":"text","text":"extend from (35.68476, −220.24257) to (37.78428, −122.41310)."}]}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleCoordinateBounds","interfaceLanguage":"occ"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/visibleCoordinateBounds":{"abstract":[{"text":"The coordinate bounds visible in the receiver’s viewport.","type":"text"}],"url":"\/documentation\/maplibre\/mlnmapview\/visiblecoordinatebounds","type":"topic","kind":"symbol","role":"symbol","title":"visibleCoordinateBounds","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleCoordinateBounds","fragments":[{"kind":"identifier","text":"visibleCoordinateBounds"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"role":"symbol","title":"MLNMapView","abstract":[{"text":"An interactive, customizable map view with an interface similar to the one","type":"text"},{"text":" ","type":"text"},{"text":"provided by Apple’s MapKit.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnmapview","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","fragments":[{"text":"MLNMapView","kind":"identifier"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/docume