ion and its callout are brought into view. The annotation is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"inlineContent":[{"type":"text","text":"centered within the viewport."}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that a selection initiated by a single tap gesture is always animated."}]},{"inlineContent":[{"type":"text","text":"To specify a completion handler to execute after the animation finishes, use"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"-selectAnnotation:animated:completionHandler:"},{"type":"text","text":" method."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In versions prior to "},{"type":"codeVoice","code":"4.0.0"},{"type":"text","text":" selecting an offscreen annotation did not"},{"type":"text","text":" "},{"type":"text","text":"change the camera."}]}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnmapview","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","abstract":[{"type":"text","text":"An interactive, customizable map view with an interface similar to the one"},{"type":"text","text":" "},{"type":"text","text":"provided by Apple’s MapKit."}],"title":"MLNMapView","role":"symbol","fragments":[{"kind":"identifier","text":"MLNMapView"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/selectAnnotation:animated:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/selectAnnotation:animated:","abstract":[{"type":"text","text":"Deprecated. Selects an annotation and displays its callout view."}],"url":"\/