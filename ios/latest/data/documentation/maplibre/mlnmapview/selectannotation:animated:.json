nt":[{"type":"text","text":"map is panned so that the annotation and its callout are brought into view. The annotation is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"centered within the viewport."}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Note that a selection initiated by a single tap gesture is always animated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To specify a completion handler to execute after the animation finishes, use"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"-selectAnnotation:animated:completionHandler:"},{"type":"text","text":" method."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"In versions prior to "},{"type":"codeVoice","code":"4.0.0"},{"type":"text","text":" selecting an offscreen annotation did not"},{"type":"text","text":" "},{"type":"text","text":"change the camera."}],"type":"paragraph"}],"name":"Note","style":"note"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/selectAnnotation:animated:":{"type":"topic","title":"selectAnnotation:animated:","role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/selectAnnotation:animated:","url":"\/documentation\/maplibre\/mlnmapview\/selectannotation:animated:","abstract":[{"text":"Deprecated. Selects an annotation and displays its callout view.","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"selectAnnotation:animated:","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","title":"MapLibre","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNPointAnnotation":{"abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation"},{"type":"text","text":" object represents a one-dimensional shape located at a"},{"type":"text","text":" "},{"type":"text","text":"single geographical coordinate. Depending on how it is used, an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation"},{"type":"text","text":" object is known as a point annotation or point shape. For"},{"type":"text","text":" "},{"type":"text","text":"example, you could use a point shape to represent a city at low zoom levels, an"},{"type":"text","text":" "},{"type":"text","text":"address at high zoom levels, or the location of a long press gesture."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation","title":"MLNPointAnnotation","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"MLNPointAnnotation","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnpointannotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","url":"\/documentation\/maplibre\/mlnmapview","fragments":[{"kind":"identifier","text":"MLNMapView"}],"kind":"symbol","title":"MLNMapView","role":"symbol","type":"topic","abstract":[{"type":"text","text":"An interactive, customizable map view with an interface similar to the one"},{"type":"text","text":" "},{"text":"provided by Apple’s MapKit.","type":"text"}]}}}