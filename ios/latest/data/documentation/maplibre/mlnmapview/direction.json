xt"}]},{"type":"paragraph","inlineContent":[{"text":"Changing the value of this property updates the map view immediately. If you","type":"text"},{"text":" ","type":"text"},{"text":"want to animate the change, use the ","type":"text"},{"type":"codeVoice","code":"-setDirection:animated:"},{"text":" method instead.","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The heading of the map, measured in degrees clockwise from true north."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/direction":{"title":"direction","url":"\/documentation\/maplibre\/mlnmapview\/direction","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/direction","fragments":[{"kind":"identifier","text":"direction"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The heading of the map, measured in degrees clockwise from true north."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"abstract":[{"type":"text","text":"An interactive, customizable map view with an interface similar to the one"},{"type":"text","text":" "},{"type":"text","text":"provided by Apple’s MapKit."}],"url":"\/documentation\/maplibre\/mlnmapview","type":"topic","title":"MLNMapView","fragments":[{"text":"MLNMapView","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","type":"topic","title":"MapLibre","kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"}}}