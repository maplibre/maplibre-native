{"abstract":[{"text":"The heading of the map, measured in degrees clockwise from true north.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"kind":"text","text":") "},{"preciseIdentifier":"c:@T@CLLocationDirection","kind":"typeIdentifier","text":"CLLocationDirection"},{"kind":"text","text":" "},{"kind":"identifier","text":"direction"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The value "},{"type":"codeVoice","code":"0"},{"type":"text","text":" means that the top edge of the map view corresponds to true"},{"type":"text","text":" "},{"type":"text","text":"north. The value "},{"code":"90","type":"codeVoice"},{"type":"text","text":" means the top of the map is pointing due east. The"},{"type":"text","text":" "},{"type":"text","text":"value "},{"code":"180","type":"codeVoice"},{"type":"text","text":" means the top of the map points due south, and so on."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Changing the value of this property updates the map view immediately. If you"},{"type":"text","text":" "},{"type":"text","text":"want to animate the change, use the "},{"type":"codeVoice","code":"-setDirection:animated:"},{"type":"text","text":" method instead."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapview\/direction"]}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/direction"},"metadata":{"symbolKind":"property","modules":[{"name":"MapLibre"}],"role":"symbol","fragments":[{"text":"direction","kind":"identifier"}],"