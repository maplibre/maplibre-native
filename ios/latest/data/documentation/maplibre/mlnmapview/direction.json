{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"The heading of the map, measured in degrees clockwise from true north."}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/direction"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"CLLocationDirection","preciseIdentifier":"c:@T@CLLocationDirection"},{"kind":"text","text":" "},{"kind":"identifier","text":"direction"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value "},{"code":"0","type":"codeVoice"},{"type":"text","text":" means that the top edge of the map view corresponds to true"},{"type":"text","text":" "},{"type":"text","text":"north. The value "},{"code":"90","type":"codeVoice"},{"type":"text","text":" means the top of the map is pointing due east. The"},{"type":"text","text":" "},{"type":"text","text":"value "},{"code":"180","type":"codeVoice"},{"type":"text","text":" means the top of the map points due south, and so on."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Changing the value of this property updates the map view immediately. If you"},{"type":"text","text":" "},{"type":"text","text":"want to animate the change, use the "},{"code":"-setDirection:animated:","type":"codeVoice"},{"type":"text","text":" method instead."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"kind":"symbol","metadata":{"fragments":[{"kind":"identifier","text":"direction"}],"externalID":"c:objc(cs)