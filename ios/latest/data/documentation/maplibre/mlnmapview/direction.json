{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/direction"},"sections":[],"abstract":[{"type":"text","text":"The heading of the map, measured in degrees clockwise from true north."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"text":"CLLocationDirection","preciseIdentifier":"c:@T@CLLocationDirection","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"direction","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The value ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" means that the top edge of the map view corresponds to true","type":"text"},{"text":" ","type":"text"},{"text":"north. The value ","type":"text"},{"code":"90","type":"codeVoice"},{"text":" means the top of the map is pointing due east. The","type":"text"},{"text":" ","type":"text"},{"text":"value ","type":"text"},{"code":"180","type":"codeVoice"},{"text":" means the top of the map points due south, and so on.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Changing the value of this property updates the map view immediately. If you","type":"text"},{"text":" ","type":"text"},{"text":"want to animate the change, use the ","type":"text"},{"code":"-setDirection:animated:","type":"codeVoice"},{"text":" method instead.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"metadata":{"modules":[{"name":"MapLibre"}],"fragments":[{"kind":"identifier","text":"direction"}],"remoteSource":{"url":"https:\/\/github.com\/maplibre\/m