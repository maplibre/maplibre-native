{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"]]},"kind":"symbol","abstract":[{"type":"text","text":"Deprecated. Sets the distance from the edges of the map view’s frame to the edges"},{"type":"text","text":" "},{"type":"text","text":"of the map view’s logical viewport with an optional transition animation."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setContentInset:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:@S@UIEdgeInsets","text":"UIEdgeInsets","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"contentInset","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"animated:","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":") "},{"kind":"internalParam","text":"animated"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The new values to inset the content by.","type":"text"}],"type":"paragraph"}],"name":"contentInset"},{"content":[{"inlineContent":[{"text":"Specify ","type":"text"},{"code":"YES","type":"codeVoice"},{"text":" if you want the map view to animate the change to","type":"text"},{"text":" ","type":"text"},{"text":"the content inset or ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":" if you want the map to inset the content","type":"text"},{"text":" ","type":"text"},{"text":"immediately.","type":"text"}],"type":"paragraph"}],"name":"animated"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the value of this property