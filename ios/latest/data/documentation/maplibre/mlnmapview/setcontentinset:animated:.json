{"abstract":[{"text":"Deprecated. Sets the distance from the edges of the map view’s frame to the edges","type":"text"},{"text":" ","type":"text"},{"text":"of the map view’s logical viewport with an optional transition animation.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setContentInset:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@UIEdgeInsets","text":"UIEdgeInsets"},{"kind":"text","text":") "},{"kind":"internalParam","text":"contentInset"},{"kind":"text","text":" "},{"kind":"identifier","text":"animated:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":") "},{"kind":"internalParam","text":"animated"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"name":"contentInset","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new values to inset the content by."}]}]},{"name":"animated","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specify "},{"type":"codeVoice","code":"YES"},{"type":"text","text":" if you want the map view to animate the change to"},{"type":"text","text":" "},{"type":"text","text":"the content inset or "},{"type":"codeVoice","code":"NO"},{"type":"text","text":" if you want the map to inset the content"},{"type":"text","text":" "},{"type":"text","text":"immediately."}]}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When the value of this property is equal to "},{"type":"codeVoice","code":"UIEdgeInsetsZero"},{"type":"text","text":", viewport"},{"type":"text","text":" "},{"type":"text","text":"properties such as "},{"type":"codeVoice","code"