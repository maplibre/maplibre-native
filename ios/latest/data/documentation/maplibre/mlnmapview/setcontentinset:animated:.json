rty may be overridden at any time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The usage of "},{"code":"automaticallyAdjustsScrollViewInsets","type":"codeVoice"},{"type":"text","text":" has been deprecated"},{"type":"text","text":" "},{"type":"text","text":"use the map view’s property "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/automaticallyAdjustsContentInset","type":"reference","isActive":true},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To specify a completion handler to execute after the animation finishes, use"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"-setContentInset:animated:completionHandler:","type":"codeVoice"},{"type":"text","text":" method."}]}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/automaticallyAdjustsContentInset":{"role":"symbol","fragments":[{"kind":"identifier","text":"automaticallyAdjustsContentInset"}],"abstract":[{"type":"text","text":"A boolean value that indicates if whether the map view should automatically"},{"type":"text","text":" "},{"type":"text","text":"adjust its content insets."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/automaticallyAdjustsContentInset","title":"automaticallyAdjustsContentInset","url":"\/documentation\/maplibre\/mlnmapview\/automaticallyadjustscontentinset"},"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/setContentInset:animated:":{"abstract":[{"text":"Deprecated. Sets the distance from the edg