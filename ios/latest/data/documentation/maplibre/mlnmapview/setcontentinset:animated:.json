{"kind":"symbol","abstract":[{"text":"Deprecated. Sets the distance from the edges of the map view’s frame to the edges","type":"text"},{"text":" ","type":"text"},{"text":"of the map view’s logical viewport with an optional transition animation.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setContentInset:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@UIEdgeInsets","text":"UIEdgeInsets"},{"kind":"text","text":") "},{"kind":"internalParam","text":"contentInset"},{"kind":"text","text":" "},{"kind":"identifier","text":"animated:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":") "},{"kind":"internalParam","text":"animated"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new values to inset the content by."}]}],"name":"contentInset"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specify "},{"code":"YES","type":"codeVoice"},{"type":"text","text":" if you want the map view to animate the change to"},{"type":"text","text":" "},{"type":"text","text":"the content inset or "},{"code":"NO","type":"codeVoice"},{"type":"text","text":" if you want the map to inset the content"},{"type":"text","text":" "},{"type":"text","text":"immediately."}]}],"name":"animated"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When the value of this property is equal to "},{"code":"UIEdgeInsetsZero","type":"codeVoice"},{"type":"text","text":", viewport"},{"type":"text","text":" "},{"type":"text","text":"properties such