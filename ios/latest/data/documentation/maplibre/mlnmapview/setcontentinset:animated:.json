umentation\/MapLibre\/MLNMapView\/automaticallyAdjustsContentInset"},{"text":"instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To specify a completion handler to execute after the animation finishes, use"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"-setContentInset:animated:completionHandler:"},{"type":"text","text":" method."}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"Deprecated. Sets the distance from the edges of the map view’s frame to the edges","type":"text"},{"text":" ","type":"text"},{"text":"of the map view’s logical viewport with an optional transition animation.","type":"text"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnmapview\/setcontentinset:animated:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/setContentInset:animated:":{"abstract":[{"type":"text","text":"Deprecated. Sets the distance from the edges of the map view’s frame to the edges"},{"type":"text","text":" "},{"type":"text","text":"of the map view’s logical viewport with an optional transition animation."}],"url":"\/documentation\/maplibre\/mlnmapview\/setcontentinset:animated:","fragments":[{"text":"- ","kind":"text"},{"text":"setContentInset:animated:","kind":"identifier"}],"role":"symbol","title":"setContentInset:animated:","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setContentInset:animated:","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","role":"collection","type":"topic","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/automaticallyAdjustsContentInset":{"fragments