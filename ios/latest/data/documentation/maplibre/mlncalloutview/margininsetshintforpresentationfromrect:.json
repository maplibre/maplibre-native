:"rect"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"UIEdgeInsets"},{"text":" representing the margins. Values should be negative.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"These are used to determine positioning. Currently only the top and bottom properties of the return","type":"text"},{"text":" ","type":"text"},{"text":"value are used. For example, ","type":"text"},{"type":"codeVoice","code":"{ .top = -50.0, .left = -10.0, .bottom = 0.0, .right = -10.0 }"},{"text":" ","type":"text"},{"text":"indicates a 50 point margin above the presentation origin rect (and 10 point margins to the left","type":"text"},{"text":" ","type":"text"},{"text":"and the right) in which the callout is assumed to be displayed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are no assumed defaults for these margins, as they should be calculated from the callout that","type":"text"},{"text":" ","type":"text"},{"text":"is to be presented. For example, ","type":"text"},{"type":"codeVoice","code":"SMCalloutView"},{"text":" generates the top margin from the callout height,","type":"text"},{"text":" ","type":"text"},{"text":"but the left and right margins from a minimum width that the callout should have.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"If implemented, should provide margins to expand the rect the callout is presented from.","type":"text"}],"variants":[{"paths":["\/documentation\/maplibre\/mlncalloutview\/margininsetshintforpresentationfromrect:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/presentCalloutFromRect:inView:constrainedToRect:animated:":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Presents a callout view by ad