tyle\/sourceWithIdentifier:","role":"symbol","title":"sourceWithIdentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"kind":"symbol","fragments":[{"text":"MLNStyle","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnstyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","role":"symbol","title":"MLNStyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/resetFeatureStates":{"kind":"symbol","role":"symbol","abstract":[{"text":"Removes all feature state entries from this source.","type":"text"}],"title":"resetFeatureStates","fragments":[{"text":"- ","kind":"text"},{"text":"resetFeatureStates","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/resetFeatureStates","type":"topic","url":"\/documentation\/maplibre\/mlnshapesource\/resetfeaturestates"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/leavesOfCluster:offset:limit:":{"kind":"symbol","role":"symbol","title":"leavesOfCluster:offset:limit:","abstract":[{"text":"Returns an array of map features that are the leaves of the specified cluster.","type":"text"},{"text":" ","type":"text"},{"text":"(“Leaves” are the original points that belong to the cluster.)","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"leavesOfCluster:offset:limit:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/leavesOfCluster:offset:limit:","type":"topic","url":"\/documentation\/maplibre\/mlnshapesource\/leavesofcluster:offset:limit:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/initWithIdentifier:shape:options:":{"kind":"symbol","fragments":[{"kind":"text","text":"- "},{"text":"initWithIdentifier:shape:option