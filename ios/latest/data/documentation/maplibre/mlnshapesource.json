pLibre/MLNShapeSource/zoomLevelForExpandingCluster:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/zoomLevelForExpandingCluster:","url":"\/documentation\/maplibre\/mlnshapesource\/zoomlevelforexpandingcluster:","type":"topic","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"zoomLevelForExpandingCluster:"}],"title":"zoomLevelForExpandingCluster:","abstract":[{"type":"text","text":"Returns the zoom level at which the given cluster expands."}],"kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","url":"\/documentation\/maplibre\/mlnsource","type":"topic","fragments":[{"text":"MLNSource","kind":"identifier"}],"title":"MLNSource","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"kind":"symbol","role":"symbol"}}}