ient-side elevation coloring based on DEM data. The implementation supports"},{"type":"text","text":" "},{"type":"text","text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings."}],"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","role":"symbol","fragments":[{"text":"MLNColorReliefStyleLayer","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"sourceWithIdentifier:"}],"type":"topic","url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","role":"symbol","kind":"symbol","title":"sourceWithIdentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"title":"MLNVectorTileSource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":" is a map content source that supplies tiled vector data"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"text","text":"Mapbox Vector Tile"},{"type":"text","text":" format"},{"type":"text","text":" "},{"type":"text","text":"to be shown on the map. The location of and metadata about the tiles are"},{"type":"text","text":" "},{"type":"text","text":"defined either by an option dictionary or by an external file that conforms to"},{"type":"text","text":" "},{"type":"text","text":"the"},{"type":"text","text":" "},{"type":"text","text":"TileJSON specification"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A vector tile source is added to an "},{"type":"reference","isActive":true,"identifier":"