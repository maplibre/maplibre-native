ments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"featureStateForFeatureID:"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnshapesource\/featurestateforfeatureid:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featureStateForFeatureID:","title":"featureStateForFeatureID:","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Gets the current state of a feature in this source."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"fragments":[{"text":"MLNColorReliefStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"Client-side elevation coloring based on DEM data. The implementation supports"},{"type":"text","text":" "},{"type":"text","text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings."}],"title":"MLNColorReliefStyleLayer","type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource":{"url":"\/documentation\/maplibre\/mlnimagesource","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"MLNImageSource"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource"},{"type":"text","text":" is a content source that is used for a georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"image to be shown on the map. The georeferenced image scales and rotates as the"},{"type":"text","text":" "},{"type":"text","text":"user zooms and rotates the map. Images may also be used as icons or patterns"},{"type":"text","text":" "},{"type":"text","text":"in a style layer. To register an image for use as an icon or pattern,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:"},{"type":"text","text":" method. To configure a point"},{"type":"text","text":" "},{"type":"text","text":"annotation’s image, use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage"},{"type":"text","text":" class."}],"kind":"symbol","title":"MLNImageSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/removeFeatureStateForFeatureID:stateKey:":{"fragments":[{"text":"- ","kind":"text"},{"text":"removeFeatureStateForFeatureID:stateKey:","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnshapesource\/removefeaturestateforfeatureid:statekey:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:","title":"removeFeatureStateForFeatureID:stateKey:","role":"symbol","type":"topic","abstract":[{"text":"Removes state from a feature in this source, or from all features when","type":"text"},{"text":" ","type":"text"},{"code":"featureID","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/addSource:":{"fragments":[{"text":"- ","kind":"text"},{"text":"addSource:","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds a new source to the current style."}],"title":"addSource:","type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/addsource:","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/addSource:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/zoomLevelForExpandingCluster:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"zoomLevelForExpandingCluster:"}],"abstract":[{"type":"text","text":"Returns the