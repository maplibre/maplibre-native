ence","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true},{"type":"text","text":" objects. Use a style layer to"},{"type":"text","text":" "},{"type":"text","text":"control the appearance of content supplied by the tile source."}],"title":"MLNTileSource","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource","fragments":[{"text":"MLNTileSource","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlntilesource","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"abstract":[{"text":"Client-side elevation coloring based on DEM data. The implementation supports","type":"text"},{"text":" ","type":"text"},{"text":"Mapbox Terrain RGB, Mapzen Terrarium tiles and custom encodings.","type":"text"}],"title":"MLNColorReliefStyleLayer","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","fragments":[{"text":"MLNColorReliefStyleLayer","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"title":"MLNShapeSource","url":"\/documentation\/maplibre\/mlnshapesource","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"topic","role":"symbol","fragments":[{"text":"MLNShapeSource","kind":"identifier"}],"abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\