hat conforms to","type":"text"},{"text":" ","type":"text"},{"text":"the","type":"text"},{"text":" ","type":"text"},{"text":"TileJSON specification","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A raster tile source is added to an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object along with one or more","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","type":"reference"},{"text":" objects. Use a raster style layer to control the","type":"text"},{"text":" ","type":"text"},{"text":"appearance of content supplied by the raster tile source.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/featuresMatchingPredicate:":{"type":"topic","role":"symbol","title":"featuresMatchingPredicate:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featuresMatchingPredicate:","kind":"symbol","abstract":[{"type":"text","text":"Returns an array of map features for this source, filtered by the given"},{"type":"text","text":" "},{"type":"text","text":"predicate."}],"url":"\/documentation\/maplibre\/mlnshapesource\/featuresmatchingpredicate:","fragments":[{"text":"- ","kind":"text"},{"text":"featuresMatchingPredicate:","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/sourceWithIdentifier:":{"type":"topic","role":"symbol","title":"sourceWithIdentifier:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/sourceWithIdentifier:","abstract":[{"type":"text","text":"Returns a source with the given identifier in the current style."}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/sourcewithidentifier:","fragments":[{"text":"- ","kind":"text"},{"text":"sourceWithIdentifier:","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterDEMSource":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterDEMSource","fragments":[{"kind":"identifier","text":"MLNRasterDEMSource"}],"title":"MLNRasterDEMSource","url":"\/documentation\/maplibre\/mlnrasterdemsource","role":"symbol","kind":"symbol","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterDEMSource"},{"text":" is a map content source that supplies rasterized","type":"text"},{"text":" ","type":"text"},{"text":"digital elevation model","type":"text"},{"text":" ","type":"text"},{"text":"(DEM) tiles to be shown on the map. The location of and metadata about the","type":"text"},{"text":" ","type":"text"},{"text":"tiles are defined either by an option dictionary or by an external file that","type":"text"},{"text":" ","type":"text"},{"text":"conforms to the","type":"text"},{"text":" ","type":"text"},{"text":"TileJSON specification","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A raster DEM source is added to an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" object along with one or more","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer"},{"text":" objects. Use a hillshade","type":"text"},{"text":" ","type":"text"},{"text":"style layer to control the appearance of content supplied by the raster DEM source,","type":"text"},{"text":" ","type":"text"},{"text":"or a color relief style layer to render elevation data with a color ramp.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/removeFeatureStateForFeatureID:stateKey:":{"type":"topic","url":"\/documentation\/maplibre\/mlnshapesource\/removefeaturestateforfeatureid:statekey:","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:","abstract":[{"text":"Removes state from a feature in this source, or from all features when","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"featureID"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"title":"removeFeatureStateForFeatureID:stateKey:","fragments":[{"text":"- ","kind":"text"},{"text":"removeFeatureStateForFeatureID:stateKey:","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/shape":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/shape","abstract":[{"type":"text","text":"The contents of the source. A shape can represent a GeoJSON geometry, a"},{"type":"text","text":" "},{"type":"text","text":"feature, or a collection of features."}],"url":"\/documentation\/maplibre\/mlnshapesource\/shape","type":"topic","title":"shape","kind":"symbol","fragments":[{"text":"shape","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","fragments":[{"kind":"identifier","text":"MLNRasterStyleLayer"}],"title":"MLNRasterStyleLayer","url":"\/documentation\/maplibre\/mlnrasterstylelayer","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"imagery on the map, especially raster tiles."}]},"doc://org.swift.MyProject/documentati