re","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"kind":"symbol","role":"symbol","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","type":"reference","isActive":true},{"text":" is a style layer that renders georeferenced raster","type":"text"},{"text":" ","type":"text"},{"text":"imagery on the map, especially raster tiles.","type":"text"}],"title":"MLNRasterStyleLayer","fragments":[{"text":"MLNRasterStyleLayer","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","url":"\/documentation\/maplibre\/mlnrasterstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/setImage:forName:":{"kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setImage:forName:"}],"type":"topic","url":"\/documentation\/maplibre\/mlnstyle\/setimage:forname:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","role":"symbol","title":"setImage:forName:","abstract":[{"text":"Adds or overrides an image used by the style’s layers.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNColorReliefStyleLayer":{"kind":"symbol","fragments":[{"text":"MLNColorReliefStyleLayer","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlncolorreliefstylelayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNColorReliefStyleLayer","role":"symbol","title":"MLNColorReliefStyleLayer","abstract":[{"type":"text","text":"Client-side elevation coloring based on DEM data. The implementation supports"},{"type":"text","text":" "},{"type":"text","text":"Mapbox