:" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCluster","isActive":true},{"type":"text","text":" protocol (currently only objects of type "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCluster","isActive":true},{"type":"text","text":")."}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/addSource:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addSource:"}],"url":"\/documentation\/maplibre\/mlnstyle\/addsource:","kind":"symbol","title":"addSource:","abstract":[{"text":"Adds a new source to the current style.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/addSource:","type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/featuresMatchingPredicate:":{"title":"featuresMatchingPredicate:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featuresMatchingPredicate:","url":"\/documentation\/maplibre\/mlnshapesource\/featuresmatchingpredicate:","abstract":[{"text":"Returns an array of map features for this source, filtered by the given","type":"text"},{"text":" ","type":"text"},{"text":"predicate.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"featuresMatchingPredicate:","kind":"identifier"}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNTileSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource","fragments":[{"text":"MLNTileSource","kind":"identifier"}],"title":"MLNTileSource","type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlntilesource","role":"symbol","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource"},{"type":"text","text":" is a map content source that supplies map