er. For each required tile source, if"},{"type":"text","text":" "},{"type":"text","text":"this parameter is set to a value less than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels down to the tile source’s minimum"},{"type":"text","text":" "},{"type":"text","text":"zoom level."}],"type":"paragraph"}]},{"name":"maximumZoomLevel","content":[{"inlineContent":[{"type":"text","text":"The maximum zoom level to be covered by the downloaded"},{"type":"text","text":" "},{"type":"text","text":"tiles. This parameter should be set to at least the value of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumZoomLevel"},{"type":"text","text":" parameter. For each required tile source, if this"},{"type":"text","text":" "},{"type":"text","text":"parameter is set to a value greater than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the designated initializer for "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeOfflineRegion":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","title":"MLNShapeOfflineRegion","fragments":[{"text":"MLNShapeOfflineRegion","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"text":"An offline region defined by a style URL, geographic shape, and","type":"text"},{"text":" ","type":"text"},{"text":"range of zoom levels.","type":"text"}],"kind":"symbol","url":"\/documentati