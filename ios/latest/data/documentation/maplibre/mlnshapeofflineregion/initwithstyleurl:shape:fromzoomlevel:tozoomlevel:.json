,"kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"parameters":[{"name":"styleURL","content":[{"inlineContent":[{"text":"URL of the map style for which to download resources. The URL","type":"text"},{"text":" ","type":"text"},{"text":"may be a full HTTP or HTTPS URL or a canonical URL.","type":"text"},{"text":" ","type":"text"},{"text":"Specify ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for the default style.","type":"text"},{"text":" ","type":"text"},{"text":"Relative file URLs cannot be used as offline style URLs. To download the","type":"text"},{"text":" ","type":"text"},{"text":"online resources required by a local style, specify a URL to an online copy","type":"text"},{"text":" ","type":"text"},{"text":"of the style.","type":"text"}],"type":"paragraph"}]},{"name":"shape","content":[{"inlineContent":[{"text":"The shape of the geographic region to be covered by","type":"text"},{"text":" ","type":"text"},{"text":"the downloaded tiles.","type":"text"}],"type":"paragraph"}]},{"name":"minimumZoomLevel","content":[{"inlineContent":[{"text":"The minimum zoom level to be covered by the downloaded","type":"text"},{"text":" ","type":"text"},{"text":"tiles. This parameter should be set to at least 0 but no greater than the","type":"text"},{"text":" ","type":"text"},{"text":"value of the ","type":"text"},{"code":"maximumZoomLevel","type":"codeVoice"},{"text":" parameter. For each required tile source, if","type":"text"},{"text":" ","type":"text"},{"text":"this parameter is set to a value less than the tile source’s minimum zoom","type":"text"},{"text":" ","type":"text"},{"text":"level, the download covers zoom levels down to the tile source’s minimum","type":"text"},{"text":" ","type":"text"},{"text":"zoom level.","type":"text"}],"type":"paragraph"}]},{"name":"maximumZoomLevel","content":[{"inlineContent":[{"text":"The maximum zoom level to be covered by the downloaded","type":"text"},{"text":" ","type":"text"},{"text":"tiles. This parameter should be set to at least the value of the","type":"text"},{"text":" ","type":"text"},{"code":"minimumZoomLevel","type":"codeVoice"},{"text":" parameter. For each required tile source, if this","type":"text"},{"text":" ","type":"text"},{"text":"parameter is set to a value greater than the tile source’s minimum zoom","type":"text"},{"text":" ","type":"text"},{"text":"level, the download covers zoom levels up to the tile source’s maximum zoom","type":"text"},{"text":" ","type":"text"},{"text":"level.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This is the designated initializer for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnshapeofflineregion\/initwithstyleurl:shape:fromzoomlevel:tozoomlevel:"]}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion\/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:"},"abstract":[{"text":"Initializes a newly created offline region with the given style URL, geometry,","type":"text"},{"text":" ","type":"text"},{"text":"and range of zoom levels.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeOfflineRegion":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","kind":"symbol","url":"\/documentation\/maplibre\/mlnshapeofflineregion","abstract":[{"text":"An offline region defined by a style URL, geographic shape, and","type":"text"},{"text":" ","type":"text"},{"text":"range of zoom levels.","type":"text"}],"title":"MLNShapeOfflineRegion","fragments":[{"text":"MLNShapeOfflineRegion","