":"text","text":" "},{"type":"text","text":"this parameter is set to a value less than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels down to the tile source’s minimum"},{"type":"text","text":" "},{"type":"text","text":"zoom level."}],"type":"paragraph"}],"name":"minimumZoomLevel"},{"content":[{"inlineContent":[{"type":"text","text":"The maximum zoom level to be covered by the downloaded"},{"type":"text","text":" "},{"type":"text","text":"tiles. This parameter should be set to at least the value of the"},{"type":"text","text":" "},{"code":"minimumZoomLevel","type":"codeVoice"},{"type":"text","text":" parameter. For each required tile source, if this"},{"type":"text","text":" "},{"type":"text","text":"parameter is set to a value greater than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}],"type":"paragraph"}],"name":"maximumZoomLevel"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"This is the designated initializer for ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeOfflineRegion/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:":{"url":"\/documentation\/maplibre\/mlnshapeofflineregion\/initwithstyleurl:shape:fromzoomlevel:tozoomlevel:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion\/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:","title":"initWithStyleURL:shape:fromZoomLevel:toZoomLevel:","kind":"symbol","role":"symbol","fragments":[{"kind":"text","text":"- "},