xt","text":" parameter. For each required tile source, if this"},{"type":"text","text":" "},{"type":"text","text":"parameter is set to a value greater than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This is the designated initializer for "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnshapeofflineregion\/initwithstyleurl:shape:fromzoomlevel:tozoomlevel:"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Initializes a newly created offline region with the given style URL, geometry,","type":"text"},{"text":" ","type":"text"},{"text":"and range of zoom levels.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion"]]},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion\/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:","interfaceLanguage":"occ"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeOfflineRegion/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion\/initWithStyleURL:shape:fromZoomLevel:toZoomLevel:","url":"\/documentation\/maplibre\/mlnshapeofflineregion\/initwithstyleurl:shape:fromzoomlevel:tozoomlevel:","title":"initWithStyleURL:shape:fromZoomLevel:toZoomLevel:","abstract":[{"type":"text","text":"Initializes a newly cr