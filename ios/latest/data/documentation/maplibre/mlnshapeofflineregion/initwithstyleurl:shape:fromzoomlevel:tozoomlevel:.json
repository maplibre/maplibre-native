ontent":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The maximum zoom level to be covered by the downloaded"},{"type":"text","text":" "},{"type":"text","text":"tiles. This parameter should be set to at least the value of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumZoomLevel"},{"type":"text","text":" parameter. For each required tile source, if this"},{"type":"text","text":" "},{"type":"text","text":"parameter is set to a value greater than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}]}],"name":"maximumZoomLevel"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the designated initializer for "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeOfflineRegion","isActive":true},{"type":"text","text":"."}]}]}],"abstract":[{"text":"Initializes a newly created offline region with the given style URL, geometry,","type":"text"},{"text":" ","type":"text"},{"text":"and range of zoom levels.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnshapeofflineregion\/initwithstyleurl:shape:fromzoomlevel:tozoomlevel:"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"url":"\/documentation\/maplibre","title":"MapLibre","role":"collection"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeOfflineRegion":{"type":"topic","kind":"symbol","fragments":[{"text":"MLNShapeOfflineRegion