oject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","interfaceLanguage":"occ"},"metadata":{"fragments":[{"text":"MLNOfflinePackStateUnknown","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MLNOfflinePackStateUnknown"}],"externalID":"c:@E@MLNOfflinePackState@MLNOfflinePackStateUnknown","title":"MLNOfflinePackStateUnknown","symbolKind":"case","modules":[{"name":"MapLibre"}],"role":"symbol","roleHeading":"Enumeration Case"},"kind":"symbol","references":{"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre","role":"collection","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateUnknown":{"role":"symbol","fragments":[{"text":"MLNOfflinePackStateUnknown","kind":"identifier"}],"abstract":[{"type":"text","text":"It is unknown whether the pack is inactive, active, or complete."}],"title":"MLNOfflinePackStateUnknown","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState":{"abstract":[{"type":"text","text":"The state an offline pack is currently in."}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState","role":"symbol","fragments":[{"text":"MLNOfflinePackState","kind":"identifier"}],"