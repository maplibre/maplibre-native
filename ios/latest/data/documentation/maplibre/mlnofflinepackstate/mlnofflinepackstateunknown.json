yProject/documentation/MapLibre/MLNOfflinePackState":{"url":"\/documentation\/maplibre\/mlnofflinepackstate","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The state an offline pack is currently in."}],"title":"MLNOfflinePackState","fragments":[{"text":"MLNOfflinePackState","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateInvalid":{"title":"MLNOfflinePackStateInvalid","abstract":[{"type":"text","text":"The pack has been removed using the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/removePack:withCompletionHandler:","isActive":true},{"type":"text","text":" method. Sending"},{"type":"text","text":" "},{"type":"text","text":"any message to the pack will raise an exception."}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"MLNOfflinePackStateInvalid","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateinvalid","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInvalid"}}}