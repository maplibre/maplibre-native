":"symbol","externalID":"c:@E@MLNOfflinePackState@MLNOfflinePackStateUnknown","fragments":[{"kind":"identifier","text":"MLNOfflinePackStateUnknown"}],"roleHeading":"Enumeration Case","symbolKind":"case","title":"MLNOfflinePackStateUnknown","navigatorTitle":[{"kind":"identifier","text":"MLNOfflinePackStateUnknown"}]},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown"},"kind":"symbol","abstract":[{"type":"text","text":"It is unknown whether the pack is inactive, active, or complete."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateInvalid":{"title":"MLNOfflinePackStateInvalid","kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateinvalid","abstract":[{"type":"text","text":"The pack has been removed using the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/removePack:withCompletionHandler:","type":"reference","isActive":true},{"type":"text","text":" method. Sending"},{"type":"text","text":" "},{"type":"text","text":"any message to the pack will raise an exception."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInvalid","role":"symbol","fragments":[{"text":"MLNOfflinePackStateInvalid","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","title":"MapLibre","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentatio