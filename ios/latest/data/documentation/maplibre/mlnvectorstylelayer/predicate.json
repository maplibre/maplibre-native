{"abstract":[{"type":"text","text":"The style layer’s predicate."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSPredicate","text":"NSPredicate"},{"kind":"text","text":" * "},{"kind":"identifier","text":"predicate"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the style layer’s predicate to include only the features in the source"},{"type":"text","text":" "},{"type":"text","text":"layer that satisfy a condition that you define. If the style layer initially"},{"type":"text","text":" "},{"type":"text","text":"comes from the style, its predicate corresponds to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"filter"},{"type":"text","text":" "},{"type":"text","text":"property in the style JSON."}]},{"type":"paragraph","inlineContent":[{"text":"See the “","type":"text"},{"text":"Predicates and Expressions","type":"text"},{"text":"”","type":"text"},{"text":" ","type":"text"},{"text":"guide for details about the predicate syntax supported by this class.","type":"text"}]},{"level":3,"text":"Example","anchor":"Example","type":"heading"},{"inlineContent":[{"text":"To filter the layer to include only the features whose ","type":"text"},{"code":"index","type":"codeVoice"},{"text":" attribute is 5","type":"text"},{"text":" ","type":"text"},{"text":"or 10 and whose ","type":"text"},{"code":"ele","type":"codeVoice"},{"text":" attribute is at least 1,500, you could create an","type":"text"},{"text":" ","type":"text"},{"code":"NSCompoundPredicate","type":"codeVoice"},{"text":" along these lines:","type":"text"}],"type":"paragraph"},{"code":["let layer = MLNLineStyleLayer(identifier: \"contour\", source: terrain)","layer.sourceLayerIdentifier = \"contours\"","layer.predicate = NSPredicate(format: \"(index == 5 || index == 10) && CAST(ele, 'NSNumber') >=","1500.0\") mapView.style?.addLayer(layer)"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate"},"variants":[{"paths":["\/documentation\/maplibre\/mlnvectorstylelayer\/predicate"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"navigatorTitle":[{"text":"predicate","kind":"identifier"}],"symbolKind":"property","externalID":"c:objc(cs)MLNVectorStyleLayer(py)predicate","modules":[{"name":"MapLibre"}],"title":"predicate","role":"symbol","fragments":[{"text":"predicate","kind":"identifier"}],"roleHeading":"Instance Property"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer/predicate":{"title":"predicate","url":"\/documentation\/maplibre\/mlnvectorstylelayer\/predicate","abstract":[{"type":"text","text":"The style layer’s predicate."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","type":"topic","fragments":[{"text":"predicate","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"title":"MLNVectorStyleLayer","url":"\/documentation\/maplibre\/mlnvectorstylelayer","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is an abstract superclass for style layers whose content"},{"type":"text","text":" "},{"type":"text","text":"is defined by a