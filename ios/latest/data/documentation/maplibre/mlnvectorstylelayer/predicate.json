":"”","type":"text"},{"text":" ","type":"text"},{"text":"guide for details about the predicate syntax supported by this class.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Example","type":"heading","text":"Example"},{"inlineContent":[{"text":"To filter the layer to include only the features whose ","type":"text"},{"type":"codeVoice","code":"index"},{"text":" attribute is 5","type":"text"},{"text":" ","type":"text"},{"text":"or 10 and whose ","type":"text"},{"type":"codeVoice","code":"ele"},{"text":" attribute is at least 1,500, you could create an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSCompoundPredicate"},{"text":" along these lines:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let layer = MLNLineStyleLayer(identifier: \"contour\", source: terrain)","layer.sourceLayerIdentifier = \"contours\"","layer.predicate = NSPredicate(format: \"(index == 5 || index == 10) && CAST(ele, 'NSNumber') >=","1500.0\") mapView.style?.addLayer(layer)"],"type":"codeListing"}]}],"abstract":[{"type":"text","text":"The style layer’s predicate."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"},{"text":" is an abstract superclass for style layers whose content","type":"text"},{"text":" ","type":"text"},{"text":"is defined by an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"text":" object.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnvectorstylelayer","title":"MLNVectorStyleLayer","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNVectorStyleLayer"}],"identifier":"