{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnvectorstylelayer\/predicate"]}],"metadata":{"role":"symbol","fragments":[{"kind":"identifier","text":"predicate"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","title":"predicate","navigatorTitle":[{"kind":"identifier","text":"predicate"}],"externalID":"c:objc(cs)MLNVectorStyleLayer(py)predicate","symbolKind":"property"},"abstract":[{"text":"The style layer’s predicate.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSPredicate","preciseIdentifier":"c:objc(cs)NSPredicate"},{"kind":"text","text":" * "},{"kind":"identifier","text":"predicate"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Use the style layer’s predicate to include only the features in the source","type":"text"},{"text":" ","type":"text"},{"text":"layer that satisfy a condition that you define. If the style layer initially","type":"text"},{"text":" ","type":"text"},{"text":"comes from the style, its predicate corresponds to the","type":"text"},{"text":" ","type":"text"},{"code":"filter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property in the style JSON.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See the “"},{"type":"text","text":"Predicates and Expressions"},{"type":"text","text":"”"},{"type":"text","text":" "},{"type":"text","text":"guide for details about the predicate syntax supported by this class."}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":3,"text":"Example"},{"inlineContent":[{"text":"To filter the layer to include only the features whose ","type":"text"},{"type":"codeVoice","code":"index"},{"type":"text","text":" attribute is 5"},{"type":"text","text":" "},{"text":"or 10 and whose ","type":"text"},{"code":"ele","type":"codeVoice"},{"text":" attribute is at least 1,500, you could create an","type":"text"},{"text":" ","type":"text"},{"code":"NSCompoundPredicate","type":"codeVoice"},{"text":" along these lines:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let layer = MLNLineStyleLayer(identifier: \"contour\", source: terrain)","layer.sourceLayerIdentifier = \"contours\"","layer.predicate = NSPredicate(format: \"(index == 5 || index == 10) && CAST(ele, 'NSNumber') >=","1500.0\") mapView.style?.addLayer(layer)"]}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","interfaceLanguage":"occ"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer/predicate":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","abstract":[{"type":"text","text":"The style layer’s predicate."}],"role":"symbol","fragments":[{"text":"predicate","kind":"identifier"}],"kind":"symbol","title":"predicate","url":"\/documentation\/maplibre\/mlnvectorstylelayer\/predicate","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"title":"MLNVectorStyleLayer","url":"\/documentation\/maplibre\/mlnvectorstylelayer","role":"symbol","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"},{"type":"text","text":" is an abstract superclass for style layers whose content"},{"type":"text","text":" "},{"type":"text","text":