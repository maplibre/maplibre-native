","text":" "},{"text":"of ","type":"text"},{"code":"view","type":"codeVoice"},{"type":"text","text":"’s bounds. Constrains the callout to the rect in the space of "},{"code":"view","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/presentCalloutFromRect:inView:constrainedToRect:animated:","title":"presentCalloutFromRect:inView:constrainedToRect:animated:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissCalloutAnimated:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/dismissCalloutAnimated:","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/dismisscalloutanimated:","abstract":[{"text":"Dismisses the callout view.","type":"text"}],"role":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"dismissCalloutAnimated:"}],"title":"dismissCalloutAnimated:","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/leftAccessoryView":{"url":"\/documentation\/maplibre\/mlncalloutview\/leftaccessoryview","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/leftAccessoryView","type":"topic","abstract":[{"type":"text","text":"A view that the user may tap to perform an action. This view is conventionally"},{"type":"text","text":" "},{"type":"text","text":"positioned on the left side of the callout view."}],"title":"leftAccessoryView","fragments":[{"kind":"identifier","text":"leftAccessoryView"}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotation":{"role":"symbol","url":"\/documentation\/maplibre\/mlnannotation","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","isActive":true,"type":"reference"},{"text":" protocol is used to provide annotation-related information","type":"text"},{"text":" ","type":"text"},{"text":"to a map view. To use this protocol, you adopt it in any custom objects that","type":"text"},{"text":" ","type":"text"},{"text":"store or represent annotation data. Each object then serves as the source of","type":"text"},{"text":" ","type":"text"},{"text":"information about a single map annotation and provides critical information,","type":"text"},{"text":" ","type":"text"},{"text":"such as the annotation’s location on the map. Annotation objects do not provide","type":"text"},{"text":" ","type":"text"},{"text":"the visual representation of the annotation but typically coordinate (in","type":"text"},{"text":" ","type":"text"},{"text":"conjunction with the map view’s delegate) the creation of an appropriate","type":"text"},{"text":" ","type":"text"},{"text":"objects to handle the display.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","title":"MLNAnnotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation","abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"role":"symbol","fragments":[{"kind":"identifier","text":"anchoredToAnnotation"}],"title":"anchoredToAnnotation","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissesAutomatically":{"identifie