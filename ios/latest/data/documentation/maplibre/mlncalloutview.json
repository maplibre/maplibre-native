MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate"},{"text":" protocol defines a set of optional methods that","type":"text"},{"text":" ","type":"text"},{"text":"you can use to receive messages from an object that conforms to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView"},{"type":"text","text":" protocol. The callout view uses these methods to inform the"},{"type":"text","text":" "},{"type":"text","text":"delegate that the user has interacted with the the callout view."}],"role":"symbol","fragments":[{"text":"MLNCalloutViewDelegate","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","title":"MLNCalloutViewDelegate","kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlncalloutviewdelegate"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissesAutomatically":{"title":"dismissesAutomatically","role":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/dismissesautomatically","fragments":[{"text":"dismissesAutomatically","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be dismissed automatically"},{"type":"text","text":" "},{"type":"text","text":"when the map view’s viewport changes. Note that a single tap on the map view"},{"type":"text","text":" "},{"type":"text","text":"still dismisses the callout view regardless of the value of this property."},{"type":"text","text":" "},{"type":"text","text":"The callout view will be dismissed if this optional property is unimplemented."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/dismissesAutomatically"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"title":"anchoredToAnnotation","role":"symbol","url":"\/documentation\/map