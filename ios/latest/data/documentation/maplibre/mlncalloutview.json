apLibre\/MLNCalloutView\/representedObject","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","title":"MLNCalloutViewDelegate","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutviewdelegate","fragments":[{"text":"MLNCalloutViewDelegate","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate"},{"text":" protocol defines a set of optional methods that","type":"text"},{"text":" ","type":"text"},{"text":"you can use to receive messages from an object that conforms to the","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView"},{"text":" protocol. The callout view uses these methods to inform the","type":"text"},{"text":" ","type":"text"},{"text":"delegate that the user has interacted with the the callout view.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","url":"\/documentation\/maplibre","kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/leftAccessoryView":{"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/leftAccessoryView","title":"leftAccessoryView","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/leftaccessoryview","fragments":[{"kind":"identifier","text":"leftAccessoryView"}],"abstract":[{"text":"A view that the user may tap to perform an action. This view is conventionally","type":"text"},{"text":" ","type":"text"},{"text":"positioned on the left side of the callout view.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/delegate":{"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/delegate","title":"delegate","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/delegate","fragments":[{"text":"delegate","kind":"identifier"}],"abstract":[{"text":"An object conforming to the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","isActive":true,"type":"reference"},{"text":" method that receives","type":"text"},{"text":" ","type":"text"},{"text":"messages related to the callout view’s interactive subviews.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissesAutomatically":{"url":"\/documentation\/maplibre\/mlncalloutview\/dismissesautomatically","role":"symbol","fragments":[{"text":"dismissesAutomatically","kind":"identifier"}],"abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be dismissed automatically"},{"type":"text","text":" "},{"type":"text","text":"when the map view’s viewport changes. Note that a single tap on the map view"},{"type":"text","text":" "},{"type":"text","text":"still dismisses the callout view regardless of the value of this property."},{"type":"text","text":" "},{"type":"text","text":"The callout view will be dismissed if this optional property is unimplemented."}],"title":"dismissesAutomatically","type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/dismissesAutomatically"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","role":"symbol","fragments":[{"text":"anchoredToAnnotation","kind":"identifier"}],"abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"title":"anchoredToAnnotation","url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation","kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotation":{"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","title":"MLNAnnotation","kind":"symbol","url":"\/documentation\/maplibre\/mlnannotation","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","isActive":true},{"type":"text","text":" protocol is used to provide annotation-related information"},{"type":"text","text":" "},{"type":"text","text":"to a map view. To use this protocol, you adopt it in any custom objects that"},{"type":"text","text":" "},{"type":"text","text":"store or represent annotation data. Each object then serves as the source of"},{"type":"text","text":" "},{"type":"text","text":"information about a single map annotation and provides critical information,"},{"type":"text","text":" "},{"type":"text","text":"such as the annotation’s location on the map. Annotation objects do not provide"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}]}}}