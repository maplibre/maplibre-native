xt","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"fragments":[{"kind":"identifier","text":"MLNAnnotation"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","url":"\/documentation\/maplibre\/mlnannotation","role":"symbol","title":"MLNAnnotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"fragments":[{"text":"anchoredToAnnotation","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation","type":"topic","kind":"symbol","title":"anchoredToAnnotation","role":"symbol","abstract":[{"text":"A Boolean value indicating whether the callout view should be anchored to","type":"text"},{"text":" ","type":"text"},{"text":"the corresponding annotation. You can adjust the callout view’s precise location by","type":"text"},{"text":" ","type":"text"},{"text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the","type":"text"},{"text":" ","type":"text"},{"text":"annotation if this optional property is unimplemented.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/presentCalloutFromRect:inView:constrainedToRect:animated:":{"abstract":[{"type":"text","text":"Presents a callout view by adding it to "},{"type":"codeVoice","code":"view"},{"type":"text","text":" and pointing at the given rect"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"view"},{"type":"text","text":"’s bounds. Constrains the callout to the rect in the space of "},{"code":"view","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"presentCalloutFromRect:inView:constrainedToRect:animated:","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/presentCalloutFromRect:inView:constrainedToRect:animated:","url":"\/documentation\/maplibre\/mlncalloutview\/presentcalloutfromrect:inview:constrainedtorect:animated:","role":"symbol","title":"presentCalloutFromRect:inView:constrainedToRect:animated:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissesAutomatically":{"abstract":[{"text":"A Boolean value indicating whether the callout view should be dismissed automatically","type":"text"},{"text":" ","type":"text"},{"text":"when the map view’s viewport changes. Note that a single tap on the map view","type":"text"},{"text":" ","type":"text"},{"text":"still dismisses the callout view regardless of the value of this property.","type":"text"},{"text":" ","type":"text"},{"text":"The callout view will be dismissed if this optional property is unimplemented.","type":"text"}],"fragments":[{"text":"dismissesAutomatically","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/dismissesAutomatically","url":"\/documentation\/maplibre\/mlncalloutview\/dismissesautomatically","role":"symbol","title":"dismissesAutomatically"},"doc://org.swift.MyProject/objc(pl)NSObject":{"title":"NSObject","type":"unresolvable","identifier":"doc:\/\/org.swift.MyProject\/objc(pl)NSObject"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/leftAccessoryView":{"abstract":[{"text":"A view that the user may tap to perform an action. This view is conventionally","type":"text"},{"text":" ","type":"text"},{"text":"positioned on the left side of the callout view.","type":"text"}],"fragments":[{"text":"leftAccessoryView","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/leftAccessoryView","url":"\/documentation\/ma