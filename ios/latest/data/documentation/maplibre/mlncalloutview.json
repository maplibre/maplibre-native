text":" "},{"type":"text","text":"such as the annotation’s location on the map. Annotation objects do not provide"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"url":"\/documentation\/maplibre\/mlnannotation","fragments":[{"kind":"identifier","text":"MLNAnnotation"}],"role":"symbol","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"url":"\/documentation\/maplibre\/mlncalloutviewdelegate","role":"symbol","kind":"symbol","title":"MLNCalloutViewDelegate","type":"topic","fragments":[{"kind":"identifier","text":"MLNCalloutViewDelegate"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate"},{"type":"text","text":" protocol defines a set of optional methods that"},{"type":"text","text":" "},{"type":"text","text":"you can use to receive messages from an object that conforms to the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView"},{"type":"text","text":" protocol. The callout view uses these methods to inform the"},{"type":"text","text":" "},{"type":"text","text":"delegate that the user has interacted with the the callout view."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/representedObject":{"url":"\/documentation\/maplibre\/mlncalloutview\/representedobject","title":"representedObject","type":"topic","fragments":[{"kind":"identifier","text":"representedObject"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.