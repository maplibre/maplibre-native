ser has interacted with the the callout view."}],"title":"MLNCalloutViewDelegate","type":"topic","url":"\/documentation\/maplibre\/mlncalloutviewdelegate"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"anchoredToAnnotation"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"title":"anchoredToAnnotation","type":"topic","url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/presentCalloutFromRect:inView:constrainedToRect:animated:":{"kind":"symbol","role":"symbol","title":"presentCalloutFromRect:inView:constrainedToRect:animated:","url":"\/documentation\/maplibre\/mlncalloutview\/presentcalloutfromrect:inview:constrainedtorect:animated:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"presentCalloutFromRect:inView:constrainedToRect:animated:"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/presentCalloutFromRect:inView:constrainedToRect:animated:","abstract":[{"text":"Presents a callout view by adding it to ","type":"text"},{"code":"view","type":"codeVoice"},{"text":" and pointing at the given rect","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"view","type":"codeVoice"},{"text":"’s bounds. Constrains the callout to the rect in the space of ","type":"text"},{"code":"view","type":"codeVoice"},{"text":".","type":"text"}]}}}