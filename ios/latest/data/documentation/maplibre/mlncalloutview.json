f this optional property is unimplemented."}],"role":"symbol","fragments":[{"kind":"identifier","text":"dismissesAutomatically"}],"title":"dismissesAutomatically"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"role":"symbol","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","isActive":true,"type":"reference"},{"text":" protocol defines a set of optional methods that","type":"text"},{"text":" ","type":"text"},{"text":"you can use to receive messages from an object that conforms to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView","isActive":true,"type":"reference"},{"text":" protocol. The callout view uses these methods to inform the","type":"text"},{"text":" ","type":"text"},{"text":"delegate that the user has interacted with the the callout view.","type":"text"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutviewdelegate","title":"MLNCalloutViewDelegate","fragments":[{"text":"MLNCalloutViewDelegate","kind":"identifier"}]},"doc://org.swift.MyProject/objc(pl)NSObject":{"type":"unresolvable","identifier":"doc:\/\/org.swift.MyProject\/objc(pl)NSObject","title":"NSObject"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","url":"\/documentation\/maplibre","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","title":"anchoredToAnnotation","url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation","kind":"symbol","fragments":[{"text":"anchoredToAnnotation","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNAnnotation":{"type":"topic","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","isActive":true},{"type":"text","text":" protocol is used to provide annotation-related information"},{"type":"text","text":" "},{"type":"text","text":"to a map view. To use this protocol, you adopt it in any custom objects that"},{"type":"text","text":" "},{"type":"text","text":"store or represent annotation data. Each object then serves as the source of"},{"type":"text","text":" "},{"type":"text","text":"information about a single map annotation and provides critical information,"},{"type":"text","text":" "},{"type":"text","text":"such as the annotation’s location on the map. Annotation objects do not provide"},{"type":"text","text":" "},{"type":"text","text":"the visual representation of the annotation but typically coordinate (in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with the map view’s delegate) the creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"url":"\/documentation\/maplibre\/mlnannotation","role":"symbol","fragments":[{"text":"MLNAnnotation","kind":"identifier"}],"title":"MLNAnnotation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotation","kind":"symbol"}}}