ating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"fragments":[{"kind":"identifier","text":"anchoredToAnnotation"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation"},"doc://org.swift.MyProject/objc(pl)NSObject":{"title":"NSObject","identifier":"doc:\/\/org.swift.MyProject\/objc(pl)NSObject","type":"unresolvable"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/delegate":{"kind":"symbol","title":"delegate","url":"\/documentation\/maplibre\/mlncalloutview\/delegate","type":"topic","abstract":[{"type":"text","text":"An object conforming to the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","type":"reference"},{"type":"text","text":" method that receives"},{"type":"text","text":" "},{"type":"text","text":"messages related to the callout view’s interactive subviews."}],"fragments":[{"kind":"identifier","text":"delegate"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/delegate"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/leftAccessoryView":{"url":"\/documentation\/maplibre\/mlncalloutview\/leftaccessoryview","role":"symbol","kind":"symbol","fragments":[{"text":"leftAccessoryView","kind":"identifier"}],"title":"leftAccessoryView","abstract":[{"type":"text","text":"A view that the user may tap to perform an action. This view is conventionally"},{"type":"text","text":" "},{"type":"text","text":"positioned on the left side of the callout view."}],"identifier":"doc:\/\/org.swift