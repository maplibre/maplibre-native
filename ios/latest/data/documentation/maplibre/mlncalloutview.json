ation/MapLibre/MLNCalloutView/anchoredToAnnotation":{"title":"anchoredToAnnotation","type":"topic","fragments":[{"text":"anchoredToAnnotation","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","kind":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the callout view should be anchored to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding annotation. You can adjust the callout view’s precise location by"},{"type":"text","text":" "},{"type":"text","text":"overriding -[UIView setCenter:]. The callout view will not be anchored to the"},{"type":"text","text":" "},{"type":"text","text":"annotation if this optional property is unimplemented."}],"url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"url":"\/documentation\/maplibre\/mlncalloutviewdelegate","type":"topic","fragments":[{"text":"MLNCalloutViewDelegate","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","title":"MLNCalloutViewDelegate","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","isActive":true},{"type":"text","text":" protocol defines a set of optional methods that"},{"type":"text","text":" "},{"type":"text","text":"you can use to receive messages from an object that conforms to the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView","isActive":true},{"type":"text","text":" protocol. The callout view uses these methods to inform the"},{"type":"text","text":" "},{"type":"text","text":"delegate that the user has interacted with the the callout view."}]},"doc://org.swift.MyProject/documentation/MapLibr