ift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/anchoredToAnnotation","url":"\/documentation\/maplibre\/mlncalloutview\/anchoredtoannotation","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/dismissesAutomatically":{"fragments":[{"kind":"identifier","text":"dismissesAutomatically"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/dismissesAutomatically","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/dismissesautomatically","role":"symbol","abstract":[{"text":"A Boolean value indicating whether the callout view should be dismissed automatically","type":"text"},{"text":" ","type":"text"},{"text":"when the map view’s viewport changes. Note that a single tap on the map view","type":"text"},{"text":" ","type":"text"},{"text":"still dismisses the callout view regardless of the value of this property.","type":"text"},{"text":" ","type":"text"},{"text":"The callout view will be dismissed if this optional property is unimplemented.","type":"text"}],"title":"dismissesAutomatically","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","url":"\/documentation\/maplibre","role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/leftAccessoryView":{"title":"leftAccessoryView","url":"\/documentation\/maplibre\/mlncalloutview\/leftaccessoryview","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/leftAccessoryView","fragments":[{"text":"leftAccessoryView","kind":"identifier"}],"abstract":[{"type":"text","text":"A view that the user may tap to perform an action. This view is conventionally"},{"type":"text",