 creation of an appropriate"},{"type":"text","text":" "},{"type":"text","text":"objects to handle the display."}],"kind":"symbol","type":"topic","title":"MLNAnnotation","url":"\/documentation\/maplibre\/mlnannotation","fragments":[{"kind":"identifier","text":"MLNAnnotation"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/rightAccessoryView":{"abstract":[{"type":"text","text":"A view that the user may tap to perform an action. This view is conventionally"},{"type":"text","text":" "},{"type":"text","text":"positioned on the right side of the callout view."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/rightAccessoryView","title":"rightAccessoryView","url":"\/documentation\/maplibre\/mlncalloutview\/rightaccessoryview","role":"symbol","fragments":[{"text":"rightAccessoryView","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView":{"abstract":[{"type":"text","text":"A protocol for a "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" subclass that displays information about a selected"},{"type":"text","text":" "},{"type":"text","text":"annotation near that annotation."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView","title":"MLNCalloutView","url":"\/documentation\/maplibre\/mlncalloutview","role":"symbol","fragments":[{"kind":"identifier","text":"MLNCalloutView"}],"kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","type":"reference","isActive":true},{"text":" protocol defines a set of optional methods that","type":"text"},{"text":" ","type":"text"},{"text":"you can use to receive messages from an object that conforms to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.sw