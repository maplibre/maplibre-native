xt":"representedObject","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView\/representedObject"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutViewDelegate":{"title":"MLNCalloutViewDelegate","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutviewdelegate","type":"topic","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate","isActive":true},{"type":"text","text":" protocol defines a set of optional methods that"},{"type":"text","text":" "},{"type":"text","text":"you can use to receive messages from an object that conforms to the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutView","isActive":true},{"type":"text","text":" protocol. The callout view uses these methods to inform the"},{"type":"text","text":" "},{"type":"text","text":"delegate that the user has interacted with the the callout view."}],"fragments":[{"kind":"identifier","text":"MLNCalloutViewDelegate"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCalloutViewDelegate"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCalloutView/presentCalloutFromRect:inView:constrainedToRect:animated:":{"title":"presentCalloutFromRect:inView:constrainedToRect:animated:","kind":"symbol","url":"\/documentation\/maplibre\/mlncalloutview\/presentcalloutfromrect:inview:constrainedtorect:animated:","type":"topic","abstract":[{"type":"text","text":"Presents a callout view by adding it to "},{"code":"view","type":"codeVoice"},{"type":"text","text":" and pointing at the given rect"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"view","type":"codeVoice"},{"type":"text","text":"’s bounds. Constrains the callout to the rect in the space of "},{"code":"view","type":"codeVoice"},{"type":"text","text":"."}