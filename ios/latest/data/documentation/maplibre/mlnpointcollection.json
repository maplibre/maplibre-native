entation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":"’s point collections collectively using an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":" object. To access a point"},{"type":"text","text":" "},{"type":"text","text":"collection’s attributes, use an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollectionFeature","isActive":true},{"type":"text","text":" object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You cannot add an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection","isActive":true},{"type":"text","text":" object directly to a map view as an"},{"type":"text","text":" "},{"type":"text","text":"annotation. However, you can create individual "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation","isActive":true},{"type":"text","text":" objects"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"type":"codeVoice","code":"coordinates"},{"type":"text","text":" array and add those annotation objects to the map view"},{"type":"text","text":" "},{"type":"text","text":"using the "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/addAnnotations:","isActive":true},{"type":"text","text":" method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A point collection is known as a"},{"type":"text","text":" "},{"type":"text","text":"MultiPoint"},{"type":"text","text":" "},{"type":"text","text":"geometry in GeoJSON. Do not confuse "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/docum