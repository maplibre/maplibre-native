t","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"title":"MLNShapeSource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer","title":"MLNFillStyleLayer","fragments":[{"text":"MLNFillStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled (and"},{"type":"text","text":" "},{"type":"text","text":"optionally stroked) polygons on the map."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleTranslationTransition":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleTranslationTransition","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circletranslationtransition","title":"circleTranslationTransition","fragments":[{"text":"circleTranslationTransition","kind":"identifier"}],"abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"circleTranslation"},{"type":"text","text":" property."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","title":"MLNBackgroundStyleLayer","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" objects."}],"type":"topic"}}}