llStyleLayer":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","type":"topic","url":"\/documentation\/maplibre\/mlnfillstylelayer","abstract":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","type":"reference"},{"type":"text","text":" is a style layer that renders one or more filled (and"},{"type":"text","text":" "},{"type":"text","text":"optionally stroked) polygons on the map."}],"title":"MLNFillStyleLayer","fragments":[{"kind":"identifier","text":"MLNFillStyleLayer"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleColor":{"type":"topic","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circlecolor","title":"circleColor","kind":"symbol","abstract":[{"type":"text","text":"The fill color of the circle."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleColor","fragments":[{"kind":"identifier","text":"circleColor"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNHillshadeStyleLayer":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer","type":"topic","url":"\/documentation\/maplibre\/mlnhillshadestylelayer","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer"},{"type":"text","text":" is a style layer that renders raster "},{"type":"text","text":"digital elevation"},{"type":"text","text":" "},{"type":"text","text":"model"},{"type":"text","text":" (DEM) tiles on the map."}],"title":"MLNHillshadeStyleLayer","fragments":[{"text":"MLNHillshadeStyleLayer","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"topic","url":"\/documentation\/maplibre\/mlnshapesource","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"code":"shape","type":"codeVoice"},{"type":"text","text":" or "},{"code":"URL","type":"codeVoice"},{"type":"text","text":" property."}],"title":"MLNShapeSource","fragments":[{"text":"MLNShapeSource","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleBlur":{"type":"topic","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circleblur","title":"circleBlur","kind":"symbol","abstract":[{"text":"Amount to blur the circle. 1 blurs the circle such that only the centerpoint is","type":"text"},{"text":" ","type":"text"},{"text":"full opacity.","type":"text"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleBlur","fragments":[{"text":"circleBlur","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","type":"topic","title":"MLNBackgroundStyleLayer","kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" objects."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}]}}}