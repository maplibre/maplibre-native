":[{"text":"MLNCircleStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},{"text":" is a style layer that renders one or more filled","type":"text"},{"text":" ","type":"text"},{"text":"circles on the map.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleStrokeColor":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleStrokeColor","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circlestrokecolor","title":"circleStrokeColor","fragments":[{"text":"circleStrokeColor","kind":"identifier"}],"abstract":[{"type":"text","text":"The stroke color of the circle."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"role":"symbol","url":"\/documentation\/maplibre\/mlnsymbolstylelayer","fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"title":"MLNSymbolStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleRadius":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleRadius","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circleradius","title":"circleRadius","fragme