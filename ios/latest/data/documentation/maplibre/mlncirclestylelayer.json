e class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","fragments":[{"kind":"identifier","text":"MLNSource"}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnsource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/initWithIdentifier:source:":{"abstract":[{"type":"text","text":"Returns a circle style layer initialized with an identifier and source."}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlncirclestylelayer\/initwithidentifier:source:","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:source:","kind":"identifier"}],"title":"initWithIdentifier:source:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/initWithIdentifier:source:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"title":"MLNSymbolStyleLayer","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnsymbolstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"title":"MLNCircleStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"MLNCircleStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlncirclestylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layers":{"title":"layers","type":"topic","abstract":[{"type":"text","text":"The layers included in the style, arranged according to their back-to-front"},{"type":"text","text":" "},{"type":"text","text":"ordering on the screen."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layers","fragments":[{"text":"layers","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/layers"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true,"type":"reference"},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object along with an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"code":"shape","type":"codeVoice"},{"type":"text","text":" or "},{"code":"URL","type":"codeVoice"},{"type":"text","text":" property."}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnshapesource","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNShapeSource"}],"title":"MLNShapeSource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circlePitchAlignment":{"title":"circlePitchAlignment","type":"topic","abstract":[{"type":"text","text":"Orientation of circle when map is pitched."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circlePitchAlignment","fragments":[{"text":"circlePitchAlignment","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circlepitchalignment"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleStrokeWidth":{"fragments":[{"kind":"identifier","text":"circleStrokeWidth"}],"title":"circleStrokeWidth","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleStrokeWidth","abstract":[{"type":"text","text":"The width of the circle’s stroke. Strokes are placed outside of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"circleRadius"},{"type":"text","text":"."}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circlestrokewidth","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleTranslation":{"title":"circleTranslation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleTranslation","abstract":[{"text":"The geometry’s offset.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"identifier","text":"circleTranslation"}],"url":"\/documentation\/maplibre\/mlncirclestylelayer\/circletranslation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer":{"title":"MLNFillStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer"},{"type":"text","text":" is a style layer that renders one or more filled (and"},{"type":"text","text":" "},{"type":"text","text":"optionally stroked) polygons on the map."}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"MLNFillStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnfillstylelayer"}}}