 layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" objects."}],"title":"MLNBackgroundStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","fragments":[{"kind":"identifier","text":"MLNBackgroundStyleLayer"}],"url":"\/documentation\/maplibre\/mlnbackgroundstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleStrokeOpacityTransition":{"title":"circleStrokeOpacityTransition","kind":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circlestrokeopacitytransition","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleStrokeOpacityTransition","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"circleStrokeOpacity"},{"type":"text","text":" property."}],"role":"symbol","fragments":[{"kind":"identifier","text":"circleStrokeOpacityTransition"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnshapesource","fragments":[{"text":"MLNShapeSource","kind":"identifier"}],"title":"MLNShapeSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer/circleTranslation":{"title":"circleTranslation","kind":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer\/circletranslation","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer\/circleTranslation","abstract":[{"type":"text","text":"The geometry’s offset."}],"role":"symbol","fragments":[{"kind":"identifier","text":"circleTranslation"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyl