{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"readonly"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSArray<MLNPolygon *>","preciseIdentifier":"c:Q$objc(cs)NSArray"},{"kind":"text","text":" * "},{"kind":"identifier","text":"interiorPolygons"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The area occupied by any interior polygons is excluded from the overall shape.","type":"text"},{"text":" ","type":"text"},{"text":"Interior polygons should not overlap. An interior polygon should not have","type":"text"},{"text":" ","type":"text"},{"text":"interior polygons of its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If there are no interior polygons, the value of this property is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"interiorPolygons","kind":"identifier"}],"symbolKind":"property","roleHeading":"Instance Property","title":"interiorPolygons","externalID":"c:objc(cs)MLNPolygon(py)interiorPolygons","role":"symbol","fragments":[{"kind":"identifier","text":"interiorPolygons"}],"modules":[{"name":"MapLibre"}]},"kind":"symbol","abstract":[{"type":"text","text":"The array of polygons nested inside the receiver."}],"variants":[{"paths":["\/documentation\/maplibre\/mlnpolygon\/interiorpolygons"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolygon"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/org.swift.MyPr