:"MLNShape","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer/predicate":{"kind":"symbol","fragments":[{"text":"predicate","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer\/predicate","abstract":[{"text":"The style layer’s predicate.","type":"text"}],"url":"\/documentation\/maplibre\/mlnvectorstylelayer\/predicate","role":"symbol","type":"topic","title":"predicate"}}}