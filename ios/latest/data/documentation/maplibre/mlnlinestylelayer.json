oom levels."}],"url":"\/documentation\/maplibre\/mlnlinestylelayer\/linedashpattern","kind":"symbol","role":"symbol","fragments":[{"text":"lineDashPattern","kind":"identifier"}],"type":"topic","title":"lineDashPattern"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/addLayer:":{"kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnstyle\/addlayer:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addLayer:"}],"abstract":[{"type":"text","text":"Adds a new layer on top of existing layers."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/addLayer:","title":"addLayer:","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineOpacityTransition":{"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnlinestylelayer\/lineopacitytransition","fragments":[{"text":"lineOpacityTransition","kind":"identifier"}],"abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"lineOpacity"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineOpacityTransition","title":"lineOpacityTransition","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineOffset":{"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnlinestylelayer\/lineoffset","fragments":[{"text":"lineOffset","kind":"identifier"}],"abstract":[{"type":"text","text":"The line’s offset. For linear features, a positive value offsets the line to"},{"type":"text","text":" "},{"type":"text","text":"the right, relative to the direction of the line, and a negative value to the"},{"type":"text","text":" "},{"type":"text","text":"left. For polygon features, a positive value results in an inset, and a"},{"type":"text","text":" "},{"type":"text","text":"negative value results in an outset."}],"identifier":"doc:\/\/org.swift.MyProject\/doc