/MLNSource"},{"text":" is an abstract base class for map content sources. A map content","type":"text"},{"text":" ","type":"text"},{"text":"source supplies content to be shown on the map. A source is added to an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" object along with an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" object. The","type":"text"},{"text":" ","type":"text"},{"text":"foreground style layer defines the appearance of any content supplied by the","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"role":"symbol","url":"\/documentation\/maplibre\/mlnsource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"title":"MLNBackgroundStyleLayer","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","abstract":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"text":" is a style layer that covers the entire map. Use","type":"text"},{"text":" ","type":"text"},{"text":"a background style layer to configure a color or pattern to show below all","type":"text"},{"text":" ","type":"text"},{"text":"other map content. If the style’s other layers use the Mapbox Streets source,","type":"text"},{"text":" ","type":"text"},{"text":"the background style layer is responsible for drawing land, whereas the oceans","type":"text"},{"text":" ","type":"text"},{"text":"and other bodies of water are drawn by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"text":" objects.