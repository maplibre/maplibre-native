ence for ","type":"text"},{"code":"lineTranslation","type":"codeVoice"},{"text":".","type":"text"}],"title":"lineTranslationAnchor","kind":"symbol","fragments":[{"text":"lineTranslationAnchor","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","role":"article","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","type":"topic","title":"Using GeoJSON with a line style layer","abstract":[{"text":"Adding an ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"text":" to the map using a GeoJSON file.","type":"text"}],"kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer","fragments":[{"text":"MLNFillExtrusionStyleLayer","kind":"identifier"}],"type":"topic","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer","isActive":true,"type":"reference"},{"text":" is a style layer that renders one or more 3D","type":"text"},{"text":" ","type":"text"},{"text":"extruded polygons on the map.","type":"text"}],"role":"symbol","title":"MLNFillExtrusionStyleLayer","url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnvectorstylelayer","type":"topic","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer"},{"type":"text","text":" is an abstract superclass for style layers whose content