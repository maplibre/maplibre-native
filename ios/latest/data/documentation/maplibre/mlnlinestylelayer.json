MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object along with an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object. The vector style","type":"text"},{"text":" ","type":"text"},{"text":"layer defines the appearance of any content supplied by the shape source. You","type":"text"},{"text":" ","type":"text"},{"text":"can update a shape source by setting its ","type":"text"},{"code":"shape","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":" property.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layers":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/layers","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layers","title":"layers","fragments":[{"text":"layers","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The layers included in the style, arranged according to their back-to-front"},{"type":"text","text":" "},{"type":"text","text":"ordering on the screen."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineRoundLimit":{"fragments":[{"text":"lineRoundLimit","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineRoundLimit","title":"lineRoundLimit","abstract":[{"text":"Used to automatically convert round joins to miter joins for shallow angles.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnlinestylelayer\/lineroundlimit","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","title":"MLNBackgroundStyleLayer","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identif