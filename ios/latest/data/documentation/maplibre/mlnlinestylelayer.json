","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer":{"title":"MLNLineStyleLayer","url":"\/documentation\/maplibre\/mlnlinestylelayer","fragments":[{"text":"MLNLineStyleLayer","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"type":"text","text":" is a style layer that renders one or more stroked"},{"type":"text","text":" "},{"type":"text","text":"polylines on the map."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineColorTransition":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnlinestylelayer\/linecolortransition","fragments":[{"kind":"identifier","text":"lineColorTransition"}],"title":"lineColorTransition","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"lineColor"},{"type":"text","text":" property."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineColorTransition","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layerWithIdentifier:":{"title":"layerWithIdentifier:","url":"\/documentation\/maplibre\/mlnstyle\/layerwithidentifier:","fragments":[{"text":"- ","kind":"text"},{"text":"layerWithIdentifier:","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns a style layer with the given identifier in the current style."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layerWithIdentifier:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","fragments":[{"kind":"identifier","text":"MLNBackgroundStyleLayer"}],"title":"MLNBackgroundStyleLayer","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"reference","isActive":true},{"text":" is a style layer that covers the entire map. Use","type":"text"},{"text":" ","type":"text"},{"text":"a background style layer to configure a color or pattern to show below all","type":"text"},{"text":" ","type":"text"},{"text":"other map content. If the style’s other layers use the Mapbox Streets source,","type":"text"},{"text":" ","type":"text"},{"text":"the background style layer is responsible for drawing land, whereas the oceans","type":"text"},{"text":" ","type":"text"},{"text":"and other bodies of water are drawn by ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"reference","isActive":true},{"text":" objects.","type":"text"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNHillshadeStyleLayer":{"title":"MLNHillshadeStyleLayer","url":"\/documentation\/maplibre\/mlnhillshadestylelayer","fragments":[{"text":"MLNHillshadeStyleLayer","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer","type":"reference"},{"type":"text","text":" is a style layer that renders raster "},{"type":"text","text":"digital elevation"},{"type":"text","text":" "},{"type":"text","text":"model"},{"type":"text","text":" (DEM) tiles on the map."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeS