.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"reference","isActive":true},{"type":"text","text":" objects."}],"role":"symbol","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","kind":"symbol","title":"MLNBackgroundStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineWidth":{"title":"lineWidth","fragments":[{"kind":"identifier","text":"lineWidth"}],"kind":"symbol","abstract":[{"type":"text","text":"Stroke thickness."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineWidth","type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnlinestylelayer\/linewidth"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"title":"MLNSource","fragments":[{"text":"MLNSource","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"text":"foreground style layer defines the appearance of any content supplied by the","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnsource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLay