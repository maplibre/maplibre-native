ject/documentation/MapLibre/MLNLineStyleLayer/lineCap":{"type":"topic","abstract":[{"type":"text","text":"The display of line endings."}],"url":"\/documentation\/maplibre\/mlnlinestylelayer\/linecap","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineCap","kind":"symbol","title":"lineCap","fragments":[{"kind":"identifier","text":"lineCap"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineDashPattern":{"title":"lineDashPattern","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Specifies the lengths of the alternating dashes and gaps that form the dash"},{"type":"text","text":" "},{"type":"text","text":"pattern. The lengths are later scaled by the line width. To convert a dash"},{"type":"text","text":" "},{"type":"text","text":"length to points, multiply the length by the current line width. Note that"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON sources with "},{"type":"codeVoice","code":"lineMetrics: true"},{"type":"text","text":" specified won’t render dashed lines to"},{"type":"text","text":" "},{"type":"text","text":"the expected scale. Also note that zoom-dependent expressions will be evaluated"},{"type":"text","text":" "},{"type":"text","text":"only at integer zoom levels."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineDashPattern","kind":"symbol","fragments":[{"kind":"identifier","text":"lineDashPattern"}],"url":"\/documentation\/maplibre\/mlnlinestylelayer\/linedashpattern"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"type":"topic","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"type":"reference","identifier":"do