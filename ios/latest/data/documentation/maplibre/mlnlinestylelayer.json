":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" objects."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","title":"MLNBackgroundStyleLayer","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/addLayer:":{"type":"topic","abstract":[{"type":"text","text":"Adds a new layer on top of existing layers."}],"url":"\/documentation\/maplibre\/mlnstyle\/addlayer:","kind":"symbol","role":"symbol","title":"addLayer:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/addLayer:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addLayer:"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineRoundLimit":{"type":"topic","abstract":[{"type":"text","text":"Used to automatically convert round joins to miter joins for shallow angles."}],"url":"\/documentation\/maplibre\/mlnlinestylelayer\/lineroundlimit","kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineRoundLimit","title":"lineRoundLimit","fragments":[{"kind":"identifier","text":"lineRoundLimit"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineCap":{"role":"symbol","fragments":[{"kind":"identifier","text":"lineCap"}],"abstract":[{"type":"text","text":"The display of line endings."}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineCap","url":"\/documentation\/maplibre\/mlnlinestylelayer\/linecap","title":"lineCap","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"title":"MLNShapeSource","role":"symbol","type":"topic","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" is a map content source that supplies vector shapes to be"},{"type":"text","text":" "},{"type":"text","text":"shown on the map. The shapes may be instances of "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or they may be defined by local or external"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON"},{"type":"text","text":" code. A shape source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"url":"\/documentation\/maplibre\/mlnshapesource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","fragments":[{"kind":"identifier","text":"MLNShapeSource"}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineColor":{"role":"symbol","fragments":[{"text":"lineColor","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The color with which the line will be drawn."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineColor","url":"\/documentation\/maplibre\/mlnlinestylelayer\/linecolor","title":"lineColor","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineDashPattern":{"fragments":[{"text":"lineDashPattern","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnlinestylelayer\/linedashpattern","kind":"symbol","title":"lineDashPattern","role":"symbol","abstract":[{"type":"text","text":"Specifies the lengths of the alternating dashes and gaps that form the dash"},{"type":"text","text":" "},{"type":"text","text":"pattern. The lengths are later scaled by the line width. To convert a dash"},{"type":"text","text":" "},{"type":"text","text":"length to points, multiply the length by the current line width. Note that"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON sources with "},{"type":"codeVoice","code":"lineMetrics: true"},{"type":"text","text":" specified won’t render dashed lines to"},{"type":"text","text":" "},{"type":"text","text":"the expected scale. Also note that zoom-dependent expressions will be evaluated"},{"type":"text","text":" "},{"type":"text","text":"only at integer zoom levels."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer\/lineDashPattern"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer/lineWidth":{"role":"symbol","title":"lineWidth","abstract":[{"type":"text","text":"Stroke thickness."}],"url":"\/documentation\/maplibre\/mlnlinestylelay