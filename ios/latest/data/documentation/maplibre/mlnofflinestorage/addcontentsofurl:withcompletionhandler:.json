ent":[{"inlineContent":[{"text":"The completion handler to call once the contents of the given","type":"text"},{"text":" ","type":"text"},{"text":"file has been added to offline storage. This handler is executed","type":"text"},{"text":" ","type":"text"},{"text":"asynchronously on the main queue.","type":"text"}],"type":"paragraph"}],"name":"completion"}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample"]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The file must be a valid offline pack database bundled with the application or"},{"type":"text","text":" "},{"type":"text","text":"downloaded separately."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting packs are added or updated to the shared offline storage object’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" property, then the "},{"type":"codeVoice","code":"completion"},{"type":"text","text":" block is executed."}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addContentsOfURL:withCompletionHandler:","interfaceLanguage":"occ"},"abstract":[{"text":"Adds the offline packs located at the given URL to offline storage.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addcontentsofurl:withcompletionhandler:"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/OfflinePackExample":{"abstract":[{"text":"Download a region as an offline pack","type":"text"}],"role":"article","kind":"article","title":"Download Offline Pack","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample","type":"topic","url":"\/documentation\/maplibre-native-for