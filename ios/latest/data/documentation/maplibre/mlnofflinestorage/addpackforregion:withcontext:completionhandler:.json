’s "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"type":"text","text":" change."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addpackforregion:withcontext:completionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"roleHeading":"Instance Method","title":"addPackForRegion:withContext:completionHandler:","symbolKind":"method","role":"symbol","modules":[{"name":"MapLibre"}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addPackForRegion:withContext:completionHandler:"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)addPackForRegion:withContext:completionHandler:"},"abstract":[{"type":"text","text":"Creates and registers an offline pack that downloads the resources needed to"},{"type":"text","text":" "},{"type":"text","text":"use the given region offline."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack":{"fragments":[{"text":"MLNOfflinePack","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"},{"text":" represents a collection of resources necessary for viewing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a region offline to a local database."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepack","role":"symbol","title":"MLNOfflinePack","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateInactive":{"fragments":[{"kind":"identifier","text":"ML