ray result in an ","type":"text"},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"text":" change.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addpackforregion:withcontext:completionhandler:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addPackForRegion:withContext:completionHandler:"},"metadata":{"fragments":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)addPackForRegion:withContext:completionHandler:","title":"addPackForRegion:withContext:completionHandler:","role":"symbol","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"symbolKind":"method","roleHeading":"Instance Method"},"abstract":[{"type":"text","text":"Creates and registers an offline pack that downloads the resources needed to"},{"type":"text","text":" "},{"type":"text","text":"use the given region offline."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"url":"\/documentation\/maplibre","title":"MapLibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","role":"collection","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/resume":{"type":"topic","url":"\/documentation\/maplibre\/mlnofflinepack\/resume","role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"title":"resume","fragments":[{"text":"- ","kind":"text"},{"text":"resume","kind":"identifier"}]},"doc: