letion handler to call once the pack has been added."},{"type":"text","text":" "},{"type":"text","text":"This handler is executed asynchronously on the main queue."}],"type":"paragraph"}]}]},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The resulting pack is added to the shared offline storage object’s ","type":"text"},{"code":"packs","type":"codeVoice"},{"type":"text","text":" "},{"text":"property, then the ","type":"text"},{"code":"completion","type":"codeVoice"},{"text":" block is executed with that pack passed in.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pack has an initial state of "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive","type":"reference","isActive":true},{"type":"text","text":". To begin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","type":"reference","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"text":" ","type":"text"},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"text":" ","type":"text"},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"type":"text","text":" change."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addpackforregion:withcontext:completionhandler:"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addPackForRegion:withContext:completionHandler:","interfaceLanguage":"occ"},"metadata":{"role":"symbol","externalID":"c:objc(cs)MLNOfflineStorage(im)addPackForRegion:withContext:completionHandler:","symbolKind":"method","title":"addPackForRegion:withContext:completionHandler:","fragments":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addPackForRegion:withContext:completionHandler:"}]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/OfflinePackExample":{"role":"article","abstract":[{"text":"Download a region as an offline pack","type":"text"}],"url":"\/documentation\/maplibre-native-for-ios\/offlinepackexample","title":"Download Offline Pack","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample","type":"topic","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"role":"article","abstract":[{"text":"Query, delete and download offline regions","type":"text"}],"url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample","title":"Manage Offline Regions","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineR