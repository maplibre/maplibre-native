ronously on the main queue."}]}]}]},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample"],"kind":"mentions"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The resulting pack is added to the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" "},{"type":"text","text":"property, then the "},{"type":"codeVoice","code":"completion"},{"type":"text","text":" block is executed with that pack passed in."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pack has an initial state of "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive","isActive":true,"type":"reference"},{"type":"text","text":". To begin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","isActive":true,"type":"reference"},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true,"type":"reference"},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","c