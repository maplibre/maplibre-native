{"abstract":[{"type":"text","text":"Creates and registers an offline pack that downloads the resources needed to"},{"type":"text","text":" "},{"type":"text","text":"use the given region offline."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"addPackForRegion:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id<MLNOfflineRegion>","kind":"typeIdentifier","preciseIdentifier":"c:Qoobjc(pl)MLNOfflineRegion"},{"text":") ","kind":"text"},{"text":"region","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"withContext:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSData","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSData"},{"text":" *) ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"completionHandler:","kind":"identifier"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackAdditionCompletionHandler","text":"MLNOfflinePackAdditionCompletionHandler","kind":"typeIdentifier","preciseIdentifier":"c:MLNOfflineStorage.h@T@MLNOfflinePackAdditionCompletionHandler"},{"text":") ","kind":"text"},{"text":"completion","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A region to download."}],"type":"paragraph"}],"name":"region"},{"content":[{"inlineContent":[{"type":"text","text":"Arbitrary data to store alongside the downloaded resources."}],"type":"paragraph"}],"name":"context"},{"content":[{"inlineContent":[{"type":"text","text":"The completion handler to call once the pack has been added."},{"type":"text","text":" "},{"type":"text","text":"This handler is executed asynchronously on the main queue."}],"type":"paragraph"}],"name":"completion"}],"