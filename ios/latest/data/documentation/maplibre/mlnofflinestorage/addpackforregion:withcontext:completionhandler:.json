MapLibre\/MLNOfflinePack\/resume","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"type":"text","text":" change."}],"type":"paragraph"}]}],"abstract":[{"text":"Creates and registers an offline pack that downloads the resources needed to","type":"text"},{"text":" ","type":"text"},{"text":"use the given region offline.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"fragments":[{"kind":"identifier","text":"MLNOfflineStorage"}],"title":"MLNOfflineStorage","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage","url":"\/documentation\/maplibre\/mlnofflinestorage","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"MLNOfflineStorage implements a singleton (shared object) that manages offline"},{"type":"text","text":" "},{"type":"text","text":"packs and ambient caching. All of this class’s instance methods are asynchronous,"},{"type":"text","text":" "},{"type":"text","text":"reflecting the fact that offline resources are stored in a database. The shared"},{"type":"text","text":" "},{"type":"text","text":"object maintains a canonical collecti