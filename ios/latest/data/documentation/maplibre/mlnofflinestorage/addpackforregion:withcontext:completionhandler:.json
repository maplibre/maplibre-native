re\/MLNOfflinePack\/resume","type":"reference","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","type":"reference","isActive":true},{"type":"text","text":"s about that pack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"type":"text","text":" change."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack":{"type":"topic","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"},{"type":"text","text":" represents a collection of resources necessary for viewing"},{"type":"text","text":" "},{"type":"text","text":"a region offline to a local database."}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","role":"symbol","url":"\/documentation\/maplibre\/mlnofflinepack","title":"MLNOfflinePack","fragments":[{"kind":"identifier","text":"MLNOfflinePack"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackProgressChangedNotification":{"type":"topic","abstract":[{"type":"text","text":"