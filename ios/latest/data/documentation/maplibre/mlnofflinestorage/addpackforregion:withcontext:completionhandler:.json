"},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","type":"reference"},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"type":"text","text":" change."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Creates and registers an offline pack that downloads the resources needed to"},{"type":"text","text":" "},{"type":"text","text":"use the given region offline."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackAdditionCompletionHandler":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackAdditionCompletionHandler","type":"topic","fragments":[{"kind":"identifier","text":"MLNOfflinePackAdditionCompletionHandler"}],"role":"symbol","abstract":[{"text":"A block to be called once an offline pack has been completely created and","type":"text"},{"text":" ","type":"text"},{"text":"added.","type":"text"}],"title":"MLNOfflinePackAdditionCompletionHandler","url":"\/documentation\/maplibre\/mlnofflinepackadditioncompletionhandler","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOf