ePackProgressChangedNotification","type":"reference"},{"text":"s about that pack.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To detect when any call to this method results in a new pack, observe KVO","type":"text"},{"text":" ","type":"text"},{"text":"change notifications on the shared offline storage object’s ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" key path.","type":"text"},{"text":" ","type":"text"},{"text":"Additions to that array result in an ","type":"text"},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"text":" change.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)addPackForRegion:withContext:completionHandler:","role":"symbol","title":"addPackForRegion:withContext:completionHandler:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"addPackForRegion:withContext:completionHandler:","kind":"identifier"}]},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackAdditionCompletionHandler":{"abstract":[{"text":"A block to be called once an offline pack has been completely created and","type":"text"},{"text":" ","type":"text"},{"text":"added.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackAdditionCompletionHandler","kind":"symbol","fragments":[{"text":"MLNOfflinePackAdditionCompletionHandler","kind":"identifier"}],"role":"symbol","title":"MLNOfflinePackAdditionCompletionHandler","type":"topic","url":"\/documentation\/maplibre\/mlnofflinepackadditioncompletionhandler"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack":{"abstract":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/Map