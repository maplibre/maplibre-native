ue},{"type":"text","text":". To begin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification"},{"type":"text","text":"s about that pack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"type":"text","text":" change."}]}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateInactive":{"kind":"symbol","abstract":[{"type":"text","text":"The pack is incomplete and is not currently downloading."}],"url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateinactive","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive","title":"MLNOfflinePackStateInactive","fragments":[{"kind":"identifier","text":"MLNOfflinePackStateInactive"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/resume":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","type":"topic","abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"url":"\/documentation\/maplibre\/mlnofflinepack\/resume","role":"symbol","title":"resume","fragments":[{"text":"- ","kind":"text"},{"text":"resume","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/OfflinePackExample":{"abstract":[{"type":"text","text":"Download a region as an offline pack"}],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/offlinepackexample","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/OfflinePackExample","title":"Download Offline Pack","role":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"abstract":[{"type":"text","text":"Query, delete and download offline regions"}],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","title":"Manage Offline Regions","role":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"kind":"symbol","abstract":[{"type":"text","text":"MLNOfflineStorage implements a singleton (shared object) that manages offline"},{"type":"text","text":" "},{"type":"text","text":"packs and ambient caching. All of this class’s instance methods are asynchronous,"},{"type":"text","text":" "},{"type":"text","text":"reflecting the fact that offline resources are stored in a database. The shared"},{"type":"text","text":" "},{"type":"text","text":"object maintains a canonical collection of offline packs in its "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" property."}],"url":"\/documentation\/maplibre\/mlnofflinestorage","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage","title":"MLNOfflineStorage","fragments":[{"kind":"identifier","text":"MLNOfflineStorage"}],"role":"symbol"},"doc://org.swift.MyProje