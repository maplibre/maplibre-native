ePackStateInactive"},{"type":"text","text":". To begin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume"},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"text":"the completion handler. To monitor download progress, add an observer for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true,"type":"reference"},{"text":"s about that pack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To detect when any call to this method results in a new pack, observe KVO","type":"text"},{"text":" ","type":"text"},{"text":"change notifications on the shared offline storage object’s ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" key path.","type":"text"},{"text":" ","type":"text"},{"text":"Additions to that array result in an ","type":"text"},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"text":" change.","type":"text"}]}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample","abstract":[{"type":"text","text":"Query, delete and download offline regions"}],"kind":"article","role":"article","type":"topic","title":"Manage Offline Regions","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackProgressChangedNotification":{"url":"\/documentation\/maplibre\/mlnofflinepackprogresschangednotification","kind":"symbol","type":"topic","title":"MLNOfflinePackProgressChangedNotification","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","a