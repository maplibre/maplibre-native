re-Native-for-iOS\/OfflinePackExample"],"kind":"mentions"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The resulting pack is added to the shared offline storage object’s ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property, then the ","type":"text"},{"code":"completion","type":"codeVoice"},{"text":" block is executed with that pack passed in.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pack has an initial state of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive"},{"text":". To begin","type":"text"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"type":"codeVoice","code":"NSKeyValueChangeInsertion"},{"type":"text","text":" change."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\