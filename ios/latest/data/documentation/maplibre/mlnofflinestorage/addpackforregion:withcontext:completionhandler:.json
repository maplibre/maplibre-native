egin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","type":"reference"},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","type":"reference"},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"type":"text","text":" change."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","url":"\/documentation\/maplibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/resume":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"resume"}],"url":"\/documentation\/maplibre\/mlnofflinepack\/resume","role":"symbol","kind":"symbol","title":"resume","abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","type":"topic"},"doc: