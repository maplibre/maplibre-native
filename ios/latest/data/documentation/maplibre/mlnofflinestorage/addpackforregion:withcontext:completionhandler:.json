ibre-Native-for-iOS\/OfflinePackExample"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The resulting pack is added to the shared offline storage object’s ","type":"text"},{"type":"codeVoice","code":"packs"},{"text":" ","type":"text"},{"text":"property, then the ","type":"text"},{"type":"codeVoice","code":"completion"},{"text":" block is executed with that pack passed in.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The pack has an initial state of ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive","isActive":true,"type":"reference"},{"type":"text","text":". To begin"},{"type":"text","text":" "},{"type":"text","text":"downloading resources, call "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"type":"text","text":"s about that pack."}],"type":"paragraph"},{"inlineContent":[{"text":"To detect when any call to this method results in a new pack, observe KVO","type":"text"},{"text":" ","type":"text"},{"text":"change notifications on the shared offline storage object’s ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" key path.","type":"text"},{"text":" ","type":"text"},{"text":"Additions to that array result in an ","type":"text"},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"text":" change.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\