MapLibre\/MLNOfflinePack\/resume","type":"reference","isActive":true},{"type":"text","text":" on the pack from within"},{"type":"text","text":" "},{"type":"text","text":"the completion handler. To monitor download progress, add an observer for"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","type":"reference","isActive":true},{"type":"text","text":"s about that pack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To detect when any call to this method results in a new pack, observe KVO"},{"type":"text","text":" "},{"type":"text","text":"change notifications on the shared offline storage object’s "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"Additions to that array result in an "},{"code":"NSKeyValueChangeInsertion","type":"codeVoice"},{"type":"text","text":" change."}]}]}],"abstract":[{"type":"text","text":"Creates and registers an offline pack that downloads the resources needed to"},{"type":"text","text":" "},{"type":"text","text":"use the given region offline."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateInactive":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateinactive","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateInactive","title":"MLNOfflinePackStateInactive","type":"topic","fragments":[{"text":"MLNOfflinePackStateInactive","kind":"identifier"}],"abstract":[{"type":"text","text":"The pack is incomplete and is not currently downloading."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/resume":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepack\/resume","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","tit