,{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This method mimics the caching that would take place if the equivalent resource","type":"text"},{"text":" ","type":"text"},{"text":"were requested in the process of map rendering. Use this method to pre-warm the","type":"text"},{"text":" ","type":"text"},{"text":"cache with resources you know will be requested.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method is asynchronous; the data may not be immediately available for","type":"text"},{"text":" ","type":"text"},{"text":"in-progress requests, though subsequent requests should have access to the","type":"text"},{"text":" ","type":"text"},{"text":"cached data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To find out when the resource is ready to retrieve from the cache, use the","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:"},{"text":" ","type":"text"},{"text":"method.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"kind":"symbol","references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:":{"title":"preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:","fragments":[{"text":"- ","kind":"text"},{"text":"preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/preloadData:forURL:modificationDate: