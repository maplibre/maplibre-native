cussion"},{"inlineContent":[{"type":"text","text":"This method mimics the caching that would take place if the equivalent resource"},{"type":"text","text":" "},{"type":"text","text":"were requested in the process of map rendering. Use this method to pre-warm the"},{"type":"text","text":" "},{"type":"text","text":"cache with resources you know will be requested."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is asynchronous; the data may not be immediately available for"},{"text":" ","type":"text"},{"type":"text","text":"in-progress requests, though subsequent requests should have access to the"},{"text":" ","type":"text"},{"type":"text","text":"cached data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find out when the resource is ready to retrieve from the cache, use the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method."}]}]}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/preloaddata:forurl:modificationdate:expirationdate:etag:mustrevalidate:"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:":{"abstract":[{"text":"Inserts the provided resource into the ambient cache.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnofflinestorage\/preloaddata:forurl:modificationdate:expirationdate:etag:mustrevalidate:","type":"topic","identifie