e equivalent resource"},{"type":"text","text":" "},{"type":"text","text":"were requested in the process of map rendering. Use this method to pre-warm the"},{"type":"text","text":" "},{"type":"text","text":"cache with resources you know will be requested."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method is asynchronous; the data may not be immediately available for"},{"type":"text","text":" "},{"type":"text","text":"in-progress requests, though subsequent requests should have access to the"},{"type":"text","text":" "},{"type":"text","text":"cached data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To find out when the resource is ready to retrieve from the cache, use the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:completionHandler:","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/preloaddata:forurl:modificationdate:expirationdate:etag:mustrevalidate:"]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Inserts the provided resource into the ambient cache.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","kind":"symbol","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/preloadData:forURL:modificationDate:expirationDate:eTag:mustRevalidate:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/Map