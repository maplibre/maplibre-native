ype":"text","text":"a region offline to a local database."}],"role":"symbol","fragments":[{"kind":"identifier","text":"MLNOfflinePack"}],"type":"topic","title":"MLNOfflinePack","url":"\/documentation\/maplibre\/mlnofflinepack","kind":"symbol"}}}