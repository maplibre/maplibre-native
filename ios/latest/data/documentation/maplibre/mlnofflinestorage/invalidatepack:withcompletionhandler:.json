{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/invalidatepack:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"modules":[{"name":"MapLibre"}],"symbolKind":"method","fragments":[{"text":"- ","kind":"text"},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)invalidatePack:withCompletionHandler:","roleHeading":"Instance Method","role":"symbol","title":"invalidatePack:withCompletionHandler:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}]},"sections":[],"abstract":[{"text":"Invalidates the specified offline pack. This method checks that the tiles","type":"text"},{"type":"text","text":" "},{"text":"in the specified offline pack match those from the server. Local tiles that","type":"text"},{"type":"text","text":" "},{"text":"do not match the latest version on the server are updated.","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/invalidatePack:withCompletionHandler:","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"identifier","text":"invalidatePack:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MLNOfflinePack","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","preciseIdentifier":"c:objc(cs)MLNOfflinePack"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"pack"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withCompletionHandler:"},{"text":"(","kind":"text"},