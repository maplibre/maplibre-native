en"},{"type":"text","text":" "},{"type":"text","text":"marked for revalidation in offline storage, or an error occurs. This handler is"},{"type":"text","text":" "},{"type":"text","text":"executed asynchronously on the main queue."}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is more efficient than deleting the offline pack and downloading it"},{"type":"text","text":" "},{"type":"text","text":"again. If the data stored locally matches that on the server, new data will"},{"type":"text","text":" "},{"type":"text","text":"not be downloaded."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/invalidatePack:withCompletionHandler:"},"metadata":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}],"role":"symbol","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}],"title":"invalidatePack:withCompletionHandler:","roleHeading":"Instance Method","symbolKind":"method","externalID":"c:objc(cs)MLNOfflineStorage(im)invalidatePack:withCompletionHandler:","modules":[{"name":"MapLibre"}]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/invalidatePack:withCompletionHandler:":{"url":"\/documentation\/maplibre\/mlnofflinestorage\/invalidatepack:withcompletionhandler:","type":"topic","abstract":[{"text":"Invalidates the specified offline pack. This method checks that the tiles","type":"text"},{"text":" ","type":"text"},{"text":"in the specified offline pack match those from the server. Local tiles that","type":"text"},{"text":" ","type":"text"},{"text":"do not match the latest version on the server are updated.","type":"text"}],"role":"symbol","identifi