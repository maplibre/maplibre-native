t"},{"type":"text","text":" "},{"type":"text","text":"do not match the latest version on the server are updated."}],"fragments":[{"text":"- ","kind":"text"},{"text":"invalidatePack:withCompletionHandler:","kind":"identifier"}],"kind":"symbol"}}}