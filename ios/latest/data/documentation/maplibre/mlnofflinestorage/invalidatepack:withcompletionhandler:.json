k and downloading it","type":"text"},{"text":" ","type":"text"},{"text":"again. If the data stored locally matches that on the server, new data will","type":"text"},{"text":" ","type":"text"},{"text":"not be downloaded.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","externalID":"c:objc(cs)MLNOfflineStorage(im)invalidatePack:withCompletionHandler:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}],"symbolKind":"method","modules":[{"name":"MapLibre"}],"title":"invalidatePack:withCompletionHandler:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"invalidatePack:withCompletionHandler:","kind":"identifier"}],"roleHeading":"Instance Method"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/invalidatePack:withCompletionHandler:"},"abstract":[{"text":"Invalidates the specified offline pack. This method checks that the tiles","type":"text"},{"text":" ","type":"text"},{"text":"in the specified offline pack match those from the server. Local tiles that","type":"text"},{"text":" ","type":"text"},{"text":"do not match the latest version on the server are updated.","type":"text"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/invalidatepack:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","url":"\/documentation\/maplibre","type":"topic","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinestorage","fragments":[{"kind":"identifier","text":"MLNOfflineStorage"}],"type":"topic","role":"symbol"