to be invalidated.","type":"text"}]}]},{"name":"completion","content":[{"type":"paragraph","inlineContent":[{"text":"The completion handler to call once the pack has been","type":"text"},{"text":" ","type":"text"},{"text":"marked for revalidation in offline storage, or an error occurs. This handler is","type":"text"},{"text":" ","type":"text"},{"text":"executed asynchronously on the main queue.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is more efficient than deleting the offline pack and downloading it"},{"type":"text","text":" "},{"type":"text","text":"again. If the data stored locally matches that on the server, new data will"},{"type":"text","text":" "},{"type":"text","text":"not be downloaded."}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"invalidatePack:withCompletionHandler:","externalID":"c:objc(cs)MLNOfflineStorage(im)invalidatePack:withCompletionHandler:","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"invalidatePack:withCompletionHandler:"}],"modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"invalidatePack:withCompletionHandler:","kind":"identifier"}]},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","type":"topic","url":"\/documentation\/maplibre","role":"collection","kind":"symbol","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"abstract":[{"type":"text","text":"MLNOfflineStorage implements a singleton (shared object) that manages offline"},{"type":"text","text":" "},{"type":"text","text