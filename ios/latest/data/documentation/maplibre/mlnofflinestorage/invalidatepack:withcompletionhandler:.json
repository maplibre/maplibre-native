xt","text":" "},{"type":"text","text":"do not match the latest version on the server are updated."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/invalidatePack:withCompletionHandler:","kind":"symbol"}}}