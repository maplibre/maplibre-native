 version on the server are updated.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/invalidatePack:withCompletionHandler:","title":"invalidatePack:withCompletionHandler:","role":"symbol"}}}