he shared offline storage object has finished loading its"},{"type":"text","text":" "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" property, observe KVO change notifications on the "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" key path."},{"type":"text","text":" "},{"type":"text","text":"The initial load results in an "},{"type":"codeVoice","code":"NSKeyValueChangeSetting"},{"type":"text","text":" change."}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/packs"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"An array of all known offline packs, in the order in which they were created.","type":"text"}],"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"kind":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","title":"Manage Offline Regions","abstract":[{"type":"text","text":"Query, delete and download offline regions"}],"role":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/packs":{"title":"packs","role":"symbol","abstract":[{"text":"An array of all known offline packs, in the order in which they were created.","type":"text"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinestorage\/packs","type":"topic","fragments":[{"kind":"identifier","text":"packs"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/packs"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLN