{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"An array of all known offline packs, in the order in which they were created."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"strong"},{"kind":"text","text":", "},{"kind":"keyword","text":"readonly"},{"kind":"text","text":") "},{"preciseIdentifier":"c:Q$objc(cs)NSArray","kind":"typeIdentifier","text":"NSArray<MLNOfflinePack *>"},{"kind":"text","text":" * "},{"kind":"identifier","text":"packs"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This property is set to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", indicating that the receiver does not yet know"},{"type":"text","text":" "},{"type":"text","text":"the existing packs, for an undefined amount of time starting from the moment"},{"text":" ","type":"text"},{"type":"text","text":"the shared offline storage object is initialized until the packs are fetched"},{"type":"text","text":" "},{"type":"text","text":"from the database. After that point, this property is always non-nil, but it"},{"type":"text","text":" "},{"type":"text","text":"may be empty to indicate that no packs are present."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To detect when the shared offline storage object has finished loading its"},{"type":"text","text":" "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" property, observe KVO change notifications on the "},{"type":"codeVoice","code":"packs"},{"type":"text","text