ey path."},{"type":"text","text":" "},{"type":"text","text":"The initial load results in an "},{"type":"codeVoice","code":"NSKeyValueChangeSetting"},{"text":" change.","type":"text"}]}]}],"metadata":{"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"packs"}],"symbolKind":"property","title":"packs","navigatorTitle":[{"kind":"identifier","text":"packs"}],"modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNOfflineStorage(py)packs"},"abstract":[{"type":"text","text":"An array of all known offline packs, in the order in which they were created."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/packs"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"kind":"symbol","references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"abstract":[{"type":"text","text":"Query, delete and download offline regions"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","title":"Manage Offline Regions","role":"article","type":"topic","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/packs":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/packs","type":"topic","url":"\/documentation\/maplibre\/mlnofflinestorage\/packs","role":"symbol","fragments":[{"kind":"identifier","text":"packs"}],"abstract":[{"text":"An array of all known offline packs, in the order in which they were created.","type":"text"}],"title":"packs","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","type":"topic","url":"\/documentation\/maplibre","title":"MapLibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"role":"collection"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"title":"MLNOfflineStorage","abstract":[{"type":"text","text":"MLNOfflineStorage implements a singleton (shared object) that manages offline"},{"type":"text","text":" "},{"type":"text","text":"packs and ambient caching. All of this class’s instance methods are asynchronous,"},{"type":"text","text":" "},{"type":"text","text":"reflecting the fact that offline resources are stored in a database. The shared"},{"type":"text","text":" "},{"type":"text","text":"object maintains a canonical collection of offline packs in its "},{"type":"codeVoice","code":"packs"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage","fragments":[{"text":"MLNOfflineStorage","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnofflinestorage","kind":"symbol"}}}