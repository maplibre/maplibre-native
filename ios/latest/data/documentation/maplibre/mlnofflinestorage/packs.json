raph","inlineContent":[{"text":"To detect when the shared offline storage object has finished loading its","type":"text"},{"text":" ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" property, observe KVO change notifications on the ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" key path.","type":"text"},{"text":" ","type":"text"},{"text":"The initial load results in an ","type":"text"},{"code":"NSKeyValueChangeSetting","type":"codeVoice"},{"text":" change.","type":"text"}]}]}],"sections":[],"abstract":[{"type":"text","text":"An array of all known offline packs, in the order in which they were created."}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNOfflineStorage(py)packs","role":"symbol","title":"packs","navigatorTitle":[{"kind":"identifier","text":"packs"}],"symbolKind":"property","fragments":[{"kind":"identifier","text":"packs"}]},"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/ManageOfflineRegionsExample":{"role":"article","title":"Manage Offline Regions","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/manageofflineregionsexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample","kind":"article","abstract":[{"type":"text","text":"Query, delete and download offline regions"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/packs":{"role":"symbol","title":"packs","type":"topic","fragments":[{"text":"packs","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnofflinestorage\/packs","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/packs","kind":"symbol","abstract":[{"type":"text","text":"An array of all known offline packs, in the order in which they were created."}]},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","title":"MapLibre","type":"topic","url":"\/documentation\/maplibre","