{"sections":[],"kind":"symbol","metadata":{"externalID":"c:objc(cs)MLNOfflineStorage(py)packs","title":"packs","navigatorTitle":[{"kind":"identifier","text":"packs"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","fragments":[{"text":"packs","kind":"identifier"}],"symbolKind":"property","role":"symbol"},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/packs","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"An array of all known offline packs, in the order in which they were created."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"strong"},{"kind":"text","text":", "},{"kind":"keyword","text":"readonly"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:Q$objc(cs)NSArray","text":"NSArray<MLNOfflinePack *>"},{"kind":"text","text":" * "},{"kind":"identifier","text":"packs"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/ManageOfflineRegionsExample"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This property is set to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", indicating that the receiver does not yet know"},{"type":"text","text":" "},{"type":"text","text":"the existing packs, for an undefined amount of time starting from the moment"},{"type":"text","text":" "},{"type":"text","text":"the shared offline storage object is initialized until the