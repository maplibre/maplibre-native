:"available for the ambient cache."}]},{"type":"paragraph","inlineContent":[{"text":"This method should be called before the map and map style have been loaded.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This method is potentially expensive, as the database will trim cached data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in order to prevent the ambient cache from being larger than the"},{"type":"text","text":" "},{"type":"text","text":"specified amount."}]}]}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/setMaximumAmbientCacheSize:withCompletionHandler:","interfaceLanguage":"occ"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"setMaximumAmbientCacheSize:withCompletionHandler:","roleHeading":"Instance Method","modules":[{"name":"MapLibre"}],"fragments":[{"text":"- ","kind":"text"},{"kind":"identifier","text":"setMaximumAmbientCacheSize:withCompletionHandler:"}],"symbolKind":"method","role":"symbol","navigatorTitle":[{"kind":"text","text":"- "},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)setMaximumAmbientCacheSize:withCompletionHandler:"},"abstract":[{"text":"Sets the maximum ambient cache size in bytes. The default maximum cache","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":". Setting the maximum ambient cache size does not impact the maximum size","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of offline packs."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLib