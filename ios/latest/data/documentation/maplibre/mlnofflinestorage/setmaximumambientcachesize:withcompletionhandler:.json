{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Sets the maximum ambient cache size in bytes. The default maximum cache","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"0"},{"type":"text","text":". Setting the maximum ambient cache size does not impact the maximum size"},{"type":"text","text":" "},{"type":"text","text":"of offline packs."}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/setMaximumAmbientCacheSize:withCompletionHandler:","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"MapLibre"}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:withCompletionHandler:"}],"externalID":"c:objc(cs)MLNOfflineStorage(im)setMaximumAmbientCacheSize:withCompletionHandler:","symbolKind":"method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}],"role":"symbol","title":"setMaximumAmbientCacheSize:withCompletionHandler:"},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"- ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@T@NSUInteger","kind":"typeIdentifier","text":"NSUInteger"},{"kind":"text","text":") "},{"kind":"internalParam","text":"cacheSize"},{"kind":"text","text":" "},{"kind":"identifier","text":"withCompletionHandler:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":" (^)("},{"preciseIdentifier":"c:objc(cs)NSError","kind":"typeIdentifier","text":"NSError"},{"kind":"text","text":" *"},{"kind":"internalParam","text":"error"},{"kind":"text","text":")) "},{"kind":"internalParam","text":"completion"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"parameters":[{"name":"cacheSize","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The maximum size in bytes for the ambient cache."}]}]},{"name":"completion","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The completion handler to call once the maximum ambient cache"},{"type":"text","text":" "},{"type":"text","text":"size has been set. This handler is executed synchronously on the main queue."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"This method does not limit the space available to offline packs, and data in","type":"text"},{"type":"text","text":" "},{"text":"offline packs does not count towards this limit. If you set the maximum ambient","type":"text"},{"text":" ","type":"text"},{"text":"cache size to 30 MB then download 20 MB of offline packs, 30 MB will remain","type":"text"},{"text":" ","type":"text"},{"text":"available for the ambient cache.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method should be called before the map and map style have been loaded."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method is potentially expensive, as the database will trim cached data"},{"type":"text","text":" "},{"type":"text","text":"in order to prevent the ambient cache from being larger than the"},{"type":"text","text":" "},{"type":"text","text":"specified amount."}],"type":"paragraph"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"role":"collection","title":"MapLibre","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/setMaximumAmbientCacheSize:withCompletionHandler:":{"abstract":[{"text":"Sets the maximum ambient cache size in bytes. The default maximum cache","type":"text"},{"text":" ","type":"text"},{"text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":". Setting the maximum ambient cache size does not impact the maximum size","type":"text"},{"text":" ","type":"text"},{"text":"of offline packs.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/setMaximumAmbientCacheSize:withCompletionHandler:","url":"\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:","fragments":[{"text":"- ","kind":"text"},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","title":"setMaximumAmbientCacheSize:withCompletionHandler:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"title":"MLNOfflineStorage","role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinestorage","abstract":[{"text":"MLNOfflineStorage implements a singleton (shared object) that manages offline","type":"text"},{"text":" ","type":"text"},{"text":"packs and ambient caching. All of this class’s instance methods are asynchronous,","type":"text"},{"text":" ","type":"text"},{"text":"reflecting the fact that offline resources are stored in a database. The shared","type":"text"},{"text":" ","type":"text"},{"text":"object maintains a canonical collection of offline packs in its ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" property.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage","type":"topic","fragments":[{"kind":"identifier","text":"MLNOfflineStorage"}]}}}