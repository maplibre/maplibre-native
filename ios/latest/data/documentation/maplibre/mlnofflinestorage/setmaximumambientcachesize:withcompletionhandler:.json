{"abstract":[{"type":"text","text":"Sets the maximum ambient cache size in bytes. The default maximum cache"},{"type":"text","text":" "},{"type":"text","text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"0","type":"codeVoice"},{"type":"text","text":". Setting the maximum ambient cache size does not impact the maximum size"},{"type":"text","text":" "},{"type":"text","text":"of offline packs."}],"kind":"symbol","variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:withCompletionHandler:"}],"role":"symbol","title":"setMaximumAmbientCacheSize:withCompletionHandler:","externalID":"c:objc(cs)MLNOfflineStorage(im)setMaximumAmbientCacheSize:withCompletionHandler:","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","fragments":[{"kind":"text","text":"- "},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}],"symbolKind":"method"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSUInteger","text":"NSUInteger"},{"kind":"text","text":") "},{"kind":"internalParam","text":"cacheSize"},{"kind":"text","text":" "},{"kind":"identifier","text":"withCompletionHandler:"},{"text":"(","kind":"text"},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"kind":"text","text":" (^)("},{"preciseIdentifier":"c:objc(cs)NSError","kind":"typeIdentifier","text":"NSError"},{"kind":"text","text":" *"},{"kind":"internalParam","text":"error"},{"kind":"text","text":")) "},{"kind":"internalParam","text":"completion"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The maximum size in bytes for the ambient cache."}]}],"name":"cacheSize"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The completion handler to call once the maximum ambient cache","type":"text"},{"text":" ","type":"text"},{"text":"size has been set. This handler is executed synchronously on the main queue.","type":"text"}]}],"name":"completion"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"This method does not limit the space available to offline packs, and data in","type":"text"},{"text":" ","type":"text"},{"text":"offline packs does not count towards this limit. If you set the maximum ambient","type":"text"},{"text":" ","type":"text"},{"text":"cache size to 30 MB then download 20 MB of offline packs, 30 MB will remain","type":"text"},{"text":" ","type":"text"},{"text":"available for the ambient cache.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method should be called before the map and map style have been loaded."}],"type":"paragraph"},{"inlineContent":[{"text":"This method is potentially expensive, as the database will trim cached data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in order to prevent the ambient cache from being larger than the"},{"type":"text","text":" "},{"type":"text","text":"specified amount."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/setMaximumAmbientCacheSize:withCompletionHandler:","interfaceLanguage":"occ"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/setMaximumAmbientCacheSize:withCompletionHandler:":{"kind":"symbol","role":"symbol","type":"topic","title":"setMaximumAmbientCacheSize:withCompletionHandler:","url":"\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:","abstract":[{"type":"text","text":"Sets the maximum ambient cache size in bytes. The default maximum cache"},{"type":"text","text":" "},{"type":"text","text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"0"},{"type":"text","text":". Setting the maximum ambient cache size does not impact the maximum size"},{"type":"text","text":" "},{"type":"text","text":"of offline packs."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/setMaximumAmbientCacheSize:withCompletionHandler:","fragments":[{"text":"- ","kind":"text"},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","url":"\/documentation\/maplibre","title":"MapLibre","role":"collection","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage","url":"\/documentation\/maplibre\/mlnofflinestorage","abstract":[{"text":"MLNOfflineStorage implements a singleton (shared object) that manages offline","type":"text"},{"text":" ","type":"text"},{"text":"packs and ambient caching. All of this class’s instance methods are asynchronous,","type":"text"},{"text":" ","type":"text"},{"text":"reflecting the fact that offline resources are stored in a database. The shared","type":"text"},{"text":" ","type":"text"},{"text":"object maintains a canonical collection of offline packs in its ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" property.","type":"text"}],"title":"MLNOfflineStorage","fragments":[{"text":"MLNOfflineStorage","kind":"identifier"}]}}}