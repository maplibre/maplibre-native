{"abstract":[{"type":"text","text":"Sets the maximum ambient cache size in bytes. The default maximum cache"},{"text":" ","type":"text"},{"text":"size is 50 MB. To disable ambient caching, set the maximum ambient cache size","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":". Setting the maximum ambient cache size does not impact the maximum size"},{"type":"text","text":" "},{"type":"text","text":"of offline packs."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSUInteger","text":"NSUInteger"},{"text":") ","kind":"text"},{"text":"cacheSize","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"withCompletionHandler:","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":" (^)("},{"preciseIdentifier":"c:objc(cs)NSError","kind":"typeIdentifier","text":"NSError"},{"kind":"text","text":" *"},{"kind":"internalParam","text":"error"},{"kind":"text","text":")) "},{"kind":"internalParam","text":"completion"},{"kind":"text","text":";"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The maximum size in bytes for the ambient cache.","type":"text"}],"type":"paragraph"}],"name":"cacheSize"},{"content":[{"inlineContent":[{"text":"The completion handler to call once the maximum ambient cache","type":"text"},{"text":" ","type":"text"},{"text":"size has been set. This handler is executed synchronously on the main queue.","type":"text"}],"type":"paragraph"}],"name":"completion"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method does not limit the space available to offline packs, and data in"},{"type":"text","text":" "},{"type":"text","text":"offline packs does not count towards this limit. If you set the maximum ambient"},{"type":"text","text":" "},{"type":"text","text":"cache size to 30 MB then download 20 MB of offline packs, 30 MB will remain"},{"type":"text","text":" "},{"type":"text","text":"available for the ambient cache."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method should be called before the map and map style have been loaded."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is potentially expensive, as the database will trim cached data"},{"type":"text","text":" "},{"type":"text","text":"in order to prevent the ambient cache from being larger than the"},{"type":"text","text":" "},{"type":"text","text":"specified amount."}]}]}],"metadata":{"title":"setMaximumAmbientCacheSize:withCompletionHandler:","externalID":"c:objc(cs)MLNOfflineStorage(im)setMaximumAmbientCacheSize:withCompletionHandler:","symbolKind":"method","role":"symbol","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","fragments":[{"text":"- ","kind":"text"},{"text":"setMaximumAmbientCacheSize:withCompletionHandler:","kind":"identifier"}],"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setMaximumAmbientCacheSize:withCompletionHandler:"}]},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/setmaximumambientcachesize:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNO