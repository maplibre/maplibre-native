re\/MLNOfflineStorage","abstract":[{"text":"MLNOfflineStorage implements a singleton (shared object) that manages offline","type":"text"},{"text":" ","type":"text"},{"text":"packs and ambient caching. All of this class’s instance methods are asynchronous,","type":"text"},{"text":" ","type":"text"},{"text":"reflecting the fact that offline resources are stored in a database. The shared","type":"text"},{"text":" ","type":"text"},{"text":"object maintains a canonical collection of offline packs in its ","type":"text"},{"code":"packs","type":"codeVoice"},{"text":" property.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"MLNOfflineStorage","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnofflinestorage"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/addContentsOfFile:withCompletionHandler:":{"abstract":[{"text":"Adds the offline packs located at the given file path to offline storage.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addContentsOfFile:withCompletionHandler:","role":"symbol","title":"addContentsOfFile:withCompletionHandler:","url":"\/documentation\/maplibre\/mlnofflinestorage\/addcontentsoffile:withcompletionhandler:","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addContentsOfFile:withCompletionHandler:"}],"type":"topic","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBatchedOfflinePackAdditionCompletionHandler":{"abstract":[{"type":"text","text":"A block to be called once the contents of a file are copied into the current packs."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBatchedOfflinePackAdditionCompletionHandler","role":"symbol","title":"MLNBatchedOfflinePackAdditionCompletionHandler","url":"\/documentation\/maplibre\/mlnbatchedofflinepackadditioncompletionhandler","fragments":[{"kind":"identifier","text":"MLNBatchedOfflinePackAdditionCompletionHandler"}