The file path must be"},{"text":" ","type":"text"},{"text":"writable as schema updates may be perfomed.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The completion handler to call once the contents of the given","type":"text"},{"text":" ","type":"text"},{"text":"file has been added to offline storage. This handler is executed","type":"text"},{"text":" ","type":"text"},{"text":"asynchronously on the main queue.","type":"text"}],"type":"paragraph"}],"name":"completion"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The file must be a valid offline pack database bundled with the application or","type":"text"},{"text":" ","type":"text"},{"text":"downloaded separately.","type":"text"}]},{"inlineContent":[{"text":"The resulting packs are added or updated to the shared offline storage object’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"packs"},{"text":" property, then the ","type":"text"},{"code":"completion","type":"codeVoice"},{"type":"text","text":" block is executed."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addcontentsoffile:withcompletionhandler:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addContentsOfFile:withCompletionHandler:"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/addContentsOfFile:withCompletionHandler:":{"kind":"symbol","role":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"addContentsOfFile:withCompletionHandler:"}],"type":"topic","title":"addContentsOfFile:withCompletionHandler:","abstract":[{"type":"text","text":"Adds the offline packs located at the given file path to offline storage."}],"url":"\/documentation\/maplibre\/mlnofflinestorage\/addcontentsoffile:withcompletionh