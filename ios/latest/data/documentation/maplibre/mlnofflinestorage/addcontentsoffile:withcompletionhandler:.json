rameters":[{"name":"filePath","content":[{"inlineContent":[{"text":"A string representation of the file path. The file path must be","type":"text"},{"text":" ","type":"text"},{"text":"writable as schema updates may be perfomed.","type":"text"}],"type":"paragraph"}]},{"name":"completion","content":[{"inlineContent":[{"type":"text","text":"The completion handler to call once the contents of the given"},{"type":"text","text":" "},{"type":"text","text":"file has been added to offline storage. This handler is executed"},{"type":"text","text":" "},{"type":"text","text":"asynchronously on the main queue."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The file must be a valid offline pack database bundled with the application or","type":"text"},{"text":" ","type":"text"},{"text":"downloaded separately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The resulting packs are added or updated to the shared offline storage object’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"packs"},{"text":" property, then the ","type":"text"},{"type":"codeVoice","code":"completion"},{"type":"text","text":" block is executed."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinestorage\/addcontentsoffile:withcompletionhandler:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNBatchedOfflinePackAdditionCompletionHandler":{"abstract":[{"type":"text","text":"A block to be called once the contents of a file are copied into the current packs."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBatchedOfflinePackAdditionCompletionHandler","kind":"symbol","url":"\/documentation\/maplibre\/mlnbatchedofflinepackadditioncompletionhandler","title":"MLNBatchedOfflinePackAdditionCompletionHandler","fragments":[