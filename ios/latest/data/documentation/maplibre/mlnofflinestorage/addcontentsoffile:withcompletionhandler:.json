xt","text":" "},{"type":"text","text":"reflecting the fact that offline resources are stored in a database. The shared"},{"type":"text","text":" "},{"type":"text","text":"object maintains a canonical collection of offline packs in its "},{"code":"packs","type":"codeVoice"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","title":"MapLibre","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBatchedOfflinePackAdditionCompletionHandler":{"url":"\/documentation\/maplibre\/mlnbatchedofflinepackadditioncompletionhandler","title":"MLNBatchedOfflinePackAdditionCompletionHandler","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBatchedOfflinePackAdditionCompletionHandler","fragments":[{"kind":"identifier","text":"MLNBatchedOfflinePackAdditionCompletionHandler"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A block to be called once the contents of a file are copied into the current packs."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/addContentsOfFile:withCompletionHandler:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/addContentsOfFile:withCompletionHandler:","type":"topic","url":"\/documentation\/maplibre\/mlnofflinestorage\/addcontentsoffile:withcompletionhandler:","kind":"symbol","abstract":[{"type":"text","text":"Adds the offline packs located at the given file path to offline storage."}],"title":"addContentsOfFile:withCompletionHandler:","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"addContentsOfFile:withCompletio