{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"preciseIdentifier":"c:@E@CLActivityType","text":"CLActivityType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"activityType","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The location manager uses this property as a cue to determine when location updates"},{"type":"text","text":" "},{"type":"text","text":"may be automatically paused."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default value is "},{"type":"codeVoice","code":"CLActivityTypeOther"},{"type":"text","text":" when "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference","isActive":true},{"text":" uses its","type":"text"},{"text":" ","type":"text"},{"text":"default location manager.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"method","externalID":"c:objc(pl)MLNLocationManager(im)activityType","roleHeading":"Instance Method","modules":[{"name":"MapLibre"}],"role":"symbol","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"activityType","kind":"identifier"}],"fragments":[{"text":"- ","kind":"text"},{"text":"activityType","kind":"identifier"}],"title":"activityType"},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager\/activityType","interfaceLanguage":"occ"},"kind":"symbol","abstract":[{"type":"text","text":"Specifies the type of user activity associated with the location updates."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnlocationmanager\/activitytype"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLocationManager/activityType":{"abstract":[{"type":"text","text":"Specifies the type of user activity associated with the location updates."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager\/activityType","url":"\/documentation\/maplibre\/mlnlocationmanager\/activitytype","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"activityType","kind":"identifier"}],"type":"topic","kind":"symbol","title":"activityType"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"title":"MLNMapView","type":"topic","kind":"symbol","abstract":[{"text":"An interactive, customizable map view with an interface similar to the one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provided by Apple’s MapKit."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","url":"\/documentation\/maplibre\/mlnmapview","fragments":[{"kind":"identifier","text":"MLNMapView"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLocationManager":{"role":"symbol","fragments":[{"text":"MLNLocationManager","kind":"identifier"}],"type":"topic","title":"MLNLocationManager","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager","url":"\/documentation\/maplibre\/mlnlocationmanager","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager"},{"type":"text",