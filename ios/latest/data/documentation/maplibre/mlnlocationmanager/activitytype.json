ementation"},{"type":"text","text":" "},{"type":"text","text":"does not need to be based on "},{"type":"codeVoice","code":"CLLocationManager"},{"type":"text","text":"."}],"title":"MLNLocationManager","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager","url":"\/documentation\/maplibre\/mlnlocationmanager","role":"symbol","fragments":[{"text":"MLNLocationManager","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNLocationManager/activityType":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Specifies the type of user activity associated with the location updates."}],"title":"activityType","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLocationManager\/activityType","url":"\/documentation\/maplibre\/mlnlocationmanager\/activitytype","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"activityType","kind":"identifier"}]}}}