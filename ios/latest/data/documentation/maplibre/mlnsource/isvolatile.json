{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"kind":"symbol","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","interfaceLanguage":"occ"},"metadata":{"title":"isVolatile","externalID":"c:objc(cs)MLNSource(py)isVolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"navigatorTitle":[{"kind":"identifier","text":"isVolatile"}],"roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"MapLibre"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"]}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"getter"},{"kind":"text","text":"="},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":", "},{"kind":"keyword","text":"setter"},{"kind":"text","text":"="},{"kind":"identifier","text":"setVolatile:"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"BOOL","preciseIdentifier":"c:@T@BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"When "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"type":"text","text":" "},{"type":"text","text":"ambient cache on disk, whatever the response’s "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forbid storing it, or that must not outlive the session. Other"},{"type":"text","text":" "},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"code":"NO","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle","type":"topic","title":"MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","type":"topic","role":"symbol","fragments":[{"text":"isVolatile","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"kind":"symbol","title":"isVolatile"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"url":"\/documentation\/maplibre\/mlnsource","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"MLNSource"}],"abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true},{"type":"text","tex