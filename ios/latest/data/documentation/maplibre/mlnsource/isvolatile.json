ntrol","type":"codeVoice"},{"text":" header says;","type":"text"},{"text":" ","type":"text"},{"text":"they are held in memory for as long as the map needs them. Use it for content","type":"text"},{"text":" ","type":"text"},{"text":"whose terms forbid storing it, or that must not outlive the session. Other","type":"text"},{"text":" ","type":"text"},{"text":"resources, such as a TileJSON file the source is configured with, are still","type":"text"},{"text":" ","type":"text"},{"text":"cached. The default is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}]}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"role":"symbol","type":"topic","kind":"symbol","title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"fragments":[{"kind":"identifier","text":"MLNStyle"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"role":"symbol","type":"topic","kind":"symbol","title":"MLNSource","url":"\/documentation\/maplibre\/mlnsource","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","type":"reference"},{"text":" is an abstract base class for map content sources. A map content","type":"text"},{"text":" ","type":"text"},{"text":"source supplies content to be shown on the map. A source is added to an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object along with an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object. The","type":"text"},{"text":" ","type":"text"},{"text":"foreground style layer defines the appearance of any content supplied by the","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"fragments":[{"text":"MLNSource","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","url":"\/documentation\/maplibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","title":"MapLibre","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"role":"symbol","abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","url":"\/documentation\/maplibre\/mlnsource\/isvolatile","title":"isVolatile","kind":"symbol","fragments":[{"kind":"identifier","text":"isVolatile"}],"type":"topic"}}}