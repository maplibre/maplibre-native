{"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"getter"},{"kind":"text","text":"="},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":", "},{"kind":"keyword","text":"setter"},{"kind":"text","text":"="},{"kind":"identifier","text":"setVolatile:"},{"kind":"text","text":") "},{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"YES","type":"codeVoice"},{"text":", tiles of this source are neither written to nor read from the","type":"text"},{"text":" ","type":"text"},{"text":"ambient cache on disk, whatever the response’s ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" header says;","type":"text"},{"text":" ","type":"text"},{"text":"they are held in memory for as long as the map needs them. Use it for content","type":"text"},{"text":" ","type":"text"},{"text":"whose terms forbid storing it, or that must not outlive the session. Other","type":"text"},{"text":" ","type":"text"},{"text":"resources, such as a TileJSON file the source is configured with, are still","type":"text"},{"text":" ","type":"text"},{"text":"cached. The default is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"text":" ","type":"text"},{"text":"under the old setting.","type"