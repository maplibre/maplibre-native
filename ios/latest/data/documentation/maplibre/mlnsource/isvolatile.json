{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"getter"},{"kind":"text","text":"="},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":", "},{"kind":"keyword","text":"setter"},{"kind":"text","text":"="},{"kind":"identifier","text":"setVolatile:"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"BOOL","preciseIdentifier":"c:@T@BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"type":"text","text":" "},{"type":"text","text":"ambient cache on disk, whatever the response’s "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forbid storing it, or that must not outlive the session. Other"},{"type":"text","text":" "},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"code":"NO","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"isVolatile","symbolKind":"property","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"isVolatile"}],"navigatorTitle":[{"kind":"identifier","text":"isVolatile"}],"role":"symbol","externalID":"c:objc(cs)MLNSource(py)isVolatile"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","role":"symbol","title":"MLNStyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle","fragments":[{"text":"MLNStyle","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"title":"MLNSource","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","type":"reference"},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"type":"text","text":" object along with an "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"url":"\/documentation\/maplibre\/mlnsource","fragments":[{"text":"MLNSource","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"type":"topic","title":"isVolatile"}}}