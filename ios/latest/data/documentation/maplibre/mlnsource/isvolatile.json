{"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"getter"},{"kind":"text","text":"="},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":", "},{"kind":"keyword","text":"setter"},{"kind":"text","text":"="},{"kind":"identifier","text":"setVolatile:"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"BOOL","preciseIdentifier":"c:@T@BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"YES"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"type":"text","text":" "},{"type":"text","text":"ambient cache on disk, whatever the response’s "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forbid storing it, or that must not outlive the session. Other"},{"type":"text","text":" "},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"type":"codeVoice","code":"NO"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}],"type":"paragraph"}]}],"metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","title":"isVolatile","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"isVolatile","kind":"identifier"}],"fragments":[{"kind":"identifier","text":"isVolatile"}],"externalID":"c:objc(cs)MLNSource(py)isVolatile"},"variants":[{"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"role":"symbol","type":"topic","title":"isVolatile","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","url":"\/documentation\/maplibre\/mlnsource\/isvolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","