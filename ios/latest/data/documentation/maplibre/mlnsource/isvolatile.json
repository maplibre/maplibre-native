ault is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"text":" ","type":"text"},{"text":"under the old setting.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"title":"isVolatile","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"c:objc(cs)MLNSource(py)isVolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"navigatorTitle":[{"text":"isVolatile","kind":"identifier"}]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","title":"MapLibre","url":"\/documentation\/maplibre","type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"fragments":[{"kind":"identifier","text":"isVolatile"}],"kind":"symbol","role":"symbol","type":"topic","title":"isVolatile"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","title":"MLNSource","kind":"symbol","url":"\/documentation\/maplibre\/mlnsource","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true,"type":"reference"},{