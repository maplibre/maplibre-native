{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"getter","kind":"keyword"},{"text":"=","kind":"text"},{"text":"isVolatile","kind":"identifier"},{"text":", ","kind":"text"},{"text":"setter","kind":"keyword"},{"text":"=","kind":"text"},{"text":"setVolatile:","kind":"identifier"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:@T@BOOL","text":"BOOL","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"isVolatile","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"type":"text","text":" "},{"type":"text","text":"ambient cache on disk, whatever the response’s "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forbid storing it, or that must not outlive the session. Other"},{"type":"text","text":" "},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"code":"NO","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}]}]}],"metadata":{"modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNSource(py)isVolatile","role":"symbol","symbolKind":"property","roleHeading":"Instance Property","title":"isVolatile","navigatorTitle":[{"text":"isVolatile","kind":"identifier"}],"fragments":[{"text":"isVolatile","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","role":"symbol","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","type":"topic","fragments":[{"text":"MLNStyle","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","role":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"title":"MLNSource","url":"\/documentation\/maplibre\/mlnsource","type":"topic","fragments":[{"text":"MLNSource","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","role":"symbol","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","title":"isVolatile","type":"topic","fragments":[{"text":"isVolatile","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","url":"\/documentation\/maplibre","type":"topic"}}}