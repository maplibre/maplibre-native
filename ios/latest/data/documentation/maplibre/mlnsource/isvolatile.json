t":" "},{"text":"resources, such as a TileJSON file the source is configured with, are still","type":"text"},{"text":" ","type":"text"},{"text":"cached. The default is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"text":" ","type":"text"},{"text":"under the old setting.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"isVolatile","navigatorTitle":[{"text":"isVolatile","kind":"identifier"}],"roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"identifier","text":"isVolatile"}],"externalID":"c:objc(cs)MLNSource(py)isVolatile","modules":[{"name":"MapLibre"}],"symbolKind":"property"},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","kind":"symbol","url":"\/documentation\/maplibre","role":"collection","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"fragments":[{"text":"isVolatile","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","role":"symbol","type":"topic","abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"title":"isVolatile"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","fragments":[{"text":"MLNSource","kind":"identifier"}],"type":"topic","title":"MLNSource","role":"symbol","kind":"symbol","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation