ntrol","type":"codeVoice"},{"text":" header says;","type":"text"},{"text":" ","type":"text"},{"text":"they are held in memory for as long as the map needs them. Use it for content","type":"text"},{"text":" ","type":"text"},{"text":"whose terms forbid storing it, or that must not outlive the session. Other","type":"text"},{"text":" ","type":"text"},{"text":"resources, such as a TileJSON file the source is configured with, are still","type":"text"},{"text":" ","type":"text"},{"text":"cached. The default is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"text":" ","type":"text"},{"text":"under the old setting.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","type":"topic","abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"kind":"symbol","fragments":[{"kind":"identifier","text":"isVolatile"}],"url":"\/documentation\/maplibre\/mlnsource\/isvolatile","role":"symbol","title":"isVolatile"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","url":"\/documentation\/maplibre","type":"topic","title":"MapLibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"type":"topic","title":"MLNStyle","kind":"symbol