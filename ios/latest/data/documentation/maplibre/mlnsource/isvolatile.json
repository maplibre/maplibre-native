ntent sources. A map content","type":"text"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" object along with an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"url":"\/documentation\/maplibre\/mlnsource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","kind":"symbol","title":"isVolatile","role":"symbol","fragments":[{"text":"isVolatile","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnsource\/isvolatile"}}}