leJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"type":"codeVoice","code":"NO"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}]}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile"},"sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"role":"symbol","kind":"symbol","title":"isVolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","url":"\/documentation\/maplibre\/mlnsource\/isvolatile","type":"topic","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}]},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"type":"topic","title":"MLNSource","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","url":"\/documentation\/maplibre\/mlnsource","fragments":[{"kind":"identifier","text":"MLNSource"}],"abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapL