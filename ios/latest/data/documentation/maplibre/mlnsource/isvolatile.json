ce is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"type":"codeVoice","code":"NO"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}]}]}],"metadata":{"title":"isVolatile","roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"identifier","text":"isVolatile"}],"externalID":"c:objc(cs)MLNSource(py)isVolatile","symbolKind":"property","navigatorTitle":[{"kind":"identifier","text":"isVolatile"}],"modules":[{"name":"MapLibre"}]},"abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"type":"topic","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyle"}],"url":"\/documentation\/maplibre\/mlnstyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","title":"MLNStyle","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","title":"isVolatile","fragments":[{"kind":"identifier","text":"isVolatile"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnsource\/isvolatile","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}]},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","r