e","code":"Cache-Control"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forbid storing it, or that must not outlive the session. Other"},{"type":"text","text":" "},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"type":"text","text":" "},{"type":"text","text":"cached. The default is "},{"code":"NO","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}],"type":"paragraph"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","role":"collection","type":"topic","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","title":"MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","isActive":true},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"fragments":[{"kind":"identifier","text":"MLNSource"}],"title":"MLNSource","role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnsource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"title":"isVolatile","fragments":[{"text":"isVolatile","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","role":"symbol","abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"url":"\/documentation\/maplibre\/mlnsource\/isvolatile"}}}