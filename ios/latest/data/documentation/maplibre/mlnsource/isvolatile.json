{"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@property","kind":"keyword"},{"kind":"text","text":" ("},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"getter","kind":"keyword"},{"text":"=","kind":"text"},{"text":"isVolatile","kind":"identifier"},{"text":", ","kind":"text"},{"text":"setter","kind":"keyword"},{"text":"=","kind":"text"},{"text":"setVolatile:","kind":"identifier"},{"text":") ","kind":"text"},{"text":"BOOL","preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"isVolatile","kind":"identifier"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"text":" ","type":"text"},{"text":"ambient cache on disk, whatever the response’s ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" header says;","type":"text"},{"text":" ","type":"text"},{"text":"they are held in memory for as long as the map needs them. Use it for content","type":"text"},{"text":" ","type":"text"},{"text":"whose terms forbid storing it, or that must not outlive the session. Other","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"resources, such as a TileJSON file the source is configured with, are still"},{"text":" ","type":"text"},{"text":"cached. The default is ","type":"text"},{"code":"NO","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Set it before adding the source to a style, so that no tile is requested","type":"text"},{"text":" ","type":"text"},{"text":"under the old setting.","type":"text"}]}]}],"metadata":{"externalID":"c:objc(cs)MLNSource(py)isVolatile","fragments":[{"text":"isVolatile","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"role":"symbol","roleHeading":"Instance Property","navigatorTitle":[{"text":"isVolatile","kind":"identifier"}],"title":"isVolatile","symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","url":"\/documentation\/maplibre","title":"MapLibre","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","type":"topic","fragments":[{"text":"MLNStyle","kind":"identifier"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"type":"topic","fragments":[{"text":"isVolatile","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","role":"symbol","kind":"symbol","title":"isVolatile","url":"\/documentation\/maplibre\/mlnso