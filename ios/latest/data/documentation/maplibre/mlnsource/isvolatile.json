{"abstract":[{"type":"text","text":"Whether the tiles this source loads are kept out of persistent storage."}],"sections":[],"metadata":{"navigatorTitle":[{"text":"isVolatile","kind":"identifier"}],"externalID":"c:objc(cs)MLNSource(py)isVolatile","modules":[{"name":"MapLibre"}],"symbolKind":"property","fragments":[{"kind":"identifier","text":"isVolatile"}],"role":"symbol","roleHeading":"Instance Property","title":"isVolatile"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","interfaceLanguage":"occ"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"getter"},{"kind":"text","text":"="},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":", "},{"kind":"keyword","text":"setter"},{"kind":"text","text":"="},{"kind":"identifier","text":"setVolatile:"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"BOOL","preciseIdentifier":"c:@T@BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVolatile"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", tiles of this source are neither written to nor read from the"},{"type":"text","text":" "},{"type":"text","text":"ambient cache on disk, whatever the response’s "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" header says;"},{"type":"text","text":" "},{"type":"text","text":"they are held in memory for as long as the map needs them. Use it for content"},{"type":"text","text":" "},{"type":"text","text":"whose terms forb