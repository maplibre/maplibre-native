ault is "},{"type":"codeVoice","code":"NO"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"Set it before adding the source to a style, so that no tile is requested"},{"type":"text","text":" "},{"type":"text","text":"under the old setting."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"isVolatile","kind":"identifier"}],"role":"symbol","roleHeading":"Instance Property","title":"isVolatile","externalID":"c:objc(cs)MLNSource(py)isVolatile","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"kind":"identifier","text":"isVolatile"}],"symbolKind":"property"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsource\/isvolatile"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"fragments":[{"kind":"identifier","text":"MLNStyle"}],"title":"MLNStyle","type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource/isVolatile":{"abstract":[{"text":"Whether the tiles this source loads are kept out of persistent storage.","type":"text"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource\/isVolatile","title":"isVolatile","url":"\/documentation\/maplibre\/mlnsource\/isvolatile","type":"topic","fragments":[{"text":"isVolatile","kind":"identifier"}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"type":"topic","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","url":"\/documen