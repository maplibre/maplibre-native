"Mac Catalyst"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"mapView","content":[{"type":"paragraph","inlineContent":[{"text":"The map view that has just loaded a style.","type":"text"}]}]},{"name":"style","content":[{"type":"paragraph","inlineContent":[{"text":"The style that was loaded.","type":"text"}]}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"This method is called during the initialization of the map view and after any","type":"text"},{"text":" ","type":"text"},{"text":"subsequent loading of a new style. This method is called between the","type":"text"},{"text":" ","type":"text"},{"code":"-mapViewWillStartRenderingMap:","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-mapViewDidFinishRenderingMap:"},{"type":"text","text":" delegate"},{"text":" ","type":"text"},{"type":"text","text":"methods. Changes to sources or layers of the current style do not cause this"},{"text":" ","type":"text"},{"text":"method to be called.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method is the earliest opportunity to modify the layout or appearance of"},{"type":"text","text":" "},{"type":"text","text":"the current style before the map view is displayed to the user."}],"type":"paragraph"},{"anchor":"Related-examples","text":"Related examples","type":"heading","level":4},{"inlineContent":[{"text":"TODO: Dynamically style interactive points","type":"text"},{"type":"text","text":" "},{"type":"text","text":"TODO: Add multiple shapes from a single shape source examples, learn how to"},{"type":"text","text":" "},{"type":"text","text":"ensure a map’s style has loaded before modifying it at runtime"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Tells the delegate that the map has just finished loading a style.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://org.swift.MyProj