}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This method is called during the initialization of the map view and after any","type":"text"},{"text":" ","type":"text"},{"text":"subsequent loading of a new style. This method is called between the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-mapViewWillStartRenderingMap:"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-mapViewDidFinishRenderingMap:"},{"text":" delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods. Changes to sources or layers of the current style do not cause this","type":"text"},{"text":" ","type":"text"},{"text":"method to be called.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method is the earliest opportunity to modify the layout or appearance of","type":"text"},{"text":" ","type":"text"},{"text":"the current style before the map view is displayed to the user.","type":"text"}],"type":"paragraph"},{"level":4,"text":"Related examples","anchor":"Related-examples","type":"heading"},{"inlineContent":[{"text":"TODO: Dynamically style interactive points","type":"text"},{"text":" ","type":"text"},{"text":"TODO: Add multiple shapes from a single shape source examples, learn how to","type":"text"},{"text":" ","type":"text"},{"text":"ensure a map’s style has loaded before modifying it at runtime","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:didfinishloadingstyle:"]}],"abstract":[{"text":"Tells the delegate that the map has just finished loading a style.","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:didFinishLoadingStyle:","interfaceLanguage":"occ"},"sections":[],"references":{"doc://org.swift.MyProj