t"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The map view that has just loaded a style."}],"type":"paragraph"}],"name":"mapView"},{"content":[{"inlineContent":[{"type":"text","text":"The style that was loaded."}],"type":"paragraph"}],"name":"style"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"This method is called during the initialization of the map view and after any","type":"text"},{"type":"text","text":" "},{"text":"subsequent loading of a new style. This method is called between the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-mapViewWillStartRenderingMap:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-mapViewDidFinishRenderingMap:"},{"type":"text","text":" delegate"},{"text":" ","type":"text"},{"text":"methods. Changes to sources or layers of the current style do not cause this","type":"text"},{"text":" ","type":"text"},{"text":"method to be called.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method is the earliest opportunity to modify the layout or appearance of","type":"text"},{"text":" ","type":"text"},{"text":"the current style before the map view is displayed to the user.","type":"text"}],"type":"paragraph"},{"level":4,"anchor":"Related-examples","type":"heading","text":"Related examples"},{"inlineContent":[{"type":"text","text":"TODO: Dynamically style interactive points"},{"text":" ","type":"text"},{"text":"TODO: Add multiple shapes from a single shape source examples, learn how to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ensure a map’s style has loaded before modifying it at runtime"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:didfinishloadingstyle:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProj