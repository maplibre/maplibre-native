ring the shape annotation."}]}]},{"name":"annotation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The annotation being rendered."}]}]}]},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"An alpha value between "},{"type":"codeVoice","code":"0"},{"type":"text","text":" and "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A value of "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" results in a completely transparent shape. A value of "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the default, results in a completely opaque shape."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method sets the opacity of an entire shape, inclusive of its stroke and"},{"type":"text","text":" "},{"type":"text","text":"fill. To independently set the values for stroke or fill, specify an alpha"},{"type":"text","text":" "},{"type":"text","text":"component in the color returned by "},{"type":"codeVoice","code":"-mapView:strokeColorForShapeAnnotation:"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"-mapView:fillColorForPolygonAnnotation:"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:alphaforshapeannotation:"]}],"kind":"symbol","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:alphaForShapeAnnotation:","interfaceLanguage":"occ"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapViewDelegate/mapView:alphaForShapeAnnotation: