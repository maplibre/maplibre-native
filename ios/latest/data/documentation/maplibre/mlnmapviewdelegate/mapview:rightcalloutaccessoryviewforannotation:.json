type":"text"},{"type":"codeVoice","code":"-mapView:calloutViewForAnnotation:"},{"text":" is present in","type":"text"},{"text":" ","type":"text"},{"text":"the delegate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To display a view on the callout’s left side, implement the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-mapView:leftCalloutAccessoryViewForAnnotation:"},{"text":" method.","type":"text"}]},{"level":4,"text":"Related examples","anchor":"Related-examples","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"TODO: Default callout usage, learn how to modify the view that is","type":"text"},{"text":" ","type":"text"},{"text":"displayed on the right side of the standard callout bubble.","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Returns the view to display on the right side of the standard callout bubble.","type":"text"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:rightCalloutAccessoryViewForAnnotation:","interfaceLanguage":"occ"},"kind":"symbol","references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapViewDelegate/mapView:rightCalloutAccessoryViewForAnnotation:":{"url":"\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:rightcalloutaccessoryviewforannotation:","role":"symbol","title":"mapView:rightCalloutAccessoryViewForAnnotation:","fragments":[{"text":"- ","kind":"text"},{"text":"mapView:rightCalloutAccessoryViewForAnnotation:","kind":"identifier"}],"type":"topic","abstract":[{"text":"Returns the view to display on the right side of the standard callout bubble.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:rightCalloutAccessoryViewForAnnotation:","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"fragments":[{"text":"MLNMapView","kind":"identifier"}],"role":"symbol","abstract":[{"type":