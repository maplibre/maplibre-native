m the delegate, or if it returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"standard callout view has no accessory view on its right side. The return value","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of this method is ignored if "},{"type":"codeVoice","code":"-mapView:calloutViewForAnnotation:"},{"type":"text","text":" is present in"},{"type":"text","text":" "},{"type":"text","text":"the delegate."}],"type":"paragraph"},{"inlineContent":[{"text":"To display a view on the callout’s left side, implement the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-mapView:leftCalloutAccessoryViewForAnnotation:"},{"text":" method.","type":"text"}],"type":"paragraph"},{"text":"Related examples","level":4,"type":"heading","anchor":"Related-examples"},{"inlineContent":[{"text":"TODO: Default callout usage, learn how to modify the view that is","type":"text"},{"text":" ","type":"text"},{"text":"displayed on the right side of the standard callout bubble.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","role":"collection","type":"topic","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapViewDelegate/mapView:rightCalloutAccessoryViewForAnnotation:":{"type":"topic","title":"mapView:rightCalloutAccessoryViewForAnnotation:","url":"\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:rightcalloutaccessoryviewforannotation:","role":"symbol","abstract":[{"text":"Returns the view to display on the right side of the standard callout bubble.","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"mapView:rightCalloutA