{"abstract":[{"type":"text","text":"Tells the delegate that the location of the user was updated."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"mapView:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MLNMapView","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)MLNMapView","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"},{"text":" *) ","kind":"text"},{"text":"mapView","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"didUpdateUserLocation:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MLNUserLocation","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)MLNUserLocation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserLocation"},{"text":" *) ","kind":"text"},{"text":"userLocation","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The map view that is tracking the user’s location."}]}],"name":"mapView"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The location object representing the user’s latest"},{"type":"text","text":" "},{"type":"text","text":"location. This property may be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"userLocation"}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"While the "},{"type":"codeVoice","code":"showsUserLocation"},{"type":"text","text":" property is set to "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", this method is called"},{"type":"text","text":" "},{"text":"whenever a new location update is received by the map view. This method is also","type":"text"},{"type":"text","text":" "},{"text":"called if the map view’s user tracking mode is set to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithHeading"},{"type":"text","text":" and the heading changes, or if it is"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithCourse","type":"reference","isActive":true},{"text":" and the course changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method is not called if the application is currently running in the","type":"text"},{"text":" ","type":"text"},{"text":"background. If you want to receive location updates while running in the","type":"text"},{"text":" ","type":"text"},{"text":"background, you must use the Core Location framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:didupdateuserlocation:"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:didUpdateUserLocation:","interfaceLanguage":"occ"},"metadata":{"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"mapView:didUpdateUserLocation:"}],"remoteSource":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/platform\/ios\/src\/MLNMapViewDelegate.h#L567","fileName":"MLNMapViewDelegate.h"},"externalID":"c:objc(pl)MLNMapViewDelegate(im)mapView:didUpdateUserLocation:","title":"mapView:didUpdateUserLocation:","symbolKind":"method","