s location.","type":"text"}]}]},{"name":"userLocation","content":[{"inlineContent":[{"type":"text","text":"The location object representing the user’s latest"},{"type":"text","text":" "},{"type":"text","text":"location. This property may be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"While the "},{"code":"showsUserLocation","type":"codeVoice"},{"type":"text","text":" property is set to "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", this method is called"},{"type":"text","text":" "},{"type":"text","text":"whenever a new location update is received by the map view. This method is also"},{"type":"text","text":" "},{"type":"text","text":"called if the map view’s user tracking mode is set to"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithHeading","type":"reference","isActive":true},{"type":"text","text":" and the heading changes, or if it is"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithCourse","isActive":true},{"type":"text","text":" and the course changes."}],"type":"paragraph"},{"inlineContent":[{"text":"This method is not called if the application is currently running in the","type":"text"},{"text":" ","type":"text"},{"text":"background. If you want to receive location updates while running in the","type":"text"},{"text":" ","type":"text"},{"text":"background, you must use the Core Location framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:didUpdateUserLocation:","interfaceLanguage":"occ"},"schemaV