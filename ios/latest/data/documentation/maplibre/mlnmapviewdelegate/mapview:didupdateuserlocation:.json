{"abstract":[{"text":"Tells the delegate that the location of the user was updated.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"mapView:","kind":"identifier"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","preciseIdentifier":"c:objc(cs)MLNMapView","text":"MLNMapView","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"mapView"},{"text":" ","kind":"text"},{"kind":"identifier","text":"didUpdateUserLocation:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)MLNUserLocation","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserLocation","text":"MLNUserLocation","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"userLocation","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"name":"mapView","content":[{"type":"paragraph","inlineContent":[{"text":"The map view that is tracking the user’s location.","type":"text"}]}]},{"name":"userLocation","content":[{"inlineContent":[{"text":"The location object representing the user’s latest","type":"text"},{"text":" ","type":"text"},{"text":"location. This property may be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"While the "},{"code":"showsUserLocation","type":"codeVoice"},{"type":"text","text":" property is set to "},{"code":"YES","type":"codeVoice"},{"type":"text","text":", this method is called"},{"type":"text","text":" "},{"type":"text","text":"whenever a new location update is received by the map view. This met