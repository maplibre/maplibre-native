ions"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The map view rendering the shape annotation."}]}],"name":"mapView"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The annotation being rendered."}]}],"name":"annotation"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"A color to use for the shape outline.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The default stroke color is the map view’s tint color. If a pattern color is","type":"text"},{"text":" ","type":"text"},{"text":"specified, the result is undefined.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Opacity may be set by specifying an alpha component. The default alpha value is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" and results in a completely opaque stroke.","type":"text"}]},{"type":"heading","text":"Related examples","anchor":"Related-examples","level":4},{"type":"paragraph","inlineContent":[{"text":"TODO: Annotation models, learn how to modify the outline color of an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"text":" object that has been added to your map as an annotation.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:strokeColorForShapeAnnotation:"},"abstract":[{"type":"text","text":"Returns the color to use when rendering the outline of a shape annotation."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","url":"\/documentation\/maplibre","kind":"symbol","role":"collection","t