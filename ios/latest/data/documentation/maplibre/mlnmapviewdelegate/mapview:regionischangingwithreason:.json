e methods to notify your application when specific operations complete. The"},{"type":"text","text":" "},{"type":"text","text":"map view also uses these methods to request information about annotations"},{"type":"text","text":" "},{"type":"text","text":"displayed on the map, such as the styles and interaction modes to apply to"},{"type":"text","text":" "},{"type":"text","text":"individual annotations."}],"fragments":[{"kind":"identifier","text":"MLNMapViewDelegate"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate","kind":"symbol","title":"MLNMapViewDelegate","role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnmapviewdelegate"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCameraChangeReason":{"type":"topic","fragments":[{"kind":"identifier","text":"MLNCameraChangeReason"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCameraChangeReason","kind":"symbol","title":"MLNCameraChangeReason","role":"symbol","abstract":[{"type":"text","text":"Bitmask values that describe why a camera move occurred."}],"url":"\/documentation\/maplibre\/mlncamerachangereason"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/setCamera:animated:":{"type":"topic","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"setCamera:animated:"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setCamera:animated:","kind":"symbol","title":"setCamera:animated:","role":"symbol","abstract":[{"type":"text","text":"Moves the viewpoint to a different location with respect to the map with an"},{"type":"text","text":" "},{"type":"text","text":"optional transition animation. For animated changes, wait until the map view has"},{"type":"text","text":" "},{"type":"text","text":"finished loading before calling this method."}],"url":"\/documentation\/maplibre\/mlnmapview\/setcamera:animated:"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","url":"\/documentation\/maplibre","kind":"symbol","title":"MapLibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]}}}