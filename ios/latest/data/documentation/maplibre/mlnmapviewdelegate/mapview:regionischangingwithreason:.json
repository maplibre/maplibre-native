ingwithreason:"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"MLNMapView"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","abstract":[{"text":"An interactive, customizable map view with an interface similar to the one","type":"text"},{"text":" ","type":"text"},{"text":"provided by Apple’s MapKit.","type":"text"}],"url":"\/documentation\/maplibre\/mlnmapview","title":"MLNMapView"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/setCamera:animated:":{"title":"setCamera:animated:","abstract":[{"text":"Moves the viewpoint to a different location with respect to the map with an","type":"text"},{"text":" ","type":"text"},{"text":"optional transition animation. For animated changes, wait until the map view has","type":"text"},{"text":" ","type":"text"},{"text":"finished loading before calling this method.","type":"text"}],"url":"\/documentation\/maplibre\/mlnmapview\/setcamera:animated:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setCamera:animated:","kind":"symbol","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"setCamera:animated:","kind":"identifier"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCameraChangeReason":{"title":"MLNCameraChangeReason","abstract":[{"type":"text","text":"Bitmask values that describe why a camera move occurred."}],"url":"\/documentation\/maplibre\/mlncamerachangereason","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCamera