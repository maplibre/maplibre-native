{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"This method is called as the currently displayed map camera changes as part of","type":"text"},{"text":" ","type":"text"},{"text":"an animation, whether due to a user gesture or due to a call to a method such","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setCamera:animated:","isActive":true,"type":"reference"},{"text":". This method can be called before","type":"text"},{"text":" ","type":"text"},{"code":"-mapViewDidFinishLoadingMap:","type":"codeVoice"},{"text":" is called.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"During the animation, this method may be called many times to report updates to","type":"text"},{"text":" ","type":"text"},{"text":"the viewpoint. Therefore, your implementation of this method should be as lightweight","type":"text"},{"text":" ","type":"text"},{"text":"as possible to avoid affecting performance.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If this method is implemented "},{"type":"codeVoice","code":"-mapViewRegionIsChanging:"},{"text":" will not be called.","type":"text"}]}]}]}],"metadata":{"role":"symbol","title":"mapView:regionIsChangingWithReason:","externalID":"c:objc(pl)MLNMapViewDelegate(im)mapView:regionIsChangingWithReason:","fragments":[{"text":"- ","kind":"text"},{"text":"mapView:regionIsChangingWithReason:","kind":"identifier"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"mapView:regionIsChangingWithReason:","kind":"identifier"}],"roleHeading":"Instance Method","modules":[{"name":"MapLibre"}],"remoteSource":{"fileName":"MLNMapViewDelegate.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/platform\/ios\/src\/MLNMapViewDelegate.h#L152"},"sym