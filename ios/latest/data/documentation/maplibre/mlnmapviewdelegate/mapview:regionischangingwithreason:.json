nishLoadingMap:","type":"codeVoice"},{"type":"text","text":" is called."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"During the animation, this method may be called many times to report updates to"},{"type":"text","text":" "},{"type":"text","text":"the viewpoint. Therefore, your implementation of this method should be as lightweight"},{"type":"text","text":" "},{"type":"text","text":"as possible to avoid affecting performance."}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If this method is implemented "},{"type":"codeVoice","code":"-mapViewRegionIsChanging:"},{"type":"text","text":" will not be called."}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:regionIsChangingWithReason:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":":nodoc:"},{"type":"text","text":" "},{"type":"text","text":"Tells the delegate that the viewpoint depicted by the map view is changing."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:regionischangingwithreason:"]}],"metadata":{"externalID":"c:objc(pl)MLNMapViewDelegate(im)mapView:regionIsChangingWithReason:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"mapView:regionIsChangingWithReason:"}],"remoteSource":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/platform\/ios\/src\/MLNMapViewDelegate.h#L152","fileName":"MLNMapViewDelegate.h"},"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"- ","kind":"text"},{"text":"mapView:regionIsChangingWithReason:","kind":"identifier"}],"title":"mapView:regionIsChangingWithReason:","role":"symbol","modules":[{"name":"MapLibre"}]},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNM