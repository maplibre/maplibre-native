ssion","anchor":"discussion"},{"inlineContent":[{"text":"This method is called as the currently displayed map camera changes as part of","type":"text"},{"text":" ","type":"text"},{"text":"an animation, whether due to a user gesture or due to a call to a method such","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setCamera:animated:","isActive":true},{"type":"text","text":". This method can be called before"},{"type":"text","text":" "},{"type":"codeVoice","code":"-mapViewDidFinishLoadingMap:"},{"type":"text","text":" is called."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During the animation, this method may be called many times to report updates to"},{"type":"text","text":" "},{"type":"text","text":"the viewpoint. Therefore, your implementation of this method should be as lightweight"},{"type":"text","text":" "},{"type":"text","text":"as possible to avoid affecting performance."}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"If this method is implemented "},{"code":"-mapViewRegionIsChanging:","type":"codeVoice"},{"type":"text","text":" will not be called."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnmapviewdelegate\/mapview:regionischangingwithreason:"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDelegate\/mapView:regionIsChangingWithReason:"},"abstract":[{"text":":nodoc:","type":"text"},{"text":" ","type":"text"},{"text":"Tells the delegate that the viewpoint depicted by the map view is changing