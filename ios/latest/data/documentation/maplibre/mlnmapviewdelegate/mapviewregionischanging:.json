anging."}]}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This method is called as the currently displayed map camera changes as part of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"an animation, whether due to a user gesture or due to a call to a method such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/setCamera:animated:"},{"type":"text","text":". This method can be called before"},{"type":"text","text":" "},{"type":"codeVoice","code":"-mapViewDidFinishLoadingMap:"},{"type":"text","text":" is called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"During the animation, this method may be called many times to report updates to"},{"type":"text","text":" "},{"type":"text","text":"the viewpoint. Therefore, your implementation of this method should be as lightweight"},{"type":"text","text":" "},{"text":"as possible to avoid affecting performance.","type":"text"}]},{"type":"heading","anchor":"Related-examples","text":"Related examples","level":4},{"inlineContent":[{"type":"text","text":"TODO: Cluster point data, learn how to trigger an action whenever"},{"type":"text","text":" "},{"text":"the map region changes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/setCamera:animated:":{"abstract":[{"text":"Moves the viewpoint to a different location with respect to the map with an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"optional transition animation. For animated changes, wait until the map view has"},{"type":"text","text":" "},{"type":"text","text":"finished loading before calling this method."}],"title":"setCamera:animated:","type":"topic","url":"\/documentation\/maplibre\/mlnmapview\/setcamera:animated:","identifier