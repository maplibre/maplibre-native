 the direction the"},{"type":"text","text":" "},{"type":"text","text":"device is facing, which is sized according to the reported accuracy."}],"type":"topic","url":"\/documentation\/maplibre\/mlnusertrackingmode\/mlnusertrackingmodefollowwithheading","title":"MLNUserTrackingModeFollowWithHeading","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithHeading","role":"symbol","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView/showsUserHeadingIndicator":{"fragments":[{"text":"showsUserHeadingIndicator","kind":"identifier"}],"abstract":[{"type":"text","text":"A Boolean value indicating whether the user location annotation may display a"},{"type":"text","text":" "},{"type":"text","text":"permanent heading indicator."}],"type":"topic","url":"\/documentation\/maplibre\/mlnmapview\/showsuserheadingindicator","title":"showsUserHeadingIndicator","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/showsUserHeadingIndicator","role":"symbol","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNUserLocation/heading":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserLocation\/heading","kind":"symbol","fragments":[{"kind":"identifier","text":"heading"}],"url":"\/documentation\/maplibre\/mlnuserlocation\/heading","type":"topic","title":"heading","abstract":[{"text":"The heading of the user location. (read-only)","type":"text"}],"role":"symbol"}}}