adingIndicator"}],"url":"\/documentation\/maplibre\/mlnmapview\/showsuserheadingindicator"},"doc://org.swift.MyProject/documentation/MapLibre/MLNUserLocation/heading":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserLocation\/heading","title":"heading","abstract":[{"type":"text","text":"The heading of the user location. (read-only)"}],"fragments":[{"text":"heading","kind":"identifier"}],"type":"topic","url":"\/documentation\/maplibre\/mlnuserlocation\/heading","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNUserTrackingMode/MLNUserTrackingModeFollowWithHeading":{"kind":"symbol","fragments":[{"text":"MLNUserTrackingModeFollowWithHeading","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnusertrackingmode\/mlnusertrackingmodefollowwithheading","abstract":[{"type":"text","text":"The map follows the user location and rotates when the heading changes."},{"type":"text","text":" "},{"type":"text","text":"The default user location annotation displays a fan-shaped indicator with"},{"type":"text","text":" "},{"type":"text","text":"the current heading. The heading indicator represents the direction the"},{"type":"text","text":" "},{"type":"text","text":"device is facing, which is sized according to the reported accuracy."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNUserTrackingMode\/MLNUserTrackingModeFollowWithHeading","title":"MLNUserTrackingModeFollowWithHeading"}}}