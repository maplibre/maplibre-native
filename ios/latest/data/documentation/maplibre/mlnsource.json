ource","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNImageSource":{"abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource","type":"reference"},{"type":"text","text":" is a content source that is used for a georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"image to be shown on the map. The georeferenced image scales and rotates as the"},{"type":"text","text":" "},{"type":"text","text":"user zooms and rotates the map. Images may also be used as icons or patterns"},{"type":"text","text":" "},{"type":"text","text":"in a style layer. To register an image for use as an icon or pattern,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/setImage:forName:","type":"reference"},{"type":"text","text":" method. To configure a point"},{"type":"text","text":" "},{"type":"text","text":"annotation’s image, use the "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAnnotationImage","type":"reference"},{"type":"text","text":" class."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNImageSource"}],"title":"MLNImageSource","type":"topic","url":"\/documentation\/maplibre\/mlnimagesource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNImageSource"}}}