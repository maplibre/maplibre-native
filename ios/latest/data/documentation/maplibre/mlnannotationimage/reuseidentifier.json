{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"readonly"},{"kind":"text","text":") "},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"kind":"text","text":" * "},{"kind":"identifier","text":"reuseIdentifier"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"You specify the reuse identifier when you create the image object. You use this","type":"text"},{"text":" ","type":"text"},{"text":"type later to retrieve an annotation image object that was created previously","type":"text"},{"text":" ","type":"text"},{"text":"but which is currently unused because its annotation is not on screen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you define distinctly different types of annotations (with distinctly"},{"type":"text","text":" "},{"type":"text","text":"different annotation images to go with them), you can differentiate between the"},{"type":"text","text":" "},{"type":"text","text":"annotation types by specifying different reuse identifiers for each one."}],"type":"paragraph"}]}],"metadata":{"role":"symbol","remoteSource":{"fileName":"MLNAnnotationImage.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/platform\/ios\/src\/MLNAnnotationImage.h#L50"},"fragments":[{"text":"reuseIdentifier","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","symbolKind":"property","externalID":"c:objc(cs)MLNAnnotationImage(py)reuseIdentifier","title":"reuseIdentifier","navigatorTitle":[{"text":"reuseIdentifier","kind":"identifier"}]},"variants":[{"paths":["\/doc