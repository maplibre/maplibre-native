e\/MLNFillStyleLayer\/fillTranslation","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"fillTranslation"}],"abstract":[{"type":"text","text":"The geometry’s offset."}],"title":"fillTranslation"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"MLNStyle"}],"title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},{"type":"text","text":" objects."}],"type":"topic","fragments":[{"kind":"identifier","text":"MLNBackgroundStyleLayer"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","role":"symbol","kind":"symbol","title":"MLNBackgroundStyleLayer","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillOpacity":{"title":"fillOpacity","fragments":[{"text":"fillOpacity","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillOpacity","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillopacity","type":"topic","abstract":[{"type":"text","text":"The opacity of the entire fill layer. In contrast to the "},{"type":"codeVoice","code":"fillColor"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"value will also affect the 1pt stroke around the fill, if the stroke is used."}],"role":"symbol","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillColor":{"title":"fillColor","fragments":[{"text":"fillColor","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillColor","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillcolor","type":"topic","abstract":[{"type":"text","text":"The color of the filled part of this layer. When used with an SDF fill pattern,"},{"type":"text","text":" "},{"type":"text","text":"this serves as the foreground color of the pattern."}],"role":"symbol","kind":"symbol"}}}