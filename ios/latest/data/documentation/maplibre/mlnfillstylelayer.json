 "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"kind":"symbol","title":"MLNStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillPattern":{"role":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillpattern","type":"topic","fragments":[{"text":"fillPattern","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillPattern","abstract":[{"text":"Name of image in sprite to use for drawing image fills. For seamless patterns,","type":"text"},{"text":" ","type":"text"},{"text":"image width and height must be a factor of two (2, 4, 8, …, 512). Note that","type":"text"},{"text":" ","type":"text"},{"text":"zoom-dependent expressions will be evaluated only at integer zoom levels.","type":"text"}],"title":"fillPattern"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillTranslationAnchor":{"role":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer\/filltranslationanchor","type":"topic","fragments":[{"text":"fillTranslationAnchor","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillTranslationAnchor","abstract":[{"text":"Controls the frame of reference for ","type":"text"},{"code":"fillTranslation","type":"codeVoice"},{"text":".","type":"text"}],"title":"fillTranslationAnchor"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNCir