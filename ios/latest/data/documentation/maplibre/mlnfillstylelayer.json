cumentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"fragments":[{"text":"MLNCircleStyleLayer","kind":"identifier"}],"title":"MLNCircleStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","url":"\/documentation\/maplibre\/mlncirclestylelayer","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNFillExtrusionStyleLayer"}],"title":"MLNFillExtrusionStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer","url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer"},{"type":"text","text":" is a style layer that renders one or more 3D"},{"type":"text","text":" "},{"type":"text","text":"extruded polygons on the map."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillPattern":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillpattern","role":"symbol","type":"topic","fragments":[{"text":"fillPattern","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillPattern","abstract":[{"type":"text","text":"Name of image in sprite to use for drawing image fills. For seamless patterns,"},{"type":"text","text":" "},{"type":"text","text":"image width and height must be a factor of two (2, 4, 8, …, 512). Note that"},{"type":"text","text":" "},{"type":"text","text":"zoom-dependent expressions will be evaluated only at integer zoom levels."}],"title":"fillPattern"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layers":{"title":"layers","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layers","kind":"symbol","fragments":[{"text":"layers","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle\/layers","abstract":[{"type":"text","text":"The layers included in the style, arranged according to their back-to-front"},{"type":"text","text":" "},{"type":"text","text":"ordering on the screen."}]}}}