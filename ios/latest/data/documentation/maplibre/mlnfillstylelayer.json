arance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"fragments":[{"text":"MLNShapeSource","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnshapesource"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"type":"topic","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","type":"reference","isActive":true},{"type":"text","text":" objects."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","kind":"symbol","role":"symbol","title":"MLNBackgroundStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"type":"topic","fragments":[{"text":"MLNRasterStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnrasterstylelayer","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true,"type":"reference"},{"text":" is a style layer that renders georeferenced raster","type":"text"},{"text":" ","type":"text"},{"text":"imagery on the map, especially raster tiles.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","kind":"symbol","role":"symbol","title":"MLNRasterStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillOutlineColorTransition":{"type":"topic","fragments":[{"kind":"identifier","text":"fillOutlineColorTransition"}],"url":"\/documentation\/maplibre\/mlnfillstylelayer\/filloutlinecolortransition","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"fillOutlineColor"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillOutlineColorTransition","kind":"symbol","role":"symbol","title":"fillOutlineColorTransition"}}}