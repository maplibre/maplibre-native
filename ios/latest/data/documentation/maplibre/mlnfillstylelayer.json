etting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","fragments":[{"text":"MLNShapeSource","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"role":"symbol","title":"MLNCircleStyleLayer","url":"\/documentation\/maplibre\/mlncirclestylelayer","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","fragments":[{"text":"MLNCircleStyleLayer","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillOutlineColorTransition":{"role":"symbol","title":"fillOutlineColorTransition","url":"\/documentation\/maplibre\/mlnfillstylelayer\/filloutlinecolortransition","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"fillOutlineColor"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillOutlineColorTransition","fragments":[{"text":"fillOutlineColorTransition","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"role":"symbol","title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillColorTransition":{"role":"symbol","title":"fillColorTransition","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillcolortransition","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"type":"codeVoice","code":"fillColor"},{"type":"text","text":" property."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillColorTransition","fragments":[{"text":"fillColorTransition","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillOutlineColor":{"role":"symbol","title":"fillOutlineColor","url":"\/documentation\/maplibre\/mlnfillstylelayer\/filloutlinecolor","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The outline color of the fill. Matches the value of "},{"type":"codeVoice","code":"fillColor"},{"type":"text","text":" if unspecified."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillOutlineColor","fragments":[{"text":"fillOutlineColor","kind":"identifier"}]}}}