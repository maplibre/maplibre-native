":"symbol","title":"MLNFillStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layers":{"url":"\/documentation\/maplibre\/mlnstyle\/layers","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layers","type":"topic","fragments":[{"kind":"identifier","text":"layers"}],"abstract":[{"type":"text","text":"The layers included in the style, arranged according to their back-to-front"},{"type":"text","text":" "},{"type":"text","text":"ordering on the screen."}],"role":"symbol","title":"layers"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" objects."}],"title":"MLNBackgroundStyleLayer","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"MLNBackgroundStyleLayer","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"role":"symbol","title":"MLNSymbolStyleLayer","type":"topic","fragments":[{"text":"MLNSymbolStyleLayer",