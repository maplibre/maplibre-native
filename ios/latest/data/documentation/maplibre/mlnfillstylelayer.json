Project\/documentation\/MapLibre\/MLNFillStyleLayer\/fillTranslation","fragments":[{"kind":"identifier","text":"fillTranslation"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillColor":{"url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillcolor","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The color of the filled part of this layer."}],"title":"fillColor","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillColor","fragments":[{"kind":"identifier","text":"fillColor"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","role":"symbol","title":"MLNCircleStyleLayer","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true,"type":"reference"},{"text":" is a style layer that renders one or more filled","type":"text"},{"text":" ","type":"text"},{"text":"circles on the map.","type":"text"}],"fragments":[{"text":"MLNCircleStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlncirclestylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillOpacity":{"url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillopacity","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The opacity of the entire fill layer. In contrast to the "},{"type":"codeVoice","code":"fillColor"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"value will also affect the 1pt stroke around the fill, if the stroke is used."}],"title":"fillOpacity","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillOpacity","fragments":[{"kind":"identifier","text":"fillOpacity"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleL