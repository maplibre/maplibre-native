":"text"},{"text":" ","type":"text"},{"text":"a background style layer to configure a color or pattern to show below all","type":"text"},{"text":" ","type":"text"},{"text":"other map content. If the style’s other layers use the Mapbox Streets source,","type":"text"},{"text":" ","type":"text"},{"text":"the background style layer is responsible for drawing land, whereas the oceans","type":"text"},{"text":" ","type":"text"},{"text":"and other bodies of water are drawn by ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true,"type":"reference"},{"text":" objects.","type":"text"}],"title":"MLNBackgroundStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSource":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource","fragments":[{"text":"MLNSource","kind":"identifier"}],"kind":"symbol","title":"MLNSource","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSource"},{"type":"text","text":" is an abstract base class for map content sources. A map content"},{"type":"text","text":" "},{"type":"text","text":"source supplies content to be shown on the map. A source is added to an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object along with an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object. The"},{"type":"text","text":" "},{"type":"text","text":"foreground style layer defines the appearance of any content supplied by the"},{"type":"text","text":" "},{"type":"text","text":"source."}],"role":"symbol","url":"\/documentation\/maplibre\/mlnsource","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"url":"\/documentation\/maplibre\/mlncirclestylelayer","type":"topic","title":"MLNCircleStyleLayer","fragments":[{"text":"MLNCircleStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer/fillColor":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer\/fillColor","fragments":[{"kind":"identifier","text":"fillColor"}],"kind":"symbol","title":"fillColor","abstract":[{"type":"text","text":"The color of the filled part of this layer. When used with an SDF fill pattern,"},{"type":"text","text":" "},{"type":"text","text":"this serves as the foreground color of the pattern."}],"role":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer\/fillcolor","type":"topic"}}}