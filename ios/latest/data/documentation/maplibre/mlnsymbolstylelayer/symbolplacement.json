."},{"text":" ","type":"text"},{"type":"codeVoice","code":"line-center"},{"text":": The label is placed at the center of the line of the","type":"text"},{"text":" ","type":"text"},{"text":"geometry. Can only be used on ","type":"text"},{"type":"codeVoice","code":"LineString"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Polygon"},{"text":" geometries. Note that","type":"text"},{"text":" ","type":"text"},{"text":"a single feature in a vector tile may contain multiple line geometries.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"text":" ","type":"text"},{"type":"text","text":"Conditional expressions"},{"text":" ","type":"text"},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable"}],"type":"paragraph"},{"inlineContent":[{"text":"This property does not support applying interpolation functions to the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"text":" ","type":"text"},{"type":"text","text":"attributes."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"navigatorTitle":[{"text":"symbolPlacement","kind":"identifier"}],"roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"title":"symbolPlacement","fragments":[{"text":"symbolPlacement","kind":"identifier"}],"role":"symbol","symbolKind":"property","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolPlacement"},"sections":[],"abstract":[{"type":"text","text":"Label placement relative to its geometry."}],"identifier":{"url":"doc:\/\/org.s