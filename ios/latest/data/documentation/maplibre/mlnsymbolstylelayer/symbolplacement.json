":"text"},{"code":"LineString","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Polygon"},{"type":"text","text":" geometries."},{"type":"text","text":" "},{"type":"codeVoice","code":"line-center"},{"type":"text","text":": The label is placed at the center of the line of the"},{"type":"text","text":" "},{"type":"text","text":"geometry. Can only be used on "},{"type":"codeVoice","code":"LineString"},{"type":"text","text":" and "},{"code":"Polygon","type":"codeVoice"},{"text":" geometries. Note that","type":"text"},{"text":" ","type":"text"},{"text":"a single feature in a vector tile may contain multiple line geometries.","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"text":" ","type":"text"},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Step functions applied to the ","type":"text"},{"type":"codeVoice","code":"$zoomLevel"},{"text":" variable","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"type":"text","text":" "},{"type":"text","text":"attributes."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Label placement relative to its geometry."}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","role":"symbol","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolPlacement","navigatorTitle":[{"kind":"identifier","text":"symbolPlacement"}],"title