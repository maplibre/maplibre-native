{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"text":") ","kind":"text"},{"text":"NSExpression","preciseIdentifier":"c:objc(cs)NSExpression","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"symbolPlacement","kind":"identifier"},{"text":";","kind":"text"}]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"The default value of this property is an expression that evaluates to "},{"type":"codeVoice","code":"point"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Set this property to "},{"type":"codeVoice","code":"nil"},{"text":" to reset it to the default value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant ","type":"text"},{"code":"MLNSymbolPlacement","type":"codeVoice"},{"type":"text","text":" values"},{"type":"text","text":" "},{"type":"text","text":"Any of the following constant string values:"},{"type":"text","text":" "},{"code":"point","type":"codeVoice"},{"text":": The label is placed at the point where the geometry is located.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"line"},{"text":": The label is placed along the line of the geometry. Can only be","type":"text"},{"text":" ","type":"text"},{"text":"used on ","type":"text"},{"type":"codeVoice","code":"LineString"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Polygon"},{"text":" geometries.","type":"text"},{"text":" ","type":"text"},{"code":"line-center","type":"codeVoice"},{"text":": The label is placed at the center of the line of the","type":"text"},{"type":"text","text":" "