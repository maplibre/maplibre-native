ced at the center of the line of the"},{"type":"text","text":" "},{"text":"geometry. Can only be used on ","type":"text"},{"type":"codeVoice","code":"LineString"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Polygon"},{"type":"text","text":" geometries. Note that"},{"type":"text","text":" "},{"type":"text","text":"a single feature in a vector tile may contain multiple line geometries."},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"text":" ","type":"text"},{"text":"Step functions applied to the ","type":"text"},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"text":" ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"text":" ","type":"text"},{"text":"attributes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/symbolPlacement","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolPlacement","roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"symbolPlacement"}],"role":"symbol","modules":[{"name":"MapLibre"}],"symbolKind":"property","title":"symbolPlacement","navigatorTitle":[{"kind":"identifier","text":"symbolPlacement"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{