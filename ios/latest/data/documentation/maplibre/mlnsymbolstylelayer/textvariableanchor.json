 ","type":"text"},{"code":"center","type":"codeVoice"},{"text":": The center of the text is placed closest to the anchor.","type":"text"},{"text":" ","type":"text"},{"code":"left","type":"codeVoice"},{"type":"text","text":": The left side of the text is placed closest to the anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"right"},{"type":"text","text":": The right side of the text is placed closest to the anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"top"},{"type":"text","text":": The top of the text is placed closest to the anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"bottom"},{"type":"text","text":": The bottom of the text is placed closest to the anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"top-left"},{"type":"text","text":": The top left corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"top-right"},{"type":"text","text":": The top right corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"bottom-left"},{"type":"text","text":": The bottom left corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"bottom-right"},{"type":"text","text":": The bottom right corner of the text is placed closest to"},{"type":"text","text":" "},{"type":"text","text":"the anchor."},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"text":" variable","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property does not support applying interpolation functions to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$zoomLevel"},{"text":" variable or applying interpolation or step functions to feature","type":"text"},{"text":" ","type":"text"},{"text":"attributes.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchor"},"sections":[],"abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations: the renderer will attempt to place"},{"type":"text","text":" "},{"type":"text","text":"the label at each location, in order, before moving onto the next label. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose justification based on anchor position. To apply"},{"type":"text","text":" "},{"type":"text","text":"an offset, use the "},{"type":"codeVoice","code":"textRadialOffset"},{"type":"text","text":" or the two-dimensional "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchor"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchor":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchor","kind":"symbol","url":"\/doc