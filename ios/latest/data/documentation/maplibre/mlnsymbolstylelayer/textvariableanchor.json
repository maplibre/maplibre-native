{"abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"text":" ","type":"text"},{"text":"provide an array of ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"text":" locations: the renderer will attempt to place","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the label at each location, in order, before moving onto the next label. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose justification based on anchor position. To apply"},{"type":"text","text":" "},{"text":"an offset, use the ","type":"text"},{"type":"codeVoice","code":"textRadialOffset"},{"text":" or the two-dimensional ","type":"text"},{"type":"codeVoice","code":"textOffset"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchor"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"title":"textVariableAnchor","modules":[{"name":"MapLibre"}],"role":"symbol","navigatorTitle":[{"text":"textVariableAnchor","kind":"identifier"}],"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"textVariableAnchor","kind":"identifier"}],"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchor"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchor"},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"text":") ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression"},{"text":" * ","kind":"text"},{"text":"textVariableAnchor","kind":"identifier"},{"text":";","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading