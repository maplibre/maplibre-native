: The bottom of the text is placed closest to the anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"top-left"},{"type":"text","text":": The top left corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"top-right"},{"type":"text","text":": The top right corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"bottom-left"},{"type":"text","text":": The bottom left corner of the text is placed closest to the"},{"type":"text","text":" "},{"type":"text","text":"anchor."},{"type":"text","text":" "},{"type":"codeVoice","code":"bottom-right"},{"type":"text","text":": The bottom right corner of the text is placed closest to"},{"type":"text","text":" "},{"type":"text","text":"the anchor."},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Step functions applied to the ","type":"text"},{"type":"codeVoice","code":"$zoomLevel"},{"text":" variable","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property does not support applying interpolation functions to the","type":"text"},{"text":" ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable or applying interpolation or step functions to feature","type":"text"},{"text":" ","type":"text"},{"text":"attributes.","type":"text"}]}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","abstract":[{"type":"te