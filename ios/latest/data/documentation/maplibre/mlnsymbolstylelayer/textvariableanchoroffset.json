{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSExpression","preciseIdentifier":"c:objc(cs)NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"textVariableAnchorOffset"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The length of the array must be even, and must alternate between enum and","type":"text"},{"text":" ","type":"text"},{"text":"point entries. i.e., each anchor location must be accompanied by a point, and","type":"text"},{"text":" ","type":"text"},{"text":"that point defines the offset when the corresponding anchor location is used.","type":"text"},{"text":" ","type":"text"},{"text":"Positive offset values indicate right and down, while negative values indicate","type":"text"},{"text":" ","type":"text"},{"text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple","type":"text"},{"text":" ","type":"text"},{"text":"offsets to try and place a label using the same anchor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When present, this property takes precedence over ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"textVariableAnchor"},{"text":", ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"textRadialOffset","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""],"type":"codeListing"},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"type":"codeVoice","code":"top"},{"text":" anchor, ","type":"text"},{"type":"codeVoice","code":"[0, 4]"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"textOffset"},{"text":"; the text will be shifted down by 4 ems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"type":"codeVoice","code":"left"},{"text":" anchor, ","type":"text"},{"type":"codeVoice","code":"[3, 0]"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"textOffset"},{"text":"; the text will be shifted right by 3 ems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"type":"codeVoice","code":"text"},{"text":" is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"symbolPlacement"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MLNSymbolPlacementPoint"},{"text":". Otherwise, it is ignored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant interleaved ","type":"text"},{"type":"codeVoice","code":"MLNTextAnchor"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"CGVector"},{"text":" array values","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"text":" ","type":"text"},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Interpolation and step functions applied to the ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable and\/or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"feature attributes"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"role":"symbol","symbolKind":"property","title":"textVariableAnchorOffset","roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","navigatorTitle":[{"kind":"identifier","text":"textVariableAnchorOffset"}]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","interfaceLanguage":"occ"},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"text":" ","type":"text"},{"text":"provide an array of ","type":"text"},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"text":" ","type":"text"},{"text":"The renderer will attempt to place the label at each location, in order, before","type":"text"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"code":"textJustify: auto","type":"codeVoice"},{"text":" to choose","type":"text"},{"text":" ","type":"text"},{"text":"justification based on anchor position.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"role":"symbol","url":"\/documentation\/maplibre\/mlnsymbolst