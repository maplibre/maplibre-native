{"abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"text":" ","type":"text"},{"text":"provide an array of ","type":"text"},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"text":" ","type":"text"},{"text":"The renderer will attempt to place the label at each location, in order, before","type":"text"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"code":"textJustify: auto","type":"codeVoice"},{"text":" to choose","type":"text"},{"text":" ","type":"text"},{"text":"justification based on anchor position.","type":"text"}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"textVariableAnchorOffset","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"type":"text","text":" "},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When present, this property takes precedence over "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"textVariableAnchor"},{"type":"text","text":", "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":", and "},{"type":"codeVoice","code":"textRadialOffset"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"type":"codeVoice","code":"top"},{"type":"text","text":" anchor, "},{"type":"codeVoice","code":"[0, 4]"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted down by 4 ems."}],"type":"paragraph"},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"left","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"type":"codeVoice","code":"[3, 0]"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":"; the text will be shifted right by 3 ems."}],"type":"paragraph"},{"inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"type":"codeVoice","code":"text"},{"text":" is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"symbolPlacement"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MLNSymbolPlacementPoint"},{"text":". Otherwise, it is ignored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant interleaved ","type":"text"},{"type":"codeVoice","code":"MLNTextAnchor"},{"text":" and ","type":"text"},{"code":"CGVector","type":"codeVoice"},{"type":"text","text":" array values"},{"text":" ","type":"text"},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Interpolation and step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable and\/or"},{"text":" ","type":"text"},{"type":"text","text":"feature attributes"}],"type":"paragraph"}]}],"metadata":{"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"title":"textVariableAnchorOffset","role":"symbol","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"symbolKind":"property"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolSt