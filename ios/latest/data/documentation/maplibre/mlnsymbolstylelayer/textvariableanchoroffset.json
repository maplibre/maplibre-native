{"primaryContentSections":[{"declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression","kind":"typeIdentifier"},{"kind":"text","text":" * "},{"text":"textVariableAnchorOffset","kind":"identifier"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"text":" ","type":"text"},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"text":" ","type":"text"},{"text":"Positive offset values indicate right and down, while negative values indicate","type":"text"},{"type":"text","text":" "},{"text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple","type":"text"},{"text":" ","type":"text"},{"text":"offsets to try and place a label using the same anchor.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When present, this property takes precedence over ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"textVariableAnchor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"textRadialOffset"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"json","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""]},{"type":"paragraph","inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"top","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"code":"[0, 4]","type":"codeVoice"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted down by 4 ems."}]},{"type":"paragraph","inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"left","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"code":"[3, 0]","type":"codeVoice"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":"; the text will be shifted right by 3 ems.","type":"text"}]},{"inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"symbolPlacement","type":"codeVoice"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"type":"text","text":". Otherwise, it is ignored."}],"type":"paragraph"},{"inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant interleaved ","type":"text"},{"code":"MLNTextAnchor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CGVector","type":"codeVoice"},{"text":" array values","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"text":" ","type":"text"},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Interpolation and step functions applied to the ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable and\/or","type":"text"},{"text":" ","type":"text"},{"text":"feature attributes","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"property","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","role":"symbol","title":"textVariableAnchorOffset","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}]},"sections":[],"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"code":"textJustify: auto","type":"codeVoice"},{"type":"text","text":" to choose"},{"text":" ","type":"text"},{"text":"justification based on anchor position.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"type":"topic","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","title":"textVariableAnchorOffset","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"text":" ","type":"text"},{"text":"provide an array of ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations, each paired with an offset value."},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"type":"text","text":" "},{"type":"text","text":"moving on to the next location+offset. Use "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"title":"MLNSymbolStyleLayer","fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","url":"\/documentation\/maplibre\/mlnsymbolstylelayer","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","title":"MapLibre","role":"collection","kind":"symbol","url":"\/documentation\/maplibre"}}}