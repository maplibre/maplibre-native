{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset"},"abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"text":" ","type":"text"},{"type":"text","text":"moving on to the next location+offset. Use "},{"code":"textJustify: auto","type":"codeVoice"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"textVariableAnchorOffset"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The length of the array must be even, and must alternate between enum and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"text":" ","type":"text"},{"text":"that point defines the offset when the corresponding anchor location is used.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}],"type":"paragraph"},{"inlineContent":[{"text":"When present, this property takes precedence over ","type":"text"},{"code":"textAnchor","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"textVariableAnchor"},{"type":"text","text":", "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":", and "},{"code":"textRadialOffset","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""]},{"type":"paragraph","inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"top","type":"codeVoice"},{"type":"text","text":" anchor, "},{"code":"[0, 4]","type":"codeVoice"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"text":"; the text will be shifted down by 4 ems.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"type":"codeVoice","code":"left"},{"type":"text","text":" anchor, "},{"type":"codeVoice","code":"[3, 0]"},{"type":"text","text":" will be used for"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":"; the text will be shifted right by 3 ems."}]},{"type":"paragraph","inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"symbolPlacement"},{"text":" is set to an expression that evaluates to or","type":"text"},{"type":"text","text":" "},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"type":"text","text":". Otherwise, it is ignored."}]},{"type":"paragraph","inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}]},{"inlineContent":[{"type":"text","text":"Constant interleaved "},{"type":"codeVoice","code":"MLNTextAnchor"},{"type":"text","text":" and "},{"code":"CGVector","type":"codeVoice"},{"text":" array values","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"text":" ","type":"text"},{"text":"Conditional expressions","type":"text"},{"type":"text","text":" "},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Interpolation and step functions applied to the ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable and\/or","type":"text"},{"text":" ","type":"text"},{"text":"feature attributes","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"MapLibre"}],"title":"textVariableAnchorOffset","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"roleHeading":"Instance Property","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}]},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer","role":"symbol","fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"title":"MLNSymbolStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","url":"\/documentation\/maplibre","type":"topic","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"title":"textVariableAnchorOffset","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provide an array of "},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"type":"codeVoice","code":"textJustify: auto"},{"text":" to choose","type":"text"},{"type":"text","text":" "},{"text":"justification based on anchor position.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset","type":"topic"}}}