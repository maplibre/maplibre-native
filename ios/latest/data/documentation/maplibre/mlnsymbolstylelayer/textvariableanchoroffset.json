{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset"},"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"preciseIdentifier":"c:objc(cs)NSExpression","kind":"typeIdentifier","text":"NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"textVariableAnchorOffset"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"type":"text","text":" "},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}]},{"type":"paragraph","inlineContent":[{"text":"When present, this property takes precedence over ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"textVariableAnchor","type":"codeVoice"},{"type":"text","text":", "},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":", and "},{"code":"textRadialOffset","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"json","type":"codeListing","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"code":"top","type":"codeVoice"},{"type":"text","text":" anchor, "},{"type":"codeVoice","code":"[0, 4]"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted down by 4 ems."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"type":"codeVoice","code":"left"},{"type":"text","text":" anchor, "},{"code":"[3, 0]","type":"codeVoice"},{"type":"text","text":" will be used for"},{"text":" ","type":"text"},{"type":"codeVoice","code":"textOffset"},{"text":"; the text will be shifted right by 3 ems.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"code":"text","type":"codeVoice"},{"type":"text","text":" is non-"},{"type":"codeVoice","code":"nil"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"symbolPlacement","type":"codeVoice"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"type":"text","text":". Otherwise, it is ignored."}]},{"inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant interleaved ","type":"text"},{"type":"codeVoice","code":"MLNTextAnchor"},{"type":"text","text":" and "},{"code":"CGVector","type":"codeVoice"},{"text":" array values","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Interpolation and step functions applied to the "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable and\/or"},{"type":"text","text":" "},{"type":"text","text":"feature attributes"}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"title":"textVariableAnchorOffset","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset"},"abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"type":"text","text":" "},{"text":"provide an array of ","type":"text"},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations, each paired with an offset value."},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"type":"text","text":" "},{"type":"text","text":"moving on to the next location+offset. Use "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset",