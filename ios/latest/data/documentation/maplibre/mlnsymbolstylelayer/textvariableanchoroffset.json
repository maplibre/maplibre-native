{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"role":"symbol","navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"symbolKind":"property","title":"textVariableAnchorOffset","fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"roleHeading":"Instance Property","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset"},"abstract":[{"text":"To increase the chance of placing high-priority labels on the map, you can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"text":" ","type":"text"},{"text":"The renderer will attempt to place the label at each location, in order, before","type":"text"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"code":"textJustify: auto","type":"codeVoice"},{"text":" to choose","type":"text"},{"text":" ","type":"text"},{"text":"justification based on anchor position.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression","kind":"typeIdentifier"},{"kind":"text","text":" * "},{"kind":"identifier","text":"textVariableAnchorOffset"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"type":"text","text":" "},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple","type":"text"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When present, this property takes precedence over "},{"code":"textAnchor","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"code":"textVariableAnchor","type":"codeVoice"},{"type":"text","text":", "},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":", and "},{"code":"textRadialOffset","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"json","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"top","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"code":"[0, 4]","type":"codeVoice"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted down by 4 ems."}]},{"inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"code":"left","type":"codeVoice"},{"type":"text","text":" anchor, "},{"code":"[3, 0]","type":"codeVoice"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":"; the text will be shifted right by 3 ems."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property is only applied to the style if "},{"code":"text","type":"codeVoice"},{"type":"text","text":" is non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"symbolPlacement","type":"codeVoice"},{"type":"text","text":" is set to an expression that evaluates to or"},{"type":"text","text":" "},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"type":"text","text":". Otherwise, it is ignored."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can set this property to an expression containing any of the following:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant interleaved "},{"code":"MLNTextAnchor","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CGVector"},{"type":"text","text":" array values"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"type":"text","text":" "},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Interpolation and step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable and\/or"},{"type":"text","text":" "},{"text":"feature attributes","type":"text"}]}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"title":"MLNSymbolStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","url":"\/documentation\/maplibre\/mlnsymbolstylelayer","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","type":"reference"},{"text":" is a style layer that renders icon and text labels","type":"text"},{"text":" ","type":"text"},{"text":"at points or along lines on the map.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","role":"collection","url":"\/documentation\/maplibre","title":"MapLibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"kind":"symbol","role":"symbol","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset","title":"textVariableAnchorOffset","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","type":"topic","abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations, each paired with an offset value."},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"type":"text","text":" "},{"type":"text","text":"moving on to the next location+offset. Use "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}]}}}