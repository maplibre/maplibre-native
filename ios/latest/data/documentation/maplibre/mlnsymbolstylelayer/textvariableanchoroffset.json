{"abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"text":" ","type":"text"},{"text":"provide an array of ","type":"text"},{"code":"textAnchor","type":"codeVoice"},{"text":" locations, each paired with an offset value.","type":"text"},{"text":" ","type":"text"},{"text":"The renderer will attempt to place the label at each location, in order, before","type":"text"},{"text":" ","type":"text"},{"text":"moving on to the next location+offset. Use ","type":"text"},{"code":"textJustify: auto","type":"codeVoice"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"textVariableAnchorOffset","kind":"identifier"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"text":"that point defines the offset when the corresponding anchor location is used.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When present, this property takes precedence over "},{"code":"textAnchor","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"textVariableAnchor","type":"codeVoice"},{"type":"text","text":", "},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":", and "},{"code":"textRadialOffset","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"json","type":"codeListing","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"code":"top","type":"codeVoice"},{"type":"text","text":" anchor, "},{"code":"[0, 4]","type":"codeVoice"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":"; the text will be shifted down by 4 ems."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"code":"left","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"code":"[3, 0]","type":"codeVoice"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":"; the text will be shifted right by 3 ems.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"symbolPlacement","type":"codeVoice"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"text":". Otherwise, it is ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Constant interleaved ","type":"text"},{"code":"MLNTextAnchor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CGVector","type":"codeVoice"},{"text":" array values","type":"text"},{"text":" ","type":"text"},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"text":" ","type":"text"},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"text":"Interpolation and step functions applied to the ","type":"text"},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable and\/or","type":"text"},{"text":" ","type":"text"},{"text":"feature attributes","type":"text"}]}]}],"metadata":{"navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"title":"textVariableAnchorOffset","roleHeading":"Instance Property","modules":[{"name":"MapLibre"}],"role":"symbol","fragments":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","symbolKind":"property"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","interfaceLanguage":"occ"},"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textVariableAnchorOffset":{"title":"textVariableAnchorOffset","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyl