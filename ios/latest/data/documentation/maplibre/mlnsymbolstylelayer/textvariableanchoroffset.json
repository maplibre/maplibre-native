{"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations, each paired with an offset value."},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"type":"text","text":" "},{"type":"text","text":"moving on to the next location+offset. Use "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"text":"NSExpression","preciseIdentifier":"c:objc(cs)NSExpression","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"textVariableAnchorOffset","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"type":"text","text":" "},{"text":"Positive offset values indicate right and down, while negative values indicate","type":"text"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"text":"offsets to try and place a label using the same anchor.","type":"text"}]},{"inlineContent":[{"text":"When present, this property takes precedence over ","type":"text"},{"code":"textAnchor","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"textVariableAnchor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"textRadialOffset"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"json","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""],"type":"codeListing"},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"top","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"type":"codeVoice","code":"[0, 4]"},{"type":"text","text":" will be used for"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":"; the text will be shifted down by 4 ems.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the renderer chooses the "},{"type":"codeVoice","code":"left"},{"type":"text","text":" anchor, "},{"type":"codeVoice","code":"[3, 0]"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted right by 3 ems."}]},{"type":"paragraph","inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"symbolPlacement","type":"codeVoice"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"text":". Otherwise, it is ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can set this property to an expression containing any of the following:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant interleaved "},{"code":"MLNTextAnchor","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CGVector","type":"codeVoice"},{"type":"text","text":" array values"},{"type":"text","text":" "},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Interpolation and step functions applied to the "},{"code":"$zoomLevel","type":"codeVoice"},{"text":" variable and\/or","type":"text"},{"text":" ","type":"text"},{"text":"feature attributes","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"roleHeading":"Instance Property","title":"textVariableAnchorOffset","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"role":"symbol","symbolKind":"property","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"sections":[],"kind":"symbol","references":{"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","type":"topic","url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","abs