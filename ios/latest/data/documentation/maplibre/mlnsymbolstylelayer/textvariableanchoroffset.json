{"kind":"symbol","abstract":[{"type":"text","text":"To increase the chance of placing high-priority labels on the map, you can"},{"type":"text","text":" "},{"type":"text","text":"provide an array of "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":" locations, each paired with an offset value."},{"type":"text","text":" "},{"type":"text","text":"The renderer will attempt to place the label at each location, in order, before"},{"type":"text","text":" "},{"type":"text","text":"moving on to the next location+offset. Use "},{"type":"codeVoice","code":"textJustify: auto"},{"type":"text","text":" to choose"},{"type":"text","text":" "},{"type":"text","text":"justification based on anchor position."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","text":"NSExpression","preciseIdentifier":"c:objc(cs)NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"textVariableAnchorOffset"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The length of the array must be even, and must alternate between enum and"},{"type":"text","text":" "},{"type":"text","text":"point entries. i.e., each anchor location must be accompanied by a point, and"},{"type":"text","text":" "},{"type":"text","text":"that point defines the offset when the corresponding anchor location is used."},{"type":"text","text":" "},{"type":"text","text":"Positive offset values indicate right and down, while negative values indicate"},{"type":"text","text":" "},{"type":"text","text":"left and up. Anchor locations may repeat, allowing the renderer to try multiple"},{"type":"text","text":" "},{"type":"text","text":"offsets to try and place a label using the same anchor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When present, this property takes precedence over "},{"type":"codeVoice","code":"textAnchor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"textVariableAnchor"},{"type":"text","text":", "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":", and "},{"code":"textRadialOffset","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["","{ \"text-variable-anchor-offset\": [\"top\", [0, 4], \"left\", [3,0], \"bottom\", [1,","1]] } ",""]},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"code":"top","type":"codeVoice"},{"text":" anchor, ","type":"text"},{"code":"[0, 4]","type":"codeVoice"},{"text":" will be used for","type":"text"},{"text":" ","type":"text"},{"code":"textOffset","type":"codeVoice"},{"text":"; the text will be shifted down by 4 ems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the renderer chooses the ","type":"text"},{"type":"codeVoice","code":"left"},{"type":"text","text":" anchor, "},{"type":"codeVoice","code":"[3, 0]"},{"type":"text","text":" will be used for"},{"type":"text","text":" "},{"type":"codeVoice","code":"textOffset"},{"type":"text","text":"; the text will be shifted right by 3 ems."}],"type":"paragraph"},{"inlineContent":[{"text":"This property is only applied to the style if ","type":"text"},{"type":"codeVoice","code":"text"},{"type":"text","text":" is non-"},{"type":"codeVoice","code":"nil"},{"text":", and","type":"text"},{"type":"text","text":" "},{"code":"symbolPlacement","type":"codeVoice"},{"text":" is set to an expression that evaluates to or","type":"text"},{"text":" ","type":"text"},{"code":"MLNSymbolPlacementPoint","type":"codeVoice"},{"text":". Otherwise, it is ignored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can set this property to an expression containing any of the following:"}],"type":"paragraph"},{"inlineContent":[{"text":"Constant interleaved ","type":"text"},{"code":"MLNTextAnchor","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"CGVector"},{"text":" array values","type":"text"},{"type":"text","text":" "},{"text":"Predefined functions, including mathematical and string operators","type":"text"},{"type":"text","text":" "},{"text":"Conditional expressions","type":"text"},{"text":" ","type":"text"},{"text":"Variable assignments and references to assigned variables","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Interpolation and step functions applied to the "},{"code":"$zoomLevel","type":"codeVoice"},{"type":"text","text":" variable and\/or"},{"text":" ","type":"text"},{"text":"feature attributes","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/textvariableanchoroffset"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"externalID":"c:objc(cs)MLNSymbolStyleLayer(py)textVariableAnchorOffset","modules":[{"name":"MapLibre"}],"title":"textVariableAnchorOffset","role":"symbol","symbolKind":"property","navigatorTitle":[{"text":"textVariableAnchorOffset","kind":"identifier"}],"fragments":[{"kind":"identifier","text":"textVariableAnchorOffset"}],"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textVariableAnchorOffset"},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","url":"\/documentation\/maplibre","kind":"symbol","abstract":[{"text":"Po