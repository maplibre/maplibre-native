ned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"type":"text","text":" "},{"type":"text","text":"attributes."}]}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/symbolAvoidsEdges":{"title":"symbolAvoidsEdges","kind":"symbol","abstract":[{"text":"Whether symbols in this layer avoid colliding with symbols in adjacent tiles.","type":"text"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/symbolAvoidsEdges","fragments":[{"kind":"identifier","text":"symbolAvoidsEdges"}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/symbolavoidsedges","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolPlacement/MLNSymbolPlacementPoint":{"url":"\/documentation\/maplibre\/mlnsymbolplacement\/mlnsymbolplacementpoint","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint","abstract":[{"type":"text","text":"The label is placed at the point where the geometry is located."}],"role":"symbol","fragments":[{"text":"MLNSymbolPlacementPoint","kind":"identifier"}],"title":"MLNSymbolPlacementPoint","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","type":"topic","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","role":"collection"},"doc:/