{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"symbolAvoidsEdges","kind":"identifier"}],"title":"symbolAvoidsEdges","modules":[{"name":"MapLibre"}],"navigatorTitle":[{"kind":"identifier","text":"symbolAvoidsEdges"}],"role":"symbol","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolAvoidsEdges"},"abstract":[{"type":"text","text":"Whether symbols in this layer avoid colliding with symbols in adjacent tiles."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"symbolAvoidsEdges","kind":"identifier"},{"text":";","kind":"text"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"If this property is set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", symbols in this layer avoid crossing the","type":"text"},{"text":" ","type":"text"},{"text":"edge of a tile. You should set this property to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if the backing vector","type":"text"},{"text":" ","type":"text"},{"text":"tiles don’t have enough padding to prevent collisions, or if this layer’s","type":"text"},{"text":" ","type":"text"},{"code":"symbolPlacement","type":"codeVoice"},{"text":" property is set to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint","isActive":true,"type":"reference"},{"text":" but this layer is