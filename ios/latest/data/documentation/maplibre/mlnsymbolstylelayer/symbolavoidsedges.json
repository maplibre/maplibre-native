{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/symbolAvoidsEdges","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"]]},"metadata":{"symbolKind":"property","title":"symbolAvoidsEdges","role":"symbol","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolAvoidsEdges","roleHeading":"Instance Property","fragments":[{"text":"symbolAvoidsEdges","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"symbolAvoidsEdges","kind":"identifier"}]},"kind":"symbol","sections":[],"abstract":[{"text":"Whether symbols in this layer avoid colliding with symbols in adjacent tiles.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSExpression","text":"NSExpression"},{"kind":"text","text":" * "},{"kind":"identifier","text":"symbolAvoidsEdges"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If this property is set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":", symbols in this layer avoid crossing the"},{"type":"text","text":" "},{"type":"text","text":"edge of a tile. You should set this property to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the backing vector"},{"type":"text","text":" "},{"type":"text","text":"tiles don’t have enough padding to prevent collisions, or if this layer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"symbolPlacement"},{"type":"text","text":" property is set to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint"},{"type":"text","text":" but this layer is above a symbol"},{"type":"text","text":" "},{"type":"text","text":"layer whose "},{"type":"codeVoice","code":"symbolPlacement"},{"type":"text","text":" property is set to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint"},{"type":"text","text":". You do not need to enable this"},{"type":"text","text":" "},{"type":"text","text":"property to prevent clipped labels at tile boundaries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default value of this property is an expression that evaluates to "},{"type":"codeVoice","code":"NO"},{"type":"text","text":". Set"},{"type":"text","text":" "},{"type":"text","text":"this property to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to reset it to the default value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This attribute corresponds to the "},{"type":"text","text":"symbol-avoid-edges"},{"type":"text","text":" "},{"type":"text","text":"layout property in the MapLibre Style Spec."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can set this property to an expression containing any of the following:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Constant Boolean values"},{"type":"text","text":" "},{"type":"text","text":"Predefined functions, including mathematical and string operators"},{"type":"text","text":" "},{"type":"text","text":"Conditional expressions"},{"type":"text","text":" "},{"type":"text","text":"Variable assignments and references to assigned variables"},{"type":"text","text":" "},{"type":"text","text":"Step functions applied to the "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property does not support applying interpolation functions to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"$zoomLevel"},{"type":"text","text":" variable or applying interpolation or step functions to feature"},{"type":"text","text":" "},{"type":"text","text":"attributes."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/maplibre\/mlnsymbolstylelayer\/symbolavoidsedges"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer"},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"role":"symbol","kind":"symbol","type":"topic","title":"MLNSymbolStyleLayer","url":"\/documentation\/maplibre\/mlnsymbolstylelayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","type":"topic","url":"\/documentation\/maplibre","role":"collection","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolPlacement/MLNSymbolPlacementPoint":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint","abstract":[{"text":"The label is placed at the point where the geometry is located.","type":"text"}],"url":"\/documentation\/maplibre\/mlnsymbolplacement\/