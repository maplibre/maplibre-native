r step functions to feature","type":"text"},{"text":" ","type":"text"},{"text":"attributes.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"fragments":[{"text":"symbolAvoidsEdges","kind":"identifier"}],"navigatorTitle":[{"text":"symbolAvoidsEdges","kind":"identifier"}],"roleHeading":"Instance Property","externalID":"c:objc(cs)MLNSymbolStyleLayer(py)symbolAvoidsEdges","title":"symbolAvoidsEdges","symbolKind":"property","modules":[{"name":"MapLibre"}],"role":"symbol"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/symbolAvoidsEdges":{"title":"symbolAvoidsEdges","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/symbolavoidsedges","type":"topic","fragments":[{"text":"symbolAvoidsEdges","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/symbolAvoidsEdges","abstract":[{"type":"text","text":"Whether symbols in this layer avoid colliding with symbols in adjacent tiles."}],"kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolPlacement/MLNSymbolPlacementPoint":{"url":"\/documentation\/maplibre\/mlnsymbolplacement\/mlnsymbolplacementpoint","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolPlacement\/MLNSymbolPlacementPoint","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNSymbolPlacementPoint"}],"title":"MLNSymbolPlacementPoint","type":"topic","abstract":[{"text":"The label is placed at the point where the geometry is located.","type":"text"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"fragments":[{"text":"MLNSymbolStyleLayer","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"MLNSymbolStyleLayer","type":"topic","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSym