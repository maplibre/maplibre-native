{"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"extern","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MLNTileSourceOption","kind":"typeIdentifier","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOption","preciseIdentifier":"c:MLNTileSource.h@T@MLNTileSourceOption"},{"text":" ","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MLNTileSourceOptionTileSize","kind":"identifier"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"mentions":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The default value for this option is 512. Version 4 of the"},{"type":"text","text":" "},{"type":"text","text":"Mapbox Raster Tiles API"},{"type":"text","text":" "},{"type":"text","text":"requires a value of 256, as do many third-party tile servers, so consult your"},{"type":"text","text":" "},{"type":"text","text":"provider’s documentation for the correct value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This option is only applicable to "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterTileSource","isActive":true},{"type":"text","text":" objects; it is ignored"},{"type":"text","text":" "},{"type":"text","text":"when initializing "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":" objects."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"MapLibre"}],"symbolKind":"var","fragments":[{"text":"MLNTileSourceOptionTileSize","kind":"identifier"}],"role":"symbol","roleHeading":"Global Variable","externalID":"c:@MLNTileSourceOptionTileSize","title":"MLNTileSourceOptionTileSize","navigatorTitle":[{"text":"MLNTileSourceOptionTileSize","kind":"identifier"}]},"sections":[],"variants":[{"paths":["\/documentation\/maplibre\/mlntilesourceoptiontilesize"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionTileSize","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"abstract":[{"type":"text","text":"An "},{"code":"NSNumber","type":"codeVoice"},{"type":"text","text":" object containing a floating-point number that specifies the"},{"type":"text","text":" "},{"type":"text","text":"width and height (measured in points) at which the map displays each raster"},{"type":"text","text":" "},{"type":"text","text":"image tile when the map’s zoom level is an integer. The raster tile source"},{"type":"text","text":" "},{"type":"text","text":"scales its images up or down when the map’s zoom level falls between two"},{"type":"text","text":" "},{"type":"text","text":"integers."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","url":"\/documentation\/maplibre","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"role":"symbol","url":"\/documentation\/maplibre\/mlnrasterstylelayer","fragments":[{"kind":"identifier","text":"MLNRasterStyleLayer"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","title":"MLNRasterStyleLayer","kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","is