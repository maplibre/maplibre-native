{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Request an asynchronous update to the pack’s "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" properties."}],"metadata":{"modules":[{"name":"MapLibre"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"requestProgress","kind":"identifier"}],"role":"symbol","symbolKind":"method","externalID":"c:objc(cs)MLNOfflinePack(im)requestProgress","fragments":[{"text":"- ","kind":"text"},{"text":"requestProgress","kind":"identifier"}],"title":"requestProgress","roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"requestProgress","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The state and progress of an inactive or completed pack are computed lazily. If","type":"text"},{"text":" ","type":"text"},{"text":"you need the state or progress of a pack whose ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" property is currently","type":"text"},{"text":" ","type":"text"},{"text":"set to ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","isActive":true},{"text":", observe KVO change notifications on this","type":"text"},{"text":" ","type":"text"},{"text":"pack’s ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" key path, then call this method. Alternatively, you can add an","type":"text"},{"text":" ","type":"text"},{"text":"observer for ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"text":" about this pack that","type":"text"},{"text":" ","type":"text"},{"text":"come from the default notification center.","type":"text"}]}],"kind":"content"}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/requestProgress","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinepack\/requestprogress"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateUnknown":{"abstract":[{"type":"text","text":"It is unknown whether the pack is inactive, active, or complete."}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"MLNOfflinePackStateUnknown"}],"url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown","title":"MLNOfflinePackStateUnknown"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/requestProgress":{"url":"\/documentation\/maplibre\/mlnofflinepack\/requestprogress","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/requestProgress","abstract":[{"type":"text","text":"Request an asynchronous update to the pack’s "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" properties."}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"requestProgress"}],"role":"symbol","title":"requestProgress","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","k