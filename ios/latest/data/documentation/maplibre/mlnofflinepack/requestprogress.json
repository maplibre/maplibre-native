faceLanguage":"occ"}]}],"metadata":{"title":"requestProgress","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"MapLibre"}],"externalID":"c:objc(cs)MLNOfflinePack(im)requestProgress","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"requestProgress","kind":"identifier"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"requestProgress","kind":"identifier"}]},"sections":[],"abstract":[{"text":"Request an asynchronous update to the pack’s ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"progress"},{"type":"text","text":" properties."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateUnknown":{"role":"symbol","fragments":[{"text":"MLNOfflinePackStateUnknown","kind":"identifier"}],"type":"topic","title":"MLNOfflinePackStateUnknown","kind":"symbol","abstract":[{"type":"text","text":"It is unknown whether the pack is inactive, active, or complete."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown"},"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","role":"collection","url":"\/documentation\/maplibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage":{"url":"\/documentation\/maplibre\/mlnofflinestorage","fragments":[{"kind":"identifier","text":"MLNOfflineStorage"}],"type":"topic","abstract":[{"type":"text","text":"MLNOfflineStorage implements a singleton (shared object) that manages offline"},{"type":"text","text":" "},{"type":"text","text":"packs