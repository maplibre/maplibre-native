:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"},{"type":"text","text":" "},{"type":"text","text":"object’s progress changes. The progress may change due to a resource being"},{"type":"text","text":" "},{"type":"text","text":"downloaded or because the pack discovers during the download that more"},{"type":"text","text":" "},{"type":"text","text":"resources are required for offline viewing. This notification is posted"},{"type":"text","text":" "},{"type":"text","text":"whenever any field in the "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" property changes."}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/state":{"url":"\/documentation\/maplibre\/mlnofflinepack\/state","title":"state","type":"topic","abstract":[{"text":"The pack’s current state.","type":"text"}],"fragments":[{"kind":"identifier","text":"state"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/state","kind":"symbol","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState":{"kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"MLNOfflinePackState"}],"url":"\/documentation\/maplibre\/mlnofflinepackstate","title":"MLNOfflinePackState","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState","abstract":[{"text":"The state an offline pack is currently in.","type":"text"}]}}}