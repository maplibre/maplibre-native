xt":" "},{"code":"-requestProgress","type":"codeVoice"},{"type":"text","text":" method. To get notified when the state becomes known and"},{"text":" ","type":"text"},{"type":"text","text":"when it changes, observe KVO change notifications on this pack’s "},{"code":"state","type":"codeVoice"},{"text":" key","type":"text"},{"type":"text","text":" "},{"type":"text","text":"path. Alternatively, you can add an observer for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","isActive":true},{"type":"text","text":"s about this pack that come from the"},{"text":" ","type":"text"},{"type":"text","text":"default notification center."}]}]}],"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/state":{"kind":"symbol","role":"symbol","abstract":[{"text":"The pack’s current state.","type":"text"}],"title":"state","fragments":[{"text":"state","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/state","type":"topic","url":"\/documentation\/maplibre\/mlnofflinepack\/state"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateUnknown":{"type":"topic","role":"symbol","abstract":[{"text":"It is unknown whether the pack is inactive, active, or complete.","type":"text"}],"title":"MLNOfflinePackStateUnknown","fragments":[{"kind":"identifier","text":"MLNOfflinePackStateUnknown"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown","url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState":{"type":"topic","role":"symbol","abstract":[{"text":"The state an offline pack is currently in.","type":"text"}],"title":"MLNOfflinePackState","fragments":[{"kind":"identifier","text":"MLNOffline