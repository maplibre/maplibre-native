when it changes, observe KVO change notifications on this pack’s ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" key","type":"text"},{"text":" ","type":"text"},{"text":"path. Alternatively, you can add an observer for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackProgressChangedNotification","type":"reference"},{"text":"s about this pack that come from the","type":"text"},{"text":" ","type":"text"},{"text":"default notification center.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The pack’s current state."}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/state","interfaceLanguage":"occ"},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState/MLNOfflinePackStateUnknown":{"type":"topic","title":"MLNOfflinePackStateUnknown","role":"symbol","kind":"symbol","fragments":[{"text":"MLNOfflinePackStateUnknown","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnofflinepackstate\/mlnofflinepackstateunknown","abstract":[{"text":"It is unknown whether the pack is inactive, active, or complete.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState\/MLNOfflinePackStateUnknown"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePackState":{"role":"symbol","abstract":[{"text":"The state an offline pack is currently in.","type":"text"}],"type":"topic","fragments":[{"text":"MLNOfflinePackState","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepackstate","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePackState","title":"MLNOfflinePackState"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/state":{"role":"symbol","abstract":[{"text":"The pack’s current state.","type":"text"}],"type":"topic","fragments":[{"text":"state","kind":"identifier"}],"kind":