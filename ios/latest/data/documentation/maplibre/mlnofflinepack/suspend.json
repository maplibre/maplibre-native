{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"- (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"suspend","kind":"identifier"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pack suspends asynchronously, so some network requests may be sent after this"},{"type":"text","text":" "},{"type":"text","text":"method is called. Regardless, the "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" property will not be updated until"},{"type":"text","text":" "},{"type":"codeVoice","code":"-resume"},{"type":"text","text":" is called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the pack previously reached a higher level of progress before being"},{"type":"text","text":" "},{"type":"text","text":"suspended, it may wait to suspend until it returns to that level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume downloading, call the "},{"type":"codeVoice","code":"-resume"},{"type":"text","text":" method."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinepack\/suspend"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"symbolKind":"method","externalID":"c:objc(cs)MLNOfflinePack(im)suspend","title":"suspend","role":"symbol","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"suspend"}],"fragments":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method"},"kind":"symbol","abstract":[{"type":"text","text":"Temporarily stops downloading if the pack is active."}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documenta