{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre\/mlnofflinepack\/suspend"]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/suspend","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"]]},"kind":"symbol","metadata":{"symbolKind":"method","externalID":"c:objc(cs)MLNOfflinePack(im)suspend","modules":[{"name":"MapLibre"}],"role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}],"title":"suspend","roleHeading":"Instance Method"},"abstract":[{"text":"Temporarily stops downloading if the pack is active.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"suspend","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A pack suspends asynchronously, so some network requests may be sent after this"},{"type":"text","text":" "},{"type":"text","text":"method is called. Regardless, the "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" property will not be updated until"},{"type":"text","text":" "},{"code":"-resume","type":"codeVoice"},{"type":"text","text":" is called."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the pack previously reached a higher level of progress before being"},{"type":"text","text":" "},{"type":"text","text":"suspended, it may wait to suspend until it returns to that level."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To resume downloading, call the "},{"code":"-resume","type":"codeVoice"},{"type":"text","text":" method."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"role":"collection","kind":"symbol","title":"MapLibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack":{"type":"topic","fragments":[{"text":"MLNOfflinePack","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"},{"type":"text","text":" represents a collection of resources necessary for viewing"},{"type":"text","text":" "},{"type":"text","text":"a region offline to a local database."}],"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","title":"MLNOfflinePack","kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepack"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/suspend":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/suspend","url":"\/documentation\/maplibre\/mlnofflinepack\/suspend","abstract":[{"text":"Temporarily stops downloading if the pack is active.","type":"text"}],"type":"topic","title":"suspend","kind":"symbol","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}]}}}