{"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinepack\/suspend"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Temporarily stops downloading if the pack is active.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"suspend","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pack suspends asynchronously, so some network requests may be sent after this"},{"type":"text","text":" "},{"type":"text","text":"method is called. Regardless, the "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" property will not be updated until"},{"type":"text","text":" "},{"type":"codeVoice","code":"-resume"},{"type":"text","text":" is called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the pack previously reached a higher level of progress before being"},{"type":"text","text":" "},{"type":"text","text":"suspended, it may wait to suspend until it returns to that level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume downloading, call the "},{"type":"codeVoice","code":"-resume"},{"type":"text","text":" method."}]}],"kind":"content"}],"metadata":{"fragments":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method","title":"suspend","role":"symbol","symbolKind":"method","externalID":"c:objc(cs)MLNOfflinePack(im)suspend","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}]},"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/suspend"},"kind":"