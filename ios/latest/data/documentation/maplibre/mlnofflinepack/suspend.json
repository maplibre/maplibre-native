{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"]]},"kind":"symbol","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/suspend"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"method","modules":[{"name":"MapLibre"}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"suspend"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"suspend","kind":"identifier"}],"roleHeading":"Instance Method","role":"symbol","externalID":"c:objc(cs)MLNOfflinePack(im)suspend","title":"suspend"},"abstract":[{"type":"text","text":"Temporarily stops downloading if the pack is active."}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"- ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"suspend"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pack suspends asynchronously, so some network requests may be sent after this"},{"type":"text","text":" "},{"type":"text","text":"method is called. Regardless, the "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" property will not be updated until"},{"type":"text","text":" "},{"code":"-resume","type":"codeVoice"},{"type":"text","text":" is called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the pack previously reached a higher level of progress before being"},{"type":"text","text":" "},{"type":"text","text":"suspended, it may wait to suspend until it returns to that level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume downloading