,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","url":"\/documentation\/maplibre\/mlnofflinepack","title":"MLNOfflinePack","kind":"symbol","type":"topic","fragments":[{"text":"MLNOfflinePack","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack","type":"reference","isActive":true},{"type":"text","text":" represents a collection of resources necessary for viewing"},{"type":"text","text":" "},{"type":"text","text":"a region offline to a local database."}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflinePack/resume":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","kind":"symbol","url":"\/documentation\/maplibre\/mlnofflinepack\/resume","type":"topic","title":"resume","fragments":[{"text":"- ","kind":"text"},{"text":"resume","kind":"identifier"}],"abstract":[{"text":"Resumes downloading if the pack is inactive.","type":"text"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","type":"topic","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"kind":"symbol","title":"MapLibre"}}}