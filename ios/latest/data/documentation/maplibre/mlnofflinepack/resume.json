{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"- ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"resume"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a pack resumes after being suspended, it may begin by iterating over the"},{"type":"text","text":" "},{"type":"text","text":"already downloaded resources. As a result, the "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" structure’s"},{"type":"text","text":" "},{"code":"countOfResourcesCompleted","type":"codeVoice"},{"type":"text","text":" field may revert to 0 before rapidly returning to"},{"type":"text","text":" "},{"type":"text","text":"the level of progress at the time the pack was suspended."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To temporarily suspend downloading, call the "},{"type":"codeVoice","code":"-suspend"},{"type":"text","text":" method."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlnofflinepack\/resume"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"roleHeading":"Instance Method","title":"resume","symbolKind":"method","externalID":"c:objc(cs)MLNOfflinePack(im)resume","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"resume","kind":"identifier"}],"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"resume"}],"modules":[{"name":"MapLibre"}]},"identifier":{"url":"doc:\/\/org.