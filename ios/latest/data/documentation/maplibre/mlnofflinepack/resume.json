{"sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack\/resume","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Resumes downloading if the pack is inactive."}],"metadata":{"externalID":"c:objc(cs)MLNOfflinePack(im)resume","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"resume"}],"fragments":[{"text":"- ","kind":"text"},{"text":"resume","kind":"identifier"}],"symbolKind":"method","title":"resume","role":"symbol","modules":[{"name":"MapLibre"}],"roleHeading":"Instance Method"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"resume","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a pack resumes after being suspended, it may begin by iterating over the"},{"type":"text","text":" "},{"type":"text","text":"already downloaded resources. As a result, the "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" structure’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"countOfResourcesCompleted"},{"type":"text","text":" field may revert to 0 before rapidly returning to"},{"type":"text","text":" "},{"type":"text","text":"the level of progress at the time the pack was suspended."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To temporarily suspend downloading, call the "},{"code":"-suspend","type":"codeVoice"},{"type":"text","text":" method."}]}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflinePack"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlnof