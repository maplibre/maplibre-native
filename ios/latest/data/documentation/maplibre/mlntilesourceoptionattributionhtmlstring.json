Layer","isActive":true},{"type":"text","text":" objects. Use a style layer to"},{"type":"text","text":" "},{"type":"text","text":"control the appearance of content supplied by the tile source."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNTileSourceOption":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOption","fragments":[{"text":"MLNTileSourceOption","kind":"identifier"}],"title":"MLNTileSourceOption","role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlntilesourceoption","abstract":[{"type":"text","text":"Options for "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource","isActive":true},{"type":"text","text":" objects."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","role":"collection","kind":"symbol","url":"\/documentation\/maplibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNTileSourceOptionAttributionInfos":{"kind":"symbol","title":"MLNTileSourceOptionAttributionInfos","abstract":[{"type":"text","text":"An array of "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAttributionInfo","isActive":true},{"type":"text","text":" objects defining the buttons to be displayed"},{"type":"text","text":" "},{"type":"text","text":"in an action sheet when the source is part of a map view’s style and the map"},{"type":"text","text":" "},{"type":"text","text":"view’s attribution button is pressed."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionAttributionInfos","fragments":[{"text":"MLNTileSourceOptionAttributionInfos","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlntilesourceoptionattributi