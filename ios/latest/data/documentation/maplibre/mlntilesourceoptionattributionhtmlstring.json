{"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"extern","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOption","preciseIdentifier":"c:MLNTileSource.h@T@MLNTileSourceOption","text":"MLNTileSourceOption","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MLNTileSourceOptionAttributionHTMLString","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"By default, no attribution statements are displayed. If the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionAttributionInfos","isActive":true,"type":"reference"},{"type":"text","text":" option is specified, this option is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This option corresponds to the "},{"type":"codeVoice","code":"attribution"},{"type":"text","text":" key in the"},{"type":"text","text":" "},{"type":"text","text":"TileJSON"},{"type":"text","text":" "},{"type":"text","text":"specification."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","externalID":"c:@MLNTileSourceOptionAttributionHTMLString","fragments":[{"text":"MLNTileSourceOptionAttributionHTMLString","kind":"identifier"}],"navigatorTitle":[{"text":"MLNTileSourceOptionAttributionHTMLString","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"title":"MLNTileSourceOptionAttributionHTMLString","roleHeading":"Global Variable","symbolKind":"var"},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionAttributionHTMLString","interfaceLanguage":"occ"},"hierarchy":{"paths":