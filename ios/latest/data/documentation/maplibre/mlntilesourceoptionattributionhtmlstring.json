Active":true},{"type":"text","text":" object along with one or more"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true},{"type":"text","text":" objects. Use a style layer to"},{"type":"text","text":" "},{"type":"text","text":"control the appearance of content supplied by the tile source."}],"kind":"symbol","url":"\/documentation\/maplibre\/mlntilesource","title":"MLNTileSource","type":"topic","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource","fragments":[{"text":"MLNTileSource","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNAttributionInfo":{"role":"symbol","fragments":[{"text":"MLNAttributionInfo","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNAttributionInfo","abstract":[{"type":"text","text":"Information about an attribution statement, usually a copyright or trademark"},{"type":"text","text":" "},{"type":"text","text":"statement, associated with a map content source."}],"title":"MLNAttributionInfo","kind":"symbol","url":"\/documentation\/maplibre\/mlnattributioninfo"}}}