nd":"identifier"}],"title":"MLNOverlay","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOverlay","url":"\/documentation\/maplibre\/mlnoverlay","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOverlay","isActive":true},{"type":"text","text":" protocol defines a specific type of annotation that represents"},{"type":"text","text":" "},{"type":"text","text":"both a point and an area on a map. Overlay objects are essentially data objects"},{"type":"text","text":" "},{"type":"text","text":"that contain the geographic data needed to represent the map area. Overlays can"},{"type":"text","text":" "},{"type":"text","text":"take the form of a polyline or polygon."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNMultiPolyline/multiPolylineWithPolylines:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMultiPolyline\/multiPolylineWithPolylines:","url":"\/documentation\/maplibre\/mlnmultipolyline\/multipolylinewithpolylines:","type":"topic","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"multiPolylineWithPolylines:","kind":"identifier"}],"abstract":[{"text":"Creates and returns a multipolyline object consisting of the given polylines.","type":"text"}],"title":"multiPolylineWithPolylines:","kind":"symbol"}}}