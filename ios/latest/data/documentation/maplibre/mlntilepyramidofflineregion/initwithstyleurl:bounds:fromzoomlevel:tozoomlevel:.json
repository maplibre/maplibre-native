oom level to be covered by the downloaded"},{"type":"text","text":" "},{"type":"text","text":"tiles. This parameter should be set to at least the value of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumZoomLevel"},{"type":"text","text":" parameter. For each required tile source, if this"},{"type":"text","text":" "},{"type":"text","text":"parameter is set to a value greater than the tile source’s minimum zoom"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the designated initializer for "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTilePyramidOfflineRegion","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Initializes a newly created offline region with the given style URL, geographic"},{"type":"text","text":" "},{"type":"text","text":"coordinate bounds, and range of zoom levels."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre","doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTilePyramidOfflineRegion"]]},"variants":[{"paths":["\/documentation\/maplibre\/mlntilepyramidofflineregion\/initwithstyleurl:bounds:fromzoomlevel:tozoomlevel:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNTilePyramidOfflineRegion/initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:":{"role":"symbol","type":"topic","fragments":[{"text":"- ","kind":"text"},{"text":"initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTilePyramidOfflineRegion\/initWithStyleURL:bou