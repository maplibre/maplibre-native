text":"tiles. This parameter should be set to at least the value of the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumZoomLevel"},{"text":" parameter. For each required tile source, if this","type":"text"},{"text":" ","type":"text"},{"text":"parameter is set to a value greater than the tile source’s minimum zoom","type":"text"},{"type":"text","text":" "},{"type":"text","text":"level, the download covers zoom levels up to the tile source’s maximum zoom"},{"type":"text","text":" "},{"type":"text","text":"level."}]}],"name":"maximumZoomLevel"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This is the designated initializer for ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTilePyramidOfflineRegion","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"kind":"symbol","sections":[],"metadata":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:"}],"symbolKind":"method","externalID":"c:objc(cs)MLNTilePyramidOfflineRegion(im)initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:","title":"initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:","kind":"identifier"}],"modules":[{"name":"MapLibre"}],"role":"symbol","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNTilePyramidOfflineRegion/initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:":{"kind":"symbol","title":"initWithStyleURL:bounds:fromZoomLevel:toZoomLevel:","abstract":[{"type":"text","text":"Initializes a newly created offline region with the given style URL, geographic"},{"type":"text","text":" "},{"type":"text","text":"coordinate bounds, and range