ype":"text","text":" is a style layer that renders raster "},{"type":"text","text":"digital elevation"},{"type":"text","text":" "},{"type":"text","text":"model"},{"type":"text","text":" (DEM) tiles on the map."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"title":"MLNStyleLayer","type":"topic","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionHeight":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionHeight","type":"topic","abstract":[{"type":"text","text":"The height with which to extrude this layer."}],"title":"fillExtrusionHeight","url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusionheight","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"fillExtrusionHeight"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","type":"topic","abstract":[{"type":"text","t