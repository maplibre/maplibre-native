rence","isActive":true},{"type":"text","text":" is a style layer that renders one or more stroked"},{"type":"text","text":" "},{"type":"text","text":"polylines on the map."}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","url":"\/documentation\/maplibre\/mlncirclestylelayer","title":"MLNCircleStyleLayer","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNCircleStyleLayer"}],"abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle/layerWithIdentifier:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle\/layerWithIdentifier:","url":"\/documentation\/maplibre\/mlnstyle\/layerwithidentifier:","title":"layerWithIdentifier:","kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"layerWithIdentifier:"}],"abstract":[{"type":"text","text":"Returns a style layer with the given identifier in the current style."}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionPattern":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionPattern","url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusionpattern","title":"fillExtrusionPattern","kind":"symbol","fragments":[{"kind":"identifier","text":"fillExtrusionPattern"}],"type":"topic","abstract":[{"text":"Name of image in style images to use for drawing image fill-extrusions. For","type":"text"},{"text":" ","type":"text"},{"text":"seamless pa