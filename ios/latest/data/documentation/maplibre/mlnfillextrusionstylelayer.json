 mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","kind":"symbol","role":"collection"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNSymbolStyleLayer"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders icon and text labels"},{"type":"text","text":" "},{"type":"text","text":"at points or along lines on the map."}],"kind":"symbol","title":"MLNSymbolStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnsymbolstylelayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/initWithIdentifier:source:":{"url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/initwithidentifier:source:","abstract":[{"type":"text","text":"Returns a fill-extrusion style layer initialized with an identifier and source."}],"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/initWithIdentifier:source:","fragments":[{"text":"- ","kind":"text"},{"text":"initWithIdentifier:source:","kind":"identifier"}],"title":"initWithIdentifier:source:","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNBackgroundStyleLayer"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" is a style layer that covers the entire map. Use"},{"type":"text","text":" "},{"type":"text","text":"a background style layer to configure a color or pattern to show below all"},{"type":"text","text":" "},{"type":"text","text":"other map content. If the style’s other layers use the Mapbox Streets source,"},{"type":"text","text":" "},{"type":"text","text":"the background style layer is responsible for drawing land, whereas the oceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" objects."}],"kind":"symbol","title":"MLNBackgroundStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnbackgroundstylelayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"kind":"symbol","title":"MLNStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionColor":{"url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusioncolor","abstract":[{"type":"text","text":"The base color of this layer. The extrusion’s surfaces will be shaded"},{"type":"text","text":" "},{"type":"text","text":"differently based on this color in combination with the "},{"code":"light","type":"codeVoice"},{"type":"text","text":" settings. If"},{"type":"text","text":" "},{"type":"text","text":"this color is specified with an alpha component, the alpha component will be"},{"type":"text","text":" "},{"type":"text","text":"ignored; use "},{"code":"fillExtrusionOpacity","type":"codeVoice"},{"type":"text","text":" to set layer opacityco."}],"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionColor","fragments":[{"text":"fillExtrusionColor","kind":"identifier"}],"title":"fillExtrusionColor","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionPattern":{"url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusionpattern","abstract":[{"type":"text","text":"Name of image in style images to use for drawing image fill-extrusions. For"},{"type":"text","text":" "},{"type":"text","text":"seamless patterns, image width and height must be a factor of two (2, 4, 8,"},{"type":"text","text":" "},{"type":"text","text":"…, 512)."}],"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionPattern","fragments":[{"text":"fillExtrusionPattern","kind":"identifier"}],"title":"fillExtrusionPattern","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNCircleStyleLayer":{"fragments":[{"kind":"identifier","text":"MLNCircleStyleLayer"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled"},{"type":"text","text":" "},{"type":"text","text":"circles on the map."}],"kind":"symbol","title":"MLNCircleStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNCircleStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlncirclestylelayer","type":"topic"}}}