ceans"},{"type":"text","text":" "},{"type":"text","text":"and other bodies of water are drawn by "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNBackgroundStyleLayer","isActive":true},{"type":"text","text":" objects."}],"title":"MLNBackgroundStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionBaseTransition":{"url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusionbasetransition","fragments":[{"kind":"identifier","text":"fillExtrusionBaseTransition"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionBaseTransition","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The transition affecting any changes to this layer’s "},{"code":"fillExtrusionBase","type":"codeVoice"},{"type":"text","text":" property."}],"title":"fillExtrusionBaseTransition"},"doc://org.swift.MyProject/documentation/MapLibre/MLNHillshadeStyleLayer":{"url":"\/documentation\/maplibre\/mlnhillshadestylelayer","fragments":[{"kind":"identifier","text":"MLNHillshadeStyleLayer"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNHillshadeStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders raster "},{"type":"text","text":"digital elevation"},{"type":"text","text":" "},{"type":"text","text":"model"},{"type":"text","text":" (DEM) tiles on the map."}],"title":"MLNHillshadeStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"title":"MLNShapeSource","fragments":[{"kind":"identifier","text":"MLNShapeSource"}],"url":"\/documentation\/maplibre\/mlnshapesource","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift