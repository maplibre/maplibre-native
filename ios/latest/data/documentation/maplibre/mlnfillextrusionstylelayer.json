ion\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"title":"MLNShapeSource","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnfillstylelayer","title":"MLNFillStyleLayer","fragments":[{"text":"MLNFillStyleLayer","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders one or more filled (and"},{"type":"text","text":" "},{"type":"text","text":"optionally stroked) polygons on the map."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNFillExtrusionStyleLayer/fillExtrusionTranslationAnchor":{"url":"\/documentation\/maplibre\/mlnfillextrusionstylelayer\/fillextrusiontranslationanchor","kind":"symbol","fragments":[{"kind":"identifier","text":"fillExtrusionTranslationAnchor"}],"abstract":[{"type":"text","text":"Controls the frame of reference for "},{"type":"codeVoice","code":"fillExtrusionTranslation"},{"type":"text","text":"."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFillExtrusionStyleLayer\/fillExtrusionTranslationAnchor","role":"symbol","type":"topic","title":"fillExtrusionTranslationAnchor"},"doc://org.swift.MyProject/documentation/MapLibre/MLNBackgroundStyleLayer":{"id