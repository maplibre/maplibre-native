/featurestatevectorexample","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample","abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true,"type":"reference"},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"kind":"article","type":"topic"}}}