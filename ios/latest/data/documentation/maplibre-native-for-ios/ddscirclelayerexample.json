oc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/FeatureStateExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","type":"topic","title":"Set Feature State","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/featurestateexample","role":"article","abstract":[{"text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions.","type":"text"}]}}}