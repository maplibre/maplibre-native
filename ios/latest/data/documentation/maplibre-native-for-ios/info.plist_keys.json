.MyProject/documentation/MapLibre-Native-for-iOS/MultipleImagesExample":{"role":"article","url":"\/documentation\/maplibre-native-for-ios\/multipleimagesexample","title":"Adding Multiple Images","type":"topic","abstract":[{"text":"Adding images to the map and assigning them to POI types","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/MultipleImagesExample","kind":"article"},"customizing-fonts.html#server-side-fonts":{"type":"link","identifier":"customizing-fonts.html#server-side-fonts","url":"customizing-fonts.html#server-side-fonts","titleInlineContent":[{"text":"server-side rendering","type":"text"}],"title":"server-side rendering"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/databasePath":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/databasePath","abstract":[{"text":"The file path at which offline packs and the ambient cache are stored.","type":"text"}],"kind":"symbol","fragments":[{"text":"databasePath","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnofflinestorage\/databasepath","role":"symbol","type":"topic","title":"databasePath"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","url":"\/documentation\/maplibre","title":"MapLibre","type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textIgnoresPlacement":{"title":"textIgnoresPlacement","kind":"symbol","fragments":[{"text":"textIgnoresPlacement","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textIgnoresPlacement","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textignoresplacement","abstract":[{"type":"text","text":"If true, other symbols can be visible even if they collide with the text."}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Customizing_Fonts":{"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/customizing_fonts","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Customizing_Fonts","kind":"article","title":"Customizing Fonts","role":"article","abstract":[{"text":"Using custom fonts","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/databaseURL":{"title":"databaseURL","kind":"symbol","fragments":[{"text":"databaseURL","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/databaseURL","url":"\/documentation\/maplibre\/mlnofflinestorage\/databaseurl","abstract":[{"type":"text","text":"The file URL at which offline packs and the ambient cache are stored."}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Predicates_and_Expressions":{"role":"article","url":"\/documentation\/maplibre-native-for-ios\/predicates_and_expressions","title":"Predicates and expressions","type":"topic","abstract":[{"type":"text","text":"Using "},{"type":"codeVoice","code":"NSPredicate"},{"type":"text","text":" with MapLibre iOS"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Predicates_and_Expressions","kind":"article"},"https://developer.apple.com/documentation/foundation/nsurl/1413819-setresourcevalue":{"title":"NSURL\/setResourceValue:forKey:error:","titleInlineContent":[{"code":"NSURL\/setResourceValue:forKey:error:","type":"codeVoice"}],"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue"}}}