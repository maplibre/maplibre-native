en if they collide with the icon."}],"kind":"symbol","role":"symbol","title":"iconIgnoresPlacement","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconIgnoresPlacement","fragments":[{"kind":"identifier","text":"iconIgnoresPlacement"}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconignoresplacement"},"https://developer.apple.com/documentation/foundation/nsurl/1413819-setresourcevalue":{"title":"NSURL\/setResourceValue:forKey:error:","url":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","type":"link","titleInlineContent":[{"code":"NSURL\/setResourceValue:forKey:error:","type":"codeVoice"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"url":"\/documentation\/maplibre\/mlnmapview","kind":"symbol","title":"MLNMapView","abstract":[{"text":"An interactive, customizable map view with an interface similar to the one","type":"text"},{"text":" ","type":"text"},{"text":"provided by Apple’s MapKit.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","fragments":[{"kind":"identifier","text":"MLNMapView"}],"type":"topic","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconAllowsOverlap":{"kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconallowsoverlap","abstract":[{"type":"text","text":"If true, the icon will be visible even if it collides with other previously"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}],"fragments":[{"kind":"identifier","text":"iconAllowsOverlap"}],"role":"symbol","title":"iconAllowsOverlap","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconAllowsOverlap"}}}