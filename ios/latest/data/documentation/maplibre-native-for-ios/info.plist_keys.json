ides with other previously","type":"text"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textallowsoverlap","title":"textAllowsOverlap","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"textAllowsOverlap","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconAllowsOverlap":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"If true, the icon will be visible even if it collides with other previously"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}],"fragments":[{"text":"iconAllowsOverlap","kind":"identifier"}],"kind":"symbol","title":"iconAllowsOverlap","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconallowsoverlap","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconAllowsOverlap"},"https://developer.apple.com/documentation/foundation/nsurl/1413819-setresourcevalue":{"url":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","title":"NSURL\/setResourceValue:forKey:error:","titleInlineContent":[{"code":"NSURL\/setResourceValue:forKey:error:","type":"codeVoice"}],"type":"link"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconIgnoresPlacement":{"abstract":[{"type":"text","text":"If true, other symbols can be visible even if they collide with the icon."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconIgnoresPlacement","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconignoresplacement","title":"iconIgnoresPlacement","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"iconIgnoresPlacement","kind":"identifier"}]}}}