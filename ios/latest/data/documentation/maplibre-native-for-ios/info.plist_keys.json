 be visible even if they collide with the text."}],"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textignoresplacement","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textIgnoresPlacement","type":"topic","fragments":[{"text":"textIgnoresPlacement","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textAllowsOverlap":{"kind":"symbol","fragments":[{"text":"textAllowsOverlap","kind":"identifier"}],"abstract":[{"text":"If true, the text will be visible even if it collides with other previously","type":"text"},{"text":" ","type":"text"},{"text":"drawn symbols.","type":"text"}],"type":"topic","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textallowsoverlap","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textAllowsOverlap","title":"textAllowsOverlap","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/databaseURL":{"kind":"symbol","role":"symbol","title":"databaseURL","abstract":[{"text":"The file URL at which offline packs and the ambient cache are stored.","type":"text"}],"url":"\/documentation\/maplibre\/mlnofflinestorage\/databaseurl","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/databaseURL","type":"topic","fragments":[{"text":"databaseURL","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/For_Style_Authors":{"kind":"article","abstract":[],"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/for_style_authors","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors","title":"Information for Style Authors","role":"article"},"customizing-fonts.html#server-side-fonts":{"type":"link","url":"customizing-fonts.html#server-side-fonts","identifier":"customizing-fonts.html#server-side-fonts","titleInlineContent":[{"text":"server-side rendering","type":"text"}],"title":"ser