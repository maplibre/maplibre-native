databaseURL","kind":"symbol","title":"databaseURL","role":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconAllowsOverlap":{"abstract":[{"type":"text","text":"If true, the icon will be visible even if it collides with other previously"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}],"kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconallowsoverlap","fragments":[{"text":"iconAllowsOverlap","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconAllowsOverlap","title":"iconAllowsOverlap"},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","role":"collection","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Predicates_and_Expressions":{"abstract":[{"text":"Using ","type":"text"},{"type":"codeVoice","code":"NSPredicate"},{"text":" with MapLibre iOS","type":"text"}],"role":"article","title":"Predicates and expressions","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Predicates_and_Expressions","url":"\/documentation\/maplibre-native-for-ios\/predicates_and_expressions","type":"topic","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconIgnoresPlacement":{"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconignoresplacement","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconIgnoresPlacement","title":"iconIgnoresPlacement","kind":"symbol","abstract":[{"text":"If true, other symbols can be visible even if they collide with the icon.","type":"text"}],"type":"topic","role":"sym