tation\/MapLibre\/MLNMapView","fragments":[{"text":"MLNMapView","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","url":"\/documentation\/maplibre","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textIgnoresPlacement":{"fragments":[{"text":"textIgnoresPlacement","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textignoresplacement","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textIgnoresPlacement","title":"textIgnoresPlacement","abstract":[{"text":"If true, other symbols can be visible even if they collide with the text.","type":"text"}],"type":"topic"},"customizing-fonts.html#server-side-fonts":{"titleInlineContent":[{"text":"server-side rendering","type":"text"}],"identifier":"customizing-fonts.html#server-side-fonts","type":"link","url":"customizing-fonts.html#server-side-fonts","title":"server-side rendering"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GestureRecognizers":{"role":"article","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GestureRecognizers","url":"\/documentation\/maplibre-native-for-ios\/gesturerecognizers","title":"User Interactions","abstract":[{"type":"text","text":"Learn how to work with gesture recognizers"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/databasePath":{"abstract":[{"text":"The file path at which offline packs and the ambient cache are stored.","type":"text"}],"fragments":[{"kind":"identifier","text":"databasePath"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/maplibre\/ml