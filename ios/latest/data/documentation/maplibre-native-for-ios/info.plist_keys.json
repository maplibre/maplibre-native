rces","type":"text"}],"url":"\/documentation\/maplibre-native-for-ios\/tile_url_templates","role":"article","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates"},"https://developer.apple.com/documentation/uikit/text_display_and_fonts/adding_a_custom_font_to_your_app":{"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/text_display_and_fonts\/adding_a_custom_font_to_your_app","type":"link","url":"https:\/\/developer.apple.com\/documentation\/uikit\/text_display_and_fonts\/adding_a_custom_font_to_your_app","titleInlineContent":[{"type":"text","text":"bundled with your application"}],"title":"bundled with your application"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GestureRecognizers":{"type":"topic","abstract":[{"type":"text","text":"Learn how to work with gesture recognizers"}],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/gesturerecognizers","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GestureRecognizers","title":"User Interactions","role":"article"},"https://developer.apple.com/fonts/system-fonts/":{"identifier":"https:\/\/developer.apple.com\/fonts\/system-fonts\/","type":"link","url":"https:\/\/developer.apple.com\/fonts\/system-fonts\/","titleInlineContent":[{"type":"text","text":"system font"}],"title":"system font"},"doc://org.swift.MyProject/documentation/MapLibre/MLNMapView":{"type":"topic","abstract":[{"type":"text","text":"An interactive, customizable map view with an interface similar to the one"},{"type":"text","text":" "},{"type":"text","text":"provided by Apple’s MapKit."}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnmapview","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","title":"MLNMapView","role":"symbol","fragments":[{"text":"MLNMapView","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/For_Style_Authors":{"type":"topic","abstract":[],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/for_style_authors","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors","title":"Information for Style Authors","role":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/iconAllowsOverlap":{"url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconallowsoverlap","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"iconAllowsOverlap"}],"title":"iconAllowsOverlap","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconAllowsOverlap","abstract":[{"type":"text","text":"If true, the icon will be visible even if it collides with other previously"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textAllowsOverlap":{"type":"topic","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textallowsoverlap","abstract":[{"type":"text","text":"If true, the text will be visible even if it collides with other previously"},{"type":"text","text":" "},{"type":"text","text":"drawn symbols."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textAllowsOverlap","fragments":[{"kind":"identifier","text":"textAllowsOverlap"}],"title":"textAllowsOverlap"},"customizing-fonts.html#server-side-fonts":{"identifier":"customizing-fonts.html#server-side-fonts","type":"link","url":"customizing-fonts.html#server-side-fonts","titleInlineContent":[{"type":"text","text":"server-side rendering"}],"title":"server-side rendering"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Customizing_Fonts":{"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/customizing_fonts","abstract":[{"text":"Using custom fonts","type":"text"}],"role":"article","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Customizing_Fonts","title":"Customizing Fonts"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textIgnoresPlacement":{"type":"topic","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textignoresplacement","abstract":[{"text":"If true, other symbols can be visible even if they collide with the text.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textIgnoresPlacement","fragments":[{"text":"textIgnoresPlacement","kind":"identifier"}],"title":"textIgnoresPlacement"},"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","role":"collection","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/MultipleImagesExample":{"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/multipleimagesexample","abstract":[{"type":"text","text":"Adding images to the map and assigning them to POI types"}],"role":"article","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/MultipleImagesExample","title":"Adding Multiple Images"},"https://developer.apple.com/documentation/foundation/nsurl/1413819-setresourcevalue":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/nsurl\/1413819-setresourcevalue","titleInlineContent":[{"type":"codeVoice","code":"NSURL\/setResourceValue:forKey:error:"}],"title":"NSURL\/setResourceValue:forKey:error:"}}}