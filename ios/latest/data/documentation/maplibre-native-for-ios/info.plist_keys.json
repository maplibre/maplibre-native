e are stored.","type":"text"}],"role":"symbol","title":"databasePath","url":"\/documentation\/maplibre\/mlnofflinestorage\/databasepath","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"type":"topic","role":"collection"},"doc://org.swift.MyProject/documentation/MapLibre/MLNOfflineStorage/databaseURL":{"url":"\/documentation\/maplibre\/mlnofflinestorage\/databaseurl","fragments":[{"kind":"identifier","text":"databaseURL"}],"type":"topic","abstract":[{"text":"The file URL at which offline packs and the ambient cache are stored.","type":"text"}],"role":"symbol","title":"databaseURL","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNOfflineStorage\/databaseURL","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/For_Style_Authors":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors","abstract":[],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/for_style_authors","role":"article","title":"Information for Style Authors"},"https://developer.apple.com/fonts/system-fonts/":{"url":"https:\/\/developer.apple.com\/fonts\/system-fonts\/","type":"link","identifier":"https:\/\/developer.apple.com\/fonts\/system-fonts\/","titleInlineContent":[{"type":"text","text":"system font"}],"title":"system font"},"customizing-fonts.html#server-side-fonts":{"url":"customizing-fonts.html#server-side-fonts","type":"link","identifier":"customizing-fonts.html#server-side-fonts","titleInlineContent":[{"type":"text","text":"server-side rendering"}],"title":"server-side rendering"}}}