 symbols.","type":"text"}],"kind":"symbol","title":"iconAllowsOverlap","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/iconAllowsOverlap","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/iconallowsoverlap","type":"topic","fragments":[{"kind":"identifier","text":"iconAllowsOverlap"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textIgnoresPlacement":{"abstract":[{"text":"If true, other symbols can be visible even if they collide with the text.","type":"text"}],"kind":"symbol","title":"textIgnoresPlacement","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textIgnoresPlacement","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textignoresplacement","type":"topic","fragments":[{"kind":"identifier","text":"textIgnoresPlacement"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/For_Style_Authors":{"title":"Information for Style Authors","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/for_style_authors","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors","role":"article","abstract":[]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Tile_URL_Templates":{"title":"Tile URL Templates","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/tile_url_templates","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates","role":"article","abstract":[{"text":"Using URL Templates when defining tile sources","type":"text"}]},"https://developer.apple.com/documentation/uikit/text_display_and_fonts/adding_a_custom_font_to_your_app":{"title":"bundled with your application","type":"link","url":"https:\/\/developer.apple.com\/documentation\/uikit\/text_display_and_fonts\/adding_a_custom_font_to_your_app","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/text_display_and_fonts\/adding_a_custom_font_to_your_app","titleInlineContent":[{"type":"text","text":"bundled with your application"}]},"customizing-fonts.html#server-side-fonts":{"title":"server-side rendering","type":"link","url":"customizing-fonts.html#server-side-fonts","identifier":"customizing-fonts.html#server-side-fonts","titleInlineContent":[{"type":"text","text":"server-side rendering"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Customizing_Fonts":{"kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Customizing_Fonts","role":"article","title":"Customizing Fonts","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/customizing_fonts","abstract":[{"text":"Using custom fonts","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Predicates_and_Expressions":{"title":"Predicates and expressions","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/predicates_and_expressions","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Predicates_and_Expressions","role":"article","abstract":[{"text":"Using ","type":"text"},{"code":"NSPredicate","type":"codeVoice"},{"text":" with MapLibre iOS","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNSymbolStyleLayer/textAllowsOverlap":{"abstract":[{"text":"If true, the text will be visible even if it collides with other previously","type":"text"},{"text":" ","type":"text"},{"text":"drawn symbols.","type":"text"}],"kind":"symbol","title":"textAllowsOverlap","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNSymbolStyleLayer\/textAllowsOverlap","url":"\/documentation\/maplibre\/mlnsymbolstylelayer\/textallowsoverlap","type":"topic","fragments":[{"kind":"identifier","text":"textAllowsOverlap"}],"role":"symbol"}}}