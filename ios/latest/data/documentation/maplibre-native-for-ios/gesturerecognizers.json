{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Learn how to work with gesture recognizers"}],"metadata":{"roleHeading":"Article","role":"article","title":"User Interactions","modules":[{"name":"MapLibre"}]},"seeAlsoSections":[{"title":"Other Articles","anchor":"Other-Articles","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Customizing_Fonts","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Info.plist_Keys","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/MultipleImagesExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Predicates_and_Expressions","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors"],"generated":true}],"primaryContentSections":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"MapLibre Native iOS provides a set of built-in gesture recognizers. You can customize or supplement these gestures according to your use case. You see what gesture recognizers are on your "},{"type":"codeVoice","code":"MLNMapView"},{"type":"text","text":" by accessing the "},{"type":"codeVoice","code":"gestureRecognizers"},{"type":"text","text":" property on your map."}]},{"type":"heading","level":2,"text":"Configuring user interaction","anchor":"Configuring-user-interaction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several properties on an "},{"type":"codeVoice","code":"MLNMapView"},{"type":"text","text":" provide ways to enable or disable a set of gesture recognizers. Boolean values are set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" by default."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/zoomEnabled","type":"codeVoice"},{"text":" - Allows the user to zoom in or out by pinching two fingers, double-tapping, tapping with two fingers, or double-tapping then dragging vertically. Accepts Boolean values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/scrollEnabled","type":"codeVoice"},{"text":" - Allows the user to scroll by dragging or swiping one finger. Accepts Boolean values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/rotateEnabled","type":"codeVoice"},{"text":" - Allows the user to rotate by moving two fingers in a circular motion. Accepts Boolean values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/pitchEnabled","type":"codeVoice"},{"text":" - Allows the user to tilt the map by vertically dragging two fingers. Accepts Boolean values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/decelerationRate","type":"codeVoice"},{"text":" - Determines the rate of deceleration after the user lifts their finger. You can set the value using the  ","type":"text"},{"code":"MLNMapViewDecelerationRateNormal","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MLNMapViewDecelerationRateFast","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"MLNMapViewDecelerationRateImmediate","type":"codeVoice"},{"text":" constants.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Individual gestures","anchor":"Individual-gestures"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gesture"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Related Property"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zooms in or out on the map’s anchor point"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/zoomEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rotation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes the "},{"code":"MLNMapView","type":"codeVoice"},{"type":"text","text":" direction based on the user rotating two fingers in a circular motion"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/rotateEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single tap"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Selects\/deselects the annotation that you tap."}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Double tap"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zooms in on the map’s anchor point"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/zoomEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two-finger tap"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zooms out with the map’s anchor point centered"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/zoomEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pan"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scrolls across mapView ("},{"type":"emphasis","inlineContent":[{"text":"note: if","type":"text"}]},{"type":"text","text":" "},{"code":"MLNUserTrackingModeFollow","type":"codeVoice"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"is being used, it will be disabled once the user pans","type":"text"}]},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/scrollEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two-finger drag"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Adjusts the pitch of the "},{"code":"MLNMapView","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"pitchEnabled","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"One-finger zoom"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tap twice; on second tap, hold your finger on the map and pan up to zoom in, or down to zoom out"}]}],[{"type":"paragraph","inlineContent":[{"code":"MLNMapView\/zoomEnabled","type":"codeVoice"}]}]]],"type":"table","alignments":["center","unset","unset"]},{"identifier":"rotation.mp4","type":"video","metadata":{"abstract":[{"type":"text","text":"Rotation with two fingers."}]}},{"identifier":"quickzoom.mp4","type":"video","metadata":{"abstract":[{"type":"text","text":"One finger zoom with a double tap."}]}},{"type":"heading","level":2,"text":"Adding custom gesture recognizers","anchor":"Adding-custom-gesture-recognizers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uigesturerecognizer","isActive":true},{"type":"text","text":" to your map programmatically or via storyboard. Adding custom responses to gesture recognizers can enhance your user’s experience, but try to use standard gestures where possible."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gesture recognizers that you add will take priority over the built-in gesture recognizer. You can also set up your own gesture recognizer to work simultaneously with built-in gesture recognizers by using "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uigesturerecognizerdelegate\/1624208-gesturerecognizer","isActive":true},{"type":"text","text":", allowing you to enhance already existing gesture recognizers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also add gesture recognizers that are only called when the default gesture recognizer fails (and vice versa), such as when a user taps on a part of the map that is not an annotation. The documentation for "},{"type":"codeVoice","code":"MLNMapView"},{"type":"text","text":" includes an example of how to create a fallback gesture recognizer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you would like to disable a specific set of gesture recognizers, such as zoom, you can set the Boolean value for the appropriate property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":". You can then add your own gesture recognizers to perform those actions."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GestureRecognizers"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/gesturerecognizers"]}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"references":{"rotation.mp4":{"poster":"rotation.png","type":"video","alt":"A short video showing the gesture for rotation with two fingers.","identifier":"rotation.mp4","variants":[{"traits":["1x","light"],"url":"\/videos\/org.swift.MyProject\/rotation.mp4"}]},"quickzoom.png":{"type":"image","alt":null,"identifier":"quickzoom.png","variants":[{"traits":["1x","light"],"url":"\/images\/org.swift.MyProject\/quickzoom.png"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/Tile_URL_Templates":{"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/tile_url_templates","abstract":[{"type":"text","text":"Using URL Templates when defining tile sources"}],"title":"Tile URL Templates","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates","role":"article","type":"topic"},"https://developer.apple.com/documentation/uikit/uigesturerecognizer":{"title":"UIGestureRecognizers","titleInlineContent":[{"type":"codeVoice","code":"UIGestureRecognizer"},{"type":"text","text":"s"}],"type":"link","identifier":"https:\/\/deve