cumentation\/MapLibre\/MLNMapViewDecelerationRateImmediate","isActive":true},{"text":" constants.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Individual gestures","anchor":"Individual-gestures"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Gesture","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Related Property","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pinch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms in or out on the map’s anchor point","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Rotation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Changes the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true,"type":"reference"},{"text":" direction based on the user rotating two fingers in a circular motion","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/rotateEnabled","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Single tap","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Selects\/deselects the annotation that you tap.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Double tap","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms in on the map’s anchor point","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineConte