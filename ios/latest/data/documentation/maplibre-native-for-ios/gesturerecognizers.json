":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/rotateEnabled","type":"reference"},{"text":" - Allows the user to rotate by moving two fingers in a circular motion. Accepts Boolean values.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/pitchEnabled","type":"reference"},{"text":" - Allows the user to tilt the map by vertically dragging two fingers. Accepts Boolean values.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/decelerationRate","type":"reference"},{"text":" - Determines the rate of deceleration after the user lifts their finger. You can set the value using the  ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateNormal","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateFast","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateImmediate","type":"reference"},{"text":" constants.","type":"text"}],"type":"paragraph"}]}]},{"text":"Individual gestures","level":2,"anchor":"Individual-gestures","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Gesture","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Related Property","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pinch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms in or out on the map’s anchor point","type":"text"}],"type":"p