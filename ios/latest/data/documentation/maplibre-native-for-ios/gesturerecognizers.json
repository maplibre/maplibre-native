g used, it will be disabled once the user pans"}]},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/scrollEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Two-finger drag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Adjusts the pitch of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"pitchEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"One-finger zoom"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tap twice; on second tap, hold your finger on the map and pan up to zoom in, or down to zoom out"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled"}],"type":"paragraph"}]]]},{"type":"video","identifier":"rotation.mp4","metadata":{"abstract":[{"type":"text","text":"Rotation with two fingers."}]}},{"type":"video","identifier":"quickzoom.mp4","metadata":{"abstract":[{"type":"text","text":"One finger zoom with a double tap."}]}},{"anchor":"Adding-custom-gesture-recognizers","type":"heading","text":"Adding custom gesture recognizers","level":2},{"type":"paragraph","inlineContent":[{"text":"You can add ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uigesturerecognizer","isActive":true,"type":"reference"},{"text":" to your map programmatically or via storyboard. Adding custom responses to gesture recognizers can enhance your user’s experience, but try to use standard gestures where possible.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The gesture recognizers that you add will take priority over the built-in gesture recognizer. You can a