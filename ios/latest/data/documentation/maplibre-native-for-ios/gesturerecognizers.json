{"sections":[],"primaryContentSections":[{"content":[{"inlineContent":[{"text":"MapLibre Native iOS provides a set of built-in gesture recognizers. You can customize or supplement these gestures according to your use case. You see what gesture recognizers are on your ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference","isActive":true},{"text":" by accessing the ","type":"text"},{"code":"gestureRecognizers","type":"codeVoice"},{"text":" property on your map.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Configuring user interaction","anchor":"Configuring-user-interaction","type":"heading"},{"inlineContent":[{"text":"Several properties on an ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","type":"reference","isActive":true},{"text":" provide ways to enable or disable a set of gesture recognizers. Boolean values are set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to zoom in or out by pinching two fingers, double-tapping, tapping with two fingers, or double-tapping then dragging vertically. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/scrollEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to scroll by dragging or swiping one finger. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/rotateEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to rotate by moving two fingers in a circular motion. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/pitchEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to tilt the map by vertically dragging two fingers. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/decelerationRate","type":"reference","isActive":true},{"type":"text","text":" - Determines the rate of deceleration after the user lifts their finger. You can set the value using the  "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateNormal","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateFast","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateImmediate","type":"reference","isActive":true},{"type":"text","text":" constants."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Individual gestures","anchor":"Individual-gestures","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Gesture","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Related Property","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pinch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms in or out on the map’s anchor point","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Rotation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Changes the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView"},{"text":" direction based on the user rotating two fingers in a circular motion","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/rotateEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Single tap","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Selects\/deselects the annotation that you tap.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Double tap","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms in on the map’s anchor point","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Two-finger tap","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zooms out with the map’s anchor point centered","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pan","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Scrolls across mapView (","type":"text"},{"inlineContent":[{"type":"text","text":"note: if"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MLNUserTrackingModeFollow"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"is being used, it will be disabled once the user pans"}],"type":"emphasis"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/docu