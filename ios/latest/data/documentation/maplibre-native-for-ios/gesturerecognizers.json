{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"primaryContentSections":[{"content":[{"type":"paragraph","inlineContent":[{"text":"MapLibre Native iOS provides a set of built-in gesture recognizers. You can customize or supplement these gestures according to your use case. You see what gesture recognizers are on your ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true,"type":"reference"},{"text":" by accessing the ","type":"text"},{"code":"gestureRecognizers","type":"codeVoice"},{"text":" property on your map.","type":"text"}]},{"anchor":"Configuring-user-interaction","type":"heading","text":"Configuring user interaction","level":2},{"type":"paragraph","inlineContent":[{"text":"Several properties on an ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true,"type":"reference"},{"text":" provide ways to enable or disable a set of gesture recognizers. Boolean values are set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" by default.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to zoom in or out by pinching two fingers, double-tapping, tapping with two fingers, or double-tapping then dragging vertically. Accepts Boolean values."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/scrollEnabled","type":"reference","isActive":true},{"type":"text","text":" - Allows the user to scroll by dragging or swiping one finger. Accepts Boolean values."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProje