{"primaryContentSections":[{"kind":"content","content":[{"inlineContent":[{"type":"text","text":"MapLibre Native iOS provides a set of built-in gesture recognizers. You can customize or supplement these gestures according to your use case. You see what gesture recognizers are on your "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true},{"type":"text","text":" by accessing the "},{"type":"codeVoice","code":"gestureRecognizers"},{"type":"text","text":" property on your map."}],"type":"paragraph"},{"text":"Configuring user interaction","type":"heading","level":2,"anchor":"Configuring-user-interaction"},{"inlineContent":[{"type":"text","text":"Several properties on an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView","isActive":true},{"type":"text","text":" provide ways to enable or disable a set of gesture recognizers. Boolean values are set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" by default."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","isActive":true},{"type":"text","text":" - Allows the user to zoom in or out by pinching two fingers, double-tapping, tapping with two fingers, or double-tapping then dragging vertically. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/scrollEnabled","isActive":true},{"type":"text","text":" - Allows the user to scroll by dragging or swiping one finger. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/rotateEnabled","isActive":true},{"type":"text","text":" - Allows the user to rotate by moving two fingers in a circular motion. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/pitchEnabled","isActive":true},{"type":"text","text":" - Allows the user to tilt the map by vertically dragging two fingers. Accepts Boolean values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/decelerationRate","isActive":true},{"type":"text","text":" - Determines the rate of deceleration after the user lifts their finger. You can set the value using the  "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateNormal","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateFast","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapViewDecelerationRateImmediate","isActive":true},{"type":"text","text":" constants."}],"type":"paragraph"}]}]},{"text":"Individual gestures","type":"heading","level":2,"anchor":"Individual-gestures"},{"type":"table","header":"row","alignments":["center","unset","unset"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Gesture","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Related Property","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pinch","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Zooms in or out on the map’s anchor point","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/zoomEnabled","isActive":true,"type":"reference"}]}]],[[{"type":"p