{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"paragraph","inlineContent":[{"text":"Starting MapLibre iOS 6.10.0, ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.protomaps.com\/pmtiles\/"},{"text":" archives are supported as tile sources. Prefix any tile source URL with ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" to read from a PMTiles archive:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/https:\/\/"},{"type":"text","text":" — stream tiles from a remote file"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/file:\/\/"},{"type":"text","text":" — read a file from the device filesystem, including the app bundle"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" prefix works with any ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/"},{"text":" (e.g. ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":", etc.), from a style JSON or dynamically."}]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"PMTiles sources do not support offline pack downloads or caching."}],"type":"paragraph"}],"style":"note"},{"text":"Loading a style that uses PMTiles sources","level":2,"type":"heading","anchor":"Loading-a-style-that-uses-PMTiles-sources"},{"inlineContent":[{"type":"text","text":"Load a style JSON that references "},{"type":"codeVoice","code":"pmtiles:\/\/"},{"type":"text","text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"]},{"level":2,"type":"heading","text":"Adding a PMTiles source directly","anchor":"Adding-a-PMTiles-source-directly"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/overturemaps.org\/"},{"text":" (yellow) and ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/opensource.foursquare.com\/os-places\/"},{"type":"text","text":" (blue) — both using "},{"type":"codeVoice","code":"MLNCircleStyleLayer"},{"type":"text","text":". The "},{"type":"codeVoice","code":"sourceLayerIdentifier"},{"type":"text","text":" names the layer within the archive to render:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The same pattern works for ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":" archives using ","type":"text"},{"type":"codeVoice","code":"MLNRasterTileSource"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MLNRasterStyleLayer"},{"type":"text","text":":"}]},{"type":"codeListing","code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":" sources added programmatically cannot specify "},{"type":"codeVoice","code":"encoding"},{"text":" via the current iOS API. Define ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"text":" sources with terrarium encoding in the style JSON instead, where the ","type":"text"},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" field is fully supported."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","text":"Loading a local PMTiles file","level":2,"anchor":"Loading-a-local-PMTiles-file"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle a "},{"type":"codeVoice","code":".pmtiles"},{"type":"text","text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via "},{"type":"codeVoice","code":"file:\/\/"},{"type":"text","text":", so no special handling is needed:"}]},{"syntax":"swift","code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing"}]}],"abstract":[{"text":"Working with PMTiles","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles"},"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON"],"generated":true,"title":"Styling and Dynamic Data","anchor":"Styling-and-Dynamic-Data"}],"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article","title":"PMTiles"}