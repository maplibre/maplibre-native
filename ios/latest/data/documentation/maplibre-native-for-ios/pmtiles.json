{"sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","interfaceLanguage":"occ"},"metadata":{"roleHeading":"Article","title":"PMTiles","modules":[{"name":"MapLibre"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"inlineContent":[{"type":"text","text":"Starting MapLibre iOS 6.10.0, "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.protomaps.com\/pmtiles\/"},{"type":"text","text":" archives are supported as tile sources. Prefix any tile source URL with "},{"type":"codeVoice","code":"pmtiles:\/\/"},{"type":"text","text":" to read from a PMTiles archive:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/https:\/\/"},{"type":"text","text":" — stream tiles from a remote file"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/file:\/\/"},{"type":"text","text":" — read a file from the device filesystem, including the app bundle"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The "},{"code":"pmtiles:\/\/","type":"codeVoice"},{"type":"text","text":" prefix works with any "},{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","isActive":true,"type":"reference"},{"type":"text","text":" (e.g. "},{"code":"vector","type":"codeVoice"},{"text":", ","type":"text"},{"code":"raster","type":"codeVoice"},{"text":", ","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":", etc.), from a style JSON or dynamically.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"PMTiles sources do not support offline pack downloads or caching.","type":"text"}]}],"style":"note","type":"aside"},{"anchor":"Loading-a-style-that-uses-PMTiles-sources","level":2,"text":"Loading a style that uses PMTiles sources","type":"heading"},{"inlineContent":[{"text":"Load a style JSON that references ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"type":"text","text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"]},{"text":"Adding a PMTiles source directly","type":"heading","anchor":"Adding-a-PMTiles-source-directly","level":2},{"inlineContent":[{"type":"text","text":"Add "},{"code":"vector","type":"codeVoice"},{"type":"text","text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — "},{"type":"reference","isActive":true,"identifier":"https:\/\/overturemaps.org\/"},{"text":" (yellow) and ","type":"text"},{"identifier":"https:\/\/opensource.foursquare.com\/os-places\/","isActive":true,"type":"reference"},{"text":" (blue) — both using ","type":"text"},{"type":"codeVoice","code":"MLNCircleStyleLayer"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"sourceLayerIdentifier"},{"text":" names the layer within the archive to render:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"]},{"inlineContent":[{"text":"The same pattern works for ","type":"text"},{"code":"raster","type":"codeVoice"},{"text":" archives using ","type":"text"},{"code":"MLNRasterTileSource","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MLNRasterStyleLayer"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":" sources added programmatically cannot specify ","type":"text"},{"type":"codeVoice","code":"encoding"},{"text":" via the current iOS API. Define ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"text":" sources with terrarium encoding in the style JSON instead, where the ","type":"text"},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" field is fully supported."}],"type":"paragraph"}],"style":"note"},{"text":"Loading a local PMTiles file","type":"heading","anchor":"Loading-a-local-PMTiles-file","level":2},{"inlineContent":[{"text":"Bundle a ","type":"text"},{"code":".pmtiles","type":"codeVoice"},{"text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via ","type":"text"},{"code":"file:\/\/","type":"codeVoice"},{"text":", so no special handling is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"]}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON"],"generated":true,"title":"Styling and Dynamic Data","anchor":"Styling-and-Dynamic-Data"}],"abstract":[{"text":"Working with PMTiles","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"type":"topic","abstract":[{"text":"Showing data from an API with custom styling and interaction","type":"text"}],"role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","title":"Showing data from an API","url":"\/documentation\/maplibre-native-for-ios\/webapidataexample","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","fragments":[{"text":"MLNLineStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnlinestylelayer","type":"topic","title":"MLNLineStyleLayer","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"type":"text","text":" is a style layer that renders one or more stroked"},{"type":"text","text":" "},{"type":"text","text":"polylines on the map."}],"role":"symbol","kind":"symbol"},"https://opensource.foursquare.com/os-places/":{"url":"https:\/\/opensource.foursquare.com\/os-places\/","identifier":"https:\/\/opensource.foursquare.com\/os-places\/","type":"link","titleInlineContent":[{"text":"Foursquare OS Places","type":"text"}],"title":"Foursquare OS Places"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/poialongrouteexample","title":"POI Along a Route","abstract":[{"text":"Use an ","type":"text"},{"type":"codeVoice","code":"NSPredicate"},{"text":" to show POI and road labels along a route.","type":"text"}],"role":"article","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/DDSCircleLayerEx