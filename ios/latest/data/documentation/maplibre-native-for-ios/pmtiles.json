{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"MapLibre"}],"title":"PMTiles"},"kind":"article","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles"},"seeAlsoSections":[{"generated":true,"title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON"],"anchor":"Styling-and-Dynamic-Data"}],"sections":[],"primaryContentSections":[{"content":[{"inlineContent":[{"text":"Starting MapLibre iOS 6.10.0, ","type":"text"},{"type":"reference","identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","isActive":true},{"type":"text","text":" archives are supported as tile sources. Prefix any tile source URL with "},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" to read from a PMTiles archive:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"pmtiles:\/\/https:\/\/","type":"codeVoice"},{"text":" — stream tiles from a remote file","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"pmtiles:\/\/file:\/\/","type":"codeVoice"},{"text":" — read a file from the device filesystem, including the app bundle","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"pmtiles:\/\/","type":"codeVoice"},{"text":" prefix works with any ","type":"text"},{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","type":"reference","isActive":true},{"text":" (e.g. ","type":"text"},{"code":"vector","type":"codeVoice"},{"text":", ","type":"text"},{"code":"raster","type":"codeVoice"},{"text":", ","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":", etc.), from a style JSON or dynamically.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"PMTiles sources do not support offline pack downloads or caching."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Loading a style that uses PMTiles sources","anchor":"Loading-a-style-that-uses-PMTiles-sources","type":"heading"},{"inlineContent":[{"text":"Load a style JSON that references ","type":"text"},{"code":"pmtiles:\/\/","type":"codeVoice"},{"text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"],"type":"codeListing"},{"level":2,"text":"Adding a PMTiles source directly","anchor":"Adding-a-PMTiles-source-directly","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"vector","type":"codeVoice"},{"text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — ","type":"text"},{"isActive":true,"identifier":"https:\/\/overturemaps.org\/","type":"reference"},{"text":" (yellow) and ","type":"text"},{"isActive":true,"identifier":"https:\/\/opensource.foursquare.com\/os-places\/","type":"reference"},{"text":" (blue) — both using ","type":"text"},{"code":"MLNCircleStyleLayer","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"sourceLayerIdentifier","type":"codeVoice"},{"type":"text","text":" names the layer within the archive to render:"}]},{"type":"codeListing","syntax":"swift","code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"]},{"inlineContent":[{"type":"text","text":"The same pattern works for "},{"type":"codeVoice","code":"raster"},{"type":"text","text":" archives using "},{"type":"codeVoice","code":"MLNRasterTileSource"},{"type":"text","text":" and "},{"code":"MLNRasterStyleLayer","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"type":"text","text":" sources added programmatically cannot specify "},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" via the current iOS API. Define "},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":" sources with terrarium encoding in the style JSON instead, where the "},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" field is fully supported."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"level":2,"text":"Loading a local PMTiles file","type":"heading","anchor":"Loading-a-local-PMTiles-file"},{"inlineContent":[{"text":"Bundle a ","type":"text"},{"code":".pmtiles","type":"codeVoice"},{"text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via ","type":"text"},{"code":"file:\/\/","type":"codeVoice"},{"text":", so no special handling is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"abstract":[{"text":"Working with PMTiles","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer":{"abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"type":"text","text":" is a style layer that renders one or more stroked"},{"type":"text","text":" "},{"type":"text","text":"polylines on the map."}],"role":"symbol","title":"MLNLineStyleLayer","fragments":[{"text":"MLNLineStyleLayer","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","url":"\/documentation\/maplibre\/mlnlinestylelayer"},"https://overturemaps.org/":{"url":"https:\/\/overturemaps.org\/","identifier":"https:\/\/overturemaps.org\/","type":"link","title":"Overture Maps","titleInlineContent":[{"text":"Overture Maps","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"abstract":[{"text":"Showing data from an API with custom styling and interaction","type":"text"}],"role":"article","title":"Showing data from an API","type":"topic","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","url":"\/documentation\/maplibre-native-for-ios\/webapidataexample"},"https://docs.protomaps.com/pmtiles/":{"url":"https:\/\/docs.protomaps.com\/pmtiles\/","identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","type":"link","title":"PMTiles","titleInlineContent":[{"text":"PMTiles","type":"text"}]},"https://maplibre.org/maplibre-style-spec/sources/":{"url":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","type":"link","title":"tile source type","titleInlineContent":[{"text":"tile source type","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"kind":"article","type":"topic","identifi