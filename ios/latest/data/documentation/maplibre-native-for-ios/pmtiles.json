{"primaryContentSections":[{"kind":"content","content":[{"inlineContent":[{"text":"Starting MapLibre iOS 6.10.0, ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.protomaps.com\/pmtiles\/"},{"text":" archives are supported as tile sources. Prefix any tile source URL with ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" to read from a PMTiles archive:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/https:\/\/"},{"text":" — stream tiles from a remote file","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/file:\/\/"},{"text":" — read a file from the device filesystem, including the app bundle","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" prefix works with any ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/"},{"text":" (e.g. ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"text":", etc.), from a style JSON or dynamically.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"PMTiles sources do not support offline pack downloads or caching.","type":"text"}]}],"name":"Note","style":"note","type":"aside"},{"text":"Loading a style that uses PMTiles sources","level":2,"anchor":"Loading-a-style-that-uses-PMTiles-sources","type":"heading"},{"inlineContent":[{"text":"Load a style JSON that references ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"],"type":"codeListing"},{"text":"Adding a PMTiles source directly","level":2,"anchor":"Adding-a-PMTiles-source-directly","type":"heading"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/overturemaps.org\/"},{"text":" (yellow) and ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/opensource.foursquare.com\/os-places\/"},{"text":" (blue) — both using ","type":"text"},{"type":"codeVoice","code":"MLNCircleStyleLayer"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"sourceLayerIdentifier"},{"text":" names the layer within the archive to render:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The same pattern works for ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":" archives using ","type":"text"},{"type":"codeVoice","code":"MLNRasterTileSource"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MLNRasterStyleLayer"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":" sources added programmatically cannot specify ","type":"text"},{"code":"encoding","type":"codeVoice"},{"text":" via the current iOS API. Define ","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":" sources with terrarium encoding in the style JSON instead, where the ","type":"text"},{"code":"encoding","type":"codeVoice"},{"text":" field is fully supported.","type":"text"}]}],"name":"Note","style":"note","type":"aside"},{"text":"Loading a local PMTiles file","level":2,"anchor":"Loading-a-local-PMTiles-file","type":"heading"},{"inlineContent":[{"text":"Bundle a ","type":"text"},{"type":"codeVoice","code":".pmtiles"},{"text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via ","type":"text"},{"type":"codeVoice","code":"file:\/\/"},{"text":", so no special handling is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","interfaceLanguage":"occ"},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"MapLibre"}],"title":"PMTiles","role":"article"},"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON"],"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data"}],"abstract":[{"text":"Working with PMTiles","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/DDSCircleLayerExample":{"kind":"article","title":"Vector Tile Sources","abstract":[{"type":"text","text":"Add and style a vector tile source"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","role":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/ddscirclelayerexample"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"role":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/poialongrouteexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","kind":"article","title":"POI Along a Route","abstract":[{"text":"Use an ","type":"text"},{"code":"NSPredicate","type":"codeVoice"},{"text":" to show POI and road labels along a route.","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GeoJSON":{"type":"topic","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","url":"\/documentation\/maplibre-native-for-ios\/geojson","title":"Working with GeoJSON Data","kind":"article","abstract":[]},"https://opensource.foursquare.com/os-places/":{"title":"Foursquare OS Places","identifier":"https:\/\/opensource.foursquare.com\/os-places\/","titleInlineContent":[{"text":"Foursquare OS Places","type":"text"}],"url":"https:\/\/opensource.foursquare.com\/os-places\/","type":"link"},"https://maplibre.org/maplibre-style-spec/sources/":{"title":"tile source type","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","titleInlineContent":[{"text":"tile source type","type":"text"}],"url":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","type":"topic","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.