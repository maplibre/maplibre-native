{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"PMTiles","modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","interfaceLanguage":"occ"},"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting MapLibre iOS 6.10.0, "},{"type":"reference","identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","isActive":true},{"type":"text","text":" archives are supported as tile sources. Prefix any tile source URL with "},{"code":"pmtiles:\/\/","type":"codeVoice"},{"type":"text","text":" to read from a PMTiles archive:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"pmtiles:\/\/https:\/\/","type":"codeVoice"},{"text":" — stream tiles from a remote file","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"pmtiles:\/\/file:\/\/","type":"codeVoice"},{"text":" — read a file from the device filesystem, including the app bundle","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"pmtiles:\/\/","type":"codeVoice"},{"type":"text","text":" prefix works with any "},{"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","isActive":true},{"type":"text","text":" (e.g. "},{"code":"vector","type":"codeVoice"},{"type":"text","text":", "},{"code":"raster","type":"codeVoice"},{"type":"text","text":", "},{"code":"raster-dem","type":"codeVoice"},{"type":"text","text":", etc.), from a style JSON or dynamically."}]},{"style":"note","content":[{"inlineContent":[{"text":"PMTiles sources do not support offline pack downloads or caching.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"text":"Loading a style that uses PMTiles sources","anchor":"Loading-a-style-that-uses-PMTiles-sources","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Load a style JSON that references "},{"code":"pmtiles:\/\/","type":"codeVoice"},{"type":"text","text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:"}]},{"code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Adding a PMTiles source directly","anchor":"Adding-a-PMTiles-source-directly","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"vector","type":"codeVoice"},{"type":"text","text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — "},{"type":"reference","identifier":"https:\/\/overturemaps.org\/","isActive":true},{"type":"text","text":" (yellow) and "},{"type":"reference","identifier":"https:\/\/opensource.foursquare.com\/os-places\/","isActive":true},{"type":"text","text":" (blue) — both using "},{"code":"MLNCircleStyleLayer","type":"codeVoice"},{"type":"text","text":". The "},{"code":"sourceLayerIdentifier","type":"codeVoice"},{"type":"text","text":" names the layer within the archive to render:"}]},{"code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same pattern works for "},{"code":"raster","type":"codeVoice"},{"type":"text","text":" archives using "},{"code":"MLNRasterTileSource","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MLNRasterStyleLayer","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":" sources added programmatically cannot specify ","type":"text"},{"code":"encoding","type":"codeVoice"},{"text":" via the current iOS API. Define ","type":"text"},{"code":"raster-dem","type":"codeVoice"},{"text":" sources with terrarium encoding in the style JSON instead, where the ","type":"text"},{"code":"encoding","type":"codeVoice"},{"text":" field is fully supported.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"text":"Loading a local PMTiles file","anchor":"Loading-a-local-PMTiles-file","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle a "},{"code":".pmtiles","type":"codeVoice"},{"type":"text","text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via "},{"code":"file:\/\/","type":"codeVoice"},{"type":"text","text":", so no special handling is needed:"}]},{"code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"abstract":[{"text":"Working with PMTiles","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"]}],"seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","generated":true,"title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/AnimatedLineExample":{"abstract":[{"type":"text","text":"Add an animated line to a map"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","type":"topic","role":"article","url":"\/documentation\/maplibre-native-for-ios\/animatedlineexample","kind":"article","title":"Animated Line"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/FeatureStateVectorExample":{"abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample","type":"topic","role":"article","url":"\/documentation\/maplibre-native-for-ios\/featurestatevectorexample","kind":"article","title":"Set Feature State (Vector Source)"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"abstract":[{"type":"text","text":"Use an "},{"code":"NSPredicate","type":"codeVoice"},{"type":"text","text":" to show POI and road labels along a route."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","type":"topic","role":"article","url":"\/documentation\/maplibre-native-for-ios\/poialongrouteexample","kind":"article","title":"POI Along a Route"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLN