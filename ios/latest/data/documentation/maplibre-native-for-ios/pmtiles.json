ier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","isActive":true},{"type":"text","text":" to the map using a GeoJSON file."}],"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","role":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"title":"Showing data from an API","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","kind":"article","abstract":[{"type":"text","text":"Showing data from an API with custom styling and interaction"}],"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/webapidataexample","role":"article"},"https://overturemaps.org/":{"titleInlineContent":[{"type":"text","text":"Overture Maps"}],"url":"https:\/\/overturemaps.org\/","type":"link","title":"Overture Maps","identifier":"https:\/\/overturemaps.org\/"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/FeatureStateVectorExample":{"type":"topic","title":"Set Feature State (Vector Source)","abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"url":"\/documentation\/maplibre-native-for-ios\/featurestatevectorexample","kind":"article","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample"},"https://opensource.foursquare.com/os-places/":{"titleInlineContent":[{"type":"text","text":"Foursquare OS Places"}],"url":"https:\/\/opensource.foursquare.com\/os-places\/","type":"link","title":"Foursquare OS Places","identifier":"https:\/\/opensource.foursquare.com\/os-places\/"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GeoJSON":{"title":"Working with GeoJSON Data","identi