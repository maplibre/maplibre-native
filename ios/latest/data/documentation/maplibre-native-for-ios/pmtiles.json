{"primaryContentSections":[{"kind":"content","content":[{"inlineContent":[{"text":"Starting MapLibre iOS 6.10.0, ","type":"text"},{"identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","type":"reference","isActive":true},{"text":" archives are supported as tile sources. Prefix any tile source URL with ","type":"text"},{"code":"pmtiles:\/\/","type":"codeVoice"},{"text":" to read from a PMTiles archive:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/https:\/\/"},{"type":"text","text":" — stream tiles from a remote file"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/file:\/\/"},{"type":"text","text":" — read a file from the device filesystem, including the app bundle"}]}]}]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"pmtiles:\/\/","type":"codeVoice"},{"text":" prefix works with any ","type":"text"},{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","type":"reference","isActive":true},{"text":" (e.g. ","type":"text"},{"code":"vector","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster"},{"type":"text","text":", "},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":", etc.), from a style JSON or dynamically."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"PMTiles sources do not support offline pack downloads or caching.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"text":"Loading a style that uses PMTiles sources","anchor":"Loading-a-style-that-uses-PMTiles-sources","type":"heading","level":2},{"inlineContent":[{"text":"Load a style JSON that references ","type":"text"},{"code":"pmtiles:\/\/","type":"codeVoice"},{"text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"],"type":"codeListing"},{"text":"Adding a PMTiles source directly","anchor":"Adding-a-PMTiles-source-directly","type":"heading","level":2},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"vector","type":"codeVoice"},{"type":"text","text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — "},{"type":"reference","identifier":"https:\/\/overturemaps.org\/","isActive":true},{"text":" (yellow) and ","type":"text"},{"type":"reference","identifier":"https:\/\/opensource.foursquare.com\/os-places\/","isActive":true},{"type":"text","text":" (blue) — both using "},{"type":"codeVoice","code":"MLNCircleStyleLayer"},{"type":"text","text":". The "},{"code":"sourceLayerIdentifier","type":"codeVoice"},{"text":" names the layer within the archive to render:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The same pattern works for ","type":"text"},{"code":"raster","type":"codeVoice"},{"text":" archives using ","type":"text"},{"code":"MLNRasterTileSource","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MLNRasterStyleLayer","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"text":" sources added programmatically cannot specify ","type":"text"},{"type":"codeVoice","code":"encoding"},{"text":" via the current iOS API. Define ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":" sources with terrarium encoding in the style JSON instead, where the "},{"code":"encoding","type":"codeVoice"},{"text":" field is fully supported.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"text":"Loading a local PMTiles file","level":2,"type":"heading","anchor":"Loading-a-local-PMTiles-file"},{"inlineContent":[{"text":"Bundle a ","type":"text"},{"code":".pmtiles","type":"codeVoice"},{"text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via ","type":"text"},{"code":"file:\/\/","type":"codeVoice"},{"text":", so no special handling is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"MapLibre"}],"title":"PMTiles"},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","interfaceLanguage":"occ"},"seeAlsoSections":[{"title":"Styling and Dynamic Data","anchor":"Styling-and-Dynamic-Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","doc:\/\/org.swift.MyProject\/documentation\/MapLib