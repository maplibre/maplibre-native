,"abstract":[{"type":"text","text":"Add and style a vector tile source"}],"url":"\/documentation\/maplibre-native-for-ios\/ddscirclelayerexample","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","type":"topic","title":"Vector Tile Sources"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer":{"kind":"symbol","abstract":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference"},{"type":"text","text":" is a style layer that renders one or more stroked"},{"text":" ","type":"text"},{"text":"polylines on the map.","type":"text"}],"type":"topic","url":"\/documentation\/maplibre\/mlnlinestylelayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","fragments":[{"kind":"identifier","text":"MLNLineStyleLayer"}],"title":"MLNLineStyleLayer","role":"symbol"},"https://maplibre.org/maplibre-style-spec/sources/":{"url":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","titleInlineContent":[{"type":"text","text":"tile source type"}],"type":"link","title":"tile source type"},"doc://org.swift.MyProject/documentation/MapLibre":{"role":"collection","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"url":"\/documentation\/maplibre","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","title":"MapLibre"},"https://opensource.foursquare.com/os-places/":{"url":"https:\/\/opensource.foursquare.com\/os-places\/","identifier":"https:\/\/opensource.foursquare.com\/os-places\/","titleInlineContent":[{"type":"text","text":"Foursquare OS Places"}],"type":"link","title":"Foursquare OS Places"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":