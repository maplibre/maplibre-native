":"article","abstract":[{"type":"text","text":"Add and style a vector tile source"}],"title":"Vector Tile Sources"},"https://overturemaps.org/":{"title":"Overture Maps","type":"link","identifier":"https:\/\/overturemaps.org\/","titleInlineContent":[{"text":"Overture Maps","type":"text"}],"url":"https:\/\/overturemaps.org\/"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"abstract":[{"text":"Adding an ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","isActive":true},{"text":" to the map using a GeoJSON file.","type":"text"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","role":"article","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","title":"Using GeoJSON with a line style layer","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/FeatureStateExample":{"title":"Set Feature State","type":"topic","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","role":"article","abstract":[{"type":"text","text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions."}],"url":"\/documentation\/maplibre-native-for-ios\/featurestateexample"},"https://docs.protomaps.com/pmtiles/":{"identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","title":"PMTiles","titleInlineContent":[{"type":"text","text":"PMTiles"}],"url":"https:\/\/docs.protomaps.com\/pmtiles\/","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"type":"topic","abstract":[{"type":"text","text":"Showing data from an API with custom styling and interaction"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","role":"article","url":"\/documentation\