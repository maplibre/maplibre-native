{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pmtiles"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"paragraph","inlineContent":[{"text":"Starting MapLibre iOS 6.10.0, ","type":"text"},{"identifier":"https:\/\/docs.protomaps.com\/pmtiles\/","isActive":true,"type":"reference"},{"text":" archives are supported as tile sources. Prefix any tile source URL with ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" to read from a PMTiles archive:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/https:\/\/"},{"text":" — stream tiles from a remote file","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pmtiles:\/\/file:\/\/"},{"text":" — read a file from the device filesystem, including the app bundle","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" prefix works with any ","type":"text"},{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/","isActive":true,"type":"reference"},{"text":" (e.g. ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":", ","type":"text"},{"type":"codeVoice","code":"raster-dem"},{"text":", etc.), from a style JSON or dynamically.","type":"text"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"PMTiles sources do not support offline pack downloads or caching."}],"type":"paragraph"}],"style":"note"},{"text":"Loading a style that uses PMTiles sources","anchor":"Loading-a-style-that-uses-PMTiles-sources","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Load a style JSON that references ","type":"text"},{"type":"codeVoice","code":"pmtiles:\/\/"},{"text":" sources. The example below loads a satellite imagery basemap of the Central Alps and sets the initial camera position:","type":"text"}]},{"code":["class PMTilesStyleURL: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        let mapView = MLNMapView(","            frame: view.bounds,","            styleURL: URL(string: \"https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/style-imagery.json\")!","        )","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.setCenter(CLLocationCoordinate2D(latitude: 47.5, longitude: 12.0), zoomLevel: 9, animated: false)","        view.addSubview(mapView)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Adding a PMTiles source directly","anchor":"Adding-a-PMTiles-source-directly","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"vector"},{"text":" sources from PMTiles archives to an already-loaded style. The example overlays two places datasets — ","type":"text"},{"identifier":"https:\/\/overturemaps.org\/","isActive":true,"type":"reference"},{"text":" (yellow) and ","type":"text"},{"identifier":"https:\/\/opensource.foursquare.com\/os-places\/","isActive":true,"type":"reference"},{"text":" (blue) — both using ","type":"text"},{"type":"codeVoice","code":"MLNCircleStyleLayer"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"sourceLayerIdentifier"},{"text":" names the layer within the archive to render:","type":"text"}]},{"code":["class PMTilesAddSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let overtureURL = URL(string: \"pmtiles:\/\/https:\/\/overturemaps-tiles-us-west-2-beta.s3.amazonaws.com\/2026-01-21\/places.pmtiles\")!","        let overtureSource = MLNVectorTileSource(identifier: \"overture-places\", configurationURL: overtureURL)","        style.addSource(overtureSource)","        let overtureLayer = MLNCircleStyleLayer(identifier: \"overture-layer\", source: overtureSource)","        overtureLayer.sourceLayerIdentifier = \"place\"","        overtureLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.96, green: 0.78, blue: 0.0, alpha: 1))","        overtureLayer.circleRadius = NSExpression(forConstantValue: 4)","        overtureLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(overtureLayer)","","        let foursquareURL = URL(string: \"pmtiles:\/\/https:\/\/oliverwipfli.ch\/data\/foursquare-os-places-10M-2024-11-20.pmtiles\")!","        let foursquareSource = MLNVectorTileSource(identifier: \"foursquare-places\", configurationURL: foursquareURL)","        style.addSource(foursquareSource)","        let foursquareLayer = MLNCircleStyleLayer(identifier: \"foursquare-layer\", source: foursquareSource)","        foursquareLayer.sourceLayerIdentifier = \"place\"","        foursquareLayer.circleColor = NSExpression(forConstantValue: UIColor(red: 0.18, green: 0.85, blue: 1.0, alpha: 1))","        foursquareLayer.circleRadius = NSExpression(forConstantValue: 4)","        foursquareLayer.circleOpacity = NSExpression(forConstantValue: 0.6)","        style.addLayer(foursquareLayer)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The same pattern works for ","type":"text"},{"type":"codeVoice","code":"raster"},{"text":" archives using ","type":"text"},{"type":"codeVoice","code":"MLNRasterTileSource"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MLNRasterStyleLayer"},{"text":":","type":"text"}]},{"code":["class PMTilesRasterSource: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        let url = URL(string: \"pmtiles:\/\/https:\/\/demotiles.maplibre.org\/pmtiles\/raster\/imagery.pmtiles\")!","        let source = MLNRasterTileSource(identifier: \"imagery\", configurationURL: url, tileSize: 256)","        style.addSource(source)","        let layer = MLNRasterStyleLayer(identifier: \"imagery\", source: source)","        style.addLayer(layer)","    }","}"],"type":"codeListing","syntax":"swift"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":" sources added programmatically cannot specify "},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" via the current iOS API. Define "},{"type":"codeVoice","code":"raster-dem"},{"type":"text","text":" sources with terrarium encoding in the style JSON instead, where the "},{"type":"codeVoice","code":"encoding"},{"type":"text","text":" field is fully supported."}],"type":"paragraph"}],"style":"note"},{"text":"Loading a local PMTiles file","anchor":"Loading-a-local-PMTiles-file","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Bundle a ","type":"text"},{"type":"codeVoice","code":".pmtiles"},{"text":" file in your app target and reference it using its bundle URL. iOS app bundle files are accessible via ","type":"text"},{"type":"codeVoice","code":"file:\/\/"},{"text":", so no special handling is needed:","type":"text"}]},{"code":["class PMTilesLocalFile: UIViewController, MLNMapViewDelegate {","    var mapView: MLNMapView!","","    override func viewDidLoad() {","        super.viewDidLoad()","        mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","        view.addSubview(mapView)","    }","","    func mapView(_: MLNMapView, didFinishLoading style: MLNStyle) {","        guard let fileURL = Bundle.main.url(forResource: \"world\", withExtension: \"pmtiles\") else { return }","        let url = URL(string: \"pmtiles:\/\/\\(fileURL.absoluteString)\")!","        let source = MLNVectorTileSource(identifier: \"world\", configurationURL: url)","        style.addSource(source)","        let layer = MLNFillStyleLayer(identifier: \"countries\", source: source)","        layer.sourceLayerIdentifier = \"countries\"","        layer.fillColor = NSExpression(forConstantValue: UIColor(red: 0.67, green: 0.83, blue: 0.87, alpha: 1))","        style.addLayer(layer)","    }","}"],"type":"codeListing","syntax":"swift"}]}],"abstract":[{"text":"Working with PMTiles","type":"text"}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"MapLibre"}],"title":"PMTiles"},"sections":[],"seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documen