rnatively, use the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shapes:options:","type":"reference","isActive":true},{"type":"text","text":" method to create a shape source"},{"type":"text","text":" "},{"type":"text","text":"with an array. "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:","type":"reference","isActive":true},{"type":"text","text":" accepts only "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instances, such as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointFeature","type":"reference","isActive":true},{"type":"text","text":" objects, whose attributes you can use when"},{"type":"text","text":" "},{"type":"text","text":"applying a predicate to "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","type":"reference","isActive":true},{"type":"text","text":" or configuring a style layer’s"},{"type":"text","text":" "},{"type":"text","text":"appearance."}]},{"type":"heading","text":"Extracting GeoJSON data from the map","anchor":"Extracting-GeoJSON-data-from-the-map","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/document