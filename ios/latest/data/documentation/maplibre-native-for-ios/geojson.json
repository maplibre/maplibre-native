text":"resulting shape or feature object into the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shape:options:","type":"reference","isActive":true},{"type":"text","text":" initializer and add it to"},{"type":"text","text":" "},{"type":"text","text":"the map, or you can use the object and its properties to power non-map-related"},{"type":"text","text":" "},{"type":"text","text":"functionality in your application."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To include multiple shapes in the source, create and pass an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollection","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature","type":"reference","isActive":true},{"type":"text","text":" object to"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shape:options:","type":"reference","isActive":true},{"type":"text","text":". Alternatively, use the"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shapes:options:","type":"reference","isActive":true},{"type":"text","text":" method to create a shape source"},{"type":"text","text":" "},{"type":"text","text":"with an array. "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:","type":"reference","isActive":true},{"type":"text","text":" accepts only "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instances, such as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointFeature","type":"reference","isActive":true},{"type":"text","text":" objects, whose attributes you can use when"},{"type":"text","text":" "},{"type":"text","text":"applying a predicate to "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","type":"reference","isActive":true},{"type":"text","text":" or configuring a style layer’s"},{"type":"text","text":" "},{"type":"text","text":"appearance."}]},{"text":"Extracting GeoJSON data from the map","level":2,"anchor":"Extracting-GeoJSON-data-from-the-map","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature","type":"reference","isActive":true},{"type":"text","text":" object has an"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape\/geoJSONDataUsingEncoding:","type":"reference","isActive":true},{"type":"text","text":" method that you can use to create a"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON source code representation of the object. You can extract a feature"},{"type":"text","text":" "},{"type":"text","text":"object from the map using a method such as"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:","type":"reference","isActive":true},{"type":"text","text":"."}]},{"text":"About GeoJSON deserialization","level":2,"anchor":"About-GeoJSON-deserialization","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The process of converting GeoJSON text into "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","type":"reference","isActive":true},{"type":"text","text":", or"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature","type":"reference","isActive":true},{"type":"text","text":" objects is known as “GeoJSON deserialization”."},{"type":"text","text":" "},{"type":"text","text":"GeoJSON geometries, features, and feature collections are known in this SDK as"},{"type":"text","text":" "},{"type":"text","text":"shapes, features, and shape collection features, respectively."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each GeoJSON object type corresponds to a type provided by either this SDK or"},{"type":"text","text":" "},{"type":"text","text":"the Core Location framework:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"GeoJSON object type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"SDK type","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Position","type":"codeVoice"},{"text":" (longitude, latitude)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"CLLocationCoordinate2D","type":"codeVoice"},{"text":" (latitude, longitude)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Point","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MultiPoint","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc