oject\/documentation\/MapLibre\/MLNShapeCollectionFeature","isActive":true,"type":"reference"},{"text":" object that the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true,"type":"reference"},{"text":" class understands","type":"text"},{"text":" ","type":"text"},{"text":"natively. First, create an ","type":"text"},{"code":"NSData","type":"codeVoice"},{"text":" object out of the source code string or file","type":"text"},{"text":" ","type":"text"},{"text":"contents, then pass that data object into the","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape\/shapeWithData:encoding:error:","isActive":true},{"text":" method. Finally, you can pass the","type":"text"},{"text":" ","type":"text"},{"text":"resulting shape or feature object into the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shape:options:","isActive":true},{"type":"text","text":" initializer and add it to"},{"type":"text","text":" "},{"text":"the map, or you can use the object and its properties to power non-map-related","type":"text"},{"type":"text","text":" "},{"type":"text","text":"functionality in your application."}]},{"type":"paragraph","inlineContent":[{"text":"To include multiple shapes in the source, create and pass an ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollection","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature","isActive":true},{"type":"text","text":" object to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shape:options:"},{"type":"text","text":". Alternatively, use the"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:shapes:options:","isActive":true,"type":"reference"},{"text":" method to create a shape source","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with an array. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/initWithIdentifier:features:options:"},{"type":"text","text":" accepts only "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instances, such as "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointFeature","isActive":true},{"type":"text","text":" objects, whose attributes you can use when"},{"type":"text","text":" "},{"type":"text","text":"applying a predicate to "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true},{"text":" or configuring a style layer’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"appearance."}]},{"text":"Extracting GeoJSON data from the map","anchor":"Extracting-GeoJSON-data-from-the-map","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Any ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature","isActive":true,"type":"reference"},{"text":", or ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature","isActive":true,"type":"reference"},{"type":"text","text":" object has an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape\/geoJSONDataUsingEncoding:","isActive":true},{"type":"text","text":" method that you can use to create a"},{"type":"text","text":" "},{"type":"text","text":"GeoJSON source code representation of the object. You can extract a feature"},{"type":"text","text":" "},{"type":"text","text":"object from the map using a method such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMapView\/visibleFeaturesAtPoint:","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","anchor":"About-GeoJSON-deserialization","text":"About GeoJSON deserialization"},{"inlineContent":[{"type":"text","text":"The process of converting GeoJSON text into "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNFeature"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeCollectionFeature"},{"type":"text","text":" objects is known as “GeoJSON deserialization”."},{"type":"text","text":" "},{"type":"text","text":"GeoJSON geometries, features, and feature collections are known in this SDK as"},{"type":"text","text":" "},{"type":"text","text":"shapes, features, and shape collection features, respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each GeoJSON object type corresponds to a type provided by either this SDK or"},{"type":"text","text":" "},{"text":"the Core Location framework:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"GeoJSON object type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"SDK type"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Position","type":"codeVoice"},{"text":" (longitude, latitude)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CLLocationCoordinate2D"},{"type":"text","text":" (latitude, longitude)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Point","type":"codeVoice"}]}],[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointAnnotation","type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MultiPoint"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPointCollection","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"LineString","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolyline","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultiLineString"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMultiPolyline","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Polygon"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNPolygon","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MultiPolygon","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNMultiPolygon"}]}]],[[{"type":"paragraph","in