{"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"title":"Advanced","anchor":"Advanced","generated":true}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"metadata":{"role":"article","roleHeading":"Article","title":"Plugin API","modules":[{"name":"MapLibre"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"primaryContentSections":[{"content":[{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}]}],"type":"aside"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"text":". Layers of plugin types appear as ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"text":" in ","type":"text"},{"code":"MLNStyle.layers","type":"codeVoice"},{"text":". The API is defined in ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Add MapLibre with the plugin API","anchor":"Add-MapLibre-with-the-plugin-API","type":"heading"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"code":"import MapLibre","type":"codeVoice"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The package has two products:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Product","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it in","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibre","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Applications","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"text":" with the plugin API enabled.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"text":".","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Write a plugin","anchor":"Write-a-plugin","type":"heading"},{"inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing"},{"inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}],"type":"paragraph"},{"syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"type":"codeListing"},{"inlineContent":[{"text":"Here ","type":"text"},{"code":"descriptor","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"text":" of the plugin. Set ","type":"text"},{"code":"struct_size","type":"codeVoice"},{"text":" of every structure to the size of its type, as ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":" describes.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Register a plugin","anchor":"Register-a-plugin","type":"heading"},{"inlineContent":[{"text":"The application passes ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}],"type":"paragraph"},{"syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing"},{"inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"text":". Plugins cannot be unregistered.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"sections":[],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","kind":"article","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"role":"article","title":"Rendering Statistics HUD"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"titleInlineContent":[{"text":"n-gon layer","type":"text"}],"title":"n-gon layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"topic","fragments":[{"kind":"identifier","text":"MLNStyle"}],"url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"role":"symbol","title":"MLNStyle"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"kind":"article","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"title":"Custom Style Layers (Metal API)","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","type":"topic"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"topic","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"text":" ","type":"text"},{"text":"manages the layout and appearance of content at a specific z-index in a style.","type":"text"},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"text":" object consists of one or more ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"text":" objects.","type":"text"}],"role":"symbol","title":"MLNStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","url":"\/documentation\/maplibre","kind":"symbol","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"role":"collection","title":"MapLibre"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"title":"maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link"}}}