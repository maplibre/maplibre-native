{"metadata":{"title":"Plugin API","roleHeading":"Article","modules":[{"name":"MapLibre"}],"role":"article"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"sections":[],"seeAlsoSections":[{"anchor":"Advanced","title":"Advanced","generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"style":"warning","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}],"type":"paragraph"}],"type":"aside"},{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" in "},{"code":"MLNStyle.layers","type":"codeVoice"},{"type":"text","text":". The API is defined in "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}]}]}]},{"text":"Add MapLibre with the plugin API","level":2,"anchor":"Add-MapLibre-with-the-plugin-API","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"code":"import MapLibre","type":"codeVoice"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The package has two products:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Product","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use it in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Contents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"text":" with the plugin API enabled.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Plugin packages","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"text":".","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Write a plugin","level":2,"anchor":"Write-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"syntax":"c"},{"type":"paragraph","inlineContent":[{"text":"Here ","type":"text"},{"code":"descriptor","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"text":" of the plugin. Set ","type":"text"},{"code":"struct_size","type":"codeVoice"},{"text":" of every structure to the size of its type, as ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":" describes.","type":"text"}]},{"type":"heading","text":"Register a plugin","level":2,"anchor":"Register-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"The application passes ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}]},{"type":"codeListing","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference","isActive":true},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"text":".","type":"text"}]}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"type":"topic","kind":"symbol","title":"MLNStyle","role":"symbol"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"titleInlineContent":[{"type":"text","text":"n-gon layer"}],"title":"n-gon layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"title":"Rendering Statistics HUD","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","role":"article","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","abstract":[{"text":"Show rendering statistics on the map","type":"text"}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"type":"link","title":"maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","kind":"symbol","title":"MapLibre","role":"collection"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"type":"link","title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"kind":"article","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","role":"article","title":"Custom Style Layers (Metal API)","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","role":"symbol","title":"MLNStyleLayer","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"type":"topic"}}}