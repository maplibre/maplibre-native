{"metadata":{"role":"article","title":"Plugin API","roleHeading":"Article","modules":[{"name":"MapLibre"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"seeAlsoSections":[{"title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"anchor":"Advanced"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"sections":[],"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"name":"Warning","type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}]}]},{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"type":"codeVoice","code":"\"type\": \"org.maplibre.ngon\""},{"type":"text","text":". Layers of plugin types appear as "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"MLNStyle.layers"},{"type":"text","text":". The API is defined in "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"type":"codeVoice","code":"plugin_api.h"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}]}]}]},{"level":2,"type":"heading","anchor":"Add-MapLibre-with-the-plugin-API","text":"Add MapLibre with the plugin API"},{"inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","isActive":true},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"type":"codeVoice","code":"import MapLibre"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product"}]}],[{"inlineContent":[{"type":"text","text":"Use it in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Applications"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Plugin packages"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Write-a-plugin","text":"Write a plugin"},{"inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"syntax":"swift"},{"inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"syntax":"c"},{"inlineContent":[{"text":"Here ","type":"text"},{"code":"descriptor","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"text":" of the plugin. Set ","type":"text"},{"code":"struct_size","type":"codeVoice"},{"text":" of every structure to the size of its type, as ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":" describes.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Register-a-plugin","text":"Register a plugin"},{"inlineContent":[{"text":"The application passes ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"syntax":"objc"},{"inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"text":". Plugins cannot be unregistered.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Example","text":"Example"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true,"type":"reference"},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","kind":"symbol","title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"role":"collection","url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"title":"n-gon layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"type":"topic","kind":"article","title":"Custom Style Layers (Metal API)","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"role":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"title":"MLNStyle"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"title":"maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"type":"topic","kind":"article","title":"Rendering Statistics HUD","abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"role":"article","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"type":"topic","kind":"symbol","title":"MLNStyleLayer","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true,"type":"reference"},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object consists of one or more "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" objects."}],"role":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link"}}}