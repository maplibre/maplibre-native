{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"seeAlsoSections":[{"title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"anchor":"Advanced","generated":true}],"metadata":{"title":"Plugin API","modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"content","content":[{"name":"Warning","content":[{"inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}],"type":"paragraph"}],"type":"aside","style":"warning"},{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" in "},{"code":"MLNStyle.layers","type":"codeVoice"},{"type":"text","text":". The API is defined in "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"code":"\"type\"","type":"codeVoice"},{"text":" in a style.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}]}]}]},{"anchor":"Add-MapLibre-with-the-plugin-API","text":"Add MapLibre with the plugin API","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"code":"import MapLibre","type":"codeVoice"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Product"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use it in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Applications"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Plugin packages"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Write-a-plugin","text":"Write a plugin","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"code":"MapLibrePluginApi","type":"codeVoice"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}],"type":"paragraph"},{"syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here "},{"code":"descriptor","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":" describes."}],"type":"paragraph"},{"anchor":"Register-a-plugin","text":"Register a plugin","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The application passes "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}],"type":"paragraph"},{"syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"type":"text","text":". Plugins cannot be unregistered."}],"type":"paragraph"},{"anchor":"Example","text":"Example","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"role":"article","title":"Custom Style Layers (Metal API)","kind":"article","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","role":"article","title":"Rendering Statistics HUD","abstract":[{"type":"text","text":"Show rendering statistics on the map"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"role":"collection","title":"MapLibre","kind":"symbol","type":"topic"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"title":"maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"url":"\/documentation\/maplibre\/mlnstyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"role":"symbol","title":"MLNStyle","kind":"symbol","type":"topic","fragments":[{"text":"MLNStyle","kind":"identifier"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"title":"MLNStyleLayer","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" objects."}],"url":"\/documentation\/maplibre\/mlnstylelayer"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","title":"n-gon layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link"}}}