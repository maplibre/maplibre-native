{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"sections":[],"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"kind":"article","seeAlsoSections":[{"title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"anchor":"Advanced"}],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"content","content":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}]}],"name":"Warning","type":"aside","style":"warning"},{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"text":". Layers of plugin types appear as ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"text":" in ","type":"text"},{"type":"codeVoice","code":"MLNStyle.layers"},{"text":". The API is defined in ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"code":"\"type\"","type":"codeVoice"},{"type":"text","text":" in a style."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}]}]}]},{"anchor":"Add-MapLibre-with-the-plugin-API","level":2,"text":"Add MapLibre with the plugin API","type":"heading"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"type":"codeVoice","code":"import MapLibre"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The package has two products:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contents"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Plugin packages"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Write-a-plugin","level":2,"text":"Write a plugin","type":"heading"},{"inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"type":"codeVoice","code":"MapLibrePluginApi"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}],"type":"paragraph"},{"code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"type":"codeListing","syntax":"c"},{"inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"type":"codeVoice","code":"struct_size"},{"text":" of every structure to the size of its type, as ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}],"type":"paragraph"},{"anchor":"Register-a-plugin","level":2,"text":"Register a plugin","type":"heading"},{"inlineContent":[{"text":"The application passes ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}],"type":"paragraph"},{"code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing","syntax":"objc"},{"inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference","isActive":true},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"type":"codeVoice","code":"ngon"},{"text":" layer type with ","type":"text"},{"type":"codeVoice","code":"mln_ngon_layer_register"},{"text":".","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article","title":"Plugin API"},"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"title":"Rendering Statistics HUD","abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","kind":"article","role":"article","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"},"doc://org.swift.MyProject/documentation/MapLibre":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"url":"\/documentation\/maplibre","kind":"symbol","role":"collection","type":"topic","title":"MapLibre"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"title":"n-gon layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"title":"maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","type":"topic","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true,"type":"reference"},{"type":"text","text":" objects."}],"fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"title":"MLNStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","title":"Custom Style Layers (Metal API)"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"type":"link","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","abstract":[{"type":"text","text":"The proxy object for the current map style."}],"url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyle"}],"role":"symbol","type":"topic","title":"MLNStyle"}}}