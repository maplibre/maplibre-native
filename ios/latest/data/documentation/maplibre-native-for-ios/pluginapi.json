{"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"title":"Advanced","anchor":"Advanced"}],"metadata":{"roleHeading":"Article","title":"Plugin API","modules":[{"name":"MapLibre"}],"role":"article"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"name":"Warning","style":"warning","content":[{"inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"type":"text","text":". Layers of plugin types appear as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"MLNStyle.layers"},{"type":"text","text":". The API is defined in "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Add MapLibre with the plugin API","anchor":"Add-MapLibre-with-the-plugin-API","type":"heading"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"type":"codeVoice","code":"import MapLibre"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Product","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contents"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"text":".","type":"text"}]},{"type":"heading","text":"Write a plugin","level":2,"anchor":"Write-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}]},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"type":"codeVoice","code":"descriptor"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"type":"text","text":" of the plugin. Set "},{"type":"codeVoice","code":"struct_size"},{"type":"text","text":" of every structure to the size of its type, as "},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}]},{"type":"heading","text":"Register a plugin","level":2,"anchor":"Register-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"The application passes ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true,"type":"reference"},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"text":".","type":"text"}]}]}],"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"role":"symbol","title":"MLNStyleLayer"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"title":"Rendering Statistics HUD","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","role":"article","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","abstract":[{"type":"text","text":"Show rendering statistics on the map"}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"type":"topic","kind":"symbol","title":"MLNStyle","role":"symbol","url":"\/documentation\/maplibre\/mlnstyle"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"type":"link","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","abstract":[{"text":"Creating a Custom Style Layer with Metal","type":"text"}],"kind":"article","type":"topic","title":"Custom Style Layers (Metal API)","role":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample"},"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mappi