t a specific z-index in a style.","type":"text"},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"text":" object consists of one or more ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"text":" objects.","type":"text"}],"role":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","title":"MLNStyleLayer","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}]}}}