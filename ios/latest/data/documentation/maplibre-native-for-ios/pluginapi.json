{"sections":[],"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"seeAlsoSections":[{"anchor":"Advanced","title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"kind":"article","metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article","title":"Plugin API"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}]}],"type":"aside","style":"warning"},{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" in "},{"type":"codeVoice","code":"MLNStyle.layers"},{"type":"text","text":". The API is defined in "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}]}]}],"type":"unorderedList"},{"text":"Add MapLibre with the plugin API","level":2,"type":"heading","anchor":"Add-MapLibre-with-the-plugin-API"},{"inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"type":"codeVoice","code":"import MapLibre"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it in","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"text":"Applications","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"text":" with the plugin API enabled.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}]}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Write a plugin","anchor":"Write-a-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"type":"codeVoice","code":"MapLibrePluginApi"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"type":"codeVoice","code":"struct_size"},{"text":" of every structure to the size of its type, as ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}]},{"type":"heading","level":2,"text":"Register a plugin","anchor":"Register-a-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The application passes "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}]},{"type":"codeListing","syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"]},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference"},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","title":"Custom Style Layers (Metal API)","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"type":"topic","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"title":"MLNStyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","type":"topic","fragments":[{"text":"MLNStyle","kind":"identifier"}],"role":"symbol","url":"\/documentation\/maplibre\/mlnstyle"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference"},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"text":" ","type":"text"},{"text":"manages the layout and appearance of content at a specific z-index in a style.","type":"text"},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object consists of one or more ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" objects.","type":"text"}],"role":"symbol","type":"topic","title":"MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"role":"article","type":"topic","title":"Rendering Statistics HUD","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","kind":"article"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h","type":"link","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}]},"doc://org.swift.MyProject/documentation/MapLibre":{"title":"MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/maplibre"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link","title":"n-gon layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}]}}}