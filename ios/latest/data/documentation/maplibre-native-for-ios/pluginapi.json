{"sections":[],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"anchor":"Advanced","title":"Advanced"}],"metadata":{"roleHeading":"Article","title":"Plugin API","modules":[{"name":"MapLibre"}],"role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}]}],"style":"warning"},{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" in "},{"code":"MLNStyle.layers","type":"codeVoice"},{"type":"text","text":". The API is defined in "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"code":"\"type\"","type":"codeVoice"},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}],"type":"paragraph"}]}]},{"text":"Add MapLibre with the plugin API","type":"heading","level":2,"anchor":"Add-MapLibre-with-the-plugin-API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","isActive":true},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"code":"import MapLibre","type":"codeVoice"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package has two products:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Product","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it in","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibre","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Applications","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"text":" with the plugin API enabled.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"text":".","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Write a plugin","type":"heading","level":2,"anchor":"Write-a-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"code":"MapLibrePluginApi","type":"codeVoice"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}]},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"code":"descriptor","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":" describes."}]},{"text":"Register a plugin","type":"heading","level":2,"anchor":"Register-a-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The application passes "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}]},{"type":"codeListing","syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"type":"text","text":". Plugins cannot be unregistered."}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","title":"MapLibre","type":"topic","role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"type":"topic","title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyle"}],"role":"symbol","abstract":[{"type":"text","text":"The proxy object for the current map style."}]},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"type":"link","title":"plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"url":"\/documentation\/maplibre\/mlnstylelayer","title":"MLNStyleLayer","type":"topic","role":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"title":"Custom Style Layers (Metal API)","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","type":"topic","kind":"article","role":"article"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"type":"link","title":"n-gon layer"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"kind":"article","title":"Rendering Statistics HUD","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","role":"article","abstract":[{"type":"text","text":"Show rendering statistics on the map"}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"type":"link","title":"maplibre-ios-with-plugin-api"}}}