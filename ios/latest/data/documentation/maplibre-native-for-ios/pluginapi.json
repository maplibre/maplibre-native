{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"anchor":"Advanced","title":"Advanced"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Article","role":"article","title":"Plugin API"},"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"primaryContentSections":[{"content":[{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}]}],"name":"Warning","style":"warning"},{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" in "},{"code":"MLNStyle.layers","type":"codeVoice"},{"type":"text","text":". The API is defined in "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}]}]}]},{"type":"heading","anchor":"Add-MapLibre-with-the-plugin-API","text":"Add MapLibre with the plugin API","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"code":"import MapLibre","type":"codeVoice"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package has two products:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contents"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Plugin packages"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"type":"text","text":"."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Write-a-plugin","text":"Write a plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"code":"MapLibrePluginApi","type":"codeVoice"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}]},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"code":"descriptor","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":" describes."}]},{"type":"heading","anchor":"Register-a-plugin","text":"Register a plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The application passes "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}]},{"type":"codeListing","syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"type":"text","text":". Plugins cannot be unregistered."}]},{"type":"heading","anchor":"Example","text":"Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference","isActive":true},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"title":"n-gon layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"title":"maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"type":"topic","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"text":" ","type":"text"},{"text":"manages the layout and appearance of content at a specific z-index in a style.","type":"text"},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" object consists of one or more ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"text":" objects.","type":"text"}],"url":"\/documentation\/maplibre\/mlnstylelayer","title":"MLNStyleLayer"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"role":"article","kind":"article","title":"Rendering Statistics HUD","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"url":"\/documentation\/maplibre","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"abstract":[{"type":"text","text":"The proxy object for the current map style."}],"role":"symbol","kind":"symbol","fragments":[{"text":"MLNStyle","kind":"identifier"}],"title":"MLNStyle","type":"topic","url":"\/documentation\/maplibre\/mlnstyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","title":"Custom Style Layers (Metal API)"}}}