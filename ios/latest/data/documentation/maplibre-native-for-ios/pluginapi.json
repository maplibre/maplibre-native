{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"kind":"article","sections":[],"metadata":{"role":"article","modules":[{"name":"MapLibre"}],"roleHeading":"Article","title":"Plugin API"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"seeAlsoSections":[{"anchor":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"title":"Advanced"}],"primaryContentSections":[{"content":[{"style":"warning","content":[{"inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Warning"},{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"text":". Layers of plugin types appear as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"text":" in ","type":"text"},{"code":"MLNStyle.layers","type":"codeVoice"},{"text":". The API is defined in ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Add MapLibre with the plugin API","anchor":"Add-MapLibre-with-the-plugin-API","type":"heading"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference"},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"code":"import MapLibre","type":"codeVoice"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"text":"The package has two products:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Product","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use it in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"MapLibre","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Plugin packages","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Write a plugin","type":"heading","anchor":"Write-a-plugin"},{"inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}],"type":"paragraph"},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"code":"descriptor","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"code":"plugin_api.h","type":"codeVoice"},{"text":" describes.","type":"text"}]},{"anchor":"Register-a-plugin","level":2,"text":"Register a plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"The application passes "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}],"type":"paragraph"},{"code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"syntax":"objc","type":"codeListing"},{"inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"text":". Plugins cannot be unregistered.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Example","anchor":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true,"type":"reference"},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","role":"article","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"kind":"article","title":"Rendering Statistics HUD","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"title":"MLNStyleLayer","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"text":" objects.","type":"text"}],"role":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"url":"\/documentation\/maplibre\/mlnstyle","title":"MLNStyle","role":"symbol","kind":"symbol","fragments":[{"text":"MLNStyle","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","role":"collection","url":"\/documentation\/maplibre","title":"MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","kind":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","abstract":[{"text":"Creating a Custom Style Layer with Metal","type":"text"}],"title":"Custom Style Layers (Metal API)","role":"article"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"title":"maplibre-ios-with-plugin-api"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"title":"n-gon layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"}}}