{"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"MapLibre"}],"title":"Plugin API"},"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"seeAlsoSections":[{"title":"Advanced","anchor":"Advanced","generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"]}],"primaryContentSections":[{"content":[{"name":"Warning","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}],"type":"paragraph"}],"style":"warning"},{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"type":"text","text":". Layers of plugin types appear as "},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference"},{"type":"text","text":" in "},{"code":"MLNStyle.layers","type":"codeVoice"},{"type":"text","text":". The API is defined in "},{"isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference"},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept."}]}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Add-MapLibre-with-the-plugin-API","type":"heading","text":"Add MapLibre with the plugin API"},{"inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"code":"import MapLibre","type":"codeVoice"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Product","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use it in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"MapLibre","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Applications"}],"type":"paragraph"}],[{"inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Plugin packages"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Write a plugin","anchor":"Write-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"type":"codeVoice","code":"MapLibrePluginApi"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}]},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"type":"codeListing","syntax":"c"},{"type":"paragraph","inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"type":"codeVoice","code":"struct_size"},{"text":" of every structure to the size of its type, as ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}]},{"level":2,"type":"heading","text":"Register a plugin","anchor":"Register-a-plugin"},{"type":"paragraph","inlineContent":[{"text":"The application passes ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}]},{"code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing","syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true,"type":"reference"},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"type":"codeVoice","code":"ngon"},{"text":" layer type with ","type":"text"},{"type":"codeVoice","code":"mln_ngon_layer_register"},{"text":".","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre":{"abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","type":"topic","url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"type":"topic","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"role":"article","title":"Custom Style Layers (Metal API)","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"type":"topic","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object consists of one or more "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" objects."}],"role":"symbol","title":"MLNStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"type":"topic","role":"symbol","title":"MLNStyle","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"url":"\/documentation\/maplibre\/mlnstyle","kind":"symbol"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","title":"n-gon layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"title":"Rendering Statistics HUD","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","kind":"article"}}}