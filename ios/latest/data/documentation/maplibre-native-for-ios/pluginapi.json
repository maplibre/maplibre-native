\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" objects."}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"type":"link","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"}}}