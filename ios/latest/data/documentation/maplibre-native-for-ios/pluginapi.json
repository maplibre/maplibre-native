{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"seeAlsoSections":[{"anchor":"Advanced","title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true}],"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"MapLibre"}],"role":"article","title":"Plugin API"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"primaryContentSections":[{"content":[{"type":"aside","style":"warning","content":[{"inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}],"type":"paragraph"}],"name":"Warning"},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"type":"text","text":". Layers of plugin types appear as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"MLNStyle.layers"},{"type":"text","text":". The API is defined in "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"type":"codeVoice","code":"plugin_api.h"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Add MapLibre with the plugin API","anchor":"Add-MapLibre-with-the-plugin-API"},{"type":"paragraph","inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"type":"codeVoice","code":"import MapLibre"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}]},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Product"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use it in"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Contents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}]}],[{"inlineContent":[{"text":"Plugin packages","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Write-a-plugin","text":"Write a plugin"},{"type":"paragraph","inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"type":"codeVoice","code":"MapLibrePluginApi"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"syntax":"c","type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}]},{"level":2,"type":"heading","anchor":"Register-a-plugin","text":"Register a plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The application passes "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}]},{"code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing","syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"type":"codeVoice","code":"ngon"},{"type":"text","text":" layer type with "},{"type":"codeVoice","code":"mln_ngon_layer_register"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"title":"maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"title":"MapLibre","kind":"symbol","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link","title":"n-gon layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"role":"symbol","type":"topic","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" objects."}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","kind":"symbol","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"title":"MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"role":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","title":"Rendering Statistics HUD","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","abstract":[{"text":"Show rendering statistics on the map","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"role":"symbol","type":"topic","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","kind":"symbol","fragments":[{"text":"MLNStyle","kind":"identifier"}],"title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"role":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","title":"Custom Style Layers (Metal API)","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","abstract":[{"text":"Creating a Custom Style Layer with Metal","type":"text"}]}}}