"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"text":" object consists of one or more ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"type":"topic","kind":"symbol","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}]}}}