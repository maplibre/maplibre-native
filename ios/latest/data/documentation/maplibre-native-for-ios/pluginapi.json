{"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"abstract":[{"text":"Extend MapLibre iOS with native code.","type":"text"}],"seeAlsoSections":[{"title":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"generated":true,"anchor":"Advanced"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Plugin API","modules":[{"name":"MapLibre"}]},"sections":[],"primaryContentSections":[{"content":[{"type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}]}],"style":"warning"},{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"text":". Layers of plugin types appear as ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"text":" in ","type":"text"},{"type":"codeVoice","code":"MLNStyle.layers"},{"text":". The API is defined in ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A plugin describes a layer type with the structures of "},{"type":"codeVoice","code":"plugin_api.h"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}]}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}]}]}]},{"text":"Add MapLibre with the plugin API","type":"heading","level":2,"anchor":"Add-MapLibre-with-the-plugin-API"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"type":"codeVoice","code":"import MapLibre"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Product"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use it in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Contents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Plugin packages"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"text":".","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Write-a-plugin","text":"Write a plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"type":"codeVoice","code":"MapLibrePluginApi"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"]},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"syntax":"c","type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"type":"codeVoice","code":"descriptor"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"type":"text","text":" of the plugin. Set "},{"type":"codeVoice","code":"struct_size"},{"type":"text","text":" of every structure to the size of its type, as "},{"type":"codeVoice","code":"plugin_api.h"},{"type":"text","text":" describes."}]},{"anchor":"Register-a-plugin","text":"Register a plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The application passes ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}]},{"syntax":"objc","type":"codeListing","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"]},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"type":"text","text":" layer type with "},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"kind":"article","role":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","title":"Custom Style Layers (Metal API)","type":"topic","abstract":[{"text":"Creating a Custom Style Layer with Metal","type":"text"}]},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","title":"n-gon layer","type":"link","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","type":"topic","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"kind":"symbol","title":"MapLibre"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"url":"\/documentation\/maplibre\/mlnstyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"fragments":[{"text":"MLNStyle","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","title":"MLNStyle","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"text":" is an abstract base class for style layers. A style layer","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"text":" ","type":"text"},{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference","isActive":true},{"type":"text","text":" objects."}],"fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"role":"symbol","title":"MLNStyleLayer","kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnstylelayer"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link","titleInlineContent":[{"text":"maplibre-ios-with-plugin-api","type":"text"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","title":"Rendering Statistics HUD","role":"article"}}}