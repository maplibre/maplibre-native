{"sections":[],"metadata":{"roleHeading":"Article","title":"Plugin API","role":"article","modules":[{"name":"MapLibre"}]},"seeAlsoSections":[{"generated":true,"title":"Advanced","anchor":"Advanced","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"primaryContentSections":[{"content":[{"type":"aside","style":"warning","name":"Warning","content":[{"inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"text":". Layers of plugin types appear as ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","type":"reference","isActive":true},{"text":" in ","type":"text"},{"code":"MLNStyle.layers","type":"codeVoice"},{"text":". The API is defined in ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"reference","isActive":true},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"type":"codeVoice","code":"\"type\""},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Add MapLibre with the plugin API","level":2,"anchor":"Add-MapLibre-with-the-plugin-API"},{"type":"paragraph","inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"code":"import MapLibre","type":"codeVoice"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The package has two products:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Product","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use it in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Contents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibre"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"text":" with the plugin API enabled.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"MapLibrePluginApi"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Plugin packages","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"type":"codeVoice","code":"<mln\/plugin\/plugin_api.h>"},{"text":".","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Write a plugin","anchor":"Write-a-plugin","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"type":"codeVoice","code":"MapLibrePluginApi"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"type":"codeListing","syntax":"c","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"]},{"type":"paragraph","inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"code":"struct_size","type":"codeVoice"},{"text":" of every structure to the size of its type, as ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":" describes.","type":"text"}]},{"type":"heading","text":"Register a plugin","level":2,"anchor":"Register-a-plugin"},{"inlineContent":[{"type":"text","text":"The application passes "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}],"type":"paragraph"},{"syntax":"objc","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"type":"text","text":". Plugins cannot be unregistered."}],"type":"paragraph"},{"text":"Example","anchor":"Example","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"type":"codeVoice","code":"ngon"},{"text":" layer type with ","type":"text"},{"type":"codeVoice","code":"mln_ngon_layer_register"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","kind":"article","type":"topic","title":"Custom Style Layers (Metal API)","abstract":[{"text":"Creating a Custom Style Layer with Metal","type":"text"}],"url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"type":"text","text":"n-gon layer"}],"type":"link","title":"n-gon layer","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","kind":"symbol","title":"MLNStyleLayer","type":"topic","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object consists of one or more "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" objects."}],"fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnstylelayer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"type":"topic","fragments":[{"text":"MLNStyle","kind":"identifier"}],"url":"\/documentation\/maplibre\/mlnstyle","title":"MLNStyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","role":"symbol"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"type":"link","title":"plugin_api.h","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"role":"article","title":"Rendering Statistics HUD","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","url":"\/documentation\/maplibre","title":"MapLibre","role":"collection","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"type":"link","title":"maplibre-ios-with-plugin-api","url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"}}}