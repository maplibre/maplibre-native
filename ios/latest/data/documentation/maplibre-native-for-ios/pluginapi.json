{"sections":[],"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"seeAlsoSections":[{"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"anchor":"Advanced","generated":true,"title":"Advanced"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"metadata":{"modules":[{"name":"MapLibre"}],"title":"Plugin API","role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"content","content":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}]}],"name":"Warning","type":"aside","style":"warning"},{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example "},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"type":"text","text":". Layers of plugin types appear as "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" in "},{"type":"codeVoice","code":"MLNStyle.layers"},{"type":"text","text":". The API is defined in "},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true,"type":"reference"},{"type":"text","text":", which documents the ownership and threading rules that plugins must follow."}]},{"type":"paragraph","inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"type":"codeVoice","code":"\"type\""},{"type":"text","text":" in a style."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Add MapLibre with the plugin API","type":"heading","anchor":"Add-MapLibre-with-the-plugin-API","level":2},{"type":"paragraph","inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api"},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"code":"import MapLibre","type":"codeVoice"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The package has two products:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Product","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it in","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"text":"Applications","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre.xcframework"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The C plugin API, included as ","type":"text"},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"type":"text","text":"."}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"text":".","type":"text"}]},{"level":2,"anchor":"Write-a-plugin","type":"heading","text":"Write a plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"code":"MapLibrePluginApi","type":"codeVoice"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"syntax":"c"},{"inlineContent":[{"type":"text","text":"Here "},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"text":" of every structure to the size of its type, as ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Register-a-plugin","type":"heading","text":"Register a plugin"},{"inlineContent":[{"type":"text","text":"The application passes "},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}],"type":"paragraph"},{"code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"type":"codeListing","syntax":"objc"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"type":"text","text":". Plugins cannot be unregistered."}]},{"type":"heading","text":"Example","anchor":"Example","level":2},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference"},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"kind":"symbol","url":"\/documentation\/maplibre\/mlnstylelayer","type":"topic","role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"title":"MLNStyleLayer","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true,"type":"reference"},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" object consists of one or more ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","type":"reference"},{"text":" objects.","type":"text"}]},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"type":"link","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"title":"Rendering Statistics HUD","abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"type":"topic","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"type":"topic","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","title":"Custom Style Layers (Metal API)","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"title":"n-gon layer","type":"link","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"kind":"symbol","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"role":"symbol","title":"MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","fragments":[{"kind":"identifier","text":"MLNStyle"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"title":"plugin_api.h","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link","titleInlineContent":[{"code":"plugin_api.h","type":"codeVoice"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"role":"collection","title":"MapLibre","url":"\/documentation\/maplibre","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"}}}