{"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"anchor":"Advanced","title":"Advanced"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"primaryContentSections":[{"content":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The plugin API is experimental and does not yet have stability guarantees.","type":"text"}]}],"name":"Warning","type":"aside","style":"warning"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"code":"\"type\": \"ngon\"","type":"codeVoice"},{"text":". Layers of plugin types appear as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"text":" in ","type":"text"},{"code":"MLNStyle.layers","type":"codeVoice"},{"text":". The API is defined in ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The name of the layer type, as used for ","type":"text"},{"code":"\"type\"","type":"codeVoice"},{"text":" in a style.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Add MapLibre with the plugin API","level":2,"anchor":"Add-MapLibre-with-the-plugin-API","type":"heading"},{"inlineContent":[{"text":"Only the build of MapLibre iOS distributed as the Swift package ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"reference","isActive":true},{"text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using ","type":"text"},{"code":"import MapLibre","type":"codeVoice"},{"text":". Use it instead of the standard package, not in addition to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The package has two products:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it in","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"MapLibre","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications"}]}],[{"type":"paragraph","inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Plugin packages","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"type":"text","text":"."}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, ","type":"text"},{"code":"MapLibre.static.plugins.xcframework.zip","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"anchor":"Write-a-plugin","text":"Write a plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plugin package depends only on "},{"code":"MapLibrePluginApi","type":"codeVoice"},{"type":"text","text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version."}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the plugin does not link MapLibre, it does not call "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:"}]},{"type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"syntax":"c"},{"inlineContent":[{"text":"Here ","type":"text"},{"type":"codeVoice","code":"descriptor"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"mln_plugin_descriptor_v1"},{"text":" of the plugin. Set ","type":"text"},{"type":"codeVoice","code":"struct_size"},{"text":" of every structure to the size of its type, as ","type":"text"},{"type":"codeVoice","code":"plugin_api.h"},{"text":" describes.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Register-a-plugin","level":2,"text":"Register a plugin"},{"inlineContent":[{"type":"text","text":"The application passes "},{"type":"codeVoice","code":"mln_plugin_register_v1"},{"type":"text","text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:"}],"type":"paragraph"},{"type":"codeListing","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"Registration is process-wide and thread-safe. Registering the same plugin again returns ","type":"text"},{"type":"codeVoice","code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","isActive":true},{"type":"text","text":" in the repository is an example plugin. It draws regular polygons at point features and registers the "},{"type":"codeVoice","code":"ngon"},{"type":"text","text":" layer type with "},{"type":"codeVoice","code":"mln_ngon_layer_register"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"role":"article","title":"Plugin API","modules":[{"name":"MapLibre"}],"roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"references":{"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","type":"link","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"title":"maplibre-ios-with-plugin-api"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud","title":"Rendering Statistics HUD","role":"article","kind":"article","type":"topic","abstract":[{"type":"text","text":"Show rendering statistics on the map"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"link","title":"n-gon layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"role":"symbol","fragments":[{"kind":"identifier","text":"MLNStyleLayer"}],"kind":"symbol","title":"MLNStyleLayer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object consists of one or more "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" objects."}],"type":"topic"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","type":"link","title":"plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"kind":"article","title":"Custom Style Layers (Metal API)","role":"article","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"url":"\/documentation\/maplibre","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"kind":"symbol","title":"MapLibre","role":"collection","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"title":"MLNStyle","role":"symbol","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","url":"\/documentation\/maplibre\/mlnstyle","fragments":[{"text":"MLNStyle","kind":"identifier"}]}}}