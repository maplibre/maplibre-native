{"abstract":[{"type":"text","text":"Extend MapLibre iOS with native code."}],"seeAlsoSections":[{"title":"Advanced","generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud"],"anchor":"Advanced"}],"primaryContentSections":[{"content":[{"style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin API is experimental and does not yet have stability guarantees."}]}],"name":"Warning","type":"aside"},{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"MapLibre Native has a C plugin API for extending it with native code. Currently, plugins can add style layer types. After a plugin registers its layer types, styles can use them like the built-in layer types, for example ","type":"text"},{"type":"codeVoice","code":"\"type\": \"ngon\""},{"text":". Layers of plugin types appear as ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"MLNStyle.layers"},{"text":". The API is defined in ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","isActive":true,"type":"reference"},{"text":", which documents the ownership and threading rules that plugins must follow.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin describes a layer type with the structures of ","type":"text"},{"code":"plugin_api.h","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The name of the layer type, as used for "},{"code":"\"type\"","type":"codeVoice"},{"type":"text","text":" in a style."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The paint properties of the layer, with their type, default value and the kinds of expressions they accept."}]}]},{"content":[{"inlineContent":[{"text":"The shaders of the layer. On iOS, which renders with Metal, a plugin provides the complete Metal Shading Language source with its entry points.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Callbacks that turn the features of a tile into vertex data, update the uniforms of the shaders and answer queries for rendered features.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Add-MapLibre-with-the-plugin-API","level":2,"text":"Add MapLibre with the plugin API","type":"heading"},{"inlineContent":[{"type":"text","text":"Only the build of MapLibre iOS distributed as the Swift package "},{"type":"reference","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","isActive":true},{"type":"text","text":" exports the plugin API. Apart from that, it is the same as the standard build, and applications keep using "},{"type":"codeVoice","code":"import MapLibre"},{"type":"text","text":". Use it instead of the standard package, not in addition to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The package has two products:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Product","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it in"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MapLibre"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications"}]}],[{"type":"paragraph","inlineContent":[{"code":"MapLibre.xcframework","type":"codeVoice"},{"type":"text","text":" with the plugin API enabled."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"MapLibrePluginApi","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Plugin packages","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The C plugin API, included as "},{"code":"<mln\/plugin\/plugin_api.h>","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GitHub release of each MapLibre iOS version also includes a static XCFramework of this build, "},{"type":"codeVoice","code":"MapLibre.static.plugins.xcframework.zip"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Write-a-plugin","level":2,"text":"Write a plugin"},{"type":"paragraph","inlineContent":[{"text":"A plugin package depends only on ","type":"text"},{"code":"MapLibrePluginApi","type":"codeVoice"},{"text":", so the application decides which MapLibre framework it links. Both products come from the same package, so Swift Package Manager resolves the header and the framework to the same version.","type":"text"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api\", exact: \"<version>\"),","],","targets: [","    \/\/ Application","    .target(name: \"App\", dependencies: [.product(name: \"MapLibre\", package: \"maplibre-ios-with-plugin-api\")]),","    \/\/ Plugin","    .target(name: \"MyLayer\", dependencies: [.product(name: \"MapLibrePluginApi\", package: \"maplibre-ios-with-plugin-api\")]),","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Because the plugin does not link MapLibre, it does not call ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" itself. Instead it exposes a function that receives the registration function and passes its descriptor to it:","type":"text"}]},{"type":"codeListing","code":["#include <mln\/plugin\/plugin_api.h>","","mln_plugin_status my_layer_register(mln_plugin_register_function_v1 register_plugin,","                                    char *error_message,","                                    size_t error_message_capacity) {","    if (!register_plugin) return MLN_PLUGIN_STATUS_NOT_FOUND;","    return register_plugin(&descriptor, error_message, error_message_capacity);","}"],"syntax":"c"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here "},{"code":"descriptor","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"mln_plugin_descriptor_v1","type":"codeVoice"},{"type":"text","text":" of the plugin. Set "},{"code":"struct_size","type":"codeVoice"},{"type":"text","text":" of every structure to the size of its type, as "},{"code":"plugin_api.h","type":"codeVoice"},{"type":"text","text":" describes."}]},{"type":"heading","anchor":"Register-a-plugin","level":2,"text":"Register a plugin"},{"type":"paragraph","inlineContent":[{"text":"The application passes ","type":"text"},{"code":"mln_plugin_register_v1","type":"codeVoice"},{"text":" to the plugin. Register all plugins before creating a map that loads a style using their layer types:","type":"text"}]},{"type":"codeListing","code":["#import <MapLibre\/MapLibre.h>","#include \"my_layer.hpp\" \/\/ includes <mln\/plugin\/plugin_api.h>","","char error[512] = {};","mln_plugin_status status = my_layer_register(&mln_plugin_register_v1, error, sizeof(error));","if (status != MLN_PLUGIN_STATUS_OK && status != MLN_PLUGIN_STATUS_ALREADY_REGISTERED) {","    NSLog(@\"Failed to register plugin: %s\", error);","}"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registration is process-wide and thread-safe. Registering the same plugin again returns "},{"code":"MLN_PLUGIN_STATUS_ALREADY_REGISTERED","type":"codeVoice"},{"text":". Plugins cannot be unregistered.","type":"text"}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","type":"reference","isActive":true},{"text":" in the repository is an example plugin. It draws regular polygons at point features and registers the ","type":"text"},{"code":"ngon","type":"codeVoice"},{"text":" layer type with ","type":"text"},{"code":"mln_ngon_layer_register","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/pluginapi"]}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"metadata":{"modules":[{"name":"MapLibre"}],"title":"Plugin API","roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PluginAPI"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/CustomStyleLayerExample":{"kind":"article","url":"\/documentation\/maplibre-native-for-ios\/customstylelayerexample","type":"topic","abstract":[{"type":"text","text":"Creating a Custom Style Layer with Metal"}],"title":"Custom Style Layers (Metal API)","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/CustomStyleLayerExample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyleLayer":{"role":"symbol","title":"MLNStyleLayer","url":"\/documentation\/maplibre\/mlnstylelayer","kind":"symbol","fragments":[{"text":"MLNStyleLayer","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyleLayer"},{"type":"text","text":" is an abstract base class for style layers. A style layer"},{"type":"text","text":" "},{"type":"text","text":"manages the layout and appearance of content at a specific z-index in a style."},{"type":"text","text":" "},{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" object consists of one or more "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle"},{"type":"text","text":" objects."}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNStyle":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","fragments":[{"text":"MLNStyle","kind":"identifier"}],"title":"MLNStyle","abstract":[{"text":"The proxy object for the current map style.","type":"text"}],"url":"\/documentation\/maplibre\/mlnstyle","role":"symbol","kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre":{"kind":"symbol","url":"\/documentation\/maplibre","type":"topic","abstract":[{"text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling.","type":"text"}],"title":"MapLibre","role":"collection","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre"},"https://github.com/maplibre/maplibre-ios-with-plugin-api":{"url":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","identifier":"https:\/\/github.com\/maplibre\/maplibre-ios-with-plugin-api","title":"maplibre-ios-with-plugin-api","titleInlineContent":[{"type":"text","text":"maplibre-ios-with-plugin-api"}],"type":"link"},"https://github.com/maplibre/maplibre-native/blob/main/include/mln/plugin/plugin_api.h":{"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","titleInlineContent":[{"type":"codeVoice","code":"plugin_api.h"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/blob\/main\/include\/mln\/plugin\/plugin_api.h","title":"plugin_api.h"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/RenderingStatisticsHud":{"role":"article","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/RenderingStatisticsHud","abstract":[{"text":"Show rendering statistics on the map","type":"text"}],"title":"Rendering Statistics HUD","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/renderingstatisticshud"},"https://github.com/maplibre/maplibre-native/tree/main/plugins/ngon-layer":{"type":"link","url":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","titleInlineContent":[{"text":"n-gon layer","type":"text"}],"identifier":"https:\/\/github.com\/maplibre\/maplibre-native\/tree\/main\/plugins\/ngon-layer","title":"n-gon layer"}}}