":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"type":"text","text":" is a style layer that renders one or more stroked"},{"text":" ","type":"text"},{"text":"polylines on the map.","type":"text"}],"fragments":[{"kind":"identifier","text":"MLNLineStyleLayer"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"type":"topic","role":"article","abstract":[{"type":"text","text":"Adding an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"type":"text","text":" to the map using a GeoJSON file."}],"url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","title":"Using GeoJSON with a line style layer"},"https://demotiles.maplibre.org":{"titleInlineContent":[{"type":"text","text":"MapLibre demo tiles"}],"title":"MapLibre demo tiles","identifier":"https:\/\/demotiles.maplibre.org","type":"link","url":"https:\/\/demotiles.maplibre.org"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/removeFeatureStateForSourceLayerID:featureID:":{"fragments":[{"text":"- ","kind":"text"},{"text":"removeFeatureStateForSourceLayerID:featureID:","kind":"identifier"}],"title":"removeFeatureStateForSourceLayerID:featureID:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Removes all state from a single feature in this source."}],"kind":"symbol","url":"\/documentation\/maplibre\/mlnvectortilesource\/removefeaturestateforsourcelayerid:featureid:"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource":{"url":"\/documentation\/maplibre\/ml