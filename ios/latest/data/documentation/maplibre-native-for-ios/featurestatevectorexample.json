yle","isActive":true},{"type":"text","text":" object. The vector style"},{"type":"text","text":" "},{"type":"text","text":"layer defines the appearance of any content supplied by the shape source. You"},{"type":"text","text":" "},{"type":"text","text":"can update a shape source by setting its "},{"type":"codeVoice","code":"shape"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" property."}],"type":"topic","fragments":[{"text":"MLNShapeSource","kind":"identifier"}]},"https://demotiles.maplibre.org":{"type":"link","url":"https:\/\/demotiles.maplibre.org","title":"MapLibre demo tiles","identifier":"https:\/\/demotiles.maplibre.org","titleInlineContent":[{"text":"MapLibre demo tiles","type":"text"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","url":"\/documentation\/maplibre-native-for-ios\/webapidataexample","title":"Showing data from an API","role":"article","kind":"article","abstract":[{"type":"text","text":"Showing data from an API with custom styling and interaction"}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/removeFeatureStateForSourceLayerID:featureID:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","fragments":[{"text":"- ","kind":"text"},{"text":"removeFeatureStateForSourceLayerID:featureID:","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Removes all state from a single feature in this source."}],"url":"\/documentation\/maplibre\/mlnvectortilesource\/removefeaturestateforsourcelayerid:featureid:","title":"removeFeatureStateForSourceLayerID:featureID:","kind":"symbol","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/ML