{"sections":[],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","type":"reference","isActive":true},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/featurestatevectorexample"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample","interfaceLanguage":"occ"},"seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"],"generated":true}],"kind":"article","metadata":{"role":"article","modules":[{"name":"MapLibre"}],"roleHeading":"Article","title":"Set Feature State (Vector Source)"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","isActive":true},{"type":"text","text":" allows you to assign user-defined key-value pairs to features at runtime for styling purposes. It works the same way for GeoJSON and vector tile sources — see "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","isActive":true},{"type":"text","text":" for the GeoJSON version — but a vector source differs in two important ways:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A source layer is required."}]},{"type":"text","text":" Vector tiles are organized into named source layers, so every feature-state call takes a "},{"type":"codeVoice","code":"sourceLayerID"},{"type":"text","text":". A "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" has a single implicit layer and therefore omits it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Features must have an "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."}]},{"type":"text","text":" Feature state is keyed by feature identifier, so the target features must carry an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" in the underlying vector tile data. The "},{"type":"reference","identifier":"https:\/\/demotiles.maplibre.org","isActive":true},{"type":"text","text":" used here assign one per country, so selection binds correctly. Note that MapLibre Native does not support promoting a feature property to an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" at runtime, so the tileset itself must provide identifiers."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Example-Implementation","type":"heading","level":2,"text":"Example Implementation"},{"anchor":"Setting-Up-the-Map-View","type":"heading","level":3,"text":"Setting Up the Map View"},{"syntax":"swift","code":["import MapLibre","import SwiftUI","import UIKit","","class FeatureStateVectorExampleUIKit: UIViewController, MLNMapViewDelegate {","    private var mapView: MLNMapView!","    private var countriesSource: MLNVectorTileSource!","","    \/\/ The source layer that holds the country polygons in the demo tiles.","    private let countriesSourceLayer = \"countries\"","","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ The MapLibre demo tiles are a world map of country polygons.","        let mapView = MLNMapView(frame: view.bounds, styleURL: DEMOTILES_STYLE)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","","        mapView.setCenter(CLLocationCoordinate2D(latitude: 20, longitude: 0), zoomLevel: 1, animated: false)","        view.addSubview(mapView)","","        self.mapView = mapView","    }"],"type":"codeListing"},{"anchor":"Adding-the-Vector-Source-and-Style-Layers","type":"heading","level":3,"text":"Adding the Vector Source and Style Layers"},{"syntax":"swift","code":["func mapView(_ mapView: MLNMapView, didFinishLoading style: MLNStyle) {","        \/\/ Add the demo tiles as a vector source, described by its TileJSON.","        let countriesSource = MLNVectorTileSource(","            identifier: \"countries-source\",","            configurationURL: URL(string: \"https:\/\/demotiles.maplibre.org\/tiles\/tiles.json\")!","        )","        style.addSource(countriesSource)","        self.countriesSource = countriesSource","","        \/\/ Fill layer: transparent by default so the basemap shows through, and","        \/\/ highlighted only where the \"selected\" feature state is set.","        let fillsLayer = MLNFillStyleLayer(identifier: \"country-fills\", source: countriesSource)","        \/\/ A vector style layer must be told which source layer to draw.","        fillsLayer.sourceLayerIdentifier = countriesSourceLayer","        fillsLayer.fillColor = NSExpression(forConstantValue: UIColor.red)","        fillsLayer.fillOpacity = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            0.5, \/\/ Selected","            0.0, \/\/ Default (transparent)","        ])","        style.addLayer(fillsLayer)","","        \/\/ Border layer: a thin border everywhere, thicker and red where selected.","        let bordersLayer = MLNLineStyleLayer(identifier: \"country-borders\", source: countriesSource)","        bordersLayer.sourceLayerIdentifier = countriesSourceLayer","        bordersLayer.lineColor = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red,","            UIColor.gray,","        ])","        bordersLayer.lineWidth = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            2.0,","            0.5,","        ])","        style.addLayer(bordersLayer)","","        \/\/ Add tap gesture recognizer to handle feature selection","        let tapGesture = UITapGestureRecognizer(target: self, action: #selector(handleMapTap(_:)))","        mapView.addGestureRecognizer(tapGesture)","    }"],"type":"codeListing"},{"anchor":"Handling-Selection","type":"heading","level":3,"text":"Handling Selection"},{"syntax":"swift","code":["@objc private func handleMapTap(_ gesture: UITapGestureRecognizer) {","        let location = gesture.location(in: mapView)","        let features = mapView.visibleFeatures(at: location, styleLayerIdentifiers: [\"country-fills\"])","","        guard let feature = features.first, let featureID = feature.identifier.map({ \"\\($0)\" }) else {","            return","        }","","        \/\/ Toggle the selection state of the tapped country. Selection is not","        \/\/ exclusive: any number of countries can be selected at the same time.","        \/\/","        \/\/ Note the sourceLayerID argument, which is required for a vector source.","        let isSelected = countriesSource.featureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID","        )?[\"selected\"] as? Bool ?? false","        countriesSource.setFeatureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID,","            state: [\"selected\": !isSelected]","        )","","        let countryName = feature.attributes[\"NAME\"] as? String ?? \"Unknown\"","        let alert = UIAlertController(","            title: \"Country Selected\",","            message: \"\\(countryName) is now \\(!isSelected ? \"selected\" : \"deselected\")\",","            preferredStyle: .alert","        )","        alert.addAction(UIAlertAction(title: \"OK\", style: .default))","        present(alert, animated: true)","    }"],"type":"codeListing"},{"anchor":"Key-Differences-from-a-GeoJSON-Source","type":"heading","level":2,"text":"Key Differences from a GeoJSON Source"},{"anchor":"Setting-Feature-State","type":"heading","level":3,"text":"Setting Feature State"},{"syntax":"swift","code":["\/\/ GeoJSON shape source — no source layer","shapeSource.setFeatureState(featureID: \"54\", state: [\"selected\": true])","","\/\/ Vector tile source — source layer required","vectorSource.setFeatureState(sourceLayerID: \"countries\", featureID: \"54\", state: [\"selected\": true])"],"type":"codeListing"},{"anchor":"Reading-and-Removing-Feature-State","type":"heading","level":3,"text":"Reading and Removing Feature State"},{"syntax":"swift","code":["\/\/ Read","let state = vectorSource.featureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove a single key","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\", stateKey: \"selected\")","","\/\/ Remove all state from a feature","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove all feature state from the source layer","vectorSource.resetFeatureStates(sourceLayerID: \"countries\")"],"type":"codeListing"},{"anchor":"API-Reference","type":"heading","level":2,"text":"API Reference"},{"anchor":"MLNVectorTileSource-Feature-State-Methods","type":"heading","level":3,"text":"MLNVectorTileSource Feature State Methods"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:","isActive":true},{"type":"text","text":" - Merge state into a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featureStateForSourceLayerID:featureID:","isActive":true},{"type":"text","text":" - Get the current state of a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","isActive":true},{"type":"text","text":" - Remove a state key from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Related-Examples","type":"heading","level":2,"text":"Related Examples"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","isActive":true},{"type":"text","text":" - The same interaction backed by a GeoJSON source"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"https://demotiles.maplibre.org":{"identifier":"https:\/\/demotiles.maplibre.org","titleInlineContent":[{"type":"text","text":"MapLibre demo tiles"}],"title":"MapLibre demo tiles","type":"link","url":"https:\/\/demotiles.maplibre.org"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GeoJSON":{"type":"topic","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","role":"article","url":"\/documentation\/maplibre-native-for-ios\/geojson","abstract":[],"title":"Working with GeoJSON Data"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"type":"topic","kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","role":"article","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","abstract":[{"type":"text","text":"Adding an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"type":"text","text":" to the map using a GeoJSON file."}],"title":"Using GeoJSON with a line style layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"type":"topic","title":"MLNVectorTileSource","kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":" is a map content source that supplies tiled vector data"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"text","text":"Mapbox Vector Tile"},{"type":"text","text":" format"},{"type":"text","text":" "},{"type":"text","text":"to be shown on the map. The location of and metadata about the tiles are"},{"type":"text","text":" "},{"type":"text","text":"defined either by an option dictionary or by an external file that conforms to"},{"type":"text","text":" "},{"type":"text","text":"the"},{"type":"text","text":" "},{"type":"text","text":"TileJSON specification"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A vector tile source is added to an "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNStyle","isActive":true},{"type":"text","text":" object along with one or more"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorStyleLayer","isActive":true},{"type":"text","text":" objects. A vector style layer defines the appearance of"},{"type":"text","text":" "},{"type":"text","text":"any content supplied by the vector tile source."}],"fragments":[{"kind":"identifier","text":"MLNVectorTileSource"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","url":"\/documentation\/maplibre\/mlnvectortilesource","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShape":{"type":"topic","title":"MLNShape","kind":"symbol","abstract":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","isActive":true},{"type":"text","text":" is an abstract class that represents a shape or annotation. Shapes"},{"type":"text","text":" "},{"type":"text","text":"constitute the content of a map — not only the overlays atop the map, but also"},{"type":"text","text":" "},{"type":"text","text":"the content that forms the base map."}],"fragments":[{"kind":"identifier","text":"MLNShape"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","url":"\/documentation\/maplibre\/mlnshape","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"role":"article","abstract":[{"type":"text","text":"Use an "},{"type":"codeVoice","code":