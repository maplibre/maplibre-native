MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","role":"article","url":"\/documentation\/maplibre-native-for-ios\/animatedlineexample"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"abstract":[{"type":"text","text":"Adding an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer"},{"type":"text","text":" to the map using a GeoJSON file."}],"kind":"article","type":"topic","title":"Using GeoJSON with a line style layer","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","role":"article","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample"},"https://maplibre.org/maplibre-style-spec/expressions/#feature-state":{"type":"link","titleInlineContent":[{"type":"text","text":"Feature state"}],"title":"Feature state","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","url":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state"},"https://demotiles.maplibre.org":{"type":"link","titleInlineContent":[{"type":"text","text":"MapLibre demo tiles"}],"title":"MapLibre demo tiles","identifier":"https:\/\/demotiles.maplibre.org","url":"https:\/\/demotiles.maplibre.org"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShape":{"fragments":[{"text":"MLNShape","kind":"identifier"}],"role":"symbol","abstract":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","type":"reference","isActive":true},{"text":" is an abstract class that represents a shape or annotation. Shapes","type":"text"},{"text":" ","type":"text"},{"text":"constitute the content of a map — not only the overlays atop the map, but also","type":"text"},{"text":" ","type":"text"},{"text":"the content that forms the base map.","type":"text"}],"type":"topic","title":"MLNShape","identifier":"doc:\/\/org.swift.MyProject\/documentation\/Ma