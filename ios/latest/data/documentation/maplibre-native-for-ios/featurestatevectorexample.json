/MapLibre-Native-for-iOS\/LineStyleLayerExample","abstract":[{"text":"Adding an ","type":"text"},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","isActive":true},{"text":" to the map using a GeoJSON file.","type":"text"}],"role":"article","title":"Using GeoJSON with a line style layer","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"kind":"article","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","title":"Showing data from an API","role":"article","abstract":[{"type":"text","text":"Showing data from an API with custom styling and interaction"}],"url":"\/documentation\/maplibre-native-for-ios\/webapidataexample"},"https://demotiles.maplibre.org":{"type":"link","url":"https:\/\/demotiles.maplibre.org","title":"MapLibre demo tiles","titleInlineContent":[{"type":"text","text":"MapLibre demo tiles"}],"identifier":"https:\/\/demotiles.maplibre.org"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/setFeatureStateForSourceLayerID:featureID:state:":{"type":"topic","url":"\/documentation\/maplibre\/mlnvectortilesource\/setfeaturestateforsourcelayerid:featureid:state:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:","abstract":[{"type":"text","text":"Sets the state of a feature in this source."}],"role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"setFeatureStateForSourceLayerID:featureID:state:","kind":"identifier"}],"title":"setFeatureStateForSourceLayerID:featureID:state:","kind":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre":{"type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Powerful, free and open-source mapping toolkit with full control over data sources and styling."}],"title":"MapLibre","url":"\/documentation\/mapli