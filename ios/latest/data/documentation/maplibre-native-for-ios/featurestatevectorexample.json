{"kind":"article","sections":[],"abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","isActive":true,"type":"reference"},{"type":"text","text":" allows you to assign user-defined key-value pairs to features at runtime for styling purposes. It works the same way for GeoJSON and vector tile sources — see "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","isActive":true,"type":"reference"},{"type":"text","text":" for the GeoJSON version — but a vector source differs in two important ways:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"A source layer is required.","type":"text"}]},{"type":"text","text":" Vector tiles are organized into named source layers, so every feature-state call takes a "},{"type":"codeVoice","code":"sourceLayerID"},{"type":"text","text":". A "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" has a single implicit layer and therefore omits it."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Features must have an "},{"code":"id","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"text","text":" Feature state is keyed by feature identifier, so the target features must carry an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" in the underlying vector tile data. The "},{"type":"reference","identifier":"https:\/\/demotiles.maplibre.org","isActive":true},{"type":"text","text":" used here assign one per country, so selection binds correctly. Note that MapLibre Native does not support promoting a feature property to an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" at runtime, so the tileset itself must provide identifiers."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Example-Implementation","text":"Example Implementation","level":2},{"type":"heading","anchor":"Setting-Up-the-Map-View","text":"Setting Up the Map View","level":3},{"type":"codeListing","code":["import MapLibre","import SwiftUI","import UIKit","","class FeatureStateVectorExampleUIKit: UIViewController, MLNMapViewDelegate {","    private var mapView: MLNMapView!","    private var countriesSource: MLNVectorTileSource!","","    \/\/ The source layer that holds the country polygons in the demo tiles.","    private let countriesSourceLayer = \"countries\"","","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ The MapLibre demo tiles are a world map of country polygons.","        let mapView = MLNMapView(frame: view.bounds, styleURL: DEMOTILES_STYLE)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","","        mapView.setCenter(CLLocationCoordinate2D(latitude: 20, longitude: 0), zoomLevel: 1, animated: false)","        view.addSubview(mapView)","","        self.mapView = mapView","    }"],"syntax":"swift"},{"type":"heading","anchor":"Adding-the-Vector-Source-and-Style-Layers","text":"Adding the Vector Source and Style Layers","level":3},{"type":"codeListing","code":["func mapView(_ mapView: MLNMapView, didFinishLoading style: MLNStyle) {","        \/\/ Add the demo tiles as a vector source, described by its TileJSON.","        let countriesSource = MLNVectorTileSource(","            identifier: \"countries-source\",","            configurationURL: URL(string: \"https:\/\/demotiles.maplibre.org\/tiles\/tiles.json\")!","        )","        style.addSource(countriesSource)","        self.countriesSource = countriesSource","","        \/\/ Fill layer: transparent by default so the basemap shows through, and","        \/\/ highlighted only where the \"selected\" feature state is set.","        let fillsLayer = MLNFillStyleLayer(identifier: \"country-fills\", source: countriesSource)","        \/\/ A vector style layer must be told which source layer to draw.","        fillsLayer.sourceLayerIdentifier = countriesSourceLayer","        fillsLayer.fillColor = NSExpression(forConstantValue: UIColor.red)","        fillsLayer.fillOpacity = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            0.5, \/\/ Selected","            0.0, \/\/ Default (transparent)","        ])","        style.addLayer(fillsLayer)","","        \/\/ Border layer: a thin border everywhere, thicker and red where selected.","        let bordersLayer = MLNLineStyleLayer(identifier: \"country-borders\", source: countriesSource)","        bordersLayer.sourceLayerIdentifier = countriesSourceLayer","        bordersLayer.lineColor = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red,","            UIColor.gray,","        ])","        bordersLayer.lineWidth = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            2.0,","            0.5,","        ])","        style.addLayer(bordersLayer)","","        \/\/ Add tap gesture recognizer to handle feature selection","        let tapGesture = UITapGestureRecognizer(target: self, action: #selector(handleMapTap(_:)))","        mapView.addGestureRecognizer(tapGesture)","    }"],"syntax":"swift"},{"type":"heading","anchor":"Handling-Selection","text":"Handling Selection","level":3},{"type":"codeListing","code":["@objc private func handleMapTap(_ gesture: UITapGestureRecognizer) {","        let location = gesture.location(in: mapView)","        let features = mapView.visibleFeatures(at: location, styleLayerIdentifiers: [\"country-fills\"])","","        guard let feature = features.first, let featureID = feature.identifier.map({ \"\\($0)\" }) else {","            return","        }","","        \/\/ Toggle the selection state of the tapped country. Selection is not","        \/\/ exclusive: any number of countries can be selected at the same time.","        \/\/","        \/\/ Note the sourceLayerID argument, which is required for a vector source.","        let isSelected = countriesSource.featureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID","        )?[\"selected\"] as? Bool ?? false","        countriesSource.setFeatureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID,","            state: [\"selected\": !isSelected]","        )","","        let countryName = feature.attributes[\"NAME\"] as? String ?? \"Unknown\"","        let alert = UIAlertController(","            title: \"Country Selected\",","            message: \"\\(countryName) is now \\(!isSelected ? \"selected\" : \"deselected\")\",","            preferredStyle: .alert","        )","        alert.addAction(UIAlertAction(title: \"OK\", style: .default))","        present(alert, animated: true)","    }"],"syntax":"swift"},{"type":"heading","anchor":"Key-Differences-from-a-GeoJSON-Source","text":"Key Differences from a GeoJSON Source","level":2},{"type":"heading","anchor":"Setting-Feature-State","text":"Setting Feature State","level":3},{"type":"codeListing","code":["\/\/ GeoJSON shape source — no source layer","shapeSource.setFeatureState(featureID: \"54\", state: [\"selected\": true])","","\/\/ Vector tile source — source layer required","vectorSource.setFeatureState(sourceLayerID: \"countries\", featureID: \"54\", state: [\"selected\": true])"],"syntax":"swift"},{"type":"heading","anchor":"Reading-and-Removing-Feature-State","text":"Reading and Removing Feature State","level":3},{"type":"codeListing","code":["\/\/ Read","let state = vectorSource.featureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove a single key","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\", stateKey: \"selected\")","","\/\/ Remove all state from a feature","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove all feature state from the source layer","vectorSource.resetFeatureStates(sourceLayerID: \"countries\")"],"syntax":"swift"},{"type":"heading","anchor":"API-Reference","text":"API Reference","level":2},{"type":"heading","anchor":"MLNVectorTileSource-Feature-State-Methods","text":"MLNVectorTileSource Feature State Methods","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:"},{"type":"text","text":" - Merge state into a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Get the current state of a feature"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","type":"reference"},{"type":"text","text":" - Remove a state key from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Related-Examples","level":2,"text":"Related Examples"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","type":"reference"},{"text":" - The same interaction backed by a GeoJSON source","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"MapLibre"}],"title":"Set Feature State (Vector Source)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/featurestatevectorexample"],"traits":[{"interfaceLanguage":"occ"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"],"title":"Styling and Dynamic Data","anchor":"Styling-and-Dynamic-Data"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNShape":{"role":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape"},{"text":" is an abstract class that represents a shape or annotation. Shapes","type":"text"},{"text":" ","type":"text"},{"text":"constitute the content of a map — not only the overlays atop the map, but also","type":"text"},{"text":" ","type":"text"},{"text":"the content that forms the base map.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/maplibre\/mlnshape","fragments":[{"kind":"identifier","text":"MLNShape"}],"title":"MLNShape"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"title":"Using GeoJSON with a line style layer","role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","kind":"article","type":"topic","abstract":[{"text":"Adding an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference"},{"text":" to the map using a GeoJSON file.","type":"text"}],"url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/setFeatureStateForSourceLayerID:featureID:state:":{"title":"setFeatureStateForSourceLayerID:featureID:state:","role":"symbol","kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:","type":"topic","abstract":[{"text":"Sets the state of a feature in this source.","type":"text"}],"fragments":