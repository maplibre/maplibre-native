{"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Set Feature State (Vector Source)","modules":[{"name":"MapLibre"}]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestatevectorexample"]}],"sections":[],"abstract":[{"type":"text","text":"This example demonstrates feature state on a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":", toggling the appearance of countries in a vector tileset as they are tapped."}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"],"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state"},{"text":" allows you to assign user-defined key-value pairs to features at runtime for styling purposes. It works the same way for GeoJSON and vector tile sources — see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"},{"text":" for the GeoJSON version — but a vector source differs in two important ways:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A source layer is required."}],"type":"strong"},{"text":" Vector tiles are organized into named source layers, so every feature-state call takes a ","type":"text"},{"code":"sourceLayerID","type":"codeVoice"},{"text":". A ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true,"type":"reference"},{"text":" has a single implicit layer and therefore omits it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Features must have an "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."}],"type":"strong"},{"text":" Feature state is keyed by feature identifier, so the target features must carry an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" in the underlying vector tile data. The ","type":"text"},{"identifier":"https:\/\/demotiles.maplibre.org","isActive":true,"type":"reference"},{"text":" used here assign one per country, so selection binds correctly. Note that MapLibre Native does not support promoting a feature property to an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" at runtime, so the tileset itself must provide identifiers.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Example Implementation","anchor":"Example-Implementation"},{"type":"heading","level":3,"text":"Setting Up the Map View","anchor":"Setting-Up-the-Map-View"},{"type":"codeListing","syntax":"swift","code":["import MapLibre","import SwiftUI","import UIKit","","class FeatureStateVectorExampleUIKit: UIViewController, MLNMapViewDelegate {","    private var mapView: MLNMapView!","    private var countriesSource: MLNVectorTileSource!","","    \/\/ The source layer that holds the country polygons in the demo tiles.","    private let countriesSourceLayer = \"countries\"","","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ The MapLibre demo tiles are a world map of country polygons.","        let mapView = MLNMapView(frame: view.bounds, styleURL: DEMOTILES_STYLE)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","","        mapView.setCenter(CLLocationCoordinate2D(latitude: 20, longitude: 0), zoomLevel: 1, animated: false)","        view.addSubview(mapView)","","        self.mapView = mapView","    }"]},{"type":"heading","level":3,"text":"Adding the Vector Source and Style Layers","anchor":"Adding-the-Vector-Source-and-Style-Layers"},{"type":"codeListing","syntax":"swift","code":["func mapView(_ mapView: MLNMapView, didFinishLoading style: MLNStyle) {","        \/\/ Add the demo tiles as a vector source, described by its TileJSON.","        let countriesSource = MLNVectorTileSource(","            identifier: \"countries-source\",","            configurationURL: URL(string: \"https:\/\/demotiles.maplibre.org\/tiles\/tiles.json\")!","        )","        style.addSource(countriesSource)","        self.countriesSource = countriesSource","","        \/\/ Fill layer: transparent by default so the basemap shows through, and","        \/\/ highlighted only where the \"selected\" feature state is set.","        let fillsLayer = MLNFillStyleLayer(identifier: \"country-fills\", source: countriesSource)","        \/\/ A vector style layer must be told which source layer to draw.","        fillsLayer.sourceLayerIdentifier = countriesSourceLayer","        fillsLayer.fillColor = NSExpression(forConstantValue: UIColor.red)","        fillsLayer.fillOpacity = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            0.5, \/\/ Selected","            0.0, \/\/ Default (transparent)","        ])","        style.addLayer(fillsLayer)","","        \/\/ Border layer: a thin border everywhere, thicker and red where selected.","        let bordersLayer = MLNLineStyleLayer(identifier: \"country-borders\", source: countriesSource)","        bordersLayer.sourceLayerIdentifier = countriesSourceLayer","        bordersLayer.lineColor = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red,","            UIColor.gray,","        ])","        bordersLayer.lineWidth = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            2.0,","            0.5,","        ])","        style.addLayer(bordersLayer)","","        \/\/ Add tap gesture recognizer to handle feature selection","        let tapGesture = UITapGestureRecognizer(target: self, action: #selector(handleMapTap(_:)))","        mapView.addGestureRecognizer(tapGesture)","    }"]},{"type":"heading","level":3,"text":"Handling Selection","anchor":"Handling-Selection"},{"type":"codeListing","syntax":"swift","code":["@objc private func handleMapTap(_ gesture: UITapGestureRecognizer) {","        let location = gesture.location(in: mapView)","        let features = mapView.visibleFeatures(at: location, styleLayerIdentifiers: [\"country-fills\"])","","        guard let feature = features.first, let featureID = feature.identifier.map({ \"\\($0)\" }) else {","            return","        }","","        \/\/ Toggle the selection state of the tapped country. Selection is not","        \/\/ exclusive: any number of countries can be selected at the same time.","        \/\/","        \/\/ Note the sourceLayerID argument, which is required for a vector source.","        let isSelected = countriesSource.featureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID","        )?[\"selected\"] as? Bool ?? false","        countriesSource.setFeatureState(","            sourceLayerID: countriesSourceLayer,","            featureID: featureID,","            state: [\"selected\": !isSelected]","        )","","        let countryName = feature.attributes[\"NAME\"] as? String ?? \"Unknown\"","        let alert = UIAlertController(","            title: \"Country Selected\",","            message: \"\\(countryName) is now \\(!isSelected ? \"selected\" : \"deselected\")\",","            preferredStyle: .alert","        )","        alert.addAction(UIAlertAction(title: \"OK\", style: .default))","        present(alert, animated: true)","    }"]},{"type":"heading","level":2,"text":"Key Differences from a GeoJSON Source","anchor":"Key-Differences-from-a-GeoJSON-Source"},{"type":"heading","level":3,"text":"Setting Feature State","anchor":"Setting-Feature-State"},{"type":"codeListing","syntax":"swift","code":["\/\/ GeoJSON shape source — no source layer","shapeSource.setFeatureState(featureID: \"54\", state: [\"selected\": true])","","\/\/ Vector tile source — source layer required","vectorSource.setFeatureState(sourceLayerID: \"countries\", featureID: \"54\", state: [\"selected\": true])"]},{"type":"heading","level":3,"text":"Reading and Removing Feature State","anchor":"Reading-and-Removing-Feature-State"},{"type":"codeListing","syntax":"swift","code":["\/\/ Read","let state = vectorSource.featureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove a single key","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\", stateKey: \"selected\")","","\/\/ Remove all state from a feature","vectorSource.removeFeatureState(sourceLayerID: \"countries\", featureID: \"54\")","","\/\/ Remove all feature state from the source layer","vectorSource.resetFeatureStates(sourceLayerID: \"countries\")"]},{"type":"heading","level":2,"text":"API Reference","anchor":"API-Reference"},{"type":"heading","level":3,"text":"MLNVectorTileSource Feature State Methods","anchor":"MLNVectorTileSource-Feature-State-Methods"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:","isActive":true,"type":"reference"},{"text":" - Merge state into a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featureStateForSourceLayerID:featureID:","isActive":true,"type":"reference"},{"text":" - Get the current state of a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","isActive":true,"type":"reference"},{"text":" - Remove a state key from a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true,"type":"reference"},{"text":" - Remove all state from a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true,"type":"reference"},{"text":" - Remove all feature state from a source layer","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Related Examples","anchor":"Related-Examples"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","isA