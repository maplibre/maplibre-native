LineStyleLayer"},{"type":"text","text":" to the map using a GeoJSON file."}],"type":"topic","url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","title":"Using GeoJSON with a line style layer"},"doc://org.swift.MyProject/documentation/MapLibre/MLNLineStyleLayer":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","role":"symbol","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","isActive":true,"type":"reference"},{"text":" is a style layer that renders one or more stroked","type":"text"},{"text":" ","type":"text"},{"text":"polylines on the map.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/maplibre\/mlnlinestylelayer","title":"MLNLineStyleLayer","fragments":[{"kind":"identifier","text":"MLNLineStyleLayer"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/PMTiles":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","role":"article","abstract":[{"type":"text","text":"Working with PMTiles"}],"kind":"article","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/pmtiles","title":"PMTiles"},"https://maplibre.org/maplibre-style-spec/expressions/#feature-state":{"titleInlineContent":[{"text":"Feature state","type":"text"}],"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","title":"Feature state","url":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","type":"link"},"https://demotiles.maplibre.org":{"titleInlineContent":[{"text":"MapLibre demo tiles","type":"text"}],"identifier":"https:\/\/demotiles.maplibre.org","title":"MapLibre demo tiles","url":"https:\/\/demotiles.maplibre.org","type":"link"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorStyleLayer":{"role":"symbol","fragments":[{"kind":"identifier","text":"MLNVectorStyleLayer"}],"type":"topic","kind":"symbol","url":"\/