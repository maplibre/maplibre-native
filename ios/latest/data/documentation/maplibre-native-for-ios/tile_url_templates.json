{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/tile_url_templates"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"modules":[{"name":"MapLibre"}],"title":"Tile URL Templates","role":"article","roleHeading":"Article"},"abstract":[{"text":"Using URL Templates when defining tile sources","type":"text"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"seeAlsoSections":[{"anchor":"Other-Articles","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Customizing_Fonts","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Info.plist_Keys","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GestureRecognizers","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/MultipleImagesExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Predicates_and_Expressions","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/For_Style_Authors"],"generated":true,"title":"Other Articles"}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/Tile_URL_Templates","interfaceLanguage":"occ"},"primaryContentSections":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSource","isActive":true},{"type":"text","text":" objects, specifically "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterTileSource","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":" objects, can be created using an initializer that accepts"},{"type":"text","text":" "},{"type":"text","text":"an array of tile URL templates. Tile URL templates are strings that specify the"},{"type":"text","text":" "},{"type":"text","text":"URLs of the vector tiles or raster tile images to load. A template resembles an"},{"type":"text","text":" "},{"type":"text","text":"absolute URL, but with any number of placeholder strings that the source"},{"type":"text","text":" "},{"type":"text","text":"evaluates based on the tile it needs to load. For example:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"http:\/\/www.example.com\/tiles\/{z}\/{x}\/{y}.pbf"},{"text":" could be","type":"text"},{"text":" ","type":"text"},{"text":"evaluated as ","type":"text"},{"type":"codeVoice","code":"http:\/\/www.example.com\/tiles\/14\/6\/9.pbf"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"http:\/\/www.example.com\/tiles\/{z}\/{x}\/{y}{ratio}.png"},{"text":" could be","type":"text"},{"text":" ","type":"text"},{"text":"evaluated as ","type":"text"},{"type":"codeVoice","code":"http:\/\/www.example.com\/tiles\/14\/6\/9@2x.png"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tile URL templates are also used to define tilesets in TileJSON manifests or"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/#raster","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/sources\/#vector-tiles","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sources in style JSON files. See the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/mapbox\/tilejson-spec\/tree\/master\/2.2.0","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for information about tile URL templates in the context of a TileJSON or style"},{"type":"text","text":" "},{"type":"text","text":"JSON file."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tile sources support the following placeholder strings in tile URL templates,"},{"type":"text","text":" "},{"type":"text","text":"all of which are optional:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Placeholder string","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{x}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The index of the tile along the map’s x axis according to Spherical Mercator projection. If the value is 0, the tile’s left edge corresponds to the 180th meridian west. If the value is 2^z−1, the tile’s right edge corresponds to the 180th meridian east.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{y}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The index of the tile along the map’s y axis according to Spherical Mercator projection. If the value is 0, the tile’s tile edge corresponds to arctan(sinh(π)), or approximately 85.0511 degrees north. If the value is 2^z−1, the tile’s bottom edge corresponds to −arctan(sinh(π)), or approximately 85.0511 degrees south. The y axis is inverted if the options parameter contains ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionTileCoordinateSystem","isActive":true,"type":"reference"},{"text":" with a value of ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileCoordinateSystem\/MLNTileCoordinateSystemTMS","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{z}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The tile’s zoom level. At zoom level 0, each tile covers the entire world map; at zoom level 1, it covers ¼ of the world; at zoom level 2, 1⁄16 of the world, and so on. For tiles loaded by a ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterTileSource","isActive":true,"type":"reference"},{"text":" object, whether the tile zoom level matches the map’s current zoom level depends on the value of the source’s tile size as specified in the ","type":"text"},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNTileSourceOptionTileSize","isActive":true,"type":"reference"},{"text":" key of the options parameter.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{bbox-epsg-3857}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The tile’s bounding box, expressed as a comma-separated list of the tile’s western, southern, eastern, and northern extents according to Spherical Mercator (EPSG:3857) projection. The bounding box is typically used with map services conforming to the ","type":"text"},{"text":"Web Map Service","type":"text"},{"text":" protocol.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{quadkey}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"A quadkey indicating both the tile’s location and its zoom level. The quadkey is typically used with ","type":"text"},{"text":"Bing Maps","type":"text"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{ratio}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"A suffix indicating the resolution of the tile image. The suffix is the empty string for standard resolution displays and ","type":"text"},{"code":"@2x","type":"codeVoice"},{"text":" for Retina displays, including displays for which ","type":"text"},{"code":"UIScreen.scale","type":"codeVoice"},{"text":" is 3.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"{prefix}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Two hexadecimal digits chosen such that each visible tile has a different prefix. The prefix is typically used for domain sharding.","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about the "},{"type":"codeVoice","code":"{x}"},{"type":"text","text":", "},{"type":"codeVoice","code":"{y}"},{"type":"text","text":", and "},{"type":"codeVoice","code":"{z}"},{"type":"text","text":" placeholder strings,"},{"type":"text","text":" "},{"type":"text","text":"consult the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/wiki.openstreetmap.org\/wiki\/Slippy_map_tilenames","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNRasterStyleLayer":{"fragments":[{"text":"MLNRasterStyleLayer","kind":"identifier"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","kind":"symbol","title":"MLNRasterStyleLayer","role":"symbol","url":"\/documentation\/maplibre\/mlnrasterstylelayer","abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNRasterStyleLayer","isActive":true},{"type":"text","text":" is a style layer that renders georeferenced raster"},{"type":"text","text":" "},{"type":"text","text":"imagery on the map, especially raster tiles."}],"type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource":{"role":"symbol","fragments":[{"text":"MLNVectorTileSource","kind":"identifier"}],"title":"MLNVectorTileSource","kind":"symbol","type":"topic","abstract":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","type":"reference"},{"text":" is a map content source that supplies tiled vector data","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"text":"Mapbox Vector Tile","type":"text"},{"text":" format","type":"text"},{"text":" ","type":"text"},{"text":"to b