{"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","type":"reference","isActive":true},{"text":" allows you to assign user-defined key-value pairs to features at runtime for styling purposes. This is useful for creating interactive maps where features change appearance based on user interactions like selection, highlighting, or other states.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature state is managed through the source that contains the feature: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource"},{"type":"text","text":" for GeoJSON data and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource"},{"type":"text","text":" for vector tiles. Features are identified by their feature identifier, so your app only needs to keep track of identifiers, not whole feature objects."}]},{"anchor":"Key-Concepts","level":2,"type":"heading","text":"Key Concepts"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Feature State"}],"type":"strong"},{"text":": User-defined key-value pairs assigned to features at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Feature-State Expressions"}],"type":"strong"},{"type":"text","text":": Style expressions that access feature state values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Interactive Styling"}],"type":"strong"},{"type":"text","text":": Dynamic visual changes based on user interactions"}]}]}],"type":"unorderedList"},{"level":2,"text":"Example Implementation","anchor":"Example-Implementation","type":"heading"},{"level":3,"text":"Setting Up the Map View","anchor":"Setting-Up-the-Map-View","type":"heading"},{"code":["import MapLibre","import SwiftUI","import UIKit","","class FeatureStateExampleUIKit: UIViewController, MLNMapViewDelegate {","    private var mapView: MLNMapView!","    private var statesSource: MLNShapeSource!","","    override func viewDidLoad() {","        super.viewDidLoad()","","        let mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","","        \/\/ Set initial camera position to show US states","        mapView.setCenter(CLLocationCoordinate2D(latitude: 42.619626, longitude: -103.523181), zoomLevel: 3, animated: false)","        view.addSubview(mapView)","","        self.mapView = mapView","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Adding Data Source and Style Layers","anchor":"Adding-Data-Source-and-Style-Layers","type":"heading"},{"code":["func mapView(_ mapView: MLNMapView, didFinishLoading style: MLNStyle) {","        \/\/ Add US states GeoJSON source","        let statesURL = URL(string: \"https:\/\/maplibre.org\/maplibre-gl-js\/docs\/assets\/us_states.geojson\")!","        let statesSource = MLNShapeSource(identifier: \"states\", url: statesURL)","        style.addSource(statesSource)","        self.statesSource = statesSource","","        \/\/ Add state fills layer with a feature-state expression for a selection effect","        let stateFillsLayer = MLNFillStyleLayer(identifier: \"state-fills\", source: statesSource)","","        \/\/ Use a feature-state expression to change color based on selection","        let fillColorExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red.withAlphaComponent(0.7), \/\/ Selected color","            UIColor.blue.withAlphaComponent(0.5), \/\/ Default color","        ])","        stateFillsLayer.fillColor = fillColorExpression","","        style.addLayer(stateFillsLayer)","","        \/\/ Add state borders layer with a feature-state expression for a selection effect","        let stateBordersLayer = MLNLineStyleLayer(identifier: \"state-borders\", source: statesSource)","","        \/\/ Use a feature-state expression to change border color based on selection","        let borderColorExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red, \/\/ Selected border color","            UIColor.blue, \/\/ Default border color","        ])","        stateBordersLayer.lineColor = borderColorExpression","","        \/\/ Use a feature-state expression to change line width based on selection","        let borderWidthExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            2.0,","            1.0,","        ])","        stateBordersLayer.lineWidth = borderWidthExpression","","        style.addLayer(stateBordersLayer)","","        \/\/ Add tap gesture recognizer to handle feature selection","        let tapGesture = UITapGestureRecognizer(target: self, action: #selector(handleMapTap(_:)))","        mapView.addGestureRecognizer(tapGesture)","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Handling User Interactions","anchor":"Handling-User-Interactions","type":"heading"},{"code":["@objc private func handleMapTap(_ gesture: UITapGestureRecognizer) {","        let location = gesture.location(in: mapView)","        let features = mapView.visibleFeatures(at: location, styleLayerIdentifiers: [\"state-fills\"])","","        guard let feature = features.first, let featureID = feature.identifier.map({ \"\\($0)\" }) else {","            return","        }","","        \/\/ Toggle the selection state of the tapped feature. Selection is not","        \/\/ exclusive: any number of states can be selected at the same time.","        let isSelected = statesSource.featureState(featureID: featureID)?[\"selected\"] as? Bool ?? false","        statesSource.setFeatureState(featureID: featureID, state: [\"selected\": !isSelected])","","        \/\/ Show alert with feature information","        let stateName = feature.attributes[\"STATE_NAME\"] as? String ?? \"Unknown State\"","        let alert = UIAlertController(","            title: \"State Selected\",","            message: \"\\(stateName) is now \\(!isSelected ? \"selected\" : \"deselected\")\",","            preferredStyle: .alert","        )","        alert.addAction(UIAlertAction(title: \"OK\", style: .default))","        present(alert, animated: true)","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"SwiftUI Integration","anchor":"SwiftUI-Integration","type":"heading"},{"code":["}","","struct FeatureStateExampleUIViewControllerRepresentable: UIViewControllerRepresentable {","    typealias UIViewControllerType = FeatureStateExampleUIKit","","    func makeUIViewController(context _: Context) -> FeatureStateExampleUIKit {","        FeatureStateExampleUIKit()","    }","","    func updateUIViewController(_: FeatureStateExampleUIKit, context _: Context) {}","}","","\/\/ SwiftUI wrapper","struct FeatureStateExample: View {","    var body: some View {","        FeatureStateExampleUIViewControllerRepresentable()","            .navigationTitle(\"Feature State\")","            .navigationBarTitleDisplayMode(.inline)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Key Features Demonstrated","anchor":"Key-Features-Demonstrated","type":"heading"},{"level":3,"text":"1. Setting Feature State","anchor":"1-Setting-Feature-State","type":"heading"},{"code":["\/\/ Merge state into a feature of a GeoJSON source","shapeSource.setFeatureState(featureID: \"54\", state: [\"selected\": true])","","\/\/ Vector tile sources additionally take the source layer","vectorSource.setFeatureState(sourceLayerID: \"states\", featureID: \"54\", state: [\"selected\": true])"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"2. Getting Feature State","anchor":"2-Getting-Feature-State","type":"heading"},{"code":["\/\/ Get the current state of a feature","let state = shapeSource.featureState(featureID: \"54\")","let isSelected = state?[\"selected\"] as? Bool ?? false"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"3. Removing Feature State","anchor":"3-Removing-Feature-State","type":"heading"},{"code":["\/\/ Remove a single state key from a feature","shapeSource.removeFeatureState(featureID: \"54\", stateKey: \"selected\")","","\/\/ Remove all state from a feature","shapeSource.removeFeatureState(featureID: \"54\")","","\/\/ Remove all feature state from the source","shapeSource.resetFeatureStates()"],"syntax":"swift","type":"codeListing"},{"anchor":"4-Feature-State-Expressions","level":3,"type":"heading","text":"4. Feature-State Expressions"},{"syntax":"swift","type":"codeListing","code":["\/\/ Create expressions that respond to feature state","let colorExpression = NSExpression(mglJSONObject: [","    \"case\",","    [\"boolean\", [\"feature-state\", \"selected\"], false],","    UIColor.red,    \/\/ Selected color","    UIColor.blue    \/\/ Default color","])"]},{"anchor":"API-Reference","type":"heading","level":2,"text":"API Reference"},{"level":3,"text":"MLNShapeSource Feature State Methods","anchor":"MLNShapeSource-Feature-State-Methods","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:","type":"reference"},{"type":"text","text":" - Merge state into a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featureStateForFeatureID:","type":"reference"},{"text":" - Get the current state of a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:"},{"type":"text","text":" - Remove a state key from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:"},{"type":"text","text":" - Remove all state from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/resetFeatureStates"},{"type":"text","text":" - Remove all feature state from the source"}]}]}]},{"anchor":"MLNVectorTileSource-Feature-State-Methods","type":"heading","level":3,"text":"MLNVectorTileSource Feature State Methods"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:"},{"type":"text","text":" - Merge state into a feature"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Get the current state of a feature"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","type":"reference"},{"text":" - Remove a state key from a feature","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","type":"reference"},{"text":" - Remove all feature state from a source layer","type":"text"}]}]}]},{"anchor":"Related-Examples","type":"heading","level":2,"text":"Related Examples"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"Predicates_and_Expressions.md","type":"reference","isActive":true},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"GeoJSON.md","type":"reference","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"GestureRecognizers.md","type":"reference","isActive":true},{"text":" - Handling user interactions","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Set Feature State","role":"article","modules":[{"name":"MapLibre"}]},"abstract":[{"type":"text","text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions."}],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","interfaceLanguage":"occ"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/