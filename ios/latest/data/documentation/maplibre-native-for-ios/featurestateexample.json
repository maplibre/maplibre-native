pressions"},{"syntax":"swift","type":"codeListing","code":["\/\/ Create expressions that respond to feature state","let colorExpression = NSExpression(mglJSONObject: [","    \"case\",","    [\"boolean\", [\"feature-state\", \"selected\"], false],","    UIColor.red,    \/\/ Selected color","    UIColor.blue    \/\/ Default color","])"]},{"level":2,"anchor":"API-Reference","type":"heading","text":"API Reference"},{"level":3,"anchor":"MLNShapeSource-Feature-State-Methods","type":"heading","text":"MLNShapeSource Feature State Methods"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:","isActive":true,"type":"reference"},{"text":" - Merge state into a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featureStateForFeatureID:","isActive":true,"type":"reference"},{"text":" - Get the current state of a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:","isActive":true,"type":"reference"},{"text":" - Remove a state key from a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:","isActive":true,"type":"reference"},{"text":" - Remove all state from a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/resetFeatureStates","isActive":true,"type":"reference"},{"text":" - Remove all feature state from the source","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"MLNVectorTileSource-Feature-State-Methods","type":"heading","text":"M