{"metadata":{"modules":[{"name":"MapLibre"}],"roleHeading":"Article","title":"Set Feature State","role":"article"},"sections":[],"abstract":[{"type":"text","text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions."}],"seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCircleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/PMTiles","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateVectorExample"],"generated":true}],"kind":"article","hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"https:\/\/maplibre.org\/maplibre-style-spec\/expressions\/#feature-state","isActive":true},{"type":"text","text":" allows you to assign user-defined key-value pairs to features at runtime for styling purposes. This is useful for creating interactive maps where features change appearance based on user interactions like selection, highlighting, or other states."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Feature state is managed through the source that contains the feature: "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource","isActive":true},{"type":"text","text":" for GeoJSON data and "},{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource","isActive":true},{"type":"text","text":" for vector tiles. Features are identified by their feature identifier, so your app only needs to keep track of identifiers, not whole feature objects."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Key Concepts","anchor":"Key-Concepts"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Feature State"}],"type":"strong"},{"text":": User-defined key-value pairs assigned to features at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Feature-State Expressions","type":"text"}]},{"type":"text","text":": Style expressions that access feature state values"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interactive Styling"}]},{"type":"text","text":": Dynamic visual changes based on user interactions"}],"type":"paragraph"}]}]},{"anchor":"Example-Implementation","type":"heading","level":2,"text":"Example Implementation"},{"anchor":"Setting-Up-the-Map-View","level":3,"text":"Setting Up the Map View","type":"heading"},{"syntax":"swift","code":["import MapLibre","import SwiftUI","import UIKit","","class FeatureStateExampleUIKit: UIViewController, MLNMapViewDelegate {","    private var mapView: MLNMapView!","    private var statesSource: MLNShapeSource!","","    override func viewDidLoad() {","        super.viewDidLoad()","","        let mapView = MLNMapView(frame: view.bounds)","        mapView.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        mapView.delegate = self","","        \/\/ Set initial camera position to show US states","        mapView.setCenter(CLLocationCoordinate2D(latitude: 42.619626, longitude: -103.523181), zoomLevel: 3, animated: false)","        view.addSubview(mapView)","","        self.mapView = mapView","    }"],"type":"codeListing"},{"anchor":"Adding-Data-Source-and-Style-Layers","level":3,"text":"Adding Data Source and Style Layers","type":"heading"},{"syntax":"swift","code":["func mapView(_ mapView: MLNMapView, didFinishLoading style: MLNStyle) {","        \/\/ Add US states GeoJSON source","        let statesURL = URL(string: \"https:\/\/maplibre.org\/maplibre-gl-js\/docs\/assets\/us_states.geojson\")!","        let statesSource = MLNShapeSource(identifier: \"states\", url: statesURL)","        style.addSource(statesSource)","        self.statesSource = statesSource","","        \/\/ Add state fills layer with a feature-state expression for a selection effect","        let stateFillsLayer = MLNFillStyleLayer(identifier: \"state-fills\", source: statesSource)","","        \/\/ Use a feature-state expression to change color based on selection","        let fillColorExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red.withAlphaComponent(0.7), \/\/ Selected color","            UIColor.blue.withAlphaComponent(0.5), \/\/ Default color","        ])","        stateFillsLayer.fillColor = fillColorExpression","","        style.addLayer(stateFillsLayer)","","        \/\/ Add state borders layer with a feature-state expression for a selection effect","        let stateBordersLayer = MLNLineStyleLayer(identifier: \"state-borders\", source: statesSource)","","        \/\/ Use a feature-state expression to change border color based on selection","        let borderColorExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            UIColor.red, \/\/ Selected border color","            UIColor.blue, \/\/ Default border color","        ])","        stateBordersLayer.lineColor = borderColorExpression","","        \/\/ Use a feature-state expression to change line width based on selection","        let borderWidthExpression = NSExpression(mglJSONObject: [","            \"case\",","            [\"boolean\", [\"feature-state\", \"selected\"], false],","            2.0,","            1.0,","        ])","        stateBordersLayer.lineWidth = borderWidthExpression","","        style.addLayer(stateBordersLayer)","","        \/\/ Add tap gesture recognizer to handle feature selection","        let tapGesture = UITapGestureRecognizer(target: self, action: #selector(handleMapTap(_:)))","        mapView.addGestureRecognizer(tapGesture)","    }"],"type":"codeListing"},{"anchor":"Handling-User-Interactions","level":3,"text":"Handling User Interactions","type":"heading"},{"syntax":"swift","code":["@objc private func handleMapTap(_ gesture: UITapGestureRecognizer) {","        let location = gesture.location(in: mapView)","        let features = mapView.visibleFeatures(at: location, styleLayerIdentifiers: [\"state-fills\"])","","        guard let feature = features.first, let featureID = feature.identifier.map({ \"\\($0)\" }) else {","            return","        }","","        \/\/ Toggle the selection state of the tapped feature. Selection is not","        \/\/ exclusive: any number of states can be selected at the same time.","        let isSelected = statesSource.featureState(featureID: featureID)?[\"selected\"] as? Bool ?? false","        statesSource.setFeatureState(featureID: featureID, state: [\"selected\": !isSelected])","","        \/\/ Show alert with feature information","        let stateName = feature.attributes[\"STATE_NAME\"] as? String ?? \"Unknown State\"","        let alert = UIAlertController(","            title: \"State Selected\",","            message: \"\\(stateName) is now \\(!isSelected ? \"selected\" : \"deselected\")\",","            preferredStyle: .alert","        )","        alert.addAction(UIAlertAction(title: \"OK\", style: .default))","        present(alert, animated: true)","    }"],"type":"codeListing"},{"anchor":"SwiftUI-Integration","level":3,"text":"SwiftUI Integration","type":"heading"},{"syntax":"swift","code":["}","","struct FeatureStateExampleUIViewControllerRepresentable: UIViewControllerRepresentable {","    typealias UIViewControllerType = FeatureStateExampleUIKit","","    func makeUIViewController(context _: Context) -> FeatureStateExampleUIKit {","        FeatureStateExampleUIKit()","    }","","    func updateUIViewController(_: FeatureStateExampleUIKit, context _: Context) {}","}","","\/\/ SwiftUI wrapper","struct FeatureStateExample: View {","    var body: some View {","        FeatureStateExampleUIViewControllerRepresentable()","            .navigationTitle(\"Feature State\")","            .navigationBarTitleDisplayMode(.inline)","    }","}"],"type":"codeListing"},{"anchor":"Key-Features-Demonstrated","level":2,"text":"Key Features Demonstrated","type":"heading"},{"anchor":"1-Setting-Feature-State","level":3,"text":"1. Setting Feature State","type":"heading"},{"syntax":"swift","code":["\/\/ Merge state into a feature of a GeoJSON source","shapeSource.setFeatureState(featureID: \"54\", state: [\"selected\": true])","","\/\/ Vector tile sources additionally take the source layer","vectorSource.setFeatureState(sourceLayerID: \"states\", featureID: \"54\", state: [\"selected\": true])"],"type":"codeListing"},{"anchor":"2-Getting-Feature-State","level":3,"text":"2. Getting Feature State","type":"heading"},{"syntax":"swift","code":["\/\/ Get the current state of a feature","let state = shapeSource.featureState(featureID: \"54\")","let isSelected = state?[\"selected\"] as? Bool ?? false"],"type":"codeListing"},{"anchor":"3-Removing-Feature-State","level":3,"text":"3. Removing Feature State","type":"heading"},{"syntax":"swift","code":["\/\/ Remove a single state key from a feature","shapeSource.removeFeatureState(featureID: \"54\", stateKey: \"selected\")","","\/\/ Remove all state from a feature","shapeSource.removeFeatureState(featureID: \"54\")","","\/\/ Remove all feature state from the source","shapeSource.resetFeatureStates()"],"type":"codeListing"},{"anchor":"4-Feature-State-Expressions","level":3,"text":"4. Feature-State Expressions","type":"heading"},{"syntax":"swift","code":["\/\/ Create expressions that respond to feature state","let colorExpression = NSExpression(mglJSONObject: [","    \"case\",","    [\"boolean\", [\"feature-state\", \"selected\"], false],","    UIColor.red,    \/\/ Selected color","    UIColor.blue    \/\/ Default color","])"],"type":"codeListing"},{"anchor":"API-Reference","level":2,"text":"API Reference","type":"heading"},{"anchor":"MLNShapeSource-Feature-State-Methods","level":3,"text":"MLNShapeSource Feature State Methods","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:"},{"type":"text","text":" - Merge state into a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featureStateForFeatureID:"},{"type":"text","text":" - Get the current state of a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:"},{"type":"text","text":" - Remove a state key from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:"},{"type":"text","text":" - Remove all state from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/resetFeatureStates"},{"type":"text","text":" - Remove all feature state from the source"}]}]}],"type":"unorderedList"},{"anchor":"MLNVectorTileSource-Feature-State-Methods","level":3,"text":"MLNVectorTileSource Feature State Methods","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/setFeatureStateForSourceLayerID:featureID:state:"},{"type":"text","text":" - Merge state into a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/featureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Get the current state of a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:"},{"type":"text","text":" - Remove a state key from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Remove all state from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:"},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}],"type":"unorderedList"},{"anchor":"Related-Examples","level":2,"text":"Related Examples","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"Predicates_and_Expressions.md"},{"type":"text","text":" - Learn about style expressions"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"GeoJSON.md"},{"type":"text","text":" - Working with GeoJSON data sources"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"GestureRecognizers.md"},{"type":"text","text":" - Handling user interactions"}]}]}],"type":"unorderedList"}]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/GeoJSON":{"type":"topic","role":"article","title":"Working with GeoJSON Data","abstract":[],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","kind":"article","url":"\/documentation\/maplibre-native-for-ios\/geojson"},"GeoJSON.md":{"type":"link","url":"GeoJSON.md","title":"GeoJSON","titleInlineContent":[{"type":"text","text":"GeoJSON"}],"identifier":"GeoJSON.md"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/removeFeatureStateForSourceLayerID:featureID:stateKey:":{"type":"topic","url":"\/documentation\/maplibre\/mlnvectortilesource\/removefeaturestateforsourcelayerid:featureid:statekey:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","title":"removeFeatureStateForSourceLayerID:featureID:stateKey:","kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"removeFeatureStateForSourceLayerID:featureID:stateKey:"}],"abstract":[{"type":"text","text":"Removes state from a feature in this source, or from all features in the"},{"type":"text","text":" "},{"type":"te