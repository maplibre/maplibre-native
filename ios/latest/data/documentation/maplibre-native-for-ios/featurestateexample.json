ot only the overlays atop the map, but also"},{"type":"text","text":" "},{"type":"text","text":"the content that forms the base map."}],"role":"symbol","fragments":[{"kind":"identifier","text":"MLNShape"}],"url":"\/documentation\/maplibre\/mlnshape","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShape","kind":"symbol","title":"MLNShape"},"GestureRecognizers.md":{"url":"GestureRecognizers.md","title":"Gesture Recognizers","identifier":"GestureRecognizers.md","type":"link","titleInlineContent":[{"type":"text","text":"Gesture Recognizers"}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/WebAPIDataExample":{"type":"topic","abstract":[{"type":"text","text":"Showing data from an API with custom styling and interaction"}],"role":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","url":"\/documentation\/maplibre-native-for-ios\/webapidataexample","kind":"article","title":"Showing data from an API"},"GeoJSON.md":{"url":"GeoJSON.md","title":"GeoJSON","identifier":"GeoJSON.md","type":"link","titleInlineContent":[{"type":"text","text":"GeoJSON"}]},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/removeFeatureStateForSourceLayerID:featureID:":{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","kind":"symbol","url":"\/documentation\/maplibre\/mlnvectortilesource\/removefeaturestateforsourcelayerid:featureid:","type":"topic","title":"removeFeatureStateForSourceLayerID:featureID:","abstract":[{"type":"text","text":"Removes all state from a single feature in this source."}],"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"removeFeatureStateForSourceLayerID:featureID:"}],"role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/DDSCircleLayerExample":{"type":"topic","abstract":[{"type":"text","text":"Add and style a vector tile sour