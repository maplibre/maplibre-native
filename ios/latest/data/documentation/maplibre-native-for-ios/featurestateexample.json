/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","isActive":true},{"text":" - Remove a state key from a feature","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true,"type":"reference"},{"text":" - Remove all state from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}]},{"text":"Related Examples","type":"heading","anchor":"Related-Examples","level":2},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"Predicates_and_Expressions.md","isActive":true},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"GeoJSON.md","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"GestureRecognizers.md","isActive":true},{"type":"text","text":" - Handling user interactions"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Styling and Dynamic Data","generated":true,"anchor":"Styling-and-Dynamic-Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\