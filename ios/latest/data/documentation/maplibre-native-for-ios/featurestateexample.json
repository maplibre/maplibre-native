":"Related-Examples"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Predicates_and_Expressions.md","isActive":true},{"type":"text","text":" - Learn about style expressions"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"GeoJSON.md","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"GestureRecognizers.md","isActive":true},{"type":"text","text":" - Handling user interactions"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"references":{"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/removeFeatureStateForSourceLayerID:featureID:":{"kind":"symbol","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","fragments":[{"text":"- ","kind":"text"},{"text":"removeFeatureStateForSourceLayerID:featureID:","kind":"identifier"}],"type":"topic","title":"removeFeatureStateForSourceLayerID:featureID:","abstract":[{"type":"text","text":"Removes all state from a single feature in this source."}],"url":"\/documentation\/maplibre\/mlnvectortilesource\/removefeaturestateforsourcelayerid:featureid:","role":"symbol"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/POIAlongRouteExample":{"kind":"article","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/POIAlongRouteExample","type":"topic","role":"article","title":"POI Along a Route","abstract":[{"type":"text","text":"Use an "},{"type":"codeVoice","code":"NSPredicate"},{"type":"text","text":" to show POI and road labels along a route."}],"url":"\/documentation\/maplibre-native-for-ios\/poialongrouteexample"},"doc://org.swift.MyProject/documentation/MapLibre-Native