nce","isActive":true},{"text":" - Remove a state key from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true,"type":"reference"},{"text":" - Remove all state from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:"},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}],"type":"unorderedList"},{"level":2,"text":"Related Examples","anchor":"Related-Examples","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"Predicates_and_Expressions.md"},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"GeoJSON.md","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"GestureRecognizers.md","isActive":true},{"type":"text","text":" - Handling user interactions"}]}]}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","generated":true,"title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/An