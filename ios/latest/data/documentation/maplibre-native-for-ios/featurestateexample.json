.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","isActive":true},{"type":"text","text":" - Remove a state key from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Related-Examples","level":2,"type":"heading","text":"Related Examples"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"Predicates_and_Expressions.md","isActive":true},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"GeoJSON.md","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"GestureRecognizers.md","isActive":true},{"type":"text","text":" - Handling user interactions"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.