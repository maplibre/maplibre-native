Remove all feature state from the source","shapeSource.resetFeatureStates()"],"syntax":"swift"},{"level":3,"type":"heading","text":"4. Feature-State Expressions","anchor":"4-Feature-State-Expressions"},{"type":"codeListing","code":["\/\/ Create expressions that respond to feature state","let colorExpression = NSExpression(mglJSONObject: [","    \"case\",","    [\"boolean\", [\"feature-state\", \"selected\"], false],","    UIColor.red,    \/\/ Selected color","    UIColor.blue    \/\/ Default color","])"],"syntax":"swift"},{"level":2,"type":"heading","text":"API Reference","anchor":"API-Reference"},{"level":3,"type":"heading","text":"MLNShapeSource Feature State Methods","anchor":"MLNShapeSource-Feature-State-Methods"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/setFeatureStateForFeatureID:state:"},{"text":" - Merge state into a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/featureStateForFeatureID:"},{"text":" - Get the current state of a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:stateKey:"},{"text":" - Remove a state key from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSource\/removeFeatureStateForFeatureID:"},{"text":" - Remove all state from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNShapeSour