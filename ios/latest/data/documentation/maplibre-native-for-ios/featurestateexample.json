t":[],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/GeoJSON","role":"article","kind":"article","title":"Working with GeoJSON Data","url":"\/documentation\/maplibre-native-for-ios\/geojson","type":"topic"},"doc://org.swift.MyProject/documentation/MapLibre/MLNVectorTileSource/resetFeatureStatesForSourceLayerID:":{"url":"\/documentation\/maplibre\/mlnvectortilesource\/resetfeaturestatesforsourcelayerid:","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"resetFeatureStatesForSourceLayerID:"}],"type":"topic","title":"resetFeatureStatesForSourceLayerID:","role":"symbol","abstract":[{"type":"text","text":"Removes all feature state entries from the given source layer."}]},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/LineStyleLayerExample":{"abstract":[{"type":"text","text":"Adding an "},{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNLineStyleLayer","type":"reference","isActive":true},{"type":"text","text":" to the map using a GeoJSON file."}],"url":"\/documentation\/maplibre-native-for-ios\/linestylelayerexample","kind":"article","type":"topic","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","role":"article","title":"Using GeoJSON with a line style layer"},"doc://org.swift.MyProject/documentation/MapLibre-Native-for-iOS/AnimatedLineExample":{"abstract":[{"type":"text","text":"Add an animated line to a map"}],"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","type":"topic","url":"\/documentation\/maplibre-native-for-ios\/animatedlineexample","title":"Animated Line","role":"article","kind":"article"},"doc://org.swift.MyProject/documentation/MapLibre/MLNShapeSource/featureStateForFeatureID:":{"type":"topic","url":"\/documentati