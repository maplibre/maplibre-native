teForSourceLayerID:featureID:stateKey:","isActive":true},{"type":"text","text":" - Remove a state key from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","isActive":true},{"type":"text","text":" - Remove all state from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}],"type":"unorderedList"},{"anchor":"Related-Examples","text":"Related Examples","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Predicates_and_Expressions.md","isActive":true},{"type":"text","text":" - Learn about style expressions"}]}]},{"content":[{"inlineContent":[{"identifier":"GeoJSON.md","type":"reference","isActive":true},{"type":"text","text":" - Working with GeoJSON data sources"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"GestureRecognizers.md","isActive":true},{"type":"text","text":" - Handling user interactions"}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","title":"Set Feature State","modules":[{"name":"MapLibre"}]},"seeAlsoSections":[{"generated":true,"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAPIDataExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/LineStyleLayerExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/DDSCir