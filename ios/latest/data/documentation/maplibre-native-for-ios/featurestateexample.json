orTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","type":"reference"},{"type":"text","text":" - Remove a state key from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","type":"reference"},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","type":"reference"},{"type":"text","text":" - Remove all feature state from a source layer"}],"type":"paragraph"}]}]},{"anchor":"Related-Examples","level":2,"text":"Related Examples","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"Predicates_and_Expressions.md","type":"reference"},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"GeoJSON.md","type":"reference"},{"type":"text","text":" - Working with GeoJSON data sources"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"GestureRecognizers.md","type":"reference"},{"type":"text","text":" - Handling user interactions"}],"type":"paragraph"}]}]}]}],"sections":[],"abstract":[{"type":"text","text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"seeAlsoSections":[{"anchor":"Styling-and-Dynamic-Data","title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/