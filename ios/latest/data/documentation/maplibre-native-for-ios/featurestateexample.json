ent state of a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:"},{"text":" - Remove a state key from a feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:"},{"type":"text","text":" - Remove all state from a feature"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}]},{"type":"heading","text":"Related Examples","anchor":"Related-Examples","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"Predicates_and_Expressions.md"},{"type":"text","text":" - Learn about style expressions"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"GeoJSON.md"},{"text":" - Working with GeoJSON data sources","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"GestureRecognizers.md"},{"text":" - Handling user interactions","type":"text"}]}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/maplibre-native-for-ios\/featurestateexample"]}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/FeatureStateExample"},"seeAlsoSections":[{"title":"Styling and Dynamic Data","generated":true,"anchor":