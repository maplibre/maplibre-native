ion\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:stateKey:","isActive":true,"type":"reference"},{"type":"text","text":" - Remove a state key from a feature"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/removeFeatureStateForSourceLayerID:featureID:","type":"reference","isActive":true},{"type":"text","text":" - Remove all state from a feature"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.swift.MyProject\/documentation\/MapLibre\/MLNVectorTileSource\/resetFeatureStatesForSourceLayerID:","isActive":true},{"type":"text","text":" - Remove all feature state from a source layer"}]}]}],"type":"unorderedList"},{"text":"Related Examples","anchor":"Related-Examples","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"Predicates_and_Expressions.md"},{"type":"text","text":" - Learn about style expressions"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"GeoJSON.md"},{"type":"text","text":" - Working with GeoJSON data sources"}]}]},{"content":[{"inlineContent":[{"identifier":"GestureRecognizers.md","isActive":true,"type":"reference"},{"text":" - Handling user interactions","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"text":"This example demonstrates how to use feature state to create interactive maps with dynamic styling based on user interactions.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/org.swift.MyProject\/documentation\/MapLibre"]]},"sections":[],"seeAlsoSections":[{"title":"Styling and Dynamic Data","identifiers":["doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/AnimatedLineExample","doc:\/\/org.swift.MyProject\/documentation\/MapLibre-Native-for-iOS\/WebAP