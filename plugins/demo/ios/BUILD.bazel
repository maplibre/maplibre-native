load("@darwin_config//:config.bzl", "BUNDLE_ID_PREFIX")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//platform/ios/bazel:provisioning.bzl", "configure_device_profiles")

# The layer types of the plugins only exist in a build with plugin support, and the plugin wrappers only build with the
# Metal renderer:
#
#   bazel build //plugins/demo/ios:PluginDemo --//:renderer=metal --//:plugins=true
_PLUGINS_ONLY = select({
    "//:plugins_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//:metal_renderer": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

configure_device_profiles()

swift_library(
    name = "Sources",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "PluginDemo",
    tags = ["manual"],
    target_compatible_with = _PLUGINS_ONLY,
    deps = [
        # The generated wrapper of each plugin that has a demo. The app registers a plugin when its demo opens.
        "//platform:ios-sdk",
        "//plugins/ios/ngon-layer",
    ],
)

apple_bundle_version(
    name = "plugin_demo_version",
    build_version = "1.0.0",
)

ios_application(
    name = "PluginDemo",
    bundle_id = "{}.maplibre.plugindemo".format(BUNDLE_ID_PREFIX),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    provisioning_profile = "xcode_profile",
    resources = ["//plugins/demo/assets:styles"],
    target_compatible_with = _PLUGINS_ONLY,
    version = ":plugin_demo_version",
    visibility = ["//visibility:public"],
    deps = [":Sources"],
)
