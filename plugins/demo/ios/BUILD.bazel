load("@darwin_config//:config.bzl", "BUNDLE_ID_PREFIX")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//platform/ios/bazel:provisioning.bzl", "configure_device_profiles")

# The demo draws with layer types that are only registered in a build with plugin support, and the gltf layer
# only has a Metal shader:
#
#   bazel build //plugins/demo/ios:PluginDemo --//:renderer=metal --//:plugins=true
#
# (`--ios_multi_cpus=sim_arm64` for the simulator, see README.md.)
_PLUGINS_ONLY = select({
    "//:plugins_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

configure_device_profiles()

swift_library(
    name = "Sources",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "PluginDemo",
    tags = ["manual"],
    target_compatible_with = _PLUGINS_ONLY,
    deps = [
        # The generated wrappers of every plugin in plugins/plugins, and a registry that registers one by its ID. The
        # app registers a plugin when its demo opens.
        "//platform:ios-sdk",
        "//plugins/ios:plugins",
    ],
)

apple_bundle_version(
    name = "plugin_demo_version",
    build_version = "1.0.0",
)

ios_application(
    name = "PluginDemo",
    bundle_id = "{}.maplibre.plugindemo".format(BUNDLE_ID_PREFIX),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    provisioning_profile = "xcode_profile",
    # `asset://car-red.glb` in a style resolves against the root of the app bundle. The demos of the plugins that only
    # need a style and a camera are listed from the metadata the plugin wrappers carry.
    resources = [
        "//plugins/demo/assets:models",
        "//plugins/demo/assets:styles",
        "//plugins/ios:demos",
    ],
    target_compatible_with = _PLUGINS_ONLY,
    version = ":plugin_demo_version",
    visibility = ["//visibility:public"],
    deps = [":Sources"],
)
