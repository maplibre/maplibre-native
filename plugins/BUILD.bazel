load("@rules_cc//cc:defs.bzl", "cc_test")
load("//bazel:flags.bzl", "CPP_FLAGS", "MAPLIBRE_FLAGS")

cc_test(
    name = "render-tests",
    timeout = "long",
    srcs = ["render_test.cpp"],
    args = [
        "--manifestPath",
        "plugins/ngon-layer/render-tests/manifest.json",
    ],
    copts = CPP_FLAGS + MAPLIBRE_FLAGS,
    data = ["//plugins/ngon-layer:render-fixtures"],
    tags = ["no-sandbox"],
    deps = [
        "//plugins/ngon-layer",
        "//render-test:render-test-srcs",
    ],
)

# The gltf layer only has a Metal shader, so its render tests only run in a Metal build:
#   bazel test //plugins:render-tests-gltf --//:renderer=metal --//:plugins=true
cc_test(
    name = "render-tests-gltf",
    timeout = "long",
    srcs = ["render_test.cpp"],
    args = [
        "--manifestPath",
        "plugins/gltf-layer/render-tests/manifest.json",
    ],
    copts = CPP_FLAGS + MAPLIBRE_FLAGS,
    data = ["//plugins/gltf-layer:render-fixtures"],
    local_defines = ["MLN_RENDER_TEST_GLTF=1"],
    tags = ["no-sandbox"],
    target_compatible_with = select({
        "//:metal_renderer": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//plugins/gltf-layer",
        "//render-test:render-test-srcs",
    ],
)
