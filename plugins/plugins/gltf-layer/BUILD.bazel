load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:flags.bzl", "CPP_FLAGS")

cc_library(
    name = "gltf-layer",
    srcs = ["shared/cpp/gltf_layer.cpp"],
    hdrs = [
        "shared/cpp/gltf_shader_metal.hpp",
        "shared/include/gltf_layer.hpp",
    ],
    copts = CPP_FLAGS,
    includes = [
        "shared/cpp",
        "shared/include",
    ],
    target_compatible_with = select({
        "//:plugins_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//:mln-plugin-api",
        "@tinygltf",
    ],
)

cc_test(
    name = "unit-tests",
    srcs = ["tests/gltf.test.cpp"],
    copts = CPP_FLAGS,
    deps = [":gltf-layer"],
)

filegroup(
    name = "render-fixtures",
    srcs = glob(
        ["render-tests/**"],
        exclude = ["render-tests/results/**"],
    ) + ["render-tests/results/.gitkeep"],
    visibility = ["//plugins:__pkg__"],
)
