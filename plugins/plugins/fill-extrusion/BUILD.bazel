load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:flags.bzl", "CPP_FLAGS")
load("//plugins:render_test.bzl", "plugin_render_test")

cc_library(
    name = "fill-extrusion",
    srcs = [
        "shared/cpp/fill_extrusion.cpp",
        "shared/cpp/rounded.hpp",
        "shared/cpp/shaders.hpp",
    ],
    hdrs = ["shared/include/fill_extrusion.hpp"],
    copts = CPP_FLAGS,
    defines = select({
        "//:metal_renderer": ["MLN_FILL_EXTRUSION_METAL=1"],
        "//conditions:default": [],
    }),
    includes = ["shared/include"],
    # The plugin itself has no renderer dependency: all interaction is C ABI.
    visibility = ["//visibility:public"],
    deps = [
        ":earcut",
        "//:mln-plugin-api",
    ],
)

cc_library(
    name = "earcut",
    hdrs = ["vendor/mapbox/earcut.hpp"],
    includes = ["vendor"],
)

cc_test(
    name = "geometry-tests",
    srcs = ["tests/geometry.test.cpp"],
    copts = CPP_FLAGS,
    deps = [
        ":fill-extrusion",
        "@googletest//:gtest_main",
    ],
)

# Every test of the repository that has a fill-extrusion layer, with the plugin replacing the built-in layer.
plugin_render_test(
    name = "render-test",
    data = ["//metrics:render-test-files"],
    ignore = "render-tests/ignores.json",
    layer_type = "fill-extrusion",
    manifest = {"//:metal_renderer": "metrics/ios-metal-render-test-runner-style.json"},
)
