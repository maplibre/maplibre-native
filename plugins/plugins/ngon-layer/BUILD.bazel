load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:flags.bzl", "CPP_FLAGS")
load("//plugins:render_test.bzl", "plugin_render_test")

# shared/cpp/ngon_shader_sources.hpp is generated by scripts/generate-shaders.ts and checked in.
cc_library(
    name = "ngon-layer",
    srcs = [
        "shared/cpp/ngon_layer.cpp",
        "shared/cpp/ngon_shader_sources.hpp",
    ],
    hdrs = ["shared/include/ngon_layer.hpp"],
    copts = CPP_FLAGS,
    includes = ["shared/include"],
    target_compatible_with = select({
        "//:plugins_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = ["//:mln-plugin-api"],
)

cc_test(
    name = "unit-tests",
    srcs = ["tests/ngon.test.cpp"],
    copts = CPP_FLAGS,
    deps = [":ngon-layer"],
)

plugin_render_test(
    name = "render-test",
    data = glob(
        ["render-tests/**"],
        exclude = ["render-tests/results/**"],
    ) + ["render-tests/results/.gitkeep"],
    manifest = "plugins/plugins/ngon-layer/render-tests/manifest.json",
)
