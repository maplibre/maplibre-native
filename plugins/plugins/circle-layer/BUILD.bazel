load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:flags.bzl", "CPP_FLAGS")
load("//plugins:render_test.bzl", "plugin_render_test")

# shared/cpp/circle_shader_sources.hpp is generated by scripts/generate-shaders.mjs and checked in.
cc_library(
    name = "circle-layer",
    srcs = [
        "shared/cpp/circle_layer.cpp",
        "shared/cpp/circle_shader_sources.hpp",
    ],
    hdrs = ["shared/include/circle_layer.hpp"],
    copts = CPP_FLAGS,
    includes = ["shared/include"],
    target_compatible_with = select({
        "//:plugins_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = ["//:mln-plugin-api"],
)

cc_test(
    name = "unit-tests",
    srcs = ["tests/circle.test.cpp"],
    copts = CPP_FLAGS,
    deps = [":circle-layer"],
)

# Every test of the repository that has a circle layer, with the plugin replacing the built-in layer.
plugin_render_test(
    name = "render-test",
    data = ["//metrics:render-test-files"],
    header = "circle_layer.hpp",
    ignore = "render-tests/ignores.json",
    layer_type = "circle",
    manifest = {
        "//:drawable_renderer": "metrics/linux-opengl.json",
        "//:metal_renderer": "metrics/ios-metal-render-test-runner-style.json",
    },
    plugin = ":circle-layer",
    register = "mln_circle_layer_register",
)
