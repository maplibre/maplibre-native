load("@darwin_config//:config.bzl", "BUNDLE_ID_PREFIX")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:defs.bzl", "objc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//bazel:flags.bzl", "CPP_FLAGS")
load("//platform/ios/bazel:provisioning.bzl", "configure_device_profiles")

# The demo draws with layer types that are only registered in a build with plugin support, and the gltf layer
# only has a Metal shader:
#
#   bazel build //plugins/ios:PluginDemo --//:renderer=metal --//:plugins=true
#
# (`--ios_multi_cpus=sim_arm64` for the simulator, see README.md.)
_PLUGINS_ONLY = select({
    "//:plugins_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

configure_device_profiles()

# The SDK links the gltf layer and registers it through `MLNPuckPlugin`. The ngon layer is not part of the SDK, so
# the app links it itself and registers it through this small wrapper.
objc_library(
    name = "PluginRegistration",
    srcs = ["Registration/NgonPlugin.mm"],
    hdrs = ["Registration/NgonPlugin.h"],
    copts = CPP_FLAGS,
    includes = ["Registration"],
    module_name = "PluginRegistration",
    target_compatible_with = _PLUGINS_ONLY,
    deps = ["//plugins/ngon-layer"],
)

swift_library(
    name = "Sources",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "PluginDemo",
    tags = ["manual"],
    target_compatible_with = _PLUGINS_ONLY,
    deps = [
        ":PluginRegistration",
        "//platform:ios-sdk",
    ],
)

apple_bundle_version(
    name = "plugin_demo_version",
    build_version = "1.0.0",
)

ios_application(
    name = "PluginDemo",
    bundle_id = "{}.maplibre.plugindemo".format(BUNDLE_ID_PREFIX),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    provisioning_profile = "xcode_profile",
    # `asset://car-red.glb` in a style resolves against the root of the app bundle.
    resources = glob([
        "Models/*.glb",
        "Styles/*.json",
    ]),
    target_compatible_with = _PLUGINS_ONLY,
    version = ":plugin_demo_version",
    visibility = ["//visibility:public"],
    deps = [":Sources"],
)
