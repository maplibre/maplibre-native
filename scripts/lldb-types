type summary add "mln::CanonicalTileID" --summary-string "${var.z%u}/${var.x}/${var.y}"
type summary add "mln::UnwrappedTileID" --summary-string "${var.canonical}+${var.wrap}"
type summary add "mln::OverscaledTileID" --summary-string "${var.canonical}=>${var.overscaledZ%u}"

type summary add -e -x "^mln::Range<.+>$" --summary-string "${var.min%d} ⇒ ${var.max%d}"
type summary add -e -x "^mln::Rect<.+>$" --summary-string "Size: ${var.w%d}×${var.h%d} — Offset: ${var.x}/${var.y}"
type summary add "mln::Size" --summary-string "${var.width}/${var.height}"
type summary add "mln::LatLng" --summary-string "${var.lat}/${var.lon}"

type summary add "mln::Color" --summary-string "${var.r}, ${var.g}, ${var.b}, ${var.a}"

type summary add -e -x "^mln::Point<.+>$" --summary-string "${var.x}/${var.y}"
type summary add -e -x "^mapbox::geometry::point<.+>$" --summary-string "${var.x}/${var.y}"

type summary add -e -x "^mln::optional<.+>$" --python-script "return valobj.GetChildAtIndex(0).GetChildAtIndex(0).GetChildAtIndex(1).GetValue() if valobj.GetChildMemberWithName('__engaged_').unsigned > 0 else '<empty>'"
